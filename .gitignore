      <input type="text" id="web_url" value="${url || 'https://www.baidu.com'}" style="flex:1;padding:6px;background:#0a0a0f;color:#fff;border:1px solid #333;border-radius:4px;outline:none;" />
      <button onclick="document.getElementById('web_frame').src=document.getElementById('web_url').value" style="padding:6px 12px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;">前往</button>
    </div>
    <iframe id="web_frame" src="${url || 'https://www.baidu.com'}" style="width:100%;height:calc(100% - 36px);border:none;"></iframe>
  `;
