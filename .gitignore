            <button class="sys-calc-btn" onclick="calcInput('6')">6</button>
            <button class="sys-calc-btn operator" onclick="calcInput('*')">×</button>
            <button class="sys-calc-btn" onclick="calcInput('1')">1</button>
            <button class="sys-calc-btn" onclick="calcInput('2')">2</button>
            <button class="sys-calc-btn" onclick="calcInput('3')">3</button>
            <button class="sys-calc-btn operator" onclick="calcInput('-')">−</button>
            <button class="sys-calc-btn" onclick="calcInput('0')">0</button>
            <button class="sys-calc-btn" onclick="calcInput('.')">.</button>
            <button class="sys-calc-btn" onclick="calcClear()">C</button>
            <button class="sys-calc-btn operator" onclick="calcInput('+')">+</button>
            <button class="sys-calc-btn equal" onclick="calcEval()" style="grid-column:span 4;">=</button>
          </div>
        </div>
      `);
      return true;
      
    case 'explorer':
      dolLog('📁 尝试打开资源管理器...', 'info');
      createGameWindow('📁 文件资源管理器', 600, 400, `
        <div style="width:100%;height:100%;background:#1e2126;padding:10px;overflow:auto;">
          <div style="font-weight:bold;color:#5a7ca3;margin-bottom:10px;">此电脑</div>
          <div style="display:flex;flex-direction:column;gap:5px;">
            <div style="display:flex;align-items:center;gap:10px;padding:5px;background:#2a2e35;border-radius:3px;">
              <span>📁</span><span>桌面</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:5px;background:#2a2e35;border-radius:3px;">
              <span>📁</span><span>文档</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:5px;background:#2a2e35;border-radius:3px;">
              <span>📁</span><span>下载</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:5px;background:#2a2e35;border-radius:3px;">
              <span>📁</span><span>音乐</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:5px;background:#2a2e35;border-radius:3px;">
              <span>📁</span><span>图片</span>
            </div>
          </div>
          <div style="margin-top:20px;color:#888;font-size:12px;">提示：浏览器环境下无法访问本地文件系统</div>
