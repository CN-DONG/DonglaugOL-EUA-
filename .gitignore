    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>JPG</option><option>PNG</option><option>GIF</option><option>BMP</option><option>WebP</option></select></div>';
    showInlineUI(html);
    var imgEl = document.getElementById(uid);
    if (imgEl) imgEl.addEventListener('change', function() { const act = window.__nsCustomAction || '图片格式选择'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('图片格式选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  // /ns/network 网络选择框
  if (line === '/ns/network' || line.startsWith('/ns/network<')) {
    const labelMatch = line.match(/^\/ns\/network(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nsnet' + Date.now();
    let html = '<div style="width:320px;padding:10px;border-radius:12px;background:#e0e4eb;margin:10px;">';
    if (customLabel) { html += '<div style="color:#333;font-size:14px;margin-bottom:6px;font-weight:500;">' + escapeHtml(customLabel) + '</div>'; }
    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>WiFi</option><option>移动网络</option><option>有线网络</option><option>蓝牙</option><option>离线</option></select></div>';
    showInlineUI(html);
    var netEl = document.getElementById(uid);
    if (netEl) netEl.addEventListener('change', function() { const act = window.__nsCustomAction || '网络选择'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('网络选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  // /ns/layout 布局选择框
  if (line === '/ns/layout' || line.startsWith('/ns/layout<')) {
    const labelMatch = line.match(/^\/ns\/layout(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nslay' + Date.now();
    let html = '<div style="width:320px;padding:10px;border-radius:12px;background:#e0e4eb;margin:10px;">';
    if (customLabel) { html += '<div style="color:#333;font-size:14px;margin-bottom:6px;font-weight:500;">' + escapeHtml(customLabel) + '</div>'; }
    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>单列布局</option><option>双列布局</option><option>三列布局</option><option>网格布局</option><option>列表布局</option></select></div>';
    showInlineUI(html);
    var layEl = document.getElementById(uid);
    if (layEl) layEl.addEventListener('change', function() { const act = window.__nsCustomAction || '布局选择'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('布局选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  // /ns/interval 刷新间隔选择框
