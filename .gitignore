// 本地应用协议映射
const olAppProtocols = {
  'mail': 'mailto:',
  'email': 'mailto:',
  'tel': 'tel:',
  'phone': 'tel:',
  'sms': 'sms:',
  'skype': 'skype:',
  'zoom': 'zoommtg:',
  'teams': 'msteams:',
  'discord': 'discord:',
  'slack': 'slack:',
  'spotify': 'spotify:',
  'steam': 'steam:',
  'calculator': 'calc:',
  'notepad': 'notepad:',
  'paint': 'mspaint:',
  'word': 'winword:',
  'excel': 'excel:',
  'powerpoint': 'powerpnt:',
  'outlook': 'outlook:',
  'browser': 'https://',
  'search': 'https://www.google.com/search?q='
};

function parseOlCmd(cmd) {
  const line = cmd.trim();
  
  // 1. /ol/open<软件名> - 打开软件官网
  const openMatch = line.match(/^\/ol\/open<([^>]+)>$/);
  if (openMatch) {
    const software = openMatch[1].toLowerCase();
    if (olSoftwareList[software]) {
      const info = olSoftwareList[software];
      dolLog(`🌐 打开软件: ${info.name}`, 'suc');
      dolLog(`🔗 官网: ${info.url}`, 'info');
      window.open(info.url, '_blank');
      dolLog('✅ 已打开官网', 'suc');
    } else {
      // 尝试搜索
      dolLog(`🔍 未找到 ${software}，正在搜索...`, 'info');
      window.open(`https://www.google.com/search?q=${encodeURIComponent(software)}+download`, '_blank');
      dolLog('✅ 已打开搜索页面', 'suc');
    }
    return true;
  }
  
  // 2. /ol/install<软件名> - 下载安装包
  const installMatch = line.match(/^\/ol\/install<([^>]+)>$/);
  if (installMatch) {
    const software = installMatch[1].toLowerCase();
    if (olSoftwareList[software]) {
      const info = olSoftwareList[software];
      dolLog(`📦 下载安装包: ${info.name}`, 'suc');
      dolLog(`🔗 下载页: ${info.download}`, 'info');
      window.open(info.download, '_blank');
      dolLog('✅ 已打开下载页面', 'suc');
      
      // 创建下载提示
      const modal = document.createElement('div');
      modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);display:flex;justify-content:center;align-items:center;z-index:99999;';
      
      modal.innerHTML = `
        <div style="background:linear-gradient(145deg,#2a2e35,#1e2126);padding:30px;border-radius:15px;text-align:center;color:#e2e2e2;max-width:400px;">
          <div style="font-size:50px;margin-bottom:15px;">📦</div>
          <h3 style="color:#9fc0e5;margin-bottom:10px;">${info.name}</h3>
          <p style="color:#a8b9a8;margin-bottom:15px;">下载页面已打开</p>
          <button onclick="this.parentElement.parentElement.remove()" style="padding:10px 25px;background:rgba(85,215,150,0.7);color:#fff;border:none;border-radius:9999px;cursor:pointer;">关闭</button>
        </div>
      `;
      
      document.body.appendChild(modal);
      setTimeout(() => modal.remove(), 5000);
    } else {
      dolLog(`🔍 未找到 ${software}，正在搜索下载...`, 'info');
      window.open(`https://www.google.com/search?q=${encodeURIComponent(software)}+installer+download`, '_blank');
      dolLog('✅ 已打开搜索页面', 'suc');
    }
    return true;
  }
  
  // 3. /ol/search<关键词> - 搜索软件
  const searchMatch = line.match(/^\/ol\/search<([^>]+)>$/);
  if (searchMatch) {
    const keyword = searchMatch[1];
    dolLog(`🔍 搜索: ${keyword}`, 'info');
    window.open(`https://www.google.com/search?q=${encodeURIComponent(keyword)}+software`, '_blank');
    dolLog('✅ 已打开搜索页面', 'suc');
    return true;
  }
  
  // 4. /ol/list - 列出常用软件
  if (line === '/ol/list') {
    dolLog('📋 常用软件列表:', 'info');
    dolLog('', 'out');
    const categories = {
      '开发工具': ['vscode', 'sublime', 'atom', 'vs', 'nodejs', 'python', 'git', 'java', 'go', 'rust'],
      '浏览器': ['chrome', 'firefox', 'edge'],
      '媒体播放': ['vlc', 'spotify', 'obs', 'audacity'],
      '通讯软件': ['discord', 'telegram', 'wechat', 'qq', 'slack', 'teams', 'zoom', 'skype'],
      '办公软件': ['office', 'word', 'excel', 'powerpoint', 'notepad'],
      '设计工具': ['photoshop', 'gimp', 'blender', 'figma', 'canva'],
      '压缩工具': ['7zip', 'winrar'],
      '数据库': ['mongodb', 'mysql', 'postgresql', 'redis'],
      '框架/库': ['react', 'vue', 'angular', 'electron', 'flutter', 'typescript']
    };
    
    Object.keys(categories).forEach(cat => {
      dolLog(`【${cat}】`, 'suc');
      categories[cat].forEach(s => {
        if (olSoftwareList[s]) {
          dolLog(`  • ${s} - ${olSoftwareList[s].name}`, 'out');
        }
      });
      dolLog('', 'out');
    });
    
    dolLog('💡 使用 /ol/open<软件名> 打开官网', 'info');
    dolLog('💡 使用 /ol/install<软件名> 下载安装包', 'info');
    return true;
  }
  
  // 5. /ol/app<协议> - 打开本地应用
  const appMatch = line.match(/^\/ol\/app<([^>]+)>$/);
  if (appMatch) {
    const app = appMatch[1].toLowerCase();
    let protocol = '';
    let target = '';
    
    // 检查是否有参数
    const paramMatch = app.match(/^([^:]+):(.+)$/);
    if (paramMatch) {
      const appName = paramMatch[1];
      const param = paramMatch[2];
      if (olAppProtocols[appName]) {
        protocol = olAppProtocols[appName];
        target = protocol + param;
      }
    } else if (olAppProtocols[app]) {
      protocol = olAppProtocols[app];
      target = protocol;
    } else {
      // 尝试直接作为协议
      target = app + ':';
    }
    
    dolLog(`📱 打开应用: ${app}`, 'info');
    dolLog(`🔗 协议: ${target}`, 'out');
    
    try {
      window.location.href = target;
      dolLog('✅ 已尝试打开应用', 'suc');
    } catch (e) {
      dolLog('⚠️ 应用可能未安装', 'warn');
    }
    return true;
  }
  
  // 6. /ol/download<URL> - 下载文件
  const downloadMatch = line.match(/^\/ol\/download<([^>]+)>$/);
  if (downloadMatch) {
    const url = downloadMatch[1];
    dolLog(`📥 下载文件: ${url}`, 'info');
    
    // 创建下载链接
    const a = document.createElement('a');
    a.href = url;
    a.download = '';
    a.target = '_blank';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    
    dolLog('✅ 已开始下载', 'suc');
    return true;
  }
  
  // 7. /ol/launch<应用名> - 尝试启动本地应用
  const launchMatch = line.match(/^\/ol\/launch<([^>]+)>$/);
  if (launchMatch) {
    const app = launchMatch[1].toLowerCase();
    dolLog(`🚀 尝试启动: ${app}`, 'info');
    
    // 尝试多种协议
    const protocols = [
      olAppProtocols[app] || '',
      `${app}:`,
      `https://${app}.com`
    ];
    
    let launched = false;
    protocols.forEach(proto => {
      if (proto && !launched) {
        try {
          dolLog(`🔗 尝试: ${proto}`, 'out');
          window.location.href = proto;
          launched = true;
        } catch (e) {}
      }
    });
    
    if (launched) {
      dolLog('✅ 已尝试启动应用', 'suc');
    } else {
      dolLog('⚠️ 无法启动应用，请手动打开', 'warn');
      dolLog('💡 或使用 /ol/open<' + app + '> 打开官网', 'info');
    }
    return true;
  }
  
  // 8. /ol/help - 显示帮助
  if (line === '/ol/help' || line === '/ol/') {
    dolLog('📖 /ol/ 指令帮助:', 'info');
    dolLog('', 'out');
    dolLog('  /ol/open<软件名>     打开软件官网', 'out');
    dolLog('  /ol/install<软件名>  下载安装包', 'out');
    dolLog('  /ol/search<关键词>   搜索软件', 'out');
    dolLog('  /ol/list             列出常用软件', 'out');
    dolLog('  /ol/app<协议>        打开本地应用', 'out');
    dolLog('  /ol/download<URL>    下载文件', 'out');
    dolLog('  /ol/launch<应用名>   尝试启动本地应用', 'out');
    dolLog('', 'out');
    dolLog('💡 示例:', 'info');
    dolLog('  /ol/open<vscode>', 'out');
    dolLog('  /ol/install<chrome>', 'out');
    dolLog('  /ol/app<mail:example@email.com>', 'out');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：安装程序模拟指令 /dcni/ 4块】 ==========
// ==================================================
// 第1块: /dcni/const<dialog>=<electron>     选择安装路径
// 第2块:    const fs<fs-extra>              复制文件到安装目录
// 第3块:    new.fap.in'ostable'<shell>      创建桌面快捷方式
// 第4块:    r<winreg>                       写入注册表关联文件格式
// 辅助指令:
//   /dcni/run                               执行完整安装流程
//   /dcni/help                              显示帮助

const dcniInstallState = {
  step: 0,
  installPath: '',
  appName: 'DonglaugOL App',
  filesCopied: false,
  shortcutCreated: false,
  registryWritten: false
};

function parseDcniCmd(cmd) {
  const line = cmd.trim();
  
  // ===== 第1块: 选择安装路径 =====
  const dialogMatch = line.match(/^\/dcni\/const<([^>]+)>=<([^>]+)>$/);
  if (dialogMatch) {
    const varName = dialogMatch[1];
    const module = dialogMatch[2];
    
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       【第1块】选择安装路径', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(`📦 模拟: const { ${varName} } = require('${module}')`, 'info');
    dolLog(`🔧 调用: ${varName}.showOpenDialog({properties: ['openDirectory']})`, 'info');
    dolLog('', 'out');
    
    // 创建路径选择界面
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);display:flex;justify-content:center;align-items:center;z-index:99999;';
    
    modal.innerHTML = `
      <div style="background:linear-gradient(145deg,#2a2e35,#1e2126);padding:30px;border-radius:15px;color:#e2e2e2;max-width:500px;width:90%;">
        <h3 style="color:#9fc0e5;margin-bottom:20px;text-align:center;">📁 选择安装路径</h3>
        <div style="background:rgba(45,49,56,0.6);padding:15px;border-radius:10px;margin-bottom:15px;">
          <label style="color:#a8b9a8;display:block;margin-bottom:8px;">安装目录:</label>
          <input type="text" id="dcniPathInput" value="C:\\Program Files\\DonglaugOL" style="width:100%;padding:10px;background:rgba(30,33,38,0.7);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#d0d8e2;font-family:monospace;">
        </div>
        <div style="background:rgba(45,49,56,0.6);padding:15px;border-radius:10px;margin-bottom:15px;">
          <label style="color:#a8b9a8;display:block;margin-bottom:8px;">应用名称:</label>
          <input type="text" id="dcniAppName" value="DonglaugOL App" style="width:100%;padding:10px;background:rgba(30,33,38,0.7);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#d0d8e2;font-family:monospace;">
        </div>
        <div style="display:flex;gap:10px;justify-content:center;">
          <button id="dcniSelectPath" style="padding:12px 25px;background:linear-gradient(180deg,rgba(85,215,150,0.75),rgba(55,188,122,0.65));color:#fff;border:none;border-radius:9999px;cursor:pointer;">确认路径</button>
          <button onclick="this.closest('div[style*=fixed]').remove()" style="padding:12px 25px;background:rgba(100,105,115,0.65);color:#fff;border:none;border-radius:9999px;cursor:pointer;">取消</button>
        </div>
      </div>
    `;
    
    document.body.appendChild(modal);
    
    // 绑定确认按钮
    setTimeout(() => {
      const selectBtn = document.getElementById('dcniSelectPath');
      if (selectBtn) {
        selectBtn.onclick = () => {
          const path = document.getElementById('dcniPathInput').value;
          const appName = document.getElementById('dcniAppName').value;
          dcniInstallState.installPath = path;
          dcniInstallState.appName = appName;
          dcniInstallState.step = 1;
          
          dolLog(`✅ 已选择安装路径: ${path}`, 'suc');
          dolLog(`✅ 应用名称: ${appName}`, 'suc');
          dolLog('', 'out');
          dolLog('💡 继续第2块: 输入    const fs<fs-extra>', 'info');
          
          modal.remove();
        };
      }
    }, 100);
    
    return true;
  }
  
  // ===== 第2块: 复制文件到安装目录 =====
  const fsMatch = line.match(/^\-+const fs<([^>]+)>$/);
  if (fsMatch) {
    const module = fsMatch[1];
    
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       【第2块】复制文件到安装目录', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(`📦 模拟: const fs = require('${module}')`, 'info');
    
    if (!dcniInstallState.installPath) {
      dolLog('⚠️ 请先执行第1块选择安装路径', 'warn');
      dolLog('💡 输入: /dcni/const<dialog>=<electron>', 'info');
      return true;
    }
    
    dolLog(`🔧 调用: fs.copySync('./app资源', '${dcniInstallState.installPath}')`, 'info');
    dolLog('', 'out');
    
    // 模拟复制进度
    dolLog('📂 正在复制文件...', 'info');
    
    const files = ['app.exe', 'config.json', 'resources/', 'libs/', 'data/'];
    let progress = 0;
    
    const copyInterval = setInterval(() => {
      if (progress < files.length) {
        dolLog(`   ✓ ${files[progress]} - 已复制`, 'out');
        progress++;
      } else {
        clearInterval(copyInterval);
        dcniInstallState.filesCopied = true;
        dcniInstallState.step = 2;
        dolLog('', 'out');
        dolLog(`✅ 所有文件已复制到: ${dcniInstallState.installPath}`, 'suc');
        dolLog('', 'out');
        dolLog('💡 继续第3块: 输入    new.fap.in\'ostable\'<shell>', 'info');
      }
    }, 300);
    
    return true;
  }
  
  // ===== 第3块: 创建桌面快捷方式 =====
  const shellMatch = line.match(/^\-+new\.fap\.in\'ostable\'<([^>]+)>$/);
  if (shellMatch) {
    const module = shellMatch[1];
    
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       【第3块】创建桌面快捷方式', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(`📦 模拟: const { shell } = require('${module}')`, 'info');
    
    if (!dcniInstallState.filesCopied) {
      dolLog('⚠️ 请先执行第2块复制文件', 'warn');
      dolLog('💡 输入:    const fs<fs-extra>', 'info');
      return true;
    }
    
    dolLog(`🔧 调用: shell.createShortcut('${dcniInstallState.installPath}\\${dcniInstallState.appName}.exe')`, 'info');
    dolLog('', 'out');
    
    // 模拟创建快捷方式
    dolLog('🔗 正在创建桌面快捷方式...', 'info');
    
    setTimeout(() => {
      dcniInstallState.shortcutCreated = true;
      dcniInstallState.step = 3;
      dolLog(`   ✓ 桌面快捷方式已创建`, 'out');
      dolLog(`   ✓ 开始菜单快捷方式已创建`, 'out');
      dolLog('', 'out');
      dolLog(`✅ 快捷方式创建完成`, 'suc');
      dolLog('', 'out');
      dolLog('💡 继续第4块: 输入    r<winreg>', 'info');
    }, 500);
    
    return true;
  }
  
  // ===== 第4块: 写入注册表关联文件格式 =====
  const regMatch = line.match(/^\-+r<([^>]+)>$/);
  if (regMatch) {
    const module = regMatch[1];
    
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       【第4块】写入注册表关联文件格式', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(`📦 模拟: require('${module}')`, 'info');
    
    if (!dcniInstallState.shortcutCreated) {
      dolLog('⚠️ 请先执行第3块创建快捷方式', 'warn');
      dolLog('💡 输入:    new.fap.in\'ostable\'<shell>', 'info');
      return true;
    }
    
    dolLog(`🔧 调用: 写入注册表 HKCR\\.${dcniInstallState.appName.toLowerCase()}`, 'info');
    dolLog('', 'out');
    
    // 模拟写入注册表
    dolLog('📝 正在写入注册表...', 'info');
    
    const regKeys = [
      `HKCR\\.dolapp -> ${dcniInstallState.appName}.File`,
      `HKCR\\${dcniInstallState.appName}.File\\shell\\open\\command -> "${dcniInstallState.installPath}\\${dcniInstallState.appName}.exe" "%1"`,
      `HKCR\\${dcniInstallState.appName}.File\\DefaultIcon -> "${dcniInstallState.installPath}\\${dcniInstallState.appName}.exe,0"`,
      `HKCU\\Software\\${dcniInstallState.appName}\\InstallPath -> "${dcniInstallState.installPath}"`,
      `HKCU\\Software\\${dcniInstallState.appName}\\Version -> "1.0.0"`
    ];
    
    let regIndex = 0;
    const regInterval = setInterval(() => {
      if (regIndex < regKeys.length) {
        dolLog(`   ✓ ${regKeys[regIndex]}`, 'out');
        regIndex++;
      } else {
        clearInterval(regInterval);
        dcniInstallState.registryWritten = true;
        dcniInstallState.step = 4;
        dolLog('', 'out');
        dolLog('✅ 注册表写入完成', 'suc');
        dolLog('', 'out');
        dolLog('═══════════════════════════════════════════════════════════', 'out');
        dolLog('       🎉 安装完成！', 'suc');
        dolLog('═══════════════════════════════════════════════════════════', 'out');
        dolLog('', 'out');
        dolLog(`📦 应用: ${dcniInstallState.appName}`, 'info');
        dolLog(`📁 路径: ${dcniInstallState.installPath}`, 'info');
        dolLog(`🔗 快捷方式: 桌面 & 开始菜单`, 'info');
        dolLog(`📝 文件关联: .dolapp`, 'info');
      }
    }, 200);
    
    return true;
  }
  
  // ===== 辅助指令: 执行完整安装流程 =====
  if (line === '/dcni/run') {
    dolLog('🚀 执行完整安装流程...', 'suc');
    dolLog('', 'out');
    dolLog('按顺序执行以下4块指令:', 'info');
    dolLog('', 'out');
    dolLog('  【第1块】/dcni/const<dialog>=<electron>', 'out');
    dolLog('  【第2块】   const fs<fs-extra>', 'out');
    dolLog('  【第3块】   new.fap.in\'ostable\'<shell>', 'out');
    dolLog('  【第4块】   r<winreg>', 'out');
    dolLog('', 'out');
    dolLog('💡 请依次输入上述指令完成安装', 'info');
    return true;
  }
  
  // ===== 辅助指令: 显示帮助 =====
  if (line === '/dcni/help' || line === '/dcni/' || line === '/dcni') {
    dolLog('📖 /dcni/ 安装程序模拟指令帮助:', 'info');
    dolLog('', 'out');
    dolLog('  【第1块】/dcni/const<dialog>=<electron>', 'out');
    dolLog('           选择安装路径（弹出路径选择窗口）', 'out');
    dolLog('', 'out');
    dolLog('  【第2块】   const fs<fs-extra>', 'out');
    dolLog('           复制文件到安装目录（模拟文件复制）', 'out');
    dolLog('', 'out');
    dolLog('  【第3块】   new.fap.in\'ostable\'<shell>', 'out');
    dolLog('           创建桌面快捷方式（模拟创建快捷方式）', 'out');
    dolLog('', 'out');
    dolLog('  【第4块】   r<winreg>', 'out');
    dolLog('           写入注册表关联文件格式（模拟注册表写入）', 'out');
    dolLog('', 'out');
    dolLog('  辅助指令:', 'info');
    dolLog('    /dcni/run    - 执行完整安装流程', 'out');
    dolLog('    /dcni/help   - 显示此帮助', 'out');
    dolLog('', 'out');
    dolLog('⚠️ 注意: 浏览器环境无法真正执行安装操作', 'warn');
    dolLog('         此指令仅模拟安装流程演示', 'warn');
    return true;
  }
  
  // ===== 辅助指令: 显示当前状态 =====
  if (line === '=import & use<nb>%') {
    dollog('=================ok log')
    dollog('bro can not use this')
    dollog('>>>end output log')
    return true;
  }
   if (line === '=import & use<system>%') {
    dollog('=================ok log')
    dollog('you are so lucky')
    dollog('>>>end output log')
    return true;
  }
  
  if (line === '=import & use<3T-CGraphics>%') {
    dollog('==============ok')
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：彩蛋指令】 ==========
// ==================================================
// /egg/easteregg    - 显示彩蛋
// secret       - 输入秘密代码解锁隐藏功能

function parseEasterEggCmd(cmd) {
  const line = cmd.trim();
  
  // easteregg - 显示彩蛋
  if (line === '/egg/easteregg' || line === '=import & use<egg1>%') {
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    
    // 显示星星动画
    const stars = [
      '        *  .  *    .  *   .   *  .  *  .',
      '     .    *    .    *   .    *    .    *',
      '   *   .  *   .   *   .  *   .  *   .  *',
      '      .    *    .    *   .    *    .',
      '   *   .  *   .   *   .  *   .  *   .  *',
      '     .    *    .    *   .    *    .    *'
    ];
    
    stars.forEach(s => dolLog(s, 'info'));
    
    dolLog('', 'out');
    dolLog('==========================================dol egg log', 'out');
    dolLog('', 'out');
    dolLog('   1>>>🎉 You found the Easter Egg!', 'suc');
    dolLog('', 'out');
    dolLog('   DonglaugOL Terminal - Created by Dongper Studio', 'info');
    dolLog('   Version 3.1.0 - "The Future is Now"', 'info');
    dolLog('', 'out');
    dolLog('   Special Thanks:', 'info');
    dolLog('     - All contributors and testers', 'out');
    dolLog('     - The open source community', 'out');
    dolLog('     - You, the user!', 'out');
    dolLog('', 'out');
    dolLog('<<<7', 'out');
    dolLog('', 'out');
    dolLog('   🔑 Secret Code: DONGPER-2026-OL-1337', 'warn');
    dolLog('   💡 Use \'secret\' command to unlock hidden features!(need /dol/output<400>)', 'info');
    dolLog('', 'out');
    dolLog('===========================================================', 'out');
    
    // 创建彩蛋弹窗
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);display:flex;justify-content:center;align-items:center;z-index:99999;';
    
    modal.innerHTML = `
      <div style="background:linear-gradient(145deg,#1a1a2e,#16213e);padding:40px;border-radius:20px;text-align:center;color:#e2e2e2;max-width:400px;box-shadow:0 0 50px rgba(100,200,255,0.3);">
        <div style="font-size:80px;margin-bottom:20px;">🎉</div>
        <h2 style="color:#9fc0e5;margin-bottom:15px;">Easter Egg Found!</h2>
        <p style="color:#a8b9a8;margin-bottom:20px;">You discovered a hidden secret!</p>
        <div style="background:rgba(45,49,56,0.6);padding:15px;border-radius:10px;margin-bottom:20px;">
          <div style="color:#55d798;font-size:18px;font-weight:bold;">DONGPER-2024-OL-1337</div>
        </div>
        <p style="color:#d0d8e2;margin-bottom:15px;">Use this code with 'secret' command</p>
        <button onclick="this.closest('div[style*=fixed]').remove()" style="padding:12px 30px;background:linear-gradient(180deg,rgba(85,215,150,0.75),rgba(55,188,122,0.65));color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">Awesome!</button>
      </div>
    `;
    
    document.body.appendChild(modal);
    
    // 5秒后自动关闭
    setTimeout(() => {
      if (modal.parentElement) modal.remove();
    }, 8000);
    
    return true;
  }
  
  // secret - 输入秘密代码
  if (line === 'secret' || line === '/secret') {
    dolLog('', 'out');
    dolLog('1>>>', 'out');
    dolLog('        🔐 SECRET CODE UNLOCKED!', 'warn');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(' <<<4', 'info');
    dolLog('', 'out');
    
    // 创建输入弹窗
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);display:flex;justify-content:center;align-items:center;z-index:99999;';
    
    modal.innerHTML = `
      <div style="background:linear-gradient(145deg,#1a1a2e,#16213e);padding:40px;border-radius:20px;text-align:center;color:#e2e2e2;max-width:400px;box-shadow:0 0 30px rgba(255,100,100,0.2);">
        <div style="font-size:60px;margin-bottom:20px;">🔐</div>
        <h2 style="color:#9fc0e5;margin-bottom:15px;">Enter Secret Code</h2>
        <input type="text" id="secretCodeInput" placeholder="Enter code..." style="width:100%;padding:15px;background:rgba(30,33,38,0.7);border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:#d0d8e2;font-size:16px;text-align:center;margin-bottom:20px;">
        <div style="display:flex;gap:10px;justify-content:center;">
          <button id="submitSecret" style="padding:12px 30px;background:linear-gradient(180deg,rgba(85,215,150,0.75),rgba(55,188,122,0.65));color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">Submit</button>
          <button onclick="this.closest('div[style*=fixed]').remove()" style="padding:12px 30px;background:rgba(100,105,115,0.65);color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">Cancel</button>
        </div>
      </div>
    `;
    
    document.body.appendChild(modal);
    
    // 绑定提交按钮
    setTimeout(() => {
      const submitBtn = document.getElementById('submitSecret');
      if (submitBtn) {
        submitBtn.onclick = () => {
          const code = document.getElementById('secretCodeInput').value;
          if (code === '=import & use<sys>%') {
             dollog('=================ok log')
             dollog('>>>end output log')
            
            
            modal.innerHTML = `
              <div style="background:linear-gradient(145deg,#1a1a2e,#16213e);padding:40px;border-radius:20px;text-align:center;color:#e2e2e2;max-width:400px;box-shadow:0 0 50px rgba(85,215,150,0.3);">
                <div style="font-size:80px;margin-bottom:20px;">🏆</div>
                <h2 style="color:#55d798;margin-bottom:15px;">ACCESS GRANTED!</h2>
                <p style="color:#a8b9a8;margin-bottom:20px;">You are now a DonglaugOL Master!</p>
                <div style="background:rgba(45,49,56,0.6);padding:15px;border-radius:10px;margin-bottom:20px;text-align:left;">
                  <div style="color:#9fc0e5;margin-bottom:10px;">Hidden Features:</div>
                  <div style="color:#d0d8e2;">1. Matrix Mode</div>
                  <div style="color:#d0d8e2;">2. Rainbow Mode</div>
                  <div style="color:#d0d8e2;">3. Hacker Mode</div>
                  <div style="color:#d0d8e2;">4. Debug Mode</div>
                  <div style="color:#d0d8e2;">5. God Mode</div>
                </div>
                <button onclick="this.closest('div[style*=fixed]').remove()" style="padding:12px 30px;background:linear-gradient(180deg,rgba(85,215,150,0.75),rgba(55,188,122,0.65));color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">Close</button>
              </div>
            `;
          } else {
            dolLog('   [ACCESS DENIED]', 'err');
            dolLog('   Wrong code. Try \'easteregg\' to find the code.', 'warn');
            dolLog('', 'out');
            dolLog('═══════════════════════════════════════════════════════════', 'out');
            
            modal.innerHTML = `
              <div style="background:linear-gradient(145deg,#1a1a2e,#16213e);padding:40px;border-radius:20px;text-align:center;color:#e2e2e2;max-width:400px;box-shadow:0 0 30px rgba(255,100,100,0.3);">
                <div style="font-size:60px;margin-bottom:20px;">❌</div>
                <h2 style="color:#ff6b6b;margin-bottom:15px;">ACCESS DENIED</h2>
                <p style="color:#a8b9a8;margin-bottom:20px;">Wrong code entered</p>
                <p style="color:#d0d8e2;margin-bottom:15px;">Try 'easteregg' to find the correct code</p>
                <button onclick="this.closest('div[style*=fixed]').remove()" style="padding:12px 30px;background:rgba(100,105,115,0.65);color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">Close</button>
              </div>
            `;
          }
        };
      }
    }, 100);
    
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：1个其他自定义指令 /config/】 ==========
// ==================================================
// /config/set<键>=<值>                   设置配置项
// /config/get<键>                        获取配置项
// /config/list                           列出所有配置
// /config/clear                          清除所有配置
// /config/preset<预设名>                  应用预设配置

const customConfig = {
  theme: 'dark',
  fontSize: 14,
  animationEnabled: true,
  soundEnabled: true,
  autoSave: false
};

function parseConfigCmd(cmd) {
  const line = cmd.trim();
  
  // 设置配置项
  const setMatch = line.match(/^\/config\/set<([^>]+)>=(.+)$/);
  if (setMatch) {
    const key = setMatch[1];
    let value = setMatch[2];
    // 尝试转换类型
    if (value === 'true') value = true;
    else if (value === 'false') value = false;
    else if (!isNaN(value)) value = parseFloat(value);
    customConfig[key] = value;
    dolLog(`✅ 配置 ${key} = ${value}`, 'suc');
    return true;
  }
  
  // 获取配置项
  const getMatch = line.match(/^\/config\/get<([^>]+)>$/);
  if (getMatch) {
    const value = customConfig[getMatch[1]];
    dolLog(`📊 配置 ${getMatch[1]} = ${value}`, 'out');
    return true;
  }
  
  // 列出所有配置
  if (line === '/config/list') {
    dolLog('📋 当前配置:', 'info');
    Object.keys(customConfig).forEach(key => {
      dolLog(`  • ${key}: ${customConfig[key]}`, 'out');
    });
    return true;
  }
  
  // 清除所有配置
  if (line === '/config/clear') {
    Object.keys(customConfig).forEach(key => {
      delete customConfig[key];
    });
    dolLog('✅ 所有配置已清除', 'suc');
    return true;
  }
  
  // 应用预设配置
  const presetMatch = line.match(/^\/config\/preset<([^>]+)>$/);
  if (presetMatch) {
    const preset = presetMatch[1];
    switch(preset) {
      case 'light':
        Object.assign(customConfig, { theme: 'light', fontSize: 14, animationEnabled: true });
        document.body.style.background = '#fff';
        document.body.style.color = '#333';
        break;
      case 'dark':
        Object.assign(customConfig, { theme: 'dark', fontSize: 14, animationEnabled: true });
        document.body.style.background = '#2c3036';
        document.body.style.color = '#e2e2e2';
        break;
      case 'minimal':
        Object.assign(customConfig, { theme: 'dark', fontSize: 12, animationEnabled: false, soundEnabled: false });
        break;
      case 'developer':
        Object.assign(customConfig, { theme: 'dark', fontSize: 16, animationEnabled: true, soundEnabled: false });
        break;
      default:
        dolLog(`❌ 未知预设: ${preset}`, 'err');
        return true;
    }
    dolLog(`✅ 已应用预设: ${preset}`, 'suc');
    return true;
  }
  
  return false;
}

