    if (customLabel) { html += '<div style="color:#333;font-size:14px;margin-bottom:6px;font-weight:500;">' + escapeHtml(customLabel) + '</div>'; }
    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>1秒</option><option>5秒</option><option>10秒</option><option>30秒</option><option>1分钟</option><option>5分钟</option></select></div>';
    showInlineUI(html);
    var intEl = document.getElementById(uid);
    if (intEl) intEl.addEventListener('change', function() { const act = window.__nsCustomAction || '刷新间隔'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('刷新间隔选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  
  // /ns/priority 优先级选择框
  if (line === '/ns/priority' || line.startsWith('/ns/priority<')) {
    const labelMatch = line.match(/^\/ns\/priority(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nspri' + Date.now();
