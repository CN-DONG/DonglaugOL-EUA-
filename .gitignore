    if (line.startsWith('remind.')) return parseRemindAfter(line);
    if (line.startsWith('worldtime.')) return parseWorldTimeAdd(line);
    if (line.startsWith('calc.')) return parseCalcEvaluate(line) || parseCalcHistory(line);
    if (line.startsWith('convert.')) return parseConvertLength(line) || parseConvertWeight(line) || parseConvertTemp(line);
    if (line.startsWith('color.')) return parseColorPicker(line) || parseColorPalette(line);
    if (line.startsWith('chart.')) return parseChartBar(line) || parseChartLine(line) || parseChartPie(line) || parseChartRadar(line);
    if (line.startsWith('data.')) return parseDataTable(line) || parseDataTree(line);
    if (line.startsWith('md.')) return parseMdRender(line);
