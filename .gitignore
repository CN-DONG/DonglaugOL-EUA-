function createScreenshotWindow() {
  if (funcWindowCache.screenshot) {funcWindowCache.screenshot.classList.remove('hide');return funcWindowCache.screenshot;}
  const win = createBaseWindow('截图工具', 500, 400, 500, 150);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div style="padding:15px;">
      <div style="margin-bottom:15px;">
        <button onclick="takeScreenshot()" style="padding:8px 20px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;font-size:14px;">📸 截取屏幕</button>
      </div>
      <div id="screenshotResult" style="width:100%;height:300px;border:1px dashed #5a7ca3;border-radius:8px;display:flex;justify-content:center;align-items:center;">
        <div style="color:#aaa;">截图结果将显示在这里</div>
      </div>
    </div>
  `;
  window.takeScreenshot = async () => {
    try {
      const stream = await navigator.mediaDevices.getDisplayMedia({video: {displaySurface: 'monitor'}});
      const video = document.createElement('video');
      video.srcObject = stream;
      video.onloadedmetadata = () => {
        const canvas = document.createElement('canvas');
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0);
        stream.getTracks().forEach(track => track.stop());
        const img = document.createElement('img');
        img.src = canvas.toDataURL();
        img.style.maxWidth = '100%';
        img.style.maxHeight = '300px';
        win.querySelector('#screenshotResult').innerHTML = '';
        win.querySelector('#screenshotResult').appendChild(img);
        dolLog(`✅ 截图成功`, 'suc');
      };
    } catch (e) {
      dolLog(`❌ 截图失败：${e.message}`, 'err');
    }
  };
  funcWindowCache.screenshot = win;
  dolLog(`✅ 截图工具窗口已创建`, 'suc');
  return win;
}

function createColorPickWindow() {
  if (funcWindowCache.colorpick) {funcWindowCache.colorpick.classList.remove('hide');return funcWindowCache.colorpick;}
  const win = createBaseWindow('颜色选择器', 300, 250, 650, 250);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div style="padding:20px;text-align:center;">
      <input type="color" id="colorPicker" value="#5a7ca3" style="width:80px;height:80px;border:none;border-radius:8px;cursor:pointer;">
      <div style="margin-top:15px;">
        <div style="color:#5a7ca3;">HEX:</div>
        <input type="text" id="hexVal" value="#5a7ca3" style="width:120px;padding:5px;border-radius:4px;border:1px solid #5a7ca3;background:#1a1a2e;color:#fff;">
      </div>
      <div style="margin-top:10px;">
        <button onclick="copyColor()" style="padding:5px 15px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;">复制颜色值</button>
      </div>
    </div>
  `;
  win.querySelector('#colorPicker').oninput = (e) => {
    win.querySelector('#hexVal').value = e.target.value;
  };
  window.copyColor = () => {
    const val = win.querySelector('#hexVal').value;
    navigator.clipboard.writeText(val);
    dolLog(`✅ 颜色值 ${val} 已复制`, 'suc');
  };
  funcWindowCache.colorpick = win;
  dolLog(`✅ 颜色选择器窗口已创建`, 'suc');
  return win;
}

function createWebSimWindow() {
  if (funcWindowCache.websim) {funcWindowCache.websim.classList.remove('hide');return funcWindowCache.websim;}
  const win = createBaseWindow('网页模拟器', 800, 600, 400, 100);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div style="display:flex;flex-direction:column;height:100%;">
      <div style="padding:5px;background:#1a1a2e;border-bottom:1px solid #333;display:flex;gap:5px;">
        <input type="text" id="webUrl" placeholder="输入网址或HTML代码" style="flex:1;padding:5px;border-radius:4px;border:1px solid #5a7ca3;background:#2c3036;color:#fff;">
        <button onclick="loadWebSim()" style="padding:5px 15px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;">加载</button>
      </div>
      <iframe id="webFrame" style="flex:1;border:none;background:#fff;"></iframe>
    </div>
  `;
  window.loadWebSim = () => {
    const url = win.querySelector('#webUrl').value.trim();
    const frame = win.querySelector('#webFrame');
    if (url.startsWith('http')) {
      frame.src = url;
    } else {
      frame.srcdoc = url || '<html><body style="display:flex;justify-content:center;align-items:center;height:100%;"><h1>网页模拟器</h1></body></html>';
    }
    dolLog(`✅ 网页模拟器已加载`, 'suc');
  };
  loadWebSim();
  funcWindowCache.websim = win;
  dolLog(`✅ 网页模拟器窗口已创建`, 'suc');
  return win;
}

function createWeatherWindow() {
  if (funcWindowCache.weather) {funcWindowCache.weather.classList.remove('hide');return funcWindowCache.weather;}
  const win = createBaseWindow('天气查询', 400, 300, 550, 200);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div style="padding:15px;">
      <div style="margin-bottom:15px;">
        <input type="text" id="cityInput" placeholder="输入城市名称" style="width:200px;padding:5px;border-radius:4px;border:1px solid #5a7ca3;background:#2c3036;color:#fff;">
        <button onclick="getWeather()" style="padding:5px 15px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;">查询</button>
      </div>
      <div id="weatherInfo" style="font-size:14px;text-align:center;">
        <div style="color:#aaa;">输入城市名称查询天气</div>
      </div>
    </div>
  `;
  window.getWeather = () => {
    const city = win.querySelector('#cityInput').value.trim();
    const info = win.querySelector('#weatherInfo');
    if (city) {
      info.innerHTML = `
        <div style="font-size:24px;color:#44ff44;">🌤️ ${city}</div>
        <div style="color:#5a7ca3;margin-top:10px;">温度: 25°C</div>
        <div style="color:#ffbd2e;">天气: 晴</div>
        <div style="color:#9b59b6;">湿度: 60%</div>
        <div style="color:#3498db;">风速: 3级</div>
      `;
      dolLog(`✅ 天气查询完成: ${city}`, 'suc');
    } else {
      info.innerHTML = '<div style="color:#ff6666;">请输入城市名称</div>';
    }
  };
  funcWindowCache.weather = win;
  dolLog(`✅ 天气查询窗口已创建`, 'suc');
  return win;
}

function createTranslateWindow() {
  if (funcWindowCache.translate) {funcWindowCache.translate.classList.remove('hide');return funcWindowCache.translate;}
  const win = createBaseWindow('翻译工具', 500, 400, 500, 150);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div style="padding:15px;height:100%;display:flex;flex-direction:column;gap:10px;">
      <div style="flex:1;">
        <div style="color:#5a7ca3;margin-bottom:5px;">原文：</div>
        <textarea id="sourceText" placeholder="输入要翻译的文本" style="width:100%;height:100px;padding:5px;border-radius:4px;border:1px solid #5a7ca3;background:#2c3036;color:#fff;resize:none;"></textarea>
      </div>
      <button onclick="doTranslate()" style="padding:8px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;">🔄 翻译</button>
      <div style="flex:1;">
        <div style="color:#44ff44;margin-bottom:5px;">译文：</div>
        <textarea id="targetText" readonly style="width:100%;height:100px;padding:5px;border-radius:4px;border:1px solid #44ff44;background:#1a1a2e;color:#44ff44;resize:none;"></textarea>
      </div>
    </div>
  `;
  window.doTranslate = () => {
    const text = win.querySelector('#sourceText').value.trim();
    const target = win.querySelector('#targetText');
    if (text) {
      target.value = '翻译中...';
      setTimeout(() => {
        target.value = '（模拟翻译结果）' + text.split('').reverse().join('');
        dolLog(`✅ 翻译完成`, 'suc');
      }, 500);
    } else {
      target.value = '请输入要翻译的文本';
    }
  };
  funcWindowCache.translate = win;
  dolLog(`✅ 翻译工具窗口已创建`, 'suc');
  return win;
}

function createCalcEnhWindow() {
  if (funcWindowCache.calcenh) {funcWindowCache.calcenh.classList.remove('hide');return funcWindowCache.calcenh;}
  const win = createBaseWindow('增强计算器', 350, 450, 550, 180);
  const content = win.querySelector('.sys-win-content');
  var btns = ['7','8','9','/','4','5','6','*','1','2','3','-','0','.','=','+','C','(',')','%'];
  var btnHtml = '';
  for (var i = 0; i < btns.length; i++) {
    btnHtml += '<button onclick="window.calcenhBtnClick(\'' + btns[i] + '\')" style="height:50px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;font-size:18px;">' + btns[i] + '</button>';
  }
  content.innerHTML = '<div style="padding:10px;"><input type="text" id="calcDisplay" readonly style="width:100%;height:50px;font-size:24px;text-align:right;padding:5px;border-radius:4px;border:1px solid #5a7ca3;background:#1a1a2e;color:#44ff44;margin-bottom:10px;"><div style="display:grid;grid-template-columns:repeat(4,1fr);gap:5px;">' + btnHtml + '</div></div>';
  window.calcenhBtnClick = function(btn) {
    var display = win.querySelector('#calcDisplay');
    if (btn === 'C') {
      display.value = '';
    } else if (btn === '=') {
      try {
        display.value = eval(display.value);
        dolLog('✅ 计算结果: ' + display.value, 'suc');
      } catch (e) {
        display.value = '错误';
      }
    } else {
      display.value += btn;
    }
  };
  funcWindowCache.calcenh = win;
  dolLog('✅ 增强计算器窗口已创建', 'suc');
  return win;
}

function parseSysSquareBtn(cmd) {
  const imgReg = /phbic\((.+?)\)(?=_|$)/;
  const webReg = /_btw\.\((https?:\/\/.+?)\)(?=_|$)/;
  const swReg = /_sw\.\((.+?)\)(?=_|$)/;
  const clsReg = /_cls\.\(\)(?=_|$)/;
  const colReg = /_col\.\((.+?)\)(?=_|$)/;
  const sndReg = /_snd\.\(\)(?=_|$)/;
  const topReg = /_top\.\((.+?)\)(?=_|$)/;
  const hidReg = /_hid\.\((.+?)\)(?=_|$)/;
  const shoReg = /_sho\.\((.+?)\)(?=_|$)/;
  const bigReg = /_big\.\(\)(?=_|$)/;
  const shdReg = /_shd\.\(\)(?=_|$)/;
  const rotReg = /_rot\.\(\)(?=_|$)/;
  const disReg = /_dis\.\(\)(?=_|$)/;
  const resReg = /_res\.\(\)(?=_|$)/;
  const nameReg = /_name\.\((.+?)\)(?=_|$)/;
  const textReg = /_text\.\(\)(?=_|$)/;
  const calcReg = /_calc\.\(\)(?=_|$)/;
  const noteReg = /_note\.\(\)(?=_|$)/;
  const imgWinReg = /_img\.\(\)(?=_|$)/;
  const setReg = /_set\.\(\)(?=_|$)/;
  const togtopReg = /_togtop\.\((.+?)\)(?=_|$)/;
  const hideallReg = /_hideall\.\(\)(?=_|$)/;
  const camReg = /_cam\.\(\)(?=_|$)/;
  const videoReg = /_video\.\(\)(?=_|$)/;
  const procReg = /_proc\.\(\)(?=_|$)/;
  const audioReg = /_audio\.\(\)(?=_|$)/;
  const fileReg = /_file\.\(\)(?=_|$)/;
  const netReg = /_net\.\(\)(?=_|$)/;
  const sysinfoReg = /_sysinfo\.\(\)(?=_|$)/;
  const screenshotReg = /_screenshot\.\(\)(?=_|$)/;
  const colorpickReg = /_colorpick\.\(\)(?=_|$)/;
  const websimReg = /_websim\.\(\)(?=_|$)/;
  const weatherReg = /_weather\.\(\)(?=_|$)/;
  const translateReg = /_translate\.\(\)(?=_|$)/;
  const calcenhReg = /_calcenh\.\(\)(?=_|$)/;
  const clockReg = /_clock\.\(\)(?=_|$)/;
  const timerReg = /_timer\.\(\)(?=_|$)/;
  const alarmReg = /_alarm\.\(\)(?=_|$)/;
  const stopwatchReg = /_stopwatch\.\(\)(?=_|$)/;
  const calendarReg = /_calendar\.\(\)(?=_|$)/;
  const todoReg = /_todo\.\(\)(?=_|$)/;
  const dictReg = /_dict\.\(\)(?=_|$)/;
  const paintReg = /_paint\.\(\)(?=_|$)/;
  const sciCalcReg = /_scicalc\.\(\)(?=_|$)/;
  const musicReg = /_music\.\(\)(?=_|$)/;
  const chatReg = /_chat\.\(\)(?=_|$)/;
  const mailReg = /_mail\.\(\)(?=_|$)/;
  const photoReg = /_photo\.\(\)(?=_|$)/;
  const mapReg = /_map\.\(\)(?=_|$)/;
  const newsReg = /_news\.\(\)(?=_|$)/;
  const gameReg = /_game\.\(\)(?=_|$)/;
  const imgUrlReg = /_imgurl\.\((.+?)\)(?=_|$)/;
  
  const imgUrl = cmd.match(imgReg)?.[1].trim() || '';
  const iconUrl = cmd.match(imgUrlReg)?.[1].trim() || '';
  const webUrl = cmd.match(webReg)?.[1].trim() || '';
  const switchId = cmd.match(swReg)?.[1].trim() || '';
  const isCls = cmd.match(clsReg) ? true : false;
  const colColor = cmd.match(colReg)?.[1].trim() || '';
  const isSnd = cmd.match(sndReg) ? true : false;
  const topId = cmd.match(topReg)?.[1].trim() || '';
  const hidId = cmd.match(hidReg)?.[1].trim() || '';
  const shoId = cmd.match(shoReg)?.[1].trim() || '';
  const isBig = cmd.match(bigReg) ? true : false;
  const isShd = cmd.match(shdReg) ? true : false;
  const isRot = cmd.match(rotReg) ? true : false;
  const isDis = cmd.match(disReg) ? true : false;
  const isRes = cmd.match(resReg) ? true : false;
  const btnName = cmd.match(nameReg)?.[1].trim() || '';
  const isText = cmd.match(textReg) ? true : false;
  const isCalc = cmd.match(calcReg) ? true : false;
  const isNote = cmd.match(noteReg) ? true : false;
  const isImgWin = cmd.match(imgWinReg) ? true : false;
  const isSet = cmd.match(setReg) ? true : false;
  const togtopId = cmd.match(togtopReg)?.[1].trim() || '';
  const isHideall = cmd.match(hideallReg) ? true : false;
  const isCam = cmd.match(camReg) ? true : false;
  const isVideo = cmd.match(videoReg) ? true : false;
  const isProc = cmd.match(procReg) ? true : false;
  const isAudio = cmd.match(audioReg) ? true : false;
  const isFile = cmd.match(fileReg) ? true : false;
  const isNet = cmd.match(netReg) ? true : false;
  const isSysinfo = cmd.match(sysinfoReg) ? true : false;
  const isScreenshot = cmd.match(screenshotReg) ? true : false;
  const isColorpick = cmd.match(colorpickReg) ? true : false;
  const isWebSim = cmd.match(websimReg) ? true : false;
  const isWeather = cmd.match(weatherReg) ? true : false;
  const isTranslate = cmd.match(translateReg) ? true : false;
  const isCalcEnh = cmd.match(calcenhReg) ? true : false;
  const isClock = cmd.match(clockReg) ? true : false;
  const isTimer = cmd.match(timerReg) ? true : false;
  const isAlarm = cmd.match(alarmReg) ? true : false;
  const isStopwatch = cmd.match(stopwatchReg) ? true : false;
  const isCalendar = cmd.match(calendarReg) ? true : false;
  const isTodo = cmd.match(todoReg) ? true : false;
  const isDict = cmd.match(dictReg) ? true : false;
  const isPaint = cmd.match(paintReg) ? true : false;
  const isSciCalc = cmd.match(sciCalcReg) ? true : false;
  const isMusic = cmd.match(musicReg) ? true : false;
  const isChat = cmd.match(chatReg) ? true : false;
  const isMail = cmd.match(mailReg) ? true : false;
  const isPhoto = cmd.match(photoReg) ? true : false;
  const isMap = cmd.match(mapReg) ? true : false;
  const isNews = cmd.match(newsReg) ? true : false;
  const isGame = cmd.match(gameReg) ? true : false;
  
  const hasFunc = webUrl || switchId || isCls || colColor || isSnd || topId || hidId || shoId || isBig || isShd || isRot || isDis || isRes || isText || isCalc || isNote || isImgWin || isSet || togtopId || isHideall || isCam || isVideo || isProc || isAudio || isFile || isNet || isSysinfo || isScreenshot || isColorpick || isWebSim || isWeather || isTranslate || isCalcEnh || isClock || isTimer || isAlarm || isStopwatch || isCalendar || isTodo || isDict || isPaint || isSciCalc || isMusic || isChat || isMail || isPhoto || isMap || isNews || isGame;
  
  const btnCmd = cmd.replace(imgReg, '').replace(imgUrlReg, '').replace(webReg, '').replace(swReg, '').replace(clsReg, '').replace(colReg, '').replace(sndReg, '').replace(topReg, '').replace(hidReg, '').replace(shoReg, '').replace(bigReg, '').replace(shdReg, '').replace(rotReg, '').replace(disReg, '').replace(resReg, '').replace(nameReg, '').replace(textReg, '').replace(calcReg, '').replace(noteReg, '').replace(imgWinReg, '').replace(setReg, '').replace(togtopReg, '').replace(hideallReg, '').replace(camReg, '').replace(videoReg, '').replace(procReg, '').replace(audioReg, '').replace(fileReg, '').replace(netReg, '').replace(sysinfoReg, '').replace(screenshotReg, '').replace(colorpickReg, '').replace(websimReg, '').replace(weatherReg, '').replace(translateReg, '').replace(calcenhReg, '').replace(clockReg, '').replace(timerReg, '').replace(alarmReg, '').replace(stopwatchReg, '').replace(calendarReg, '').replace(todoReg, '').replace(dictReg, '').replace(paintReg, '').replace(sciCalcReg, '').replace(musicReg, '').replace(chatReg, '').replace(mailReg, '').replace(photoReg, '').replace(mapReg, '').replace(newsReg, '').replace(gameReg, '');
  const reg = /^\/nad\/btn<(\d+)>\*<(\d+)>ip\{(\d+)\}\*\{(\d+)\}@\s+(.+)\[(\d+)\]$/;
  const match = btnCmd.match(reg);
  if (!match) {
    dolLog(`❌ 按钮基础格式错误！示例：/nad/btn<80>*<80>ip{100}*{100}@ 名称[1]`, 'err');
    return false;
  }
  const [, w, h, x, y, btnKey, num] = match;
  const btnUniqueKey = `${btnKey}${num}_${Date.now()}`;
  
  const btnContainer = document.createElement('div');
  btnContainer.className = 'sys-btn-container';
  btnContainer.style.left = `${x}px`;
  btnContainer.style.top = `${y}px`;
  
  const btn = document.createElement('button');
  btn.className = 'sys-square-btn';
  btn.style.width = `${w}px`;
  btn.style.height = `${h}px`;
  btn.textContent = btnKey;
  btn.setAttribute('data-btnkey', btnUniqueKey);
  btnStateCache[btnUniqueKey] = {big:false, shd:false, rot:false, dis:false};
  
  const btnNameEl = document.createElement('div');
  btnNameEl.className = 'sys-btn-name';
  btnNameEl.textContent = btnName || btnKey;
  
  btnContainer.appendChild(btn);
  btnContainer.appendChild(btnNameEl);
  
  if (imgUrl) {
    btn.style.backgroundImage = `url(${imgUrl})`;
    btn.classList.add('has-img');
    dolLog(`✅ ${btnUniqueKey} 内置图标设置成功`, 'ut');
  } else if (iconUrl) {
    btn.style.backgroundImage = `url(${iconUrl})`;
    btn.classList.add('has-img');
    dolLog(`✅ ${btnUniqueKey} 自定义图片设置成功: ${iconUrl}`, 'ut');
  }
  
  const executeFunc = () => {
    if (btnStateCache[btnUniqueKey].dis) return;
    if (isSnd) playSysSound();
    if (switchId) {
      const targetWin = sysWindowCache[switchId];
      if (targetWin) {targetWin.classList.toggle('hide');btn.classList.toggle('switch-on');dolLog(`✅ ${btnUniqueKey} → ${switchId}窗口${targetWin.classList.contains('hide')?'隐藏':'显示'}`, 'suc');}
      else dolLog(`❌ 开关联动失败：未找到ID为${switchId}的窗口`, 'err');
    }
    if (isCls) {document.querySelectorAll('.sys-btn-container, .sys-window, .nk-ad-btn, .nsrp-ad').forEach(el => el.remove());sysWindowCache={};btnStateCache={};funcWindowCache={};dolLog(`✅ ${btnUniqueKey} → 桌面清屏完成`, 'suc');}
    if (colColor) {btn.style.backgroundColor = colColor;dolLog(`✅ ${btnUniqueKey} → 按钮颜色设置为${colColor}`, 'suc');}
    if (topId) {const targetWin = sysWindowCache[topId];if (targetWin) {Object.values(sysWindowCache).forEach(win => win.classList.remove('window-top'));targetWin.classList.add('window-top');dolLog(`✅ ${btnUniqueKey} → ${topId}窗口已置顶`, 'suc');} else dolLog(`❌ 置顶失败：未找到ID为${topId}的窗口`, 'err');}
    if (hidId) {const targetWin = sysWindowCache[hidId];if (targetWin) {targetWin.classList.add('hide');dolLog(`✅ ${btnUniqueKey} → ${hidId}窗口已隐藏`, 'suc');} else dolLog(`❌ 隐藏失败：未找到ID为${hidId}的窗口`, 'err');}
    if (shoId) {const targetWin = sysWindowCache[shoId];if (targetWin) {targetWin.classList.remove('hide');dolLog(`✅ ${btnUniqueKey} → ${shoId}窗口已显示`, 'suc');} else dolLog(`❌ 显示失败：未找到ID为${shoId}的窗口`, 'err');}
    if (webUrl) {window.open(webUrl, '_blank');dolLog(`✅ ${btnUniqueKey} → 打开网站：${webUrl}`, 'suc');}
    
    const state = btnStateCache[btnUniqueKey];
    if (isBig) {state.big=!state.big;btn.classList.toggle('btn-big', state.big);dolLog(`✅ ${btnUniqueKey} → 按钮${state.big?'放大':'还原'}`, 'suc');}
    if (isShd) {state.shd=!state.shd;btn.classList.toggle('btn-shadow', state.shd);dolLog(`✅ ${btnUniqueKey} → 按钮${state.shd?'发光':'取消发光'}`, 'suc');}
    if (isRot) {state.rot=!state.rot;btn.classList.toggle('btn-rotate', state.rot);dolLog(`✅ ${btnUniqueKey} → 按钮${state.rot?'旋转':'还原'}`, 'suc');}
    if (isDis) {state.dis=!state.dis;btn.classList.toggle('btn-disable', state.dis);btn.disabled=state.dis;dolLog(`✅ ${btnUniqueKey} → 按钮${state.dis?'禁用':'启用'}`, 'suc');}
    if (isRes) {btn.classList.remove('btn-big','btn-shadow','btn-rotate','btn-disable','switch-on');btn.style.backgroundColor='';btn.disabled=false;btnStateCache[btnUniqueKey]={big:false,shd:false,rot:false,dis:false};dolLog(`✅ ${btnUniqueKey} → 按钮样式重置完成`, 'suc');}
    
    if (isText) createTextWindow();
    if (isCalc) createCalcWindow();
    if (isNote) createNoteWindow();
    if (isImgWin) createImgWindow();
    if (isSet) createSetWindow();
    if (togtopId) {
      const targetWin = sysWindowCache[togtopId];
      if (!targetWin) {dolLog(`❌ 置顶切换失败：未找到ID为${togtopId}的窗口`, 'err');return;}
      const isTop = targetWin.classList.contains('window-top');
      if (isTop) {
        targetWin.classList.remove('window-top');
        dolLog(`✅ ${btnUniqueKey} → ${togtopId}窗口取消置顶`, 'suc');
      } else {
        Object.values(sysWindowCache).forEach(win => win.classList.remove('window-top'));
        targetWin.classList.add('window-top');
        dolLog(`✅ ${btnUniqueKey} → ${togtopId}窗口已置顶`, 'suc');
      }
    }
    if (isHideall) {
      Object.values(funcWindowCache).forEach(win => win.classList.add('hide'));
      dolLog(`✅ ${btnUniqueKey} → 已批量隐藏所有功能窗口`, 'suc');
    }
    if (isCam) createCameraWindow();
    if (isVideo) createVideoWindow();
    if (isProc) createProcessWindow();
    if (isAudio) createAudioWindow();
    if (isFile) createFileWindow();
    if (isNet) createNetWindow();
    if (isSysinfo) createSysInfoWindow();
    if (isScreenshot) createScreenshotWindow();
    if (isColorpick) createColorPickWindow();
    if (isWebSim) createWebSimWindow();
    if (isWeather) createWeatherWindow();
    if (isTranslate) createTranslateWindow();
    if (isCalcEnh) createCalcEnhWindow();
    if (isClock) createClockWindow();
    if (isTimer) createTimerWindow();
    if (isAlarm) createAlarmWindow();
    if (isStopwatch) createStopwatchWindow();
    if (isCalendar) createCalendarWindow();
    if (isTodo) createTodoWindow();
    if (isDict) createDictWindow();
    if (isPaint) createPaintWindow();
    if (isSciCalc) createSciCalcWindow();
    
    if (isMusic) {window.open('https://music.163.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开网易云音乐`, 'suc');}
    if (isChat) {window.open('https://web.wechat.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开微信网页版`, 'suc');}
    if (isMail) {window.open('https://mail.qq.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开QQ邮箱`, 'suc');}
    if (isPhoto) {window.open('https://image.baidu.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开百度图片`, 'suc');}
    if (isMap) {window.open('https://map.baidu.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开百度地图`, 'suc');}
    if (isNews) {window.open('https://news.baidu.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开百度新闻`, 'suc');}
    if (isGame) {window.open('https://www.4399.com', '_blank');dolLog(`✅ ${btnUniqueKey} → 打开4399游戏`, 'suc');}
  };
  
  btn.onclick = executeFunc;
  document.body.appendChild(btnContainer);
  allComponents.push(btnContainer);
  dolLog(`✅ 全功能按钮创建成功：${btnUniqueKey}`, 'ut');
  return true;
}
function parseSysWindow(cmd) {
  const idReg = /_id\.\((.+?)\)$/;
  const winId = cmd.match(idReg)?.[1].trim() || `win_${Math.floor(Math.random()*1000)}`;
  const winCmd = cmd.replace(idReg, '');
  const reg = /^\/nad\/win<(\d+)>\*<(\d+)>ip\{(\d+)\}\*\{(\d+)\}@\s+(.+)$/;
  const match = winCmd.match(reg);
  if (!match) {
    dolLog(`❌ 窗口指令格式错误！示例：/nad/win<800>*<500>ip{100}*{100}@ 控制台_id.(main)`, 'err');
    return false;
  }
  const [, w, h, x, y, winTitle] = match;
  const win = document.createElement('div');
  win.className = 'sys-window';
  win.style.width = `${w}px`;
  win.style.height = `${h}px`;
  win.style.left = `${x}px`;
  win.style.top = `${y}px`;
  win.setAttribute('data-winid', winId);
  const titleBar = document.createElement('div');
  titleBar.className = 'sys-win-title';
  const titleSpan = document.createElement('span');
  titleSpan.className = 'win-title-text';
  titleSpan.textContent = `${winTitle} [ID:${winId}]`;
  
  const btnsDiv = document.createElement('div');
  btnsDiv.className = 'sys-win-btns';
  
  const minimizeBtn = document.createElement('div');
  minimizeBtn.className = 'sys-win-btn sys-win-minimize';
  minimizeBtn.title = '最小化';
  
  const maximizeBtn = document.createElement('div');
  maximizeBtn.className = 'sys-win-btn sys-win-maximize';
  maximizeBtn.title = '全屏';
  
  const aboutBtn = document.createElement('div');
  aboutBtn.className = 'sys-win-btn sys-win-about';
  aboutBtn.title = '关于';
  
  const moveBtn = document.createElement('div');
  moveBtn.className = 'sys-win-btn sys-win-move';
  moveBtn.title = '移动';
  
  const closeDiv = document.createElement('div');
  closeDiv.className = 'sys-win-btn sys-win-close';
  closeDiv.title = '关闭';
  closeDiv.onclick = () => win.remove();
  
  btnsDiv.append(minimizeBtn, maximizeBtn, aboutBtn, moveBtn, closeDiv);
  titleBar.appendChild(titleSpan);
  titleBar.appendChild(btnsDiv);
  win.appendChild(titleBar);
  const content = document.createElement('div');
  content.className = 'sys-win-content';
  content.innerHTML = `
    <p style="font-size:16px;font-weight:bold;margin-bottom:10px;">📌 DonglaugOL 全能融合版</p>
    <p style="margin:5px 0;color:#44ff44;"><b>✅ 初代所有功能100%保留，全能版功能全量追加</b></p>
    <p style="margin:5px 0;">1. 原有指令：/nb/btn、/wo/、/dol/系列、music、loop、@m<条件>@a<动作> 全兼容</p>
    <p style="margin:5px 0;">2. 新增指令：/nad/btn 全功能圆润按钮、/nad/win 自由窗口、5大功能窗口</p>
    <p style="margin:5px 0;">3. 新增特性：窗口置顶切换、批量隐藏、按钮样式自定义、系统设置</p>
    <p style="margin:5px 0;">4. 新增功能：相机拍照（支持前后置切换、照片保存）</p>
    <p style="margin:5px 0;">5. 新增功能：NSRP悬浮广告（链接/文字）</p>
    <p style="margin:5px 0;">6. 新增功能：time时间指令</p>
  `;
  win.appendChild(content);
  
  titleBar.onmousedown = (e) => {
    e.preventDefault();
    const disX = e.clientX - win.offsetLeft;
    const disY = e.clientY - win.offsetTop;
    const winW = win.offsetWidth;
    const winH = win.offsetHeight;
    const viewW = window.innerWidth;
    const viewH = window.innerHeight;
    const moveWin = (ev) => {
      let newLeft = ev.clientX - disX;
      let newTop = ev.clientY - disY;
      newLeft = Math.max(0, Math.min(newLeft, viewW - winW));
      newTop = Math.max(0, Math.min(newTop, viewH - winH));
      win.style.left = `${newLeft}px`;
      win.style.top = `${newTop}px`;
    };
    const stopMove = () => {
      document.removeEventListener('mousemove', moveWin);
      document.removeEventListener('mouseup', stopMove);
    };
    document.addEventListener('mousemove', moveWin);
    document.addEventListener('mouseup', stopMove);
  };
  
  win.querySelector('.sys-win-close').onclick = () => {
    win.remove();
    delete sysWindowCache[winId];
    delete sysSwitchCache[winId];
    dolLog(`✅ 窗口已关闭：${winTitle} [ID:${winId}]`, 'suc');
  };
  
  sysWindowCache[winId] = win;
  document.body.appendChild(win);
  allComponents.push(win);
  dolLog(`✅ 自由移动窗口创建成功：${winTitle} | ID:${winId}`, 'ut');
  return true;
}
function createClockWindow() {
  const win = createBaseWindow('Clock', 240, 100, 300, 150, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.alignItems = 'center';
  content.style.justifyContent = 'center';
  content.style.fontSize = '28px';
  content.style.fontFamily = 'monospace';
  content.style.color = '#5a9bd4';
  
  const timeEl = document.createElement('div');
  timeEl.id = 'sys-clock-display';
  timeEl.style.textAlign = 'center';
  content.appendChild(timeEl);
  
  const updateTime = () => {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const date = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const week = ['日', '一', '二', '三', '四', '五', '六'][now.getDay()];
    timeEl.innerHTML = `<div style="font-size:14px;color:#888;margin-bottom:5px;">${date} 周${week}</div><div>${hours}:${minutes}:${seconds}</div>`;
  };
  
  updateTime();
  const timer = setInterval(updateTime, 1000);
  
  win.addEventListener('remove', () => {
    clearInterval(timer);
  });
  
  dolLog(`✅ 时钟窗口创建成功`, 'suc');
}
function createTimerWindow() {
  const win = createBaseWindow('Timer', 240, 120, 500, 150, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.alignItems = 'center';
  content.style.justifyContent = 'center';
  content.style.gap = '10px';
  
  const displayEl = document.createElement('div');
  displayEl.id = 'sys-timer-display';
  displayEl.style.fontSize = '32px';
  displayEl.style.fontFamily = 'monospace';
  displayEl.style.color = '#5a7ca3';
  
  const progressEl = document.createElement('div');
  progressEl.style.width = '80%';
  progressEl.style.height = '8px';
  progressEl.style.background = '#3a3f48';
  progressEl.style.borderRadius = '4px';
  progressEl.style.overflow = 'hidden';
  
  const barEl = document.createElement('div');
  barEl.style.height = '100%';
  barEl.style.background = '#5a9bd4';
  barEl.style.transition = 'width 0.5s';
  progressEl.appendChild(barEl);
  
  content.appendChild(displayEl);
  content.appendChild(progressEl);
  
  let remaining = 60;
  
  const updateTimer = () => {
    const mins = String(Math.floor(remaining / 60)).padStart(2, '0');
    const secs = String(remaining % 60).padStart(2, '0');
    displayEl.textContent = `${mins}:${secs}`;
    barEl.style.width = `${(remaining / 60) * 100}%`;
    
    if (remaining <= 10) {
      displayEl.style.color = '#ff6b6b';
      barEl.style.background = '#ff6b6b';
    }
    
    if (remaining <= 0) {
      clearInterval(timer);
      displayEl.textContent = 'Done!';
      barEl.style.width = '0%';
      playSound('success');
      dolLog('🔔 倒计时结束！', 'suc');
    }
    remaining--;
  };
  
  updateTimer();
  const timer = setInterval(updateTimer, 1000);
  
  win.addEventListener('remove', () => {
    clearInterval(timer);
  });
  
  dolLog(`✅ 倒计时窗口创建成功，时长：60秒`, 'suc');
}
function createAlarmWindow() {
  const win = createBaseWindow('Alarm', 280, 180, 300, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.alignItems = 'center';
  content.style.justifyContent = 'center';
  content.style.gap = '10px';
  
  const timeInput = document.createElement('input');
  timeInput.type = 'time';
  timeInput.value = '08:00';
  timeInput.style.padding = '8px 12px';
  timeInput.style.fontSize = '16px';
  timeInput.style.background = '#3a3f48';
  timeInput.style.border = '1px solid #4a4f58';
  timeInput.style.borderRadius = '6px';
  timeInput.style.color = '#fff';
  
  const label = document.createElement('input');
  label.type = 'text';
  label.placeholder = '闹钟标签';
  label.style.padding = '8px 12px';
  label.style.fontSize = '14px';
  label.style.background = '#3a3f48';
  label.style.border = '1px solid #4a4f58';
  label.style.borderRadius = '6px';
  label.style.color = '#fff';
  label.style.width = '80%';
  
  const setBtn = document.createElement('button');
  setBtn.textContent = '设置闹钟';
  setBtn.style.padding = '6px 20px';
  setBtn.style.background = '#5a9bd4';
  setBtn.style.border = 'none';
  setBtn.style.borderRadius = '6px';
  setBtn.style.color = '#fff';
  setBtn.style.cursor = 'pointer';
  
  const status = document.createElement('div');
  status.style.fontSize = '12px';
  status.style.color = '#888';
  
  content.appendChild(timeInput);
  content.appendChild(label);
  content.appendChild(setBtn);
  content.appendChild(status);
  
  let alarmInterval = null;
  
  setBtn.onclick = () => {
    if (alarmInterval) {
      clearInterval(alarmInterval);
      alarmInterval = null;
      status.textContent = '闹钟已取消';
      status.style.color = '#ff6b6b';
      return;
    }
    
    const targetTime = timeInput.value;
    if (!targetTime) {
      status.textContent = '请选择时间';
      status.style.color = '#ff6b6b';
      return;
    }
    
    alarmInterval = setInterval(() => {
      const now = new Date();
      const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      
      if (currentTime === targetTime) {
        clearInterval(alarmInterval);
        alarmInterval = null;
        playSound('success');
        dolLog(`⏰ 闹钟响起！${label.value || '闹钟'}`, 'suc');
        status.textContent = '闹钟已响';
        status.style.color = '#5a9bd4';
      }
    }, 1000);
    
    status.textContent = `闹钟已设置：${targetTime} ${label.value ? '(' + label.value + ')' : ''}`;
    status.style.color = '#5a9bd4';
  };
  
  win.addEventListener('remove', () => {
    if (alarmInterval) clearInterval(alarmInterval);
  });
  
  dolLog(`✅ 闹钟窗口创建成功`, 'suc');
}
function createStopwatchWindow() {
  const win = createBaseWindow('Stopwatch', 260, 160, 500, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.alignItems = 'center';
  content.style.justifyContent = 'center';
  content.style.gap = '15px';
  
  const display = document.createElement('div');
  display.style.fontSize = '36px';
  display.style.fontFamily = 'monospace';
  display.style.color = '#5a9bd4';
  display.textContent = '00:00.00';
  
  const controls = document.createElement('div');
  controls.style.display = 'flex';
  controls.style.gap = '10px';
  
  const startBtn = document.createElement('button');
  startBtn.textContent = '开始';
  startBtn.style.padding = '6px 16px';
  startBtn.style.background = '#5a9bd4';
  startBtn.style.border = 'none';
  startBtn.style.borderRadius = '6px';
  startBtn.style.color = '#fff';
  startBtn.style.cursor = 'pointer';
  
  const resetBtn = document.createElement('button');
  resetBtn.textContent = '重置';
  resetBtn.style.padding = '6px 16px';
  resetBtn.style.background = '#6a6f78';
  resetBtn.style.border = 'none';
  resetBtn.style.borderRadius = '6px';
  resetBtn.style.color = '#fff';
  resetBtn.style.cursor = 'pointer';
  
  controls.appendChild(startBtn);
  controls.appendChild(resetBtn);
  content.appendChild(display);
  content.appendChild(controls);
  
  let startTime = 0;
  let elapsed = 0;
  let interval = null;
  
  const updateDisplay = () => {
    const mins = String(Math.floor(elapsed / 60000)).padStart(2, '0');
    const secs = String(Math.floor((elapsed % 60000) / 1000)).padStart(2, '0');
    const ms = String(Math.floor((elapsed % 1000) / 10)).padStart(2, '0');
    display.textContent = `${mins}:${secs}.${ms}`;
  };
  
  startBtn.onclick = () => {
    if (interval) {
      clearInterval(interval);
      interval = null;
      startBtn.textContent = '继续';
      startBtn.style.background = '#5a9bd4';
    } else {
      startTime = Date.now() - elapsed;
      interval = setInterval(() => {
        elapsed = Date.now() - startTime;
        updateDisplay();
      }, 10);
      startBtn.textContent = '暂停';
      startBtn.style.background = '#ff6b6b';
    }
  };
  
  resetBtn.onclick = () => {
    if (interval) {
      clearInterval(interval);
      interval = null;
    }
    elapsed = 0;
    updateDisplay();
    startBtn.textContent = '开始';
    startBtn.style.background = '#5a9bd4';
  };
  
  win.addEventListener('remove', () => {
    if (interval) clearInterval(interval);
  });
  
  dolLog(`✅ 秒表窗口创建成功`, 'suc');
}
function createCalendarWindow() {
  const win = createBaseWindow('Calendar', 320, 300, 700, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.gap = '10px';
  content.style.padding = '10px';
  
  const now = new Date();
  let currentMonth = now.getMonth();
  let currentYear = now.getFullYear();
  
  const header = document.createElement('div');
  header.style.display = 'flex';
  header.style.justifyContent = 'space-between';
  header.style.alignItems = 'center';
  
  const prevBtn = document.createElement('button');
  prevBtn.textContent = '◀';
  prevBtn.style.background = 'none';
  prevBtn.style.border = 'none';
  prevBtn.style.color = '#5a9bd4';
  prevBtn.style.cursor = 'pointer';
  
  const title = document.createElement('div');
  title.style.fontSize = '16px';
  title.style.fontWeight = 'bold';
  title.style.color = '#fff';
  
  const nextBtn = document.createElement('button');
  nextBtn.textContent = '▶';
  nextBtn.style.background = 'none';
  nextBtn.style.border = 'none';
  nextBtn.style.color = '#5a9bd4';
  nextBtn.style.cursor = 'pointer';
  
  header.appendChild(prevBtn);
  header.appendChild(title);
  header.appendChild(nextBtn);
  content.appendChild(header);
  
  const weekDays = ['日', '一', '二', '三', '四', '五', '六'];
  const weekHeader = document.createElement('div');
  weekHeader.style.display = 'grid';
  weekHeader.style.gridTemplateColumns = 'repeat(7, 1fr)';
  weekHeader.style.textAlign = 'center';
  weekHeader.style.fontSize = '12px';
  weekHeader.style.color = '#888';
  
  weekDays.forEach(d => {
    const cell = document.createElement('div');
    cell.textContent = d;
    weekHeader.appendChild(cell);
  });
  content.appendChild(weekHeader);
  
  const grid = document.createElement('div');
  grid.style.display = 'grid';
  grid.style.gridTemplateColumns = 'repeat(7, 1fr)';
  grid.style.textAlign = 'center';
  grid.style.gap = '2px';
  
  content.appendChild(grid);
  
  const renderCalendar = () => {
    grid.innerHTML = '';
    title.textContent = `${currentYear}年${currentMonth + 1}月`;
    
    const firstDay = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    
    for (let i = 0; i < firstDay; i++) {
      const cell = document.createElement('div');
      cell.style.height = '30px';
      cell.style.lineHeight = '30px';
      grid.appendChild(cell);
    }
    
    for (let i = 1; i <= daysInMonth; i++) {
      const cell = document.createElement('div');
      cell.textContent = i;
      cell.style.height = '30px';
      cell.style.lineHeight = '30px';
      cell.style.borderRadius = '4px';
      cell.style.cursor = 'pointer';
      
      if (i === now.getDate() && currentMonth === now.getMonth() && currentYear === now.getFullYear()) {
        cell.style.background = '#5a9bd4';
        cell.style.color = '#fff';
      } else {
        cell.style.color = '#ccc';
        cell.onmouseover = () => cell.style.background = '#3a3f48';
        cell.onmouseout = () => cell.style.background = '';
      }
      
      grid.appendChild(cell);
    }
  };
  
  prevBtn.onclick = () => {
    currentMonth--;
    if (currentMonth < 0) {
      currentMonth = 11;
      currentYear--;
    }
    renderCalendar();
  };
  
  nextBtn.onclick = () => {
    currentMonth++;
    if (currentMonth > 11) {
      currentMonth = 0;
      currentYear++;
    }
    renderCalendar();
  };
  
  renderCalendar();
  
  dolLog(`✅ 日历窗口创建成功`, 'suc');
}
function createTodoWindow() {
  const win = createBaseWindow('Todo', 300, 320, 300, 300, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.gap = '8px';
  content.style.padding = '10px';
  
  const input = document.createElement('input');
  input.type = 'text';
  input.placeholder = '添加待办事项...';
  input.style.padding = '8px';
  input.style.fontSize = '14px';
  input.style.background = '#3a3f48';
  input.style.border = '1px solid #4a4f58';
  input.style.borderRadius = '6px';
  input.style.color = '#fff';
  
  const addBtn = document.createElement('button');
  addBtn.textContent = '添加';
  addBtn.style.padding = '8px 16px';
  addBtn.style.background = '#5a9bd4';
  addBtn.style.border = 'none';
  addBtn.style.borderRadius = '6px';
  addBtn.style.color = '#fff';
  addBtn.style.cursor = 'pointer';
  
  const list = document.createElement('div');
  list.style.flex = '1';
  list.style.overflowY = 'auto';
  list.style.display = 'flex';
  list.style.flexDirection = 'column';
  list.style.gap = '4px';
  
  content.appendChild(input);
  content.appendChild(addBtn);
  content.appendChild(list);
  
  const savedTodos = localStorage.getItem('dol_todos');
  const todos = savedTodos ? JSON.parse(savedTodos) : [];
  
  const saveTodos = () => localStorage.setItem('dol_todos', JSON.stringify(todos));
  
  const renderTodos = () => {
    list.innerHTML = '';
    todos.forEach((todo, index) => {
      const item = document.createElement('div');
      item.style.display = 'flex';
      item.style.alignItems = 'center';
      item.style.gap = '8px';
      item.style.padding = '6px';
      item.style.background = '#3a3f48';
      item.style.borderRadius = '4px';
      
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = todo.done;
      checkbox.onchange = () => {
        todo.done = checkbox.checked;
        saveTodos();
        renderTodos();
      };
      
      const text = document.createElement('span');
      text.textContent = todo.text;
      text.style.flex = '1';
      text.style.color = todo.done ? '#888' : '#fff';
      text.style.textDecoration = todo.done ? 'line-through' : 'none';
      
      const delBtn = document.createElement('button');
      delBtn.textContent = '×';
      delBtn.style.background = 'none';
      delBtn.style.border = 'none';
      delBtn.style.color = '#ff6b6b';
      delBtn.style.cursor = 'pointer';
      delBtn.style.fontSize = '16px';
      delBtn.onclick = () => {
        todos.splice(index, 1);
        saveTodos();
        renderTodos();
      };
      
      item.appendChild(checkbox);
      item.appendChild(text);
      item.appendChild(delBtn);
      list.appendChild(item);
    });
  };
  
  addBtn.onclick = () => {
    const text = input.value.trim();
    if (text) {
      todos.push({ text, done: false });
      saveTodos();
      renderTodos();
      input.value = '';
    }
  };
  
  input.onkeydown = (e) => {
    if (e.key === 'Enter') addBtn.click();
  };
  
  renderTodos();
  
  dolLog(`✅ 待办事项窗口创建成功`, 'suc');
}
function createDictWindow() {
