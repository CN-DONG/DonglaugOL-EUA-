  }
}

// ==================================================
// ========== 【新增：解方程计算功能】 ==========
// ==================================================
// 格式示例:
// 1+1                    - 简单计算
// [ 2+x=y               - 解方程开始
// . y=1                  - 方程
// ?x=<?@cmt> y=<?@cmt>   - 求解变量
// 这是解方程{2+x=y        - 另一种格式
// . y=1                  - 方程

function parseEquationCmd(cmd) {
  const line = cmd.trim();
  
  // 简单数学表达式计算
  const mathExpr = line.match(/^([\d+\-*/(). ]+)$/);
  if (mathExpr) {
    try {
      // 安全验证：只允许数字和基本运算符
      const safeExpr = mathExpr[1].replace(/[^0-9+\-*/(). ]/g, '');
      if (!safeExpr) {
        dolLog('❌ 无效的表达式', 'err');
        return true;
      }
      const result = eval(safeExpr);
      dolLog(`🧮 ${safeExpr} = ${result}`, 'suc');
      return true;
    } catch (e) {
      dolLog(`❌ 计算错误: ${e.message}`, 'err');
      return true;
    }
  }
  
  // 解方程格式: [ 2+x=y . y=1 ?x=<?@cmt> y=<?@cmt>
  const eqMatch = line.match(/^\[\s*([\s\S]*?)\s*\?([\s\S]*)$/);
  if (eqMatch) {
    const equations = eqMatch[1];
    const variables = eqMatch[2];
    
    const eqLines = equations.split('.').map(l => l.trim()).filter(l => l);
    const varList = variables.split(' ').map(v => v.trim()).filter(v => v);
    
    // 解析变量列表
    const targetVars = [];
    for (const v of varList) {
      const match = v.match(/^([a-zA-Z])=/);
      if (match) targetVars.push(match[1]);
    }
    
    // 简单方程求解
    const values = {};
    for (const eq of eqLines) {
      // 匹配简单赋值: x=5 或 2+x=y
      const assignMatch = eq.match(/^([a-zA-Z])=([\d]+)$/);
      if (assignMatch) {
        values[assignMatch[1]] = parseInt(assignMatch[2]);
      }
    }
    
    // 尝试解简单方程
    for (const eq of eqLines) {
      // 匹配: x+y=5 或 2+x=y
      const eqPattern = eq.match(/^([\d]*)([a-zA-Z])?([+\-*/])?([\d]*)([a-zA-Z])?=([\d]*)([a-zA-Z])?$/);
      if (eqPattern) {
        const [, num1, var1, op, num2, var2, resultNum, resultVar] = eqPattern;
        const n1 = num1 ? parseInt(num1) : (var1 ? values[var1] : 0);
        const n2 = num2 ? parseInt(num2) : (var2 ? values[var2] : 0);
        const result = resultNum ? parseInt(resultNum) : (resultVar ? values[resultVar] : null);
        
        if (result !== null) {
          // 求解未知变量
          if (var1 && values[var1] === undefined && !num1) {
            let val;
            if (op === '+') val = result - n2;
            else if (op === '-') val = result + n2;
            else if (op === '*') val = result / n2;
            else if (op === '/') val = result * n2;
            else val = result - n2;
            values[var1] = val;
          }
          if (var2 && values[var2] === undefined && !num2) {
            let val;
            if (op === '+') val = result - n1;
            else if (op === '-') val = n1 - result;
            else if (op === '*') val = result / n1;
            else if (op === '/') val = n1 / result;
            else val = result - n1;
            values[var2] = val;
          }
        }
      }
    }
    
    // 输出结果
    let output = '📐 方程解: ';
    for (const v of targetVars) {
      output += `${v}=${values[v] !== undefined ? values[v] : '?'} `;
    }
    dolLog(output, 'suc');
    return true;
  }
  
  // 另一种解方程格式: 这是解方程{2+x=y . y=1
  const eqMatch2 = line.match(/^(.*)解方程\{([\s\S]*)$/);
  if (eqMatch2) {
    const equations = eqMatch2[2];
    const eqLines = equations.split('.').map(l => l.trim()).filter(l => l);
    
    const values = {};
    for (const eq of eqLines) {
      const assignMatch = eq.match(/^([a-zA-Z])=([\d]+)$/);
      if (assignMatch) {
        values[assignMatch[1]] = parseInt(assignMatch[2]);
      }
    }
    
    for (const eq of eqLines) {
      const eqPattern = eq.match(/^([\d]*)([a-zA-Z])?([+\-*/])?([\d]*)([a-zA-Z])?=([\d]*)([a-zA-Z])?$/);
      if (eqPattern) {
        const [, num1, var1, op, num2, var2, resultNum, resultVar] = eqPattern;
        const n1 = num1 ? parseInt(num1) : (var1 ? values[var1] : 0);
        const n2 = num2 ? parseInt(num2) : (var2 ? values[var2] : 0);
        const result = resultNum ? parseInt(resultNum) : (resultVar ? values[resultVar] : null);
        
        if (result !== null) {
          if (var1 && values[var1] === undefined && !num1) {
            let val;
            if (op === '+') val = result - n2;
            else if (op === '-') val = result + n2;
            else if (op === '*') val = result / n2;
            else if (op === '/') val = result * n2;
            else val = result - n2;
            values[var1] = val;
          }
          if (var2 && values[var2] === undefined && !num2) {
            let val;
            if (op === '+') val = result - n1;
            else if (op === '-') val = n1 - result;
            else if (op === '*') val = result / n1;
            else if (op === '/') val = n1 / result;
            else val = result - n1;
            values[var2] = val;
          }
        }
      }
    }
    
    dolLog(`🧮 方程解: x=${values['x'] !== undefined ? values['x'] : '?'}, y=${values['y'] !== undefined ? values['y'] : '?'}`, 'suc');
    return true;
  }
  
  return false;
}

// 计算器辅助函数
function calcInput(val) {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    if (result.textContent === '0' && val !== '.') {
      result.textContent = val;
    } else {
      result.textContent += val;
    }
    history.textContent = '';
  }
}

function calcClear() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    result.textContent = '0';
  }
  if (history) {
    history.textContent = '';
  }
}

function calcSquare() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    try {
      const num = parseFloat(result.textContent);
      if (!isNaN(num)) {
        history.textContent = num + '²';
        result.textContent = (num * num).toString();
      }
    } catch (e) {
      result.textContent = 'Error';
      history.textContent = '';
    }
  }
}

function calcSqrt() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    try {
      const num = parseFloat(result.textContent);
      if (!isNaN(num) && num >= 0) {
        history.textContent = '√' + num;
        result.textContent = Math.sqrt(num).toString();
      } else {
        result.textContent = 'Error';
        history.textContent = '';
      }
    } catch (e) {
      result.textContent = 'Error';
      history.textContent = '';
    }
  }
}

function calcSolveEq() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    try {
      let expr = result.textContent;
      if (!/^[\d\s+\-*/().%=<>xX]+$/.test(expr)) {
        result.textContent = 'Error';
        history.textContent = '';
        return;
      }
      if (expr.includes('x') || expr.includes('X')) {
        history.textContent = expr;
        expr = expr.replace(/x/g, '*x').replace(/X/g, '*x');
        expr = expr.replace(/(\d)x/g, '$1*x').replace(/(\d)X/g, '$1*X');
        const results = [];
        for (let x = -1000; x <= 1000; x++) {
          let testExpr = expr.replace(/x/g, x);
          try {
            const left = eval(testExpr.split('=')[0]);
            const right = eval(testExpr.split('=')[1]);
            if (Math.abs(left - right) < 0.001) {
              results.push(x);
            }
          } catch {}
        }
        if (results.length > 0) {
          result.textContent = 'x=' + results.join(', ');
        } else {
          result.textContent = 'No solution';
        }
      } else {
        result.textContent = 'Error';
      }
    } catch (e) {
      result.textContent = 'Error';
      history.textContent = '';
    }
  }
}

function calcEval() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    try {
      let expr = result.textContent;
      history.textContent = expr;
      if (expr.includes('>') && !expr.includes('=>')) {
        const parts = expr.split('>');
        if (/^[\d\s+\-*/().]+$/.test(parts[0].trim()) && /^[\d\s+\-*/().]+$/.test(parts[1].trim())) {
          const left = eval(parts[0].trim());
          const right = eval(parts[1].trim());
          result.textContent = left > right ? 'true' : 'false';
        } else { result.textContent = 'Error'; }
        return;
      }
      if (expr.includes('<') && !expr.includes('=<')) {
        const parts = expr.split('<');
        if (/^[\d\s+\-*/().]+$/.test(parts[0].trim()) && /^[\d\s+\-*/().]+$/.test(parts[1].trim())) {
          const left = eval(parts[0].trim());
          const right = eval(parts[1].trim());
          result.textContent = left < right ? 'true' : 'false';
        } else { result.textContent = 'Error'; }
        return;
      }
      expr = expr.replace(/(\d+(?:\.\d+)?)%/g, '($1/100)');
      expr = expr.replace(/(\d+(?:\.\d+)?)\*\*/g, 'Math.pow($1,');
      let powCount = (expr.match(/Math\.pow\(/g) || []).length;
      for (let i = 0; i < powCount; i++) {
        expr += ')';
      }
      expr = expr.replace(/(\d+(?:\.\d+)?)\/\/(\d+(?:\.\d+)?)/g, 'Math.floor($1/$2)');
      expr = expr.replace(/1\/(\d+(?:\.\d+)?)/g, '1/$1');
      const safeExpr = expr.replace(/Math\.\w+(\([^)]*\))?/g, '0');
      if (!/^[\d\s+\-*/().]+$/.test(safeExpr)) {
        result.textContent = 'Error';
        return;
      }
      const evalResult = eval(expr);
      result.textContent = typeof evalResult === 'number' && !isNaN(evalResult) ? evalResult.toString() : 'Error';
    } catch (e) {
      result.textContent = 'Error';
      history.textContent = '';
    }
  }
}

function calcBackspace() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    let text = result.textContent;
    if (text.length > 1) {
      result.textContent = text.slice(0, -1);
    } else {
      result.textContent = '0';
    }
    history.textContent = '';
  }
}

function calcCube() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    try {
      const num = parseFloat(result.textContent);
      if (!isNaN(num)) {
        history.textContent = num + '³';
        result.textContent = (num * num * num).toString();
      }
    } catch (e) {
      result.textContent = 'Error';
      history.textContent = '';
    }
  }
}

function calcFactorial() {
  const result = document.querySelector('#calcDisplay .calc-result');
  const history = document.getElementById('calcHistory');
  if (result) {
    try {
      const num = parseInt(result.textContent);
      if (!isNaN(num) && num >= 0 && num <= 170) {
        history.textContent = num + '!';
        let fact = 1;
        for (let i = 2; i <= num; i++) {
          fact *= i;
        }
        result.textContent = fact.toString();
      } else {
        result.textContent = 'Error';
        history.textContent = '';
      }
    } catch (e) {
      result.textContent = 'Error';
      history.textContent = '';
    }
  }
}

