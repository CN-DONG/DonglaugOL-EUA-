  content.innerHTML = `<textarea class="sys-text-content" placeholder="文本显示区，可输入/编辑文本..."></textarea>`;
  funcWindowCache.text = win;
  dolLog(`✅ 文本显示窗口已创建`, 'suc');
  return win;
}
function createCalcWindow() {
  if (funcWindowCache.calc) {funcWindowCache.calc.classList.remove('hide');return funcWindowCache.calc;}
  const win = createBaseWindow('计算器', 400, 500, 400, 200);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div class="sys-calc">
      <div class="sys-calc-input" id="calcInput">0</div>
      <div class="sys-calc-btn-group">
        <button class="sys-calc-btn" data-key="AC">AC</button>
        <button class="sys-calc-btn" data-key="+/-">+/-</button>
        <button class="sys-calc-btn" data-key="%">%</button>
        <button class="sys-calc-btn operator" data-key="/">÷</button>
        <button class="sys-calc-btn" data-key="7">7</button>
        <button class="sys-calc-btn" data-key="8">8</button>
        <button class="sys-calc-btn" data-key="9">9</button>
        <button class="sys-calc-btn operator" data-key="*">×</button>
        <button class="sys-calc-btn" data-key="4">4</button>
        <button class="sys-calc-btn" data-key="5">5</button>
        <button class="sys-calc-btn" data-key="6">6</button>
        <button class="sys-calc-btn operator" data-key="-">-</button>
        <button class="sys-calc-btn" data-key="1">1</button>
        <button class="sys-calc-btn" data-key="2">2</button>
        <button class="sys-calc-btn" data-key="3">3</button>
        <button class="sys-calc-btn operator" data-key="+">+</button>
        <button class="sys-calc-btn" data-key="0">0</button>
        <button class="sys-calc-btn" data-key=".">.</button>
        <button class="sys-calc-btn equal" data-key="=">=</button>
      </div>
    </div>
  `;
  const calcInput = win.querySelector('#calcInput');
  let currentInput = '';
  let result = '';
  win.querySelectorAll('.sys-calc-btn').forEach(btn => {
    btn.onclick = () => {
      const key = btn.dataset.key;
      if (key === 'AC') {
        currentInput = '';
        result = '';
        calcInput.textContent = '0';
        return;
      }
      if (key === '=') {
        const expr = currentInput.replace('×', '*').replace('÷', '/');
        if (/^[\d\s+\-*/().]+$/.test(expr)) {
          try {
            result = eval(expr);
            calcInput.textContent = result;
          } catch(e) {
            calcInput.textContent = '错误';
          }
        } else {
          calcInput.textContent = '错误';
        }
        return;
      }
      if (key === '+/-') {
        calcInput.textContent = calcInput.textContent.startsWith('-') ? calcInput.textContent.slice(1) : `-${calcInput.textContent}`;
        return;
      }
      if (key === '%') {
        calcInput.textContent = (parseFloat(calcInput.textContent) / 100).toString();
        return;
      }
      currentInput += key;
      calcInput.textContent = currentInput;
    };
  });
  funcWindowCache.calc = win;
  dolLog(`✅ 计算器窗口已创建`, 'suc');
  return win;
}
