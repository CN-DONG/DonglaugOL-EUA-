function createAudioWindow() {
  if (funcWindowCache.audio) {funcWindowCache.audio.classList.remove('hide');return funcWindowCache.audio;}
  const win = createBaseWindow('音频管理器', 500, 350, 600, 200);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div style="padding:15px;">
      <div style="margin-bottom:15px;">
        <label style="color:#5a7ca3;">音量控制：</label>
        <input type="range" id="volumeSlider" min="0" max="100" value="100" style="width:200px;">
        <span id="volumeVal" style="color:#44ff44;">100%</span>
      </div>
      <div style="margin-bottom:15px;">
        <label style="color:#5a7ca3;">音频输入：</label>
        <button onclick="getAudioDevices()" style="padding:3px 10px;border-radius:4px;border:none;background:#5a7ca3;color:#fff;cursor:pointer;">获取设备</button>
      </div>
      <div id="audioDevices" style="font-size:12px;color:#aaa;"></div>
    </div>
  `;
  win.querySelector('#volumeSlider').oninput = (e) => {
    win.querySelector('#volumeVal').textContent = e.target.value + '%';
  };
  window.getAudioDevices = async () => {
    try {
      const devices = await navigator.mediaDevices.enumerateDevices();
      const audioDevices = devices.filter(d => d.kind === 'audioinput' || d.kind === 'audiooutput');
      const list = win.querySelector('#audioDevices');
      if (audioDevices.length > 0) {
        list.innerHTML = audioDevices.map(d => `<div>${d.kind === 'audioinput' ? '🎤' : '🔊'} ${d.label || '未命名设备'}</div>`).join('');
      } else {
        list.innerHTML = '<div style="color:#ff6666;">未检测到音频设备</div>';
      }
    } catch (e) {
      win.querySelector('#audioDevices').innerHTML = '<div style="color:#ff6666;">无法获取音频设备</div>';
    }
  };
  funcWindowCache.audio = win;
  dolLog(`✅ 音频管理器窗口已创建`, 'suc');
  return win;
}

