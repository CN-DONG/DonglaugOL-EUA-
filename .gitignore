    if (line.startsWith('/calc/')) return parseCalcCmd(line);
    if (parseRandImportCmd(line)) return;
    if (line.startsWith('rand.')) return parseRandObjectCmd(line);
    if (line.startsWith('/rand/')) return parseRandCmd(line);
    if (parseJsonImportCmd(line)) return;
    if (line.startsWith('json.')) return parseJsonObjectCmd(line);
    if (line.startsWith('/json/')) return parseJsonCmd(line);
    if (line.startsWith('/todo/')) return parseTodoCmd(line);
    if (parseGlitchCmd(line)) return;
    if (line.startsWith('/qr/')) return parseQrCmd(line);
    if (line.startsWith('/vlc/')) return parseVlcCmd(line);
  if (line.startsWith('/ca/')) return parseCaCmd(line);
    if (line.startsWith('/code/')) return parseCodeCmd(line);
    if (line.startsWith('/img/')) return parseImgCmd(line);
    if (line.startsWith('/3d/')) return parse3dCmd(line);
    if (line.startsWith('/2d/')) return parse2dCmd(line);
    if (line.startsWith('draw.')) return parseDrawCmd(line);
    if (line.startsWith('/prt/')) return parsePrtCmd(line);
    if (line.startsWith('/tbl/')) return parseTblCmd(line);
    if (line.startsWith('/doc/')) return parseDocCmd(line);
    if (line.startsWith('/nb/new.us-ph<')) return parseImgBtn(line);
    if (line.startsWith('progress.')) return parseProgressBar(line) || parseProgressCircle(line) || parseProgressLabel(line);
    if (line.startsWith('anim.')) return parseAnimFade(line) || parseAnimSlide(line) || parseAnimBounce(line) || parseAnimShake(line) || parseAnimSpin(line);
