function embedUrlShortener() {
  const uid = 'embed_url_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <input type="text" id="${uid}_input" style="width:100%;background:#0a0a0f;color:#fff;border:none;padding:6px 8px;border-radius:4px;outline:none;margin-bottom:8px;" placeholder="输入长链接..." />
      <button onclick="shortenURL()" style="padding:6px 12px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;">缩短</button>
      <div id="${uid}_result" style="margin-top:8px;color:#00ff88;font-family:monospace;font-size:12px;"></div>
    </div>
  `;
  showInlineUI(html);
  
  const input = document.getElementById(uid + '_input');
  const result = document.getElementById(uid + '_result');
  
  window.shortenURL = () => {
    const url = input.value.trim();
    if (!url) return;
    const hash = url.split('').reduce((a, b) => a + b.charCodeAt(0), 0);
    result.textContent = `短链接: http://short.ly/${hash.toString(36)}`;
  };
  dolLog(`✅ URL缩短器已嵌入`, 'suc');
}

