function caDoc(docType) {
  const urls = {
    'js': 'https://developer.mozilla.org/zh-CN/docs/Web/JavaScript',
    'css': 'https://developer.mozilla.org/zh-CN/docs/Web/CSS',
    'html': 'https://developer.mozilla.org/zh-CN/docs/Web/HTML',
    'py': 'https://docs.python.org/zh-cn/3/',
    'cpp': 'https://zh.cppreference.com/w/cpp'
  };
  const url = urls[docType] || 'https://developer.mozilla.org/zh-CN/docs/Web';
  const win = createBaseWindow(`📚 ${docType || 'Web'} 文档`, 900, 650, 80, 60, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '0';
  content.innerHTML = `<iframe src="${url}" style="width:100%;height:100%;border:none;"></iframe>`;
