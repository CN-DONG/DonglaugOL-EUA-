function initAudio() {
  if (!clockState.audioCtx) {
    try {
      clockState.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    } catch(e) { return null; }
  }
  return clockState.audioCtx;
}

function playRingtone(ringId, loop = false) {
  const ctx = initAudio();
  if (!ctx) return;
  const ring = RINGTONES[ringId];
  if (!ring) return;
  let totalTime = 0;

  function playNote(freq, startTime, duration, volume, waveType, isSymphony) {
    if (!freq || freq === 0) return;
    const freqArr = Array.isArray(freq) ? freq : [freq];
    freqArr.forEach(f => {
      if (!f) return;
      // 主音
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.frequency.value = f;
      osc.type = waveType || 'sine';
      gain.gain.setValueAtTime(0, startTime);
      gain.gain.linearRampToValueAtTime(volume, startTime + 0.015);
      gain.gain.setValueAtTime(volume, startTime + duration * 0.6);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration - 0.01);
      osc.start(startTime); osc.stop(startTime + duration);
      // 交响曲：叠加高八度泛音
      if (isSymphony) {
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.connect(gain2); gain2.connect(ctx.destination);
        osc2.frequency.value = f * 2;
        osc2.type = 'triangle';
        gain2.gain.setValueAtTime(0, startTime);
        gain2.gain.linearRampToValueAtTime(volume * 0.25, startTime + 0.02);
        gain2.gain.exponentialRampToValueAtTime(0.001, startTime + duration - 0.01);
        osc2.start(startTime); osc2.stop(startTime + duration);
      }
    });
  }

  function playSequence() {
    const baseTime = ctx.currentTime + 0.05;
    if (ring.tracks) {
      // 多轨道交响曲
      ring.tracks.forEach(track => {
        let t = baseTime;
        track.notes.forEach(([freq, dur]) => {
          playNote(freq, t, dur, track.volume, track.wave, true);
          t += dur;
        });
        totalTime = Math.max(totalTime, t - baseTime);
      });
    } else if (ring.notes) {
      let t = baseTime;
      ring.notes.forEach(([freq, dur]) => {
        playNote(freq, t, dur, 0.22, 'sine', false);
        t += dur;
      });
      totalTime = t - baseTime;
    } else {
      ring.freq.forEach(freq => {
        playNote(freq, baseTime + totalTime, ring.duration, 0.3, 'sine', false);
        totalTime += ring.duration;
      });
    }
  }

  playSequence();

  if (loop) {
    clockState._loopTimer = setInterval(() => {
      if (!clockState._looping) return;
      playSequence();
    }, totalTime * 1000);
  }
}

function stopRingtone() {
  clockState._looping = false;
  if (clockState._loopTimer) {
    clearInterval(clockState._loopTimer);
    clockState._loopTimer = null;
  }
}

function playCustomRingtone(dataUrl) {
  const ctx = initAudio();
  if (!ctx) return;
  const audio = new Audio(dataUrl);
  audio.play().catch(() => {});
}

const WORLD_CLOCKS = [
  { city: '北京', tz: 'Asia/Shanghai', offset: 8 },
  { city: '东京', tz: 'Asia/Tokyo', offset: 9 },
  { city: '伦敦', tz: 'Europe/London', offset: 0 },
  { city: '纽约', tz: 'America/New_York', offset: -5 },
  { city: '巴黎', tz: 'Europe/Paris', offset: 1 },
  { city: '悉尼', tz: 'Australia/Sydney', offset: 10 }
];

function getTimeInOffset(offset) {
  const now = new Date();
  const utc = now.getTime() + now.getTimezoneOffset() * 60000;
  return new Date(utc + offset * 3600000);
}

function formatTime(date) {
  return date.toLocaleTimeString('zh-CN', { hour12: false });
}

function formatDate(date) {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short' });
}

// 闹铃检查器 - 每秒检查是否到时间
let alarmCheckerInterval = null;
function startAlarmChecker() {
  if (alarmCheckerInterval) return;
  alarmCheckerInterval = setInterval(() => {
    const now = new Date();
    const currentTime = now.toLocaleTimeString('zh-CN', { hour12: false }).substring(0, 5);
    const nowTs = Date.now();
    let triggered = false;
    
    clockState.alarms.forEach((alarm, idx) => {
      if (!alarm.enabled) return;
      
      if (alarm.type === 'timer') {
        if (alarm.time === currentTime) {
          triggered = true;
          alarm.enabled = false;
          localStorage.setItem('dol_alarms', JSON.stringify(clockState.alarms));
          const rt = alarm.ringtone || clockState.currentRingtone;
          clockState._looping = true;
          playRingtone(rt, true);
          dolLog(`⏰ 闹铃提醒: ${alarm.label || '定时闹铃'} (${alarm.time})`, 'suc');
        }
      } else if (alarm.type === 'countdown' && alarm.triggerTime) {
        if (nowTs >= alarm.triggerTime) {
          triggered = true;
          alarm.enabled = false;
          localStorage.setItem('dol_alarms', JSON.stringify(clockState.alarms));
          const rt = alarm.ringtone || clockState.currentRingtone;
          clockState._looping = true;
          playRingtone(rt, true);
          dolLog(`⏱️ 倒计时闹铃: ${alarm.label || '倒计时闹铃'} 时间到!`, 'suc');
        }
      }
    });
  }, 1000);
}

function openClockPanel() {
  let existingWin = document.getElementById('clock-panel');
  if (existingWin) { existingWin.remove(); return; }
  
  const win = createBaseWindow('⏰ 时钟', 380, 500, 150, 80, false, true);
  win.style.zIndex = '10000';
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '0';
  
  const panel = document.createElement('div');
  panel.className = 'clock-panel';
  panel.style.padding = '12px';
  
  const now = new Date();
  
  panel.innerHTML = `
    <div class="clock-tabs">
      <button class="clock-tab active" data-tab="clock">🕐 时钟</button>
      <button class="clock-tab" data-tab="countdown">⏱️ 倒计时</button>
      <button class="clock-tab" data-tab="world">🌍 世界时间</button>
      <button class="clock-tab" data-tab="alarm">⏰ 闹铃</button>
    </div>
    <div class="clock-display">
      <div class="clock-time" id="clockTime">${formatTime(now)}</div>
      <div class="clock-date" id="clockDate">${formatDate(now)}</div>
    </div>
    <div class="clock-content" id="clockContent"></div>
  `;
  
  content.appendChild(panel);
  
  const timeEl = panel.querySelector('#clockTime');
  const dateEl = panel.querySelector('#clockDate');
  const contentEl = panel.querySelector('#clockContent');
  const tabs = panel.querySelectorAll('.clock-tab');
  
  function updateClock() {
    const n = new Date();
    timeEl.textContent = formatTime(n);
    dateEl.textContent = formatDate(n);
  }
  
  if (clockState._clockInterval) clearInterval(clockState._clockInterval);
  clockState._clockInterval = setInterval(updateClock, 1000);
  
  function renderTab(tab) {
    clockState.tab = tab;
    tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
    contentEl.innerHTML = '';
    
    if (tab === 'clock') {
      renderClockView(contentEl);
    } else if (tab === 'countdown') {
      renderCountdownView(contentEl);
    } else if (tab === 'world') {
      renderWorldView(contentEl);
    } else if (tab === 'alarm') {
      renderAlarmView(contentEl);
    }
  }
  
  function renderClockView(container) {
    const clockBox = document.createElement('div');
    clockBox.innerHTML = `
      <div style="text-align:center;margin:10px 0;">
        <div style="font-size:64px;letter-spacing:4px;color:#ffd89b;font-family:'Courier New',monospace;font-weight:700;text-shadow:0 0 30px rgba(255,200,100,0.4);">
          ${formatTime(new Date())}
        </div>
      </div>
      <div style="display:flex;gap:6px;margin-top:10px;">
        <button class="clock-btn" style="flex:1" id="setAlarmBtn">⏰ 设置闹铃</button>
        <button class="clock-btn secondary" style="flex:1" id="goTimerBtn">⏱️ 倒计时</button>
      </div>
      <div style="margin-top:12px;padding:10px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,200,100,0.15);">
        <div style="color:#c8a070;font-size:12px;margin-bottom:6px;">快速预设时间</div>
        <div style="display:flex;gap:4px;flex-wrap:wrap;">
          <button class="clock-ringtone-btn" data-min="5">5分钟</button>
          <button class="clock-ringtone-btn" data-min="10">10分钟</button>
          <button class="clock-ringtone-btn" data-min="25">25分钟</button>
          <button class="clock-ringtone-btn" data-min="60">1小时</button>
        </div>
      </div>
    `;
    container.appendChild(clockBox);
    
    clockBox.querySelector('#setAlarmBtn').onclick = () => renderTab('alarm');
    clockBox.querySelector('#goTimerBtn').onclick = () => renderTab('countdown');
    clockBox.querySelectorAll('.clock-ringtone-btn').forEach(btn => {
      btn.onclick = () => {
        const mins = parseInt(btn.dataset.min);
        clockState.countdown.seconds = mins * 60;
        clockState.countdown.originalSeconds = mins * 60;
        renderTab('countdown');
      };
    });
  }
  
  function renderCountdownView(container) {
    const cd = clockState.countdown;
    const total = cd.seconds;
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    
    const cdBox = document.createElement('div');
    cdBox.innerHTML = `
      <div class="countdown-display" id="cdDisplay">
        ${h > 0 ? String(h).padStart(2,'0') + ':' : ''}${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}
      </div>
      <div style="display:flex;gap:6px;margin-bottom:10px;">
        <input type="number" class="clock-input" id="cdHours" placeholder="时" min="0" max="99" style="width:50px;text-align:center;">
        <span style="color:#c8a070;line-height:40px;">:</span>
        <input type="number" class="clock-input" id="cdMins" placeholder="分" min="0" max="59" style="width:50px;text-align:center;">
        <span style="color:#c8a070;line-height:40px;">:</span>
        <input type="number" class="clock-input" id="cdSecs" placeholder="秒" min="0" max="59" style="width:50px;text-align:center;">
      </div>
      <div style="display:flex;gap:6px;margin-top:10px;">
        <button class="clock-btn" id="cdStart">▶️ 开始</button>
        <button class="clock-btn secondary" id="cdPause">⏸️ 暂停</button>
        <button class="clock-btn secondary" id="cdReset">🔄 重置</button>
      </div>
      <div style="margin-top:12px;padding:10px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,200,100,0.15);">
        <div style="color:#c8a070;font-size:12px;margin-bottom:6px;">预设时间</div>
        <div style="display:flex;gap:4px;flex-wrap:wrap;">
          <button class="clock-ringtone-btn" data-s="60">1分钟</button>
          <button class="clock-ringtone-btn" data-s="300">5分钟</button>
          <button class="clock-ringtone-btn" data-s="600">10分钟</button>
          <button class="clock-ringtone-btn" data-s="1500">25分钟</button>
          <button class="clock-ringtone-btn" data-s="3600">1小时</button>
        </div>
      </div>
    `;
    container.appendChild(cdBox);
    
    const dispEl = cdBox.querySelector('#cdDisplay');
    const hInput = cdBox.querySelector('#cdHours');
    const mInput = cdBox.querySelector('#cdMins');
    const sInput = cdBox.querySelector('#cdSecs');
    
    cdBox.querySelector('#cdStart').onclick = () => {
      if (clockState.countdown.timer) return;
      let secs = cd.seconds;
      if (secs <= 0) {
        const h = parseInt(hInput.value) || 0;
        const m = parseInt(mInput.value) || 0;
        const s = parseInt(sInput.value) || 0;
        secs = h * 3600 + m * 60 + s;
        if (secs <= 0) { dolLog('请设置有效时间', 'err'); return; }
      }
      clockState.countdown.seconds = secs;
      clockState.countdown.originalSeconds = secs;
      clockState.countdown.timer = setInterval(() => {
        clockState.countdown.seconds--;
        const t = clockState.countdown.seconds;
        const hh = Math.floor(t / 3600);
        const mm = Math.floor((t % 3600) / 60);
        const ss = t % 60;
        dispEl.textContent = `${hh > 0 ? String(hh).padStart(2,'0') + ':' : ''}${String(mm).padStart(2,'0')}:${String(ss).padStart(2,'0')}`;
        if (t <= 10) dispEl.classList.add('warning');
        if (t <= 0) {
          clearInterval(clockState.countdown.timer);
          clockState.countdown.timer = null;
          clockState._looping = true;
          playRingtone(clockState.currentRingtone, true);
          dolLog('⏰ 倒计时结束！', 'suc');
        }
      }, 1000);
    };
    
    cdBox.querySelector('#cdPause').onclick = () => {
      if (clockState.countdown.timer) {
        clearInterval(clockState.countdown.timer);
        clockState.countdown.timer = null;
        stopRingtone();
        dolLog('⏸️ 倒计时已暂停', 'info');
      }
    };
    
    cdBox.querySelector('#cdReset').onclick = () => {
      if (clockState.countdown.timer) {
        clearInterval(clockState.countdown.timer);
        clockState.countdown.timer = null;
        stopRingtone();
      }
      clockState.countdown.seconds = 0;
      clockState.countdown.originalSeconds = 0;
      dispEl.textContent = '00:00';
      dispEl.classList.remove('warning');
      hInput.value = ''; mInput.value = ''; sInput.value = '';
    };
    
    cdBox.querySelectorAll('.clock-ringtone-btn').forEach(btn => {
      btn.onclick = () => {
        secs = parseInt(btn.dataset.s);
        clockState.countdown.seconds = secs;
        clockState.countdown.originalSeconds = secs;
        hInput.value = Math.floor(secs / 3600) || '';
        mInput.value = Math.floor((secs % 3600) / 60) || '';
        sInput.value = secs % 60 || '';
        const hh = Math.floor(secs / 3600);
        const mm = Math.floor((secs % 3600) / 60);
        const ss = secs % 60;
        dispEl.textContent = `${hh > 0 ? String(hh).padStart(2,'0') + ':' : ''}${String(mm).padStart(2,'0')}:${String(ss).padStart(2,'0')}`;
      };
    });
  }
  
  function renderWorldView(container) {
    const worldBox = document.createElement('div');
    const items = WORLD_CLOCKS.map(w => {
      const t = getTimeInOffset(w.offset);
      return `<div class="clock-world-item">
        <span class="clock-world-city">🌐 ${w.city}</span>
        <span class="clock-world-time">${formatTime(t)}</span>
      </div>`;
    }).join('');
    
    worldBox.innerHTML = `
      <div style="max-height:350px;overflow-y:auto;">
        ${items}
      </div>
      <div style="margin-top:12px;padding:10px;background:rgba(0,0,0,0.3);border-radius:8px;border:1px solid rgba(255,200,100,0.15);">
        <div style="color:#c8a070;font-size:12px;margin-bottom:6px;">📝 本地时区</div>
        <div style="color:#ffd89b;font-size:13px;">${Intl.DateTimeFormat().resolvedOptions().timeZone}</div>
      </div>
    `;
    container.appendChild(worldBox);
  }
  
  function renderAlarmView(container) {
    const alarmBox = document.createElement('div');
    const alarms = clockState.alarms;
    
    let alarmList = '';
    if (alarms.length > 0) {
      alarmList = alarms.map((a, idx) => {
        const typeIcon = a.type === 'countdown' ? '⏱️' : '⏰';
        const typeLabel = a.type === 'countdown' ? '倒计时' : '定时';
        const timeDisplay = a.type === 'countdown' ? a.time + '后' : a.time;
        return `
        <div class="clock-alarm-item">
          <span class="clock-alarm-time">${typeIcon} ${timeDisplay}</span>
          <span class="clock-alarm-label">${a.label || '闹铃'} [${typeLabel}]</span>
          <div class="clock-alarm-toggle ${a.enabled ? 'on' : ''}" data-idx="${idx}"></div>
          <button class="clock-ringtone-btn" style="padding:4px 8px;font-size:10px;" data-del="${idx}">🗑️</button>
        </div>
      `;
      }).join('');
    } else {
      alarmList = '<div style="color:#888;font-size:12px;text-align:center;padding:20px;">暂无闹铃</div>';
    }
    
    const ringtoneOptions = Object.entries(RINGTONES).map(([id, r]) => 
      `<button class="clock-ringtone-btn ${clockState.currentRingtone === id ? 'active' : ''}" data-ring="${id}">${r.name}</button>`
    ).join('');
    
    alarmBox.innerHTML = `
      <div style="padding:10px;background:rgba(0,0,0,0.3);border-radius:10px;margin-bottom:10px;border:1px solid rgba(255,200,100,0.15);">
        <div style="display:flex;gap:4px;margin-bottom:8px;">
          <button class="clock-tab ${alarmBox._alarmType !== 'countdown' ? 'active' : ''}" data-atype="timer" style="flex:1;padding:6px;font-size:12px;border:none;border-radius:8px;cursor:pointer;background:${alarmBox._alarmType !== 'countdown' ? '#d4a843' : '#4a3828'};color:${alarmBox._alarmType !== 'countdown' ? '#2a1e18' : '#c8a070'};">⏰ 定时提醒</button>
          <button class="clock-tab" data-atype="countdown" style="flex:1;padding:6px;font-size:12px;border:none;border-radius:8px;cursor:pointer;background:${alarmBox._alarmType === 'countdown' ? '#d4a843' : '#4a3828'};color:${alarmBox._alarmType === 'countdown' ? '#2a1e18' : '#c8a070'};">⏱️ 倒计时</button>
        </div>
        <div id="timerInputArea" style="display:${alarmBox._alarmType === 'countdown' ? 'none' : 'flex'};gap:6px;">
          <input type="time" class="clock-input" id="alarmTime" style="flex:1;">
          <input type="text" class="clock-input" id="alarmLabel" placeholder="标签" style="flex:1;">
          <button class="clock-btn" id="addAlarmBtn" style="padding:8px 12px;">➕</button>
        </div>
        <div id="countdownInputArea" style="display:${alarmBox._alarmType === 'countdown' ? 'flex' : 'none'};gap:6px;align-items:center;">
          <input type="number" class="clock-input" id="cdAlarmHours" placeholder="时" min="0" max="23" style="width:50px;text-align:center;">
          <span style="color:#c8a070;">:</span>
          <input type="number" class="clock-input" id="cdAlarmMins" placeholder="分" min="0" max="59" style="width:50px;text-align:center;">
          <span style="color:#c8a070;">:</span>
          <input type="number" class="clock-input" id="cdAlarmSecs" placeholder="秒" min="0" max="59" style="width:50px;text-align:center;">
          <input type="text" class="clock-input" id="cdAlarmLabel" placeholder="标签" style="flex:1;">
          <button class="clock-btn" id="addCdAlarmBtn" style="padding:8px 12px;">➕</button>
        </div>
      </div>
      <div style="max-height:200px;overflow-y:auto;margin-bottom:10px;">
        ${alarmList}
      </div>
      <div style="padding:10px;background:rgba(0,0,0,0.3);border-radius:10px;border:1px solid rgba(255,200,100,0.15);">
        <div style="color:#c8a070;font-size:12px;margin-bottom:6px;">🔔 闹铃铃声 (3短 + 9长)</div>
        <div class="clock-ringtone-list">
          ${ringtoneOptions}
        </div>
        <div style="display:flex;gap:6px;margin-top:8px;">
          <button class="clock-btn secondary" id="testRingtone" style="flex:1;">🔊 试听</button>
          <label class="clock-btn secondary" style="flex:1;cursor:pointer;text-align:center;">📂 上传铃声<input type="file" id="uploadRingtone" accept="audio/*" style="display:none;"></label>
        </div>
      </div>
    `;
    container.appendChild(alarmBox);
    
    // 切换定时/倒计时输入
    alarmBox.querySelectorAll('[data-atype]').forEach(btn => {
      btn.onclick = () => {
        alarmBox._alarmType = btn.dataset.atype === 'countdown' ? 'countdown' : 'timer';
        renderTab('alarm');
      };
    });
    
    // 添加定时闹铃
    alarmBox.querySelector('#addAlarmBtn').onclick = () => {
      const time = alarmBox.querySelector('#alarmTime').value;
      const label = alarmBox.querySelector('#alarmLabel').value;
      if (!time) { dolLog('请设置闹铃时间', 'err'); return; }
      clockState.alarms.push({ type: 'timer', time, label, enabled: true, ringtone: clockState.currentRingtone });
      localStorage.setItem('dol_alarms', JSON.stringify(clockState.alarms));
      startAlarmChecker();
      renderTab('alarm');
      dolLog(`⏰ 定时闹铃已设置: ${time} ${label}`, 'suc');
    };
    
    // 添加倒计时闹铃
    alarmBox.querySelector('#addCdAlarmBtn').onclick = () => {
      const h = parseInt(alarmBox.querySelector('#cdAlarmHours').value) || 0;
      const m = parseInt(alarmBox.querySelector('#cdAlarmMins').value) || 0;
      const s = parseInt(alarmBox.querySelector('#cdAlarmSecs').value) || 0;
      const label = alarmBox.querySelector('#cdAlarmLabel').value || '倒计时闹铃';
      const totalSecs = h * 3600 + m * 60 + s;
      if (totalSecs <= 0) { dolLog('请设置有效的倒计时时间', 'err'); return; }
      const triggerTime = new Date(Date.now() + totalSecs * 1000);
      const timeStr = triggerTime.toLocaleTimeString('zh-CN', { hour12: false });
      const displayTime = `${h > 0 ? h + '时' : ''}${m > 0 ? m + '分' : ''}${s > 0 ? s + '秒' : ''}`;
      clockState.alarms.push({ type: 'countdown', time: displayTime, triggerTime: triggerTime.getTime(), label, enabled: true, ringtone: clockState.currentRingtone });
      localStorage.setItem('dol_alarms', JSON.stringify(clockState.alarms));
      startAlarmChecker();
      renderTab('alarm');
      dolLog(`⏱️ 倒计时闹铃已设置: ${displayTime}后 (${timeStr}响)`, 'suc');
    };
    
    alarmBox.querySelectorAll('.clock-alarm-toggle').forEach(toggle => {
      toggle.onclick = () => {
        const idx = parseInt(toggle.dataset.idx);
        clockState.alarms[idx].enabled = !clockState.alarms[idx].enabled;
        localStorage.setItem('dol_alarms', JSON.stringify(clockState.alarms));
        toggle.classList.toggle('on');
      };
    });
    
    alarmBox.querySelectorAll('[data-del]').forEach(btn => {
      btn.onclick = () => {
        const idx = parseInt(btn.dataset.del);
        clockState.alarms.splice(idx, 1);
        localStorage.setItem('dol_alarms', JSON.stringify(clockState.alarms));
        renderTab('alarm');
      };
    });
    
    alarmBox.querySelectorAll('.clock-ringtone-btn[data-ring]').forEach(btn => {
      btn.onclick = () => {
        clockState.currentRingtone = btn.dataset.ring;
        localStorage.setItem('dol_ringtone', clockState.currentRingtone);
        alarmBox.querySelectorAll('.clock-ringtone-btn[data-ring]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      };
    });
    
    alarmBox.querySelector('#testRingtone').onclick = () => {
      playRingtone(clockState.currentRingtone, false);
      dolLog('🔊 试听铃声...', 'info');
    };
    
    alarmBox.querySelector('#uploadRingtone').onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (evt) => {
        const dataUrl = evt.target.result;
        clockState.customRingtones.push({ name: file.name, data: dataUrl });
        localStorage.setItem('dol_custom_ringtones', JSON.stringify(clockState.customRingtones));
        playCustomRingtone(dataUrl);
        dolLog(`✅ 铃声 "${file.name}" 已上传`, 'suc');
      };
      reader.readAsDataURL(file);
    };
  }
  
  tabs.forEach(tab => {
    tab.onclick = () => renderTab(tab.dataset.tab);
  });
  
  renderTab('clock');
  
  win.querySelectorAll('.sys-win-close')[0].onclick = () => {
    if (clockState._clockInterval) clearInterval(clockState._clockInterval);
    stopRingtone();
    win.remove();
  };
}

// ==================================================
// ========== 【构思区 & 思维导图系统】 ==========
// ==================================================

let brainstormState = {
  nodes: JSON.parse(localStorage.getItem('dol_brainstorm_nodes') || '[]'),
  texts: JSON.parse(localStorage.getItem('dol_brainstorm_texts') || '[]'),
  rootId: localStorage.getItem('dol_brainstorm_root') || null,
  nextId: 1,
  mode: 'select'
};

function initBrainstorm(canvas) {
  canvas.innerHTML = '';
  brainstormState.nodes = JSON.parse(localStorage.getItem('dol_brainstorm_nodes') || '[]');
  brainstormState.texts = JSON.parse(localStorage.getItem('dol_brainstorm_texts') || '[]');
  
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('class', 'mindmap-connections');
  svg.setAttribute('width', '100%');
  svg.setAttribute('height', '100%');
  svg.style.position = 'absolute';
  svg.style.top = '0';
  svg.style.left = '0';
  svg.style.pointerEvents = 'none';
  canvas.appendChild(svg);
  
  function renderConnections() {
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    brainstormState.nodes.forEach(node => {
      if (node.parentId) {
        const parent = brainstormState.nodes.find(n => n.id === node.parentId);
        if (parent) {
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          const childX = node.x + 60;
          const childY = node.y + 20;
          const parentX = parent.x + 60;
          const parentY = parent.y + 20;
          line.setAttribute('x1', parentX);
          line.setAttribute('y1', parentY);
          line.setAttribute('x2', childX);
          line.setAttribute('y2', childY);
          line.setAttribute('stroke', 'rgba(100,150,200,0.4)');
          line.setAttribute('stroke-width', '2');
          line.setAttribute('stroke-dasharray', '4');
          svg.appendChild(line);
        }
      }
    });
  }
  
  function makeDraggable(el, data) {
    let offsetX = 0, offsetY = 0, isDragging = false;
    el.addEventListener('mousedown', e => {
      if (e.target.classList.contains('node-delete') || e.target.classList.contains('text-delete')) return;
      isDragging = true;
      const rect = el.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
      if (!isDragging) return;
      const canvasRect = canvas.getBoundingClientRect();
      data.x = e.clientX - canvasRect.left - offsetX;
      data.y = e.clientY - canvasRect.top - offsetY;
      el.style.left = data.x + 'px';
      el.style.top = data.y + 'px';
      renderConnections();
    });
    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        saveBrainstorm();
      }
    });
  }
  
  function render() {
    const existingEls = canvas.querySelectorAll('.mindmap-node, .brainstorm-text-item');
    existingEls.forEach(el => el.remove());
    
    brainstormState.nodes.forEach(node => {
      const el = document.createElement('div');
      el.className = 'mindmap-node' + (node.id === brainstormState.rootId ? ' root' : '');
      el.style.left = node.x + 'px';
      el.style.top = node.y + 'px';
      el.textContent = node.text;
      el.dataset.id = node.id;
      
      const del = document.createElement('div');
      del.className = 'node-delete';
      del.textContent = '✕';
      del.onclick = (e) => {
        e.stopPropagation();
        brainstormState.nodes = brainstormState.nodes.filter(n => n.id !== node.id);
        if (node.id === brainstormState.rootId) brainstormState.rootId = null;
        saveBrainstorm();
        render();
      };
      el.appendChild(del);
      
      makeDraggable(el, node);
      
      el.ondblclick = () => {
        const newText = prompt('编辑节点:', node.text);
        if (newText !== null) {
          node.text = newText;
          saveBrainstorm();
          render();
        }
      };
      
      el.oncontextmenu = (e) => {
        e.preventDefault();
        const newNode = {
          id: brainstormState.nextId++,
          text: '新节点',
          x: node.x + 150,
          y: node.y + (Math.random() - 0.5) * 60,
          parentId: node.id
        };
        brainstormState.nodes.push(newNode);
        saveBrainstorm();
        render();
      };
      
      canvas.appendChild(el);
    });
    
    brainstormState.texts.forEach(text => {
      const el = document.createElement('div');
      el.className = 'brainstorm-text-item';
      el.style.left = text.x + 'px';
      el.style.top = text.y + 'px';
      el.textContent = text.content;
      el.dataset.id = text.id;
      
      const del = document.createElement('div');
      del.className = 'text-delete';
      del.textContent = '✕';
      del.onclick = (e) => {
        e.stopPropagation();
        brainstormState.texts = brainstormState.texts.filter(t => t.id !== text.id);
        saveBrainstorm();
        render();
      };
      el.appendChild(del);
      
      makeDraggable(el, text);
      
      el.ondblclick = () => {
        const newText = prompt('编辑文本:', text.content);
        if (newText !== null) {
          text.content = newText;
          saveBrainstorm();
          render();
        }
      };
      
      canvas.appendChild(el);
    });
    
    renderConnections();
  }
  
  function saveBrainstorm() {
    localStorage.setItem('dol_brainstorm_nodes', JSON.stringify(brainstormState.nodes));
    localStorage.setItem('dol_brainstorm_texts', JSON.stringify(brainstormState.texts));
    localStorage.setItem('dol_brainstorm_root', brainstormState.rootId || '');
  }
  
  return { render, saveBrainstorm, makeDraggable };
}

function addBrainstormText() {
  const text = prompt('输入文本内容:');
  if (!text) return;
  const el = document.querySelector('.brainstorm-canvas');
  if (!el) return;
  const canvasRect = el.getBoundingClientRect();
  brainstormState.texts.push({
    id: Date.now(),
    content: text,
    x: Math.random() * 200 + 50,
    y: Math.random() * 200 + 50
  });
  localStorage.setItem('dol_brainstorm_texts', JSON.stringify(brainstormState.texts));
  const bs = initBrainstorm(el);
  bs.render();
  dolLog('✅ 文本已添加到构思区', 'suc');
}

function addBrainstormNode() {
  const text = prompt('输入节点内容:');
  if (!text) return;
  const el = document.querySelector('.brainstorm-canvas');
  if (!el) return;
  const rootId = brainstormState.rootId || Date.now();
  if (!brainstormState.rootId) {
    brainstormState.rootId = rootId;
    brainstormState.nodes.push({ id: rootId, text, x: 200, y: 150, parentId: null });
  } else {
    brainstormState.nodes.push({
      id: Date.now(), text,
      x: Math.random() * 200 + 350,
      y: Math.random() * 200 + 50,
      parentId: brainstormState.rootId
    });
  }
  localStorage.setItem('dol_brainstorm_nodes', JSON.stringify(brainstormState.nodes));
  localStorage.setItem('dol_brainstorm_root', brainstormState.rootId);
  const bs = initBrainstorm(el);
  bs.render();
  dolLog('✅ 思维导图节点已添加', 'suc');
}

function clearBrainstorm() {
  if (!confirm('确定要清空构思区吗？')) return;
  brainstormState.nodes = [];
  brainstormState.texts = [];
  brainstormState.rootId = null;
  localStorage.removeItem('dol_brainstorm_nodes');
  localStorage.removeItem('dol_brainstorm_texts');
  localStorage.removeItem('dol_brainstorm_root');
  const el = document.querySelector('.brainstorm-canvas');
  if (el) {
    const bs = initBrainstorm(el);
    bs.render();
  }
  dolLog('🧹 构思区已清空', 'info');
}

function toggleAnimations() {
  const enabled = localStorage.getItem('dol_anim_enabled') !== 'false';
  const newState = !enabled;
  localStorage.setItem('dol_anim_enabled', newState ? 'true' : 'false');
  if (newState) {
    document.body.classList.remove('no-anim');
    dolLog('✨ 窗口动画已开启', 'suc');
  } else {
    document.body.classList.add('no-anim');
    dolLog('💤 窗口动画已关闭', 'info');
  }
  playSound('switch');
  openSettingsWindow();
}

function toggleSidebar(forceState) {
  const sidebar = document.getElementById('appSidebar');
  const floatingBtn = document.getElementById('sidebarFloatingBtn');
  if (sidebar) {
    let newState;
    if (forceState === 'on' || forceState === true) {
      newState = 'visible';
    } else if (forceState === 'off' || forceState === false) {
      newState = 'hidden';
    } else {
      newState = sidebar.classList.contains('visible') ? 'hidden' : 'visible';
    }
    
    if (newState === 'visible') {
      sidebar.classList.add('visible');
      sidebar.classList.remove('collapsed');
      const btn = sidebar.querySelector('.sidebar-collapse-btn');
      if (btn) btn.remove();
      sidebar.querySelectorAll('.sidebar-body').forEach(b => b.style.display = '');
      if (floatingBtn) floatingBtn.style.display = 'none';
      dolLog('📂 侧边栏已打开', 'suc');
      playSound('switch');
    } else {
      sidebar.classList.remove('visible');
      const btn = sidebar.querySelector('.sidebar-collapse-btn');
      if (btn) btn.remove();
      if (floatingBtn) floatingBtn.style.display = 'flex';
      dolLog('📂 侧边栏已关闭 (输入 /dol/oc.bnc 打开)', 'info');
      playSound('switch');
    }
  }
}

function toggleSection(sectionId) {
  const section = document.getElementById(sectionId);
  if (section) {
    section.classList.toggle('collapsed');
  }
}

function openBrainstormWindow() {
  let existingWin = document.getElementById('brainstorm-panel');
  if (existingWin) { existingWin.remove(); return; }
  
  const win = createBaseWindow('🧠 构思区', 600, 500, 200, 100, false, true);
  win.style.zIndex = '10000';
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  
  const area = document.createElement('div');
  area.className = 'brainstorm-area';
  area.innerHTML = `
    <div class="brainstorm-toolbar">
      <button class="brainstorm-tool-btn active" onclick="addBrainstormTextFromToolbar();playSound('click');">📝 添加文本</button>
      <button class="brainstorm-tool-btn" onclick="addBrainstormNodeFromToolbar();playSound('click');">🕸️ 思维导图节点</button>
      <button class="brainstorm-tool-btn" onclick="clearBrainstorm();playSound('click');">🗑️ 清空</button>
      <span style="flex:1;"></span>
      <span style="font-size:11px;color:rgba(255,255,255,0.4);align-self:center;">双击编辑 · 右键添加子节点 · 拖动移动</span>
    </div>
    <div class="brainstorm-canvas" id="brainstormCanvas"></div>
  `;
  content.appendChild(area);
  
  setTimeout(() => {
    const canvas = area.querySelector('#brainstormCanvas');
    const bs = initBrainstorm(canvas);
    bs.render();
  }, 100);
  
  win.querySelectorAll('.sys-win-close')[0].onclick = () => {
    win.remove();
  };
}

function addBrainstormTextFromToolbar() {
  const text = prompt('输入文本内容:');
  if (!text) return;
  const canvas = document.querySelector('.brainstorm-canvas');
  if (!canvas) return;
  brainstormState.texts.push({
    id: Date.now(),
    content: text,
    x: Math.random() * 200 + 50,
    y: Math.random() * 200 + 50
  });
  localStorage.setItem('dol_brainstorm_texts', JSON.stringify(brainstormState.texts));
  const bs = initBrainstorm(canvas);
  bs.render();
}

function addBrainstormNodeFromToolbar() {
  const text = prompt('输入节点内容:');
  if (!text) return;
  const canvas = document.querySelector('.brainstorm-canvas');
  if (!canvas) return;
  const rootId = brainstormState.rootId || Date.now();
  if (!brainstormState.rootId) {
    brainstormState.rootId = rootId;
    brainstormState.nodes.push({ id: rootId, text, x: 250, y: 180, parentId: null });
  } else {
    brainstormState.nodes.push({
      id: Date.now(), text,
      x: Math.random() * 200 + 350,
      y: Math.random() * 200 + 50,
      parentId: brainstormState.rootId
    });
  }
  localStorage.setItem('dol_brainstorm_nodes', JSON.stringify(brainstormState.nodes));
  localStorage.setItem('dol_brainstorm_root', brainstormState.rootId);
  const bs = initBrainstorm(canvas);
  bs.render();
}

// ==================================================
// ========== 【开机音效 - 比macOS更好听】 ==========
// ==================================================
function playStartupSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    if (ctx.state === 'suspended') ctx.resume();
    const now = ctx.currentTime;

    // 悦耳开机音 - E大三和弦渐入
    const chord = [
      { freq: 329.63, dur: 0.7, vol: 0.10 },  // E4
      { freq: 415.30, dur: 0.7, vol: 0.08 },  // G#4
      { freq: 493.88, dur: 0.7, vol: 0.09 },  // B4
      { freq: 659.25, dur: 0.5, vol: 0.05, delay: 0.12 }, // E5 泛音
    ];

    chord.forEach(n => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const filter = ctx.createBiquadFilter();
      osc.connect(filter); filter.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.value = n.freq;
      filter.type = 'lowpass';
      filter.frequency.value = 2200;
      const t = now + (n.delay || 0);
      // 柔和渐入渐出
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(n.vol, t + 0.12);
      gain.gain.exponentialRampToValueAtTime(n.vol * 0.4, t + n.dur * 0.6);
      gain.gain.exponentialRampToValueAtTime(0.001, t + n.dur);
      osc.start(t);
      osc.stop(t + n.dur);
    });
  } catch(e) {}
}

window.addEventListener('DOMContentLoaded', () => {
  setTimeout(checkPassword, 100);
  // 恢复动画设置
  if (localStorage.getItem('dol_anim_enabled') === 'false') {
    document.body.classList.add('no-anim');
  }
  // 开机音效 - 点击输入框时播放
  let startupPlayed = sessionStorage.getItem('dol_startup_played');
  if (!startupPlayed) {
    const codeInputEl = document.getElementById('codeInput');
    const playOnce = () => {
      playStartupSound();
      sessionStorage.setItem('dol_startup_played', '1');
      if (codeInputEl) codeInputEl.removeEventListener('focus', playOnce);
    };
    if (codeInputEl) codeInputEl.addEventListener('focus', playOnce);
  }
});

