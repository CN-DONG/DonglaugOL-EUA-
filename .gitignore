}

function caImage(keyword) {
  const win = createBaseWindow('🖼️ 图片搜索', 800, 600, 120, 70, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '8px';
  content.style.overflow = 'auto';
  const kw = keyword || 'nature';
  content.innerHTML = `
    <div style="display:flex;gap:4px;margin-bottom:8px;">
      <input type="text" id="img_kw" value="${kw}" style="flex:1;padding:6px;background:#0a0a0f;color:#fff;border:1px solid #333;border-radius:4px;outline:none;" />
      <button onclick="caImageSearch()" style="padding:6px 12px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;">搜索</button>
    </div>
    <div id="img_results" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
  `;
  
  window.caImageSearch = () => {
    const results = document.getElementById('img_results');
    const k = document.getElementById('img_kw').value || 'nature';
    results.innerHTML = '';
    for (let i = 0; i < 12; i++) {
      const img = document.createElement('img');
      img.src = `https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=${encodeURIComponent(k + ' ' + ['beautiful', 'colorful', 'abstract', 'realistic', 'artistic'][i % 5])}&image_size=square`;
      img.style.width = '150px';
      img.style.height = '150px';
      img.style.objectFit = 'cover';
      img.style.borderRadius = '8px';
      img.style.cursor = 'pointer';
      img.onclick = () => window.open(img.src);
      results.appendChild(img);
    }
  };
  caImageSearch();
  dolLog(`✅ 图片搜索: ${kw}`, 'suc');
}

function embedGame() {
  const uid = 'embed_game_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div style="display:flex;gap:8px;">
        <button onclick="playRock('rock')" style="padding:12px;background:#5a9cf0;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:24px;">✊</button>
        <button onclick="playRock('paper')" style="padding:12px;background:#5a9cf0;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:24px;">✋</button>
        <button onclick="playRock('scissors')" style="padding:12px;background:#5a9cf0;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:24px;">✌️</button>
      </div>
      <div id="${uid}_result" style="margin-top:8px;text-align:center;color:#fff;font-size:14px;"></div>
    </div>
  `;
  showInlineUI(html);
  
  const result = document.getElementById(uid + '_result');
  
  window.playRock = (player) => {
    const choices = ['rock', 'paper', 'scissors'];
    const computer = choices[Math.floor(Math.random() * 3)];
    const icons = { rock: '✊', paper: '✋', scissors: '✌️' };
    
    let msg = '';
    if (player === computer) msg = '平局！';
    else if ((player === 'rock' && computer === 'scissors') || (player === 'paper' && computer === 'rock') || (player === 'scissors' && computer === 'paper')) msg = '你赢了！';
    else msg = '电脑赢了！';
    
    result.innerHTML = `你: ${icons[player]} | 电脑: ${icons[computer]}<br>${msg}`;
  };
  dolLog(`✅ 猜拳游戏已嵌入`, 'suc');
}

function vlcLoop() {
  if (!vlcVideoEl) { dolLog(`❌ 没有正在播放的视频`, 'err'); return true; }
  vlcVideoEl.loop = !vlcVideoEl.loop;
  dolLog(`🔁 循环播放: ${vlcVideoEl.loop ? '已开启' : '已关闭'}`, vlcVideoEl.loop ? 'suc' : 'info');
  return true;
}

function vlcSpeed(param) {
  if (!vlcVideoEl) { dolLog(`❌ 没有正在播放的视频`, 'err'); return true; }
  if (!param) { dolLog(`❓ 用法: /vlc/speed<0.5-4>  例如: /vlc/speed<2>`, 'err'); return true; }
  const s = parseFloat(param);
  if (isNaN(s) || s < 0.1 || s > 16) { dolLog(`❌ 速度范围 0.1-16`, 'err'); return true; }
  vlcVideoEl.playbackRate = s;
  dolLog(`⚡ 播放速度: ${s}x`, 'suc');
  return true;
}

function vlcSnapshot() {
  if (!vlcVideoEl) { dolLog(`❌ 没有正在播放的视频`, 'err'); return true; }
  const canvas = document.createElement('canvas');
  canvas.width = vlcVideoEl.videoWidth || 640;
  canvas.height = vlcVideoEl.videoHeight || 480;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(vlcVideoEl, 0, 0, canvas.width, canvas.height);
  const dataUrl = canvas.toDataURL('image/png');
  const win = createBaseWindow('📸 视频截图', 480, 420, 350, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.textAlign = 'center';
  content.innerHTML = `
    <img src="${dataUrl}" style="max-width:100%;max-height:320px;border-radius:6px;">
    <div style="margin-top:10px;">
      <a href="${dataUrl}" download="screenshot_${Date.now()}.png" style="padding:8px 16px;background:#2e86c1;color:#fff;border-radius:6px;text-decoration:none;display:inline-block;">💾 保存图片</a>
    </div>
  `;
  dolLog(`📸 截图已生成`, 'suc');
  return true;
}

let vlcPlaylistItems = [];
let vlcPlaylistIndex = 0;

function vlcPlaylist(param) {
  if (!param) {
    if (vlcPlaylistItems.length === 0) { dolLog(`❓ 用法: /vlc/playlist<url1|url2|url3>`, 'err'); return true; }
    dolLog(`📋 播放列表 (${vlcPlaylistItems.length} 个，当前第 ${vlcPlaylistIndex+1} 个)`, 'info');
    vlcPlaylistItems.forEach((url, i) => {
      dolLog(`&nbsp;&nbsp;${i === vlcPlaylistIndex ? '▶' : '  '} [${i+1}] ${url}`, i === vlcPlaylistIndex ? 'suc' : 'out');
    });
    return true;
  }
  vlcPlaylistItems = param.split('|').map(u => u.trim()).filter(u => u);
  vlcPlaylistIndex = 0;
  ensureVlcWindow();
  const playNext = () => {
    if (vlcPlaylistIndex >= vlcPlaylistItems.length) {
      dolLog(`📋 播放列表播放完毕`, 'info');
      return;
    }
    vlcVideoEl.src = vlcPlaylistItems[vlcPlaylistIndex];
    vlcVideoEl.play();
    dolLog(`▶ 正在播放 [${vlcPlaylistIndex+1}/${vlcPlaylistItems.length}]: ${vlcPlaylistItems[vlcPlaylistIndex]}`, 'suc');
  };
  vlcVideoEl.onended = () => { vlcPlaylistIndex++; playNext(); };
  playNext();
  return true;
}

function parseImgCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/img/')) return false;
  const rest = cmd.substring(5);
  let action = rest, param = null;
  const sp = rest.indexOf('<');
  if (sp !== -1) {
    param = rest.substring(sp+1, rest.length - (rest.endsWith('>') ? 1 : 0));
    action = rest.substring(0, sp);
  }
  return executeImgAction(action, param);
}

function executeImgAction(action, param) {
  switch(action) {
    case 'preview': return imgPreview(param);
    case 'info': return imgInfo(param);
    case 'filter': return imgFilter(param);
    case 'rotate': return imgRotate(param);
    case 'grayscale': return imgGrayscale(param);
    case 'slideshow': return imgSlideshow(param);
    case 'gallery': return imgGallery(param);
    case 'open': return imgOpen();
    case 'embed': return imgEmbed(param);
    default: dolLog(`❌ 未知的 img 指令: ${action}`, 'err'); return true;
  }
}

function imgPreview(param) {
  if (!param && param !== '') {
    const input = document.createElement('input');
    input.type = 'file'; input.accept = 'image/*';
    input.onchange = e => {
      if (e.target.files[0]) {
        const url = URL.createObjectURL(e.target.files[0]);
        showImgPreview(url, e.target.files[0].name);
      }
    };
    input.click();
    return true;
  }
  showImgPreview(param);
  return true;
}

function showImgPreview(url, name = '') {
  const win = createBaseWindow('🖼️ 图片预览' + (name ? ' - ' + name : ''), 560, 460, 350, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.textAlign = 'center';
  content.style.overflow = 'auto';
  content.innerHTML = `<img src="${url}" style="max-width:100%;max-height:380px;border-radius:6px;">`;
  dolLog(`🖼️ 图片已预览`, 'suc');
  return true;
}

function imgInfo(param) {
  if (!param) {
    const input = document.createElement('input');
    input.type = 'file'; input.accept = 'image/*';
    input.onchange = e => {
      if (e.target.files[0]) {
        const f = e.target.files[0];
        const url = URL.createObjectURL(f);
        const img = new Image();
        img.onload = () => {
          dolLog(`🖼️ 图片信息`, 'info');
          dolLog(`&nbsp;&nbsp;文件名: ${f.name}`, 'out');
          dolLog(`&nbsp;&nbsp;尺寸: ${img.width} x ${img.height}`, 'out');
          dolLog(`&nbsp;&nbsp;大小: ${(f.size/1024).toFixed(2)} KB`, 'out');
          dolLog(`&nbsp;&nbsp;类型: ${f.type || '未知'}`, 'out');
        };
        img.src = url;
      }
    };
    input.click();
    return true;
  }
  const img = new Image();
  img.crossOrigin = 'anonymous';
  img.onload = () => {
    dolLog(`🖼️ 图片信息`, 'info');
    dolLog(`&nbsp;&nbsp;URL: ${param}`, 'out');
    dolLog(`&nbsp;&nbsp;尺寸: ${img.width} x ${img.height}`, 'out');
  };
  img.onerror = () => dolLog(`❌ 图片加载失败`, 'err');
  img.src = param;
  return true;
}

function imgFilter(param) {
  if (!param) { dolLog(`❓ 用法: /img/filter<图片URL|滤镜>  滤镜: blur/brightness/contrast/saturate/hue/grayscale/sepia/invert`, 'err'); return true; }
  const parts = param.split('|');
  const url = parts[0].trim();
  const filter = (parts[1] || 'grayscale').trim().toLowerCase();
  const filterMap = {
    blur: 'blur(5px)', brightness: 'brightness(1.5)', contrast: 'contrast(1.5)',
    saturate: 'saturate(2)', hue: 'hue-rotate(90deg)', grayscale: 'grayscale(100%)',
    sepia: 'sepia(100%)', invert: 'invert(100%)'
  };
  if (!filterMap[filter]) { dolLog(`❌ 不支持的滤镜: ${filter}`, 'err'); return true; }
  const win = createBaseWindow('🎨 图片滤镜 - ' + filter, 560, 460, 350, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.textAlign = 'center';
  content.innerHTML = `
    <div style="color:#888;font-size:12px;margin-bottom:8px;">原图 vs 滤镜效果</div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
      <div><div style="color:#888;font-size:11px;">原图</div><img src="${url}" style="max-width:240px;max-height:300px;border-radius:6px;"></div>
      <div><div style="color:#888;font-size:11px;">${filter}</div><img src="${url}" style="max-width:240px;max-height:300px;border-radius:6px;filter:${filterMap[filter]};"></div>
    </div>
  `;
  dolLog(`🎨 滤镜已应用: ${filter}`, 'suc');
  return true;
}

function imgRotate(param) {
  if (!param) { dolLog(`❓ 用法: /img/rotate<图片URL|角度>`, 'err'); return true; }
  const parts = param.split('|');
  const url = parts[0].trim();
  const angle = parseInt(parts[1]) || 90;
  const win = createBaseWindow('🔄 图片旋转 ' + angle + '°', 560, 460, 350, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.textAlign = 'center';
  content.innerHTML = `<img src="${url}" style="max-width:100%;max-height:380px;border-radius:6px;transform:rotate(${angle}deg);">`;
  dolLog(`🔄 图片已旋转 ${angle}°`, 'suc');
  return true;
}

function imgGrayscale(param) {
  if (!param) { dolLog(`❓ 用法: /img/grayscale<图片URL>`, 'err'); return true; }
  const win = createBaseWindow('⬛⬜ 灰度图', 560, 460, 350, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.textAlign = 'center';
  content.innerHTML = `
    <div style="color:#888;font-size:12px;margin-bottom:8px;">原图 vs 灰度</div>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
      <img src="${param}" style="max-width:240px;max-height:340px;border-radius:6px;">
      <img src="${param}" style="max-width:240px;max-height:340px;border-radius:6px;filter:grayscale(100%);">
    </div>
  `;
  dolLog(`⬛⬜ 灰度图已生成`, 'suc');
  return true;
}

function imgSlideshow(param) {
  if (!param) { dolLog(`❓ 用法: /img/slideshow<url1|url2|url3>`, 'err'); return true; }
  const urls = param.split('|').map(u => u.trim()).filter(u => u);
  let idx = 0;
  const win = createBaseWindow('🎞️ 幻灯片 (' + urls.length + ' 张)', 600, 480, 350, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.textAlign = 'center';
  content.innerHTML = `
    <div style="display:flex;align-items:center;justify-content:center;gap:10px;height:100%;">
      <button id="ss-prev" style="padding:20px 14px;background:#333;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:20px;">◀</button>
      <img id="ss-img" src="${urls[0]}" style="max-width:420px;max-height:380px;border-radius:6px;">
      <button id="ss-next" style="padding:20px 14px;background:#333;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:20px;">▶</button>
    </div>
    <div id="ss-info" style="color:#888;font-size:12px;margin-top:8px;">1 / ${urls.length}</div>
  `;
  const update = () => {
    content.querySelector('#ss-img').src = urls[idx];
    content.querySelector('#ss-info').textContent = `${idx+1} / ${urls.length}`;
  };
  content.querySelector('#ss-prev').onclick = () => { idx = (idx - 1 + urls.length) % urls.length; update(); };
  content.querySelector('#ss-next').onclick = () => { idx = (idx + 1) % urls.length; update(); };
  dolLog(`🎞️ 幻灯片已开始 (${urls.length} 张)`, 'suc');
  return true;
}

function imgGallery(param) {
  if (!param) { dolLog(`❓ 用法: /img/gallery<url1|url2|url3|...>`, 'err'); return true; }
  const urls = param.split('|').map(u => u.trim()).filter(u => u);
  const win = createBaseWindow('🖼️ 图片画廊 (' + urls.length + ' 张)', 680, 520, 300, 180, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '12px';
  content.style.overflow = 'auto';
  let html = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;">';
  urls.forEach((url, i) => {
    html += `<div style="cursor:pointer;" onclick="
      const w=window.open('','_blank');
      w.document.write('<body style=\\'margin:0;display:flex;align-items:center;justify-content:center;background:#000;min-height:100vh;\\'><img src=\\'${url}\\' style=\\'max-width:100%;max-height:100vh;\\'></body>');
    "><img src="${url}" style="width:100%;height:120px;object-fit:cover;border-radius:6px;"></div>`;
  });
  html += '</div>';
  content.innerHTML = html;
  dolLog(`🖼️ 图片画廊已生成 (${urls.length} 张)`, 'suc');
  return true;
}

function imgOpen() {
  const input = document.createElement('input');
  input.type = 'file'; input.accept = 'image/*'; input.multiple = true;
  input.onchange = e => {
    const files = Array.from(e.target.files);
    if (files.length === 0) return;
    if (files.length === 1) {
      const url = URL.createObjectURL(files[0]);
      showImgPreview(url, files[0].name);
    } else {
      const urls = files.map(f => URL.createObjectURL(f));
      const win = createBaseWindow('🖼️ 本地图片画廊 (' + files.length + ' 张)', 680, 520, 300, 180, false, true);
      const content = win.querySelector('.sys-win-content');
      content.style.padding = '12px';
      content.style.overflow = 'auto';
      let html = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;">';
      files.forEach((f, i) => {
        const url = urls[i];
        html += `<div><img src="${url}" style="width:100%;height:120px;object-fit:cover;border-radius:6px;"><div style="font-size:11px;color:#888;text-align:center;margin-top:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">${f.name}</div></div>`;
      });
      html += '</div>';
      content.innerHTML = html;
      dolLog(`🖼️ 本地图片画廊已生成 (${files.length} 张)`, 'suc');
    }
  };
  input.click();
  return true;
}

function imgEmbed(param) {
  if (!param) {
    const input = document.createElement('input');
    input.type = 'file'; input.accept = 'image/*'; input.multiple = true;
    input.onchange = e => {
      const files = Array.from(e.target.files);
      if (files.length === 0) return;
      let html = '<div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">';
      files.forEach(f => {
        const url = URL.createObjectURL(f);
        html += `<div style="margin-bottom:6px;"><div style="color:#888;font-size:11px;">📁 ${escapeHtml(f.name)} (${(f.size/1024).toFixed(1)} KB)</div><img src="${url}" style="max-width:100%;max-height:360px;border-radius:6px;"></div>`;
      });
      html += '</div>';
      showInlineUI(html);
      dolLog(`✅ 图片已嵌入页面 (${files.length} 张)`, 'suc');
    };
    input.click();
    return true;
  }
  const urls = param.split('|').map(u => u.trim()).filter(u => u);
  let html = '<div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">';
  urls.forEach(url => {
    html += `<img src="${url}" style="max-width:100%;max-height:360px;border-radius:6px;margin:4px 0;">`;
  });
  html += '</div>';
  showInlineUI(html);
  dolLog(`✅ 图片已嵌入页面 (${urls.length} 张)`, 'suc');
  return true;
}

let prtState = { connected: false, queue: [], status: '空闲', paper: 'A4', copies: 1, color: 'color', dpi: 300, progress: 0, jobs: [] };

function parsePrtCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/prt/')) return false;
  const rest = cmd.substring(5);
  let action = rest, param = null;
  const sp = rest.indexOf('<');
  if (sp !== -1) {
    param = rest.substring(sp+1, rest.length - (rest.endsWith('>') ? 1 : 0));
    action = rest.substring(0, sp);
  }
  return executePrtAction(action, param);
}

function executePrtAction(action, param) {
  switch(action) {
    case 'open': return prtOpen();
    case 'nad': return prtNad();
    case 'connect': return prtConnect();
    case 'disconnect': return prtDisconnect();
    case 'status': return prtStatus();
    case 'print': return prtPrint(param);
    case 'queue': return prtQueue();
    case 'cancel': return prtCancel();
    case 'paper': return prtPaper(param);
    case 'quality': return prtQuality(param);
    case 'copies': return prtCopies(param);
    case 'ink': return prtInk();
    default: dolLog(`❌ 未知的 prt 指令: ${action}`, 'err'); return true;
  }
}

function prtOpen() {
  const win = createBaseWindow('🖨️ 打印机控制面板', 520, 560, 400, 180, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '16px';
  content.style.background = '#f5f5f5';
  content.style.color = '#333';
  content.innerHTML = `
    <div style="font-size:18px;font-weight:bold;margin-bottom:12px;color:#2c3e50;">🖨️ 打印机 ${prtState.connected ? '<span style="color:#27ae60;">● 已连接</span>' : '<span style="color:#e74c3c;">● 未连接</span>'}</div>
    <div style="background:#fff;padding:12px;border-radius:8px;margin-bottom:12px;border:1px solid #ddd;">
      <div style="font-weight:bold;margin-bottom:8px;">设备状态</div>
      <div id="prt-status-text" style="font-size:13px;color:#555;">状态: ${prtState.status} | 纸张: ${prtState.paper} | DPI: ${prtState.dpi}</div>
      <div id="prt-progress" style="margin-top:8px;display:none;">
        <div style="font-size:12px;color:#666;margin-bottom:4px;">打印进度...</div>
        <div style="background:#eee;border-radius:4px;height:8px;overflow:hidden;"><div id="prt-bar" style="background:#3498db;height:100%;width:0%;transition:width 0.3s;"></div></div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px;">
      <button id="btn-connect" style="padding:10px;background:${prtState.connected ? '#e74c3c' : '#27ae60'};color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">${prtState.connected ? '🔌 断开连接' : '🔌 连接打印机'}</button>
      <button id="btn-print" style="padding:10px;background:#3498db;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">🖨️ 打印测试页</button>
      <button id="btn-queue" style="padding:10px;background:#f39c12;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">📋 查看队列 (${prtState.queue.length})</button>
      <button id="btn-cancel" style="padding:10px;background:#95a5a6;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">✖ 取消全部</button>
      <button id="btn-ink" style="padding:10px;background:#8e44ad;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">🎨 墨水余量</button>
      <button id="btn-status" style="padding:10px;background:#16a085;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">ℹ️ 详细状态</button>
    </div>
    <div style="background:#fff;padding:12px;border-radius:8px;border:1px solid #ddd;">
      <div style="font-weight:bold;margin-bottom:8px;">打印设置</div>
      <div style="font-size:12px;color:#555;line-height:1.8;">
        <div>纸张: <select id="set-paper" style="padding:4px;"><option>A4</option><option>A5</option><option>A3</option><option>Letter</option></select></div>
        <div>质量: <select id="set-dpi" style="padding:4px;"><option>300</option><option>600</option><option>1200</option></select> DPI</div>
        <div>色彩: <select id="set-color" style="padding:4px;"><option value="color">彩色</option><option value="bw">黑白</option></select></div>
        <div>份数: <input id="set-copies" type="number" value="1" min="1" max="99" style="width:60px;padding:4px;"></div>
      </div>
      <button id="btn-apply" style="margin-top:8px;padding:8px 16px;background:#2c3e50;color:#fff;border:none;border-radius:6px;cursor:pointer;">✔ 应用设置</button>
    </div>
  `;
  const $ = id => content.querySelector('#' + id);
  $('btn-connect').onclick = () => {
    if (prtState.connected) { prtDisconnect(); } else { prtConnect(); }
    win.remove(); prtOpen();
  };
  $('btn-print').onclick = () => { prtPrint('测试页'); win.remove(); prtOpen(); };
  $('btn-queue').onclick = () => { prtQueue(); };
  $('btn-cancel').onclick = () => { prtCancel(); win.remove(); prtOpen(); };
  $('btn-ink').onclick = () => { prtInk(); };
  $('btn-status').onclick = () => { prtStatus(); };
  $('btn-apply').onclick = () => {
    prtState.paper = $('set-paper').value;
    prtState.dpi = parseInt($('set-dpi').value);
    prtState.color = $('set-color').value;
    prtState.copies = parseInt($('set-copies').value) || 1;
    dolLog(`⚙️ 打印设置已更新: ${prtState.paper} / ${prtState.dpi}DPI / ${prtState.color === 'color' ? '彩色' : '黑白'} / ${prtState.copies}份`, 'suc');
  };
  dolLog(`🖨️ 打印机控制面板已打开`, 'suc');
  return true;
}

function prtNad() {
  const win = createBaseWindow('🖨️ NAD 打印机', 560, 480, 400, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '0';
  content.style.background = 'linear-gradient(180deg,#2a2a3a 0%,#1a1a28 100%)';
  const mkBtn = (label, color, onclick) => `<button style="padding:14px 18px;background:linear-gradient(180deg,${color} 0%,${color}dd 50%,${color}aa 100%);color:#fff;border:2px solid #111;border-radius:8px;cursor:pointer;font-weight:bold;font-size:13px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.3),0 3px 6px rgba(0,0,0,0.5),0 0 0 1px rgba(0,0,0,0.3);text-shadow:0 1px 2px rgba(0,0,0,0.5);" onmouseover="this.style.filter='brightness(1.1)'" onmouseout="this.style.filter='brightness(1)'" onmousedown="this.style.transform='translateY(2px)';this.style.boxShadow='inset 0 1px 0 rgba(255,255,255,0.2),0 1px 3px rgba(0,0,0,0.5)'" onmouseup="this.style.transform='';this.style.boxShadow=''">${label}</button>`;
  content.innerHTML = `
    <div style="padding:18px;background:linear-gradient(180deg,rgba(0,0,0,0.4) 0%,transparent 100%);border-bottom:1px solid rgba(255,255,255,0.05);">
      <div style="display:flex;align-items:center;justify-content:space-between;">
        <div style="font-size:16px;font-weight:bold;color:#ddd;letter-spacing:2px;text-shadow:0 2px 4px rgba(0,0,0,0.8);">NAD PRINTER</div>
        <div style="display:flex;gap:8px;">
          <div id="nad-led-pwr" style="width:10px;height:10px;border-radius:50%;background:${prtState.connected ? '#2ecc71' : '#555'};box-shadow:0 0 ${prtState.connected ? '8px' : '0'} #2ecc71;"></div>
          <div id="nad-led-ink" style="width:10px;height:10px;border-radius:50%;background:#3498db;box-shadow:0 0 6px #3498db;"></div>
          <div id="nad-led-err" style="width:10px;height:10px;border-radius:50%;background:#555;"></div>
        </div>
      </div>
    </div>
    <div style="padding:14px;">
      <div style="background:#0a0a0f;padding:14px;border-radius:6px;border:1px solid #333;margin-bottom:14px;box-shadow:inset 0 2px 8px rgba(0,0,0,0.8);">
        <div style="color:#2ecc71;font-family:'Courier New',monospace;font-size:12px;line-height:1.6;text-shadow:0 0 6px rgba(46,204,113,0.5);">
          STATUS: <span id="nad-status">${prtState.status.toUpperCase()}</span><br>
          PAPER: <span id="nad-paper">${prtState.paper}</span> | DPI: <span id="nad-dpi">${prtState.dpi}</span><br>
          QUEUE: <span id="nad-queue">${prtState.queue.length}</span> JOBS
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px;">
        ${mkBtn('🔌 电源', prtState.connected ? '#c0392b' : '#27ae60', 'prtConnect()')}
        ${mkBtn('🖨️ 打印', '#2980b9', 'prtPrint("NAD测试页")')}
        ${mkBtn('📋 队列', '#8e44ad', 'prtQueue()')}
        ${mkBtn('✖ 取消', '#7f8c8d', 'prtCancel()')}
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;">
        ${mkBtn('📄 纸张', '#d35400', 'prtPaper()')}
        ${mkBtn('🎯 DPI', '#16a085', 'prtQuality()')}
        ${mkBtn('🎨 墨水', '#2980b9', 'prtInk()')}
        ${mkBtn('ℹ️ 状态', '#f39c12', 'prtStatus()')}
      </div>
    </div>
  `;
  const btns = content.querySelectorAll('button');
  const actions = [
    () => { if (prtState.connected) prtDisconnect(); else prtConnect(); win.remove(); prtNad(); },
    () => { prtPrint('NAD测试页'); },
    () => { prtQueue(); },
    () => { prtCancel(); },
    () => { prtPaper(); },
    () => { prtQuality(); },
    () => { prtInk(); },
    () => { prtStatus(); }
  ];
  btns.forEach((b, i) => { b.onclick = actions[i]; b.removeAttribute('onclick'); });
  dolLog(`🖨️ NAD 打印机已打开`, 'suc');
  return true;
}

function prtConnect() {
  if (prtState.connected) { dolLog(`⚠️ 打印机已连接`, 'info'); return true; }
  prtState.connected = true;
  prtState.status = '就绪';
  dolLog(`🔌 打印机已连接 (HP LaserJet Pro M404dn)`, 'suc');
  return true;
}

function prtDisconnect() {
  if (!prtState.connected) { dolLog(`⚠️ 打印机未连接`, 'info'); return true; }
  prtState.connected = false;
  prtState.status = '离线';
  dolLog(`🔌 打印机已断开`, 'info');
  return true;
}

function prtStatus() {
  if (!prtState.connected) { dolLog(`❌ 打印机未连接`, 'err'); return true; }
  dolLog(`ℹ️ 打印机状态`, 'info');
  dolLog(`&nbsp;&nbsp;设备: HP LaserJet Pro M404dn`, 'out');
  dolLog(`&nbsp;&nbsp;状态: ${prtState.status}`, 'out');
  dolLog(`&nbsp;&nbsp;纸张: ${prtState.paper}`, 'out');
  dolLog(`&nbsp;&nbsp;DPI: ${prtState.dpi}`, 'out');
  dolLog(`&nbsp;&nbsp;色彩: ${prtState.color === 'color' ? '彩色' : '黑白'}`, 'out');
  dolLog(`&nbsp;&nbsp;队列: ${prtState.queue.length} 个任务`, 'out');
  return true;
}

function prtPrint(param) {
  if (!prtState.connected) { dolLog(`❌ 请先连接打印机: /prt/connect`, 'err'); return true; }
  const name = param || '文档';
  const job = { id: Date.now(), name: name, status: '等待中', progress: 0, time: new Date().toLocaleTimeString() };
  prtState.queue.push(job);
  dolLog(`🖨️ 已加入打印队列: ${name} (${prtState.copies}份)`, 'suc');
  setTimeout(() => processPrintQueue(), 500);
  return true;
}

function processPrintQueue() {
  if (prtState.queue.length === 0) return;
  const job = prtState.queue[0];
  if (job.status === '等待中') {
    job.status = '打印中';
    prtState.status = '打印中';
    dolLog(`🖨️ 正在打印: ${job.name}`, 'info');
  }
  job.progress += 20;
  if (job.progress >= 100) {
    job.status = '已完成';
    dolLog(`✅ 打印完成: ${job.name}`, 'suc');
    prtState.queue.shift();
    prtState.status = prtState.queue.length > 0 ? '打印中' : '就绪';
    if (prtState.queue.length > 0) setTimeout(() => processPrintQueue(), 800);
  } else {
    setTimeout(() => processPrintQueue(), 600);
  }
}

function prtQueue() {
  if (prtState.queue.length === 0) { dolLog(`📋 打印队列为空`, 'info'); return true; }
  dolLog(`📋 打印队列 (${prtState.queue.length} 个任务)`, 'info');
  prtState.queue.forEach((j, i) => {
    dolLog(`&nbsp;&nbsp;[${i+1}] ${j.name} - ${j.status} (${j.progress}%) - ${j.time}`, j.status === '打印中' ? 'suc' : 'out');
  });
  return true;
}

function prtCancel() {
  const n = prtState.queue.length;
  prtState.queue = [];
  prtState.status = prtState.connected ? '就绪' : '离线';
  if (n > 0) dolLog(`✖ 已取消 ${n} 个打印任务`, 'info');
  else dolLog(`📋 队列为空，无需取消`, 'info');
  return true;
}

function prtPaper(param) {
  if (!param) { dolLog(`📄 当前纸张: ${prtState.paper} | 可选: A4/A5/A3/Letter`, 'info'); return true; }
  const valid = ['A4', 'A5', 'A3', 'Letter'];
  if (!valid.includes(param)) { dolLog(`❌ 不支持的纸张: ${param}`, 'err'); return true; }
  prtState.paper = param;
  dolLog(`📄 纸张已设置为: ${param}`, 'suc');
  return true;
}

function prtQuality(param) {
  if (!param) { dolLog(`🎯 当前DPI: ${prtState.dpi} | 可选: 300/600/1200`, 'info'); return true; }
  const d = parseInt(param);
  if (![300, 600, 1200].includes(d)) { dolLog(`❌ 不支持的DPI: ${param}`, 'err'); return true; }
  prtState.dpi = d;
  dolLog(`🎯 打印质量已设置为: ${d} DPI`, 'suc');
  return true;
}

function prtCopies(param) {
  if (!param) { dolLog(`📄 当前份数: ${prtState.copies}`, 'info'); return true; }
  const n = parseInt(param);
  if (isNaN(n) || n < 1 || n > 99) { dolLog(`❌ 份数范围 1-99`, 'err'); return true; }
  prtState.copies = n;
  dolLog(`📄 份数已设置为: ${n}`, 'suc');
  return true;
}

function prtInk() {
  if (!prtState.connected) { dolLog(`❌ 请先连接打印机`, 'err'); return true; }
  const levels = { '黑色(BK)': 85, '青色(C)': 72, '品红(M)': 68, '黄色(Y)': 90 };
  dolLog(`🎨 墨水余量`, 'info');
  for (const [k, v] of Object.entries(levels)) {
    const bar = '█'.repeat(Math.floor(v / 10)) + '░'.repeat(10 - Math.floor(v / 10));
    dolLog(`&nbsp;&nbsp;${k}: ${bar} ${v}%`, v > 30 ? 'suc' : 'err');
  }
  return true;
}

let tblData = { rows: [['姓名', '年龄', '城市'], ['张三', '25', '北京'], ['李四', '30', '上海']], cols: 3 };

function parseTblCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/tbl/')) return false;
  const rest = cmd.substring(5);
  let action = rest, param = null;
  const sp = rest.indexOf('<');
  if (sp !== -1) {
    param = rest.substring(sp+1, rest.length - (rest.endsWith('>') ? 1 : 0));
    action = rest.substring(0, sp);
  }
  return executeTblAction(action, param);
}

function executeTblAction(action, param) {
  switch(action) {
    case 'new': return tblNew(param);
    case 'add': return tblAdd(param);
    case 'show': return tblShow();
    default: dolLog(`❌ 未知的 tbl 指令: ${action}`, 'err'); return true;
  }
}

function tblNew(param) {
  if (!param) { dolLog(`❓ 用法: /tbl/new<列数|行数|表头1,表头2...>`, 'err'); return true; }
  const parts = param.split('|');
  const cols = parseInt(parts[0]) || 3;
  const rows = parseInt(parts[1]) || 1;
  const headers = parts[2] ? parts[2].split(',').map(s => s.trim()) : Array(cols).fill('列');
  tblData.cols = cols;
  tblData.rows = [headers.slice(0, cols)];
  for (let i = 0; i < rows; i++) tblData.rows.push(Array(cols).fill(''));
  dolLog(`📊 新表格已创建 (${cols}列 x ${rows+1}行)`, 'suc');
  return true;
}

function tblAdd(param) {
  if (!param) { dolLog(`❓ 用法: /tbl/add<值1,值2,值3...>`, 'err'); return true; }
  const values = param.split(',').map(s => s.trim());
  while (values.length < tblData.cols) values.push('');
  tblData.rows.push(values.slice(0, tblData.cols));
  dolLog(`📊 已添加一行: ${values.join(' | ')}`, 'suc');
  return true;
}

function tblShow() {
  if (tblData.rows.length === 0) { dolLog(`❌ 没有表格数据，先创建: /tbl/new<3>`, 'err'); return true; }
  const win = createBaseWindow('📊 表格', 640, 480, 380, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '16px';
  content.style.overflow = 'auto';
  let html = '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
  tblData.rows.forEach((row, i) => {
    html += '<tr>';
    row.forEach(cell => {
      if (i === 0) html += `<th style="padding:8px 12px;border:1px solid #444;background:#2c3e50;color:#fff;text-align:left;">${escapeHtml(cell)}</th>`;
      else html += `<td style="padding:8px 12px;border:1px solid #444;background:${i%2===0?'#fff':'#f8f9fa'};color:#333;">${escapeHtml(cell)}</td>`;
    });
    html += '</tr>';
  });
  html += '</table>';
  html += `<div style="margin-top:10px;color:#888;font-size:12px;">共 ${tblData.rows.length-1} 条数据，${tblData.cols} 列</div>`;
  content.innerHTML = html;
  dolLog(`📊 表格已显示`, 'suc');
  return true;
}

let docData = { title: '未命名文档', content: [], cursor: 0 };

function parseDocCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/doc/')) return false;
  const rest = cmd.substring(5);
  let action = rest, param = null;
  const sp = rest.indexOf('<');
  if (sp !== -1) {
    param = rest.substring(sp+1, rest.length - (rest.endsWith('>') ? 1 : 0));
    action = rest.substring(0, sp);
  }
  return executeDocAction(action, param);
}

function executeDocAction(action, param) {
  switch(action) {
    case 'new': return docNew(param);
    case 'write': return docWrite(param);
    case 'show': return docShow();
    default: dolLog(`❌ 未知的 doc 指令: ${action}`, 'err'); return true;
  }
}

function docNew(param) {
  docData.title = param || '未命名文档';
  docData.content = [];
  dolLog(`📝 新文档已创建: ${docData.title}`, 'suc');
  return true;
}

function docWrite(param) {
  if (!param) { dolLog(`❓ 用法: /doc/write<文本内容>`, 'err'); return true; }
  docData.content.push({ type: 'p', text: param });
  dolLog(`📝 已写入: ${param.substring(0,30)}${param.length>30?'...':''}`, 'suc');
  return true;
}

function docShow() {
  if (docData.content.length === 0) { dolLog(`❌ 文档为空，先写入内容: /doc/write<内容>`, 'err'); return true; }
  const win = createBaseWindow('📝 ' + docData.title, 620, 520, 380, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '24px';
  content.style.background = '#fff';
  content.style.color = '#333';
  content.style.overflow = 'auto';
  let html = `<h1 style="font-size:20px;margin-bottom:16px;padding-bottom:10px;border-bottom:2px solid #333;">${escapeHtml(docData.title)}</h1>`;
  docData.content.forEach(item => {
    if (item.type === 'p') html += `<p style="margin-bottom:10px;line-height:1.6;font-size:14px;">${escapeHtml(item.text)}</p>`;
  });
  html += `<div style="margin-top:20px;padding-top:10px;border-top:1px solid #ddd;color:#999;font-size:12px;">共 ${docData.content.length} 段 | ${new Date().toLocaleString()}</div>`;
  content.innerHTML = html;
  dolLog(`📝 文档已显示`, 'suc');
  return true;
}

let dolGameImported = false;

function parseGameImportCmd(line) {
  const cmd = line.trim();
  const match = cmd.match(/^=import\s*&\s*use<([^>]+)>%$/);
  if (match) {
    const module = match[1].trim();
    if (module.toLowerCase() === 'game') {
      dolGameImported = true;
      dolLog(`✅ 已导入游戏模块 (game)`, 'suc');
      dolLog(`📌 可用指令: game.2d[游戏名] | game.3d[游戏名]`, 'info');
      return true;
    } else {
      dolLog(`❌ 不支持的模块: ${module}`, 'err');
      return true;
    }
  }
  return false;
}

function parseGame2dCmd(line) {
  const cmd = line.trim();
  const match = cmd.match(/^game\.2d\[([^\]]+)\]$/);
  if (match) {
    const gameName = match[1].trim();
    if (!dolGameImported) {
      dolLog(`❌ 请先导入游戏模块: =import & use<game>%`, 'err');
      return true;
    }
    dolLog(`🎮 正在创建2D游戏: ${gameName}`, 'info');
    dolLog(`📊 游戏类型: 2D平面游戏`, 'out');
    dolLog(`🎯 游戏名称: ${gameName}`, 'out');
    dolLog(`✨ 游戏画布已准备就绪`, 'suc');
    createGameWindow(gameName, '2d');
    return true;
  }
  return false;
}

function parseGame3dCmd(line) {
  const cmd = line.trim();
  const match = cmd.match(/^game\.3d\[([^\]]+)\]$/);
  if (match) {
    const gameName = match[1].trim();
    if (!dolGameImported) {
      dolLog(`❌ 请先导入游戏模块: =import & use<game>%`, 'err');
      return true;
    }
    dolLog(`🎮 正在创建3D游戏: ${gameName}`, 'info');
    dolLog(`📊 游戏类型: 3D立体游戏`, 'out');
    dolLog(`🎯 游戏名称: ${gameName}`, 'out');
    dolLog(`✨ 3D渲染引擎已启动`, 'suc');
    createGameWindow(gameName, '3d');
    return true;
  }
  return false;
}

function createGameWindow(gameName, gameType) {
  // 支持两种签名: (gameName, gameType) 或 (title, width, height, content)
  if (typeof gameType === 'number') {
    // 4参数模式: (title, width, height, content)
    const title = gameName;
    const width = gameType;
    const height = arguments[2];
    const content = arguments[3];
    const win = createBaseWindow(title, width, height, 50, 50, false, true);
    const winContent = win.querySelector('.sys-win-content');
    winContent.style.padding = '15px';
    winContent.innerHTML = content;
    return win;
  }
  
  // 2参数模式: (gameName, gameType)
  const win = createBaseWindow(`🎮 ${gameName} (${gameType.toUpperCase()})`, 800, 600, 50, 50, false, true);
  const winContent = win.querySelector('.sys-win-content');
  winContent.style.padding = '0';
  winContent.style.display = 'flex';
  winContent.style.flexDirection = 'column';
  
  if (gameType === '2d') {
    winContent.innerHTML = `
      <div style="flex:1;background:linear-gradient(180deg, #2d2d44 0%, #1a1a2e 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;">
        <div style="text-align:center;margin-bottom:30px;">
          <div style="font-size:64px;margin-bottom:16px;">🏔️</div>
          <div style="font-size:32px;color:#ffd700;font-weight:bold;margin-bottom:8px;">8848</div>
          <div style="font-size:16px;color:#888;">珠穆朗玛峰高度 - 数字猜测游戏</div>
        </div>
        <div style="background:rgba(0,0,0,0.3);padding:20px;border-radius:16px;border:1px solid rgba(255,255,255,0.1);width:100%;max-width:400px;">
          <div id="game8848Status" style="color:#5a9cf0;font-size:18px;text-align:center;margin-bottom:20px;height:24px;">猜测一个1-10000之间的数字</div>
          <input type="number" id="game8848Input" placeholder="输入数字" style="width:100%;padding:15px;font-size:24px;text-align:center;background:rgba(0,0,0,0.3);border:2px solid rgba(255,255,255,0.2);border-radius:10px;color:#fff;margin-bottom:15px;outline:none;box-sizing:border-box;" min="1" max="10000">
          <div id="game8848History" style="color:#888;font-size:12px;text-align:center;margin-bottom:15px;min-height:30px;"></div>
          <button onclick="game8848Guess()" class="sys-calc-btn" style="width:100%;font-size:18px;padding:12px;">猜!</button>
          <button onclick="game8848Reset()" class="sys-calc-btn" style="width:100%;font-size:16px;padding:10px;margin-top:8px;">重新开始</button>
        </div>
      </div>
    `;
    window.game8848Target = 8848;
    window.game8848Guesses = [];
  } else if (gameType === '3d') {
    winContent.innerHTML = `
      <div style="flex:1;background:linear-gradient(180deg, #1a1a1a 0%, #0a0a0a 100%);display:flex;align-items:center;justify-content:center;overflow:hidden;">
        <div style="width:200px;height:200px;perspective:800px;">
          <div id="cube3d" style="width:100%;height:100%;position:relative;transform-style:preserve-3d;animation:rotate3d 10s infinite linear;">
            <div style="position:absolute;width:200px;height:200px;background:linear-gradient(145deg, #5a9cf0, #3a7ccf);border:2px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:bold;backface-visibility:hidden;transform:translateZ(100px);">前</div>
            <div style="position:absolute;width:200px;height:200px;background:linear-gradient(145deg, #4ade80, #2dae60);border:2px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:bold;backface-visibility:hidden;transform:rotateY(180deg) translateZ(100px);">后</div>
            <div style="position:absolute;width:200px;height:200px;background:linear-gradient(145deg, #fbbf24, #dba520);border:2px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:bold;backface-visibility:hidden;transform:rotateY(90deg) translateZ(100px);">右</div>
            <div style="position:absolute;width:200px;height:200px;background:linear-gradient(145deg, #f87171, #d65656);border:2px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:bold;backface-visibility:hidden;transform:rotateY(-90deg) translateZ(100px);">左</div>
            <div style="position:absolute;width:200px;height:200px;background:linear-gradient(145deg, #a78bfa, #8b6cf6);border:2px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:bold;backface-visibility:hidden;transform:rotateX(90deg) translateZ(100px);">上</div>
            <div style="position:absolute;width:200px;height:200px;background:linear-gradient(145deg, #fb7185, #e14d66);border:2px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;font-weight:bold;backface-visibility:hidden;transform:rotateX(-90deg) translateZ(100px);">下</div>
          </div>
        </div>
      </div>
      <div style="height:40px;background:rgba(30,30,40,0.8);display:flex;align-items:center;padding:0 15px;gap:10px;border-top:1px solid rgba(255,255,255,0.1);">
        <button class="sys-calc-btn" style="font-size:12px;padding:5px 12px;" onclick="document.getElementById('cube3d').style.animationPlayState='running'">播放</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:5px 12px;" onclick="document.getElementById('cube3d').style.animationPlayState='paused'">暂停</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:5px 12px;" onclick="location.reload()">重置</button>
      </div>
      <style>@keyframes rotate3d {0%{transform:rotateX(0deg) rotateY(0deg);}100%{transform:rotateX(360deg) rotateY(360deg);}}</style>
    `;
  } else {
    winContent.innerHTML = `
      <div style="flex:1;background:linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);display:flex;align-items:center;justify-content:center;position:relative;">
        <div style="text-align:center;">
          <div style="font-size:48px;margin-bottom:16px;">${gameType === '3d' ? '🗺️' : '🎲'}</div>
          <div style="font-size:24px;color:#fff;font-weight:bold;margin-bottom:8px;">${gameName}</div>
          <div style="font-size:16px;color:#888;">${gameType === '3d' ? '3D 立体游戏引擎' : '2D 平面游戏引擎'}</div>
          <div style="margin-top:20px;color:#5a9cf0;font-size:14px;">游戏开发中...</div>
        </div>
      </div>
      <div style="height:40px;background:rgba(30,30,40,0.8);display:flex;align-items:center;padding:0 15px;gap:10px;border-top:1px solid rgba(255,255,255,0.1);">
        <button class="sys-calc-btn" style="font-size:12px;padding:5px 12px;" onclick="dolLog('▶️ 游戏开始', 'suc')">开始</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:5px 12px;" onclick="dolLog('⏸️ 游戏暂停', 'info')">暂停</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:5px 12px;" onclick="dolLog('🔄 游戏重置', 'info')">重置</button>
      </div>
    `;
  }
}

function game8848Guess() {
  const input = document.getElementById('game8848Input');
  const status = document.getElementById('game8848Status');
  const history = document.getElementById('game8848History');
  const guess = parseInt(input.value);
  
  if (isNaN(guess) || guess < 1 || guess > 10000) {
    status.textContent = '请输入1-10000之间的数字';
    status.style.color = '#f87171';
    return;
  }
  
  window.game8848Guesses.push(guess);
  
  if (guess === window.game8848Target) {
    status.textContent = `🎉 恭喜！猜对了！8848！用了${window.game8848Guesses.length}次`;
    status.style.color = '#4ade80';
    input.disabled = true;
    playSound('success');
  } else if (guess < window.game8848Target) {
    status.textContent = '⬆️ 太低了！再试试';
    status.style.color = '#fbbf24';
    playSound('click');
  } else {
    status.textContent = '⬇️ 太高了！再试试';
    status.style.color = '#f87171';
    playSound('click');
  }
  
  history.textContent = '历史记录: ' + window.game8848Guesses.join(', ');
  input.value = '';
}

function game8848Reset() {
  const input = document.getElementById('game8848Input');
  const status = document.getElementById('game8848Status');
  const history = document.getElementById('game8848History');
  
  input.disabled = false;
  input.value = '';
  status.textContent = '猜测一个1-10000之间的数字';
  status.style.color = '#5a9cf0';
  history.textContent = '';
  window.game8848Guesses = [];
}

function parseCustomCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 创建自定义元素
  const createMatch = line.match(/^\/nb\/element<([^>]+)>id<([^>]+)>/);
  if (createMatch) {
    const type = createMatch[1];
    const id = createMatch[2];
    const el = document.createElement(type);
    el.id = id;
    el.style.position = 'absolute';
    document.body.appendChild(el);
    allComponents.push(el);
    customElements[id] = el;
    dolLog(`✅ 已创建元素: ${type}#${id}`, 'suc');
    return true;
  }
  
  // 2. 设置元素样式
  const styleMatch = line.match(/^\/nb\/style<([^>]+)>prop<([^>]+)>val<([^>]+)>/);
  if (styleMatch && customElements[styleMatch[1]]) {
    customElements[styleMatch[1]].style[styleMatch[2]] = styleMatch[3];
    dolLog(`✅ 元素 ${styleMatch[1]} 样式 ${styleMatch[2]} = ${styleMatch[3]}`, 'suc');
    return true;
  }
  
  // 3. 设置元素属性
  const attrMatch = line.match(/^\/nb\/attr<([^>]+)>name<([^>]+)>val<([^>]+)>/);
  if (attrMatch && customElements[attrMatch[1]]) {
    customElements[attrMatch[1]].setAttribute(attrMatch[2], attrMatch[3]);
    dolLog(`✅ 元素 ${attrMatch[1]} 属性 ${attrMatch[2]} = ${attrMatch[3]}`, 'suc');
    return true;
  }
  
  // 4. 绑定事件（支持缩进格式    <指令内容>）
  const eventMatch = line.match(/^\/nb\/event<([^>]+)>type<([^>]+)>cmd<([^>]+)>/);
  if (eventMatch && customElements[eventMatch[1]]) {
    customElements[eventMatch[1]].addEventListener(eventMatch[2], () => {
      const cmd = eventMatch[3];
      // 支持缩进格式    <指令内容>，提取内部指令
      const inlineMatch = cmd.match(/^\s*-\+-<([^>]+)>\s*$/);
      if (inlineMatch) {
        executeSingleLine(inlineMatch[1]);
      } else {
        executeSingleLine(cmd);
      }
    });
    dolLog(`✅ 元素 ${eventMatch[1]} 已绑定 ${eventMatch[2]} 事件`, 'suc');
    return true;
  }
  
  // 5. 添加子元素
  const appendMatch = line.match(/^\/nb\/append<([^>]+)>child<([^>]+)>/);
  if (appendMatch && customElements[appendMatch[1]] && customElements[appendMatch[2]]) {
    customElements[appendMatch[1]].appendChild(customElements[appendMatch[2]]);
    dolLog(`✅ 已将 ${appendMatch[2]} 添加到 ${appendMatch[1]}`, 'suc');
    return true;
  }
  
  // 6. 删除元素
  const removeMatch = line.match(/^\/nb\/remove<([^>]+)>/);
  if (removeMatch && customElements[removeMatch[1]]) {
    customElements[removeMatch[1]].remove();
    const idx = allComponents.indexOf(customElements[removeMatch[1]]);
    if (idx > -1) allComponents.splice(idx, 1);
    delete customElements[removeMatch[1]];
    dolLog(`✅ 已删除元素 ${removeMatch[1]}`, 'suc');
    return true;
  }
  
  // 7. 克隆元素
  const cloneMatch = line.match(/^\/nb\/clone<([^>]+)>new<([^>]+)>/);
  if (cloneMatch && customElements[cloneMatch[1]]) {
    const clone = customElements[cloneMatch[1]].cloneNode(true);
    clone.id = cloneMatch[2];
    document.body.appendChild(clone);
    allComponents.push(clone);
    customElements[cloneMatch[2]] = clone;
    dolLog(`✅ 已克隆元素 ${cloneMatch[1]} → ${cloneMatch[2]}`, 'suc');
    return true;
  }
  
  // 8. 设置HTML内容
  const htmlMatch = line.match(/^\/nb\/html<([^>]+)>content<([^>]+)>/);
  if (htmlMatch && customElements[htmlMatch[1]]) {
    customElements[htmlMatch[1]].innerHTML = htmlMatch[2];
    dolLog(`✅ 元素 ${htmlMatch[1]} HTML已更新`, 'suc');
    return true;
  }
  
  // 9. 设置文本内容
  const textMatch = line.match(/^\/nb\/text<([^>]+)>content<([^>]+)>/);
  if (textMatch && customElements[textMatch[1]]) {
    customElements[textMatch[1]].textContent = textMatch[2];
    dolLog(`✅ 元素 ${textMatch[1]} 文本已更新`, 'suc');
    return true;
  }
  
  // 10. 隐藏元素
  const hideMatch = line.match(/^\/nb\/hide<([^>]+)>/);
  if (hideMatch && customElements[hideMatch[1]]) {
    customElements[hideMatch[1]].style.display = 'none';
    dolLog(`✅ 元素 ${hideMatch[1]} 已隐藏`, 'suc');
    return true;
  }
  
  // 11. 显示元素
  const showMatch = line.match(/^\/nb\/show<([^>]+)>/);
  if (showMatch && customElements[showMatch[1]]) {
    customElements[showMatch[1]].style.display = '';
    dolLog(`✅ 元素 ${showMatch[1]} 已显示`, 'suc');
    return true;
  }
  
  // 12. 切换显示/隐藏
  const toggleMatch = line.match(/^\/nb\/toggle<([^>]+)>/);
  if (toggleMatch && customElements[toggleMatch[1]]) {
    const el = customElements[toggleMatch[1]];
    el.style.display = el.style.display === 'none' ? '' : 'none';
    dolLog(`✅ 元素 ${toggleMatch[1]} 显示状态已切换`, 'suc');
    return true;
  }
  
  // 13. 执行动画
  const animMatch = line.match(/^\/nb\/animate<([^>]+)>type<([^>]+)>dur<(\d+)>/);
  if (animMatch && customElements[animMatch[1]]) {
    const el = customElements[animMatch[1]];
    const animType = animMatch[2];
    const duration = parseInt(animMatch[3]);
    
    el.style.transition = `all ${duration}ms ease`;
    
    switch(animType) {
      case 'slideInLeft': el.style.transform = 'translateX(-100%)'; setTimeout(() => el.style.transform = 'translateX(0)', 10); break;
      case 'slideInRight': el.style.transform = 'translateX(100%)'; setTimeout(() => el.style.transform = 'translateX(0)', 10); break;
      case 'slideInTop': el.style.transform = 'translateY(-100%)'; setTimeout(() => el.style.transform = 'translateY(0)', 10); break;
      case 'slideInBottom': el.style.transform = 'translateY(100%)'; setTimeout(() => el.style.transform = 'translateY(0)', 10); break;
      case 'fadeIn': el.style.opacity = '0'; setTimeout(() => el.style.opacity = '1', 10); break;
      case 'scaleIn': el.style.transform = 'scale(0)'; setTimeout(() => el.style.transform = 'scale(1)', 10); break;
      case 'rotateIn': el.style.transform = 'rotate(-180deg) scale(0)'; setTimeout(() => el.style.transform = 'rotate(0) scale(1)', 10); break;
      default: dolLog(`❌ 未知动画类型: ${animType}`, 'err'); return true;
    }
    
    dolLog(`✅ 元素 ${animMatch[1]} 动画 "${animType}" 已执行`, 'suc');
    return true;
  }
  
  // 14. 获取属性值
  const getMatch = line.match(/^\/nb\/get<([^>]+)>prop<([^>]+)>/);
  if (getMatch && customElements[getMatch[1]]) {
    const value = customElements[getMatch[1]][getMatch[2]] || customElements[getMatch[1]].getAttribute(getMatch[2]);
    dolLog(`📊 元素 ${getMatch[1]} 的 ${getMatch[2]} = ${value}`, 'out');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【3D制作指令 /3d/】 ==========
// ==================================================
// 职业分类: 建模师 | 雕刻师 | 材质师 | 动画师 | 灯光师 | 渲染师
// 【建模师】 cube, sphere, torus, cone, cylinder, plane, pyramid, prism, hexagon,
//            octahedron, dodecahedron, icosahedron, tetrahedron, ellipse, capsule,
//            ring, gear, star, heart, diamond, position, rotate, scale, color, segments
// 【雕刻师】 sculpt_push, sculpt_pull, sculpt_smooth, sculpt_pinch, sculpt_flatten,
//            sculpt_inflate, sculpt_grab, sculpt_crease, sculpt_size, sculpt_strength
// 【材质师】 texture, material, metalness, roughness, opacity, emissive, tiling, wireframe
// 【动画师】 animate_rotate, animate_bounce, animate_pulse, animate_spin, animate_wave,
//            animate_speed, animate_pause, animate_stop
// 【灯光师】 light_ambient, light_directional, light_point, light_spot, light_intensity,
//            light_color, shadow, background
// 【渲染师】 render_image, render_quality, render_antialias, save, load, export_obj, export_stl
// 职业切换: job_modeler, job_sculptor, job_texture, job_animator, job_lighter, job_renderer, job_all, jobs

let scene3d = {
  win: null,
  container: null,
  rotation: { x: 30, y: 45, z: 0 },
  color: '#5a9cf0',
  model: 'cube',
  size: 100,
  texture: null,
  textureImage: null,
  wireframe: false,
  scale: 1,
  job: 'all',
  position: { x: 0, y: 0, z: 0 },
  segments: 32,
  animation: {
    active: false,
    type: null,
    speed: 1,
    paused: false,
    time: 0
  },
  animInterval: null,
  sculpt: {
    size: 1.5,
    strength: 0.3,
    soft: true
  },
  material: {
    type: 'standard',
    metalness: 0,
    roughness: 0.5,
    opacity: 1,
    emissive: '#000000',
    tiling: 1
  },
  lighting: {
    ambient: { color: '#ffffff', intensity: 0.5 },
    directional: { color: '#ffffff', intensity: 0.8, x: 1, y: 1, z: 1 },
    point: { color: '#ffffff', intensity: 0, x: 0, y: 5, z: 0 },
    spot: { color: '#ffffff', intensity: 0, x: 0, y: 10, z: 0 },
    shadow: false
  },
  background: '#0a0a0f',
  render: {
    quality: 'medium',
    antialias: true,
    shadowQuality: 'low'
  }
};

function parse3dCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/3d/')) return false;
  const rest = cmd.substring(4);
  let action = rest, param = null;
  const sp = rest.indexOf('<');
  if (sp !== -1) {
    param = rest.substring(sp+1, rest.length - (rest.endsWith('>') ? 1 : 0));
    action = rest.substring(0, sp);
  }
  return execute3dAction(action, param);
}

function execute3dAction(action, param) {
  switch(action) {
    case 'cube': return create3dCube(param);
    case 'sphere': return create3dSphere(param);
    case 'torus': return create3dTorus(param);
    case 'cone': return create3dCone(param);
    case 'cylinder': return create3dCylinder(param);
    case 'rotate': return set3dRotation(param);
    case 'color': return set3dColor(param);
    case 'open': return open3dWindow();
    case 'embed': return embed3dScene();
    case 'reset': return reset3dScene();
    case 'save': return save3dModel(param);
    case 'load': return load3dModel(param);
    case 'texture': return set3dTexture(param);
    case 'wireframe': return toggle3dWireframe();
    case 'scale': return set3dScale(param);
    case 'plane': return create3dPlane(param);
    case 'pyramid': return create3dPyramid(param);
    case 'prism': return create3dPrism(param);
    case 'hexagon': return create3dHexagon(param);
    case 'octahedron': return create3dOctahedron(param);
    case 'dodecahedron': return create3dDodecahedron(param);
    case 'icosahedron': return create3dIcosahedron(param);
    case 'tetrahedron': return create3dTetrahedron(param);
    case 'ellipse': return create3dEllipse(param);
    case 'capsule': return create3dCapsule(param);
    case 'ring': return create3dRing(param);
    case 'gear': return create3dGear(param);
    case 'star': return create3dStar(param);
    case 'heart': return create3dHeart(param);
    case 'diamond': return create3dDiamond(param);
    case 'position': return set3dPosition(param);
    case 'segments': return set3dSegments(param);
    case 'sculpt_push': return sculpt3dPush(param);
    case 'sculpt_pull': return sculpt3dPull(param);
    case 'sculpt_smooth': return sculpt3dSmooth(param);
    case 'sculpt_pinch': return sculpt3dPinch(param);
    case 'sculpt_flatten': return sculpt3dFlatten(param);
    case 'sculpt_inflate': return sculpt3dInflate(param);
    case 'sculpt_grab': return sculpt3dGrab(param);
    case 'sculpt_crease': return sculpt3dCrease(param);
    case 'sculpt_size': return set3dSculptSize(param);
    case 'sculpt_strength': return set3dSculptStrength(param);
    case 'material': return set3dMaterial(param);
    case 'metalness': return set3dMetalness(param);
    case 'roughness': return set3dRoughness(param);
    case 'opacity': return set3dOpacity(param);
    case 'emissive': return set3dEmissive(param);
    case 'tiling': return set3dTiling(param);
    case 'animate_rotate': return animate3dRotate(param);
    case 'animate_bounce': return animate3dBounce(param);
    case 'animate_pulse': return animate3dPulse(param);
    case 'animate_spin': return animate3dSpin(param);
    case 'animate_wave': return animate3dWave(param);
    case 'animate_speed': return set3dAnimSpeed(param);
    case 'animate_stop': return stop3dAnimation();
    case 'animate_pause': return pause3dAnimation();
    case 'light_ambient': return set3dAmbientLight(param);
    case 'light_directional': return set3dDirectionalLight(param);
    case 'light_point': return set3dPointLight(param);
    case 'light_spot': return set3dSpotLight(param);
    case 'light_intensity': return set3dLightIntensity(param);
    case 'light_color': return set3dLightColor(param);
    case 'shadow': return toggle3dShadow(param);
    case 'background': return set3dBackground(param);
    case 'render_image': return render3dImage(param);
    case 'render_quality': return set3dRenderQuality(param);
    case 'render_antialias': return toggle3dAntialias(param);
    case 'export_obj': return export3dObj(param);
    case 'export_stl': return export3dStl(param);
    case 'job_modeler': return set3dJob('modeler');
    case 'job_sculptor': return set3dJob('sculptor');
    case 'job_texture': return set3dJob('texture');
    case 'job_animator': return set3dJob('animator');
    case 'job_lighter': return set3dJob('lighter');
    case 'job_renderer': return set3dJob('renderer');
    case 'job_all': return set3dJob('all');
    case 'jobs': return list3dJobs();
    default: dolLog(`❌ 未知的 3d 指令: ${action}`, 'err'); return true;
  }
}

function open3dWindow() {
  if (scene3d.win && document.body.contains(scene3d.win)) {
    scene3d.win.remove();
  }
  scene3d.win = createBaseWindow('🎲 3D制作工作室', 800, 600, 200, 100, false, true);
  const content = scene3d.win.querySelector('.sys-win-content');
  content.style.padding = '10px';
  content.style.background = '#0a0a0f';
  content.style.display = 'flex';
  content.style.gap = '10px';
  content.innerHTML = `
    <div style="flex:1;background:#000;border-radius:8px;overflow:hidden;position:relative;">
      <canvas id="scene3dCanvas" style="width:100%;height:100%;"></canvas>
      <div style="position:absolute;top:10px;left:10px;color:#fff;font-size:12px;background:rgba(0,0,0,0.7);padding:5px 10px;border-radius:4px;">
        🎲 ${scene3d.model.toUpperCase()} | ${scene3d.color}
      </div>
    </div>
    <div style="width:200px;background:#1a1a24;border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:10px;overflow-y:auto;max-height:540px;">
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;">🎨 模型类型</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dCube('100')">🟦 立方体</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dSphere('50')">🔵 球体</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dTorus('40')">⭕ 圆环</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dCone('50*100')">🔺 圆锥</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dCylinder('50*100')">🔷 圆柱</button>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🎨 颜色</div>
      <input type="color" id="scene3dColor" value="${scene3d.color}" oninput="set3dColor(this.value)" style="width:100%;height:30px;border:none;border-radius:4px;cursor:pointer;">
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🔄 旋转角度</div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="0" max="360" value="${scene3d.rotation.x}" oninput="update3dRotation('x', this.value)" style="flex:1;">
        <span style="color:#888;font-size:11px;">X</span>
      </div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="0" max="360" value="${scene3d.rotation.y}" oninput="update3dRotation('y', this.value)" style="flex:1;">
        <span style="color:#888;font-size:11px;">Y</span>
      </div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="0" max="360" value="${scene3d.rotation.z}" oninput="update3dRotation('z', this.value)" style="flex:1;">
        <span style="color:#888;font-size:11px;">Z</span>
      </div>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">📐 缩放</div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="10" max="300" value="${scene3d.scale * 100}" oninput="set3dScale(this.value/100)" style="flex:1;">
        <span style="color:#888;font-size:11px;">${scene3d.scale}x</span>
      </div>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🎭 纹理</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="set3dTexture()">📷 加载纹理</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="set3dTexture('none')">❌ 移除纹理</button>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🔲 模式</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="toggle3dWireframe()">${scene3d.wireframe ? '🔲 实体模式' : '🕸️ 线框模式'}</button>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">💾 保存/加载</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="save3dModel()">💾 保存模型</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="load3dModel()">📂 加载模型</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;margin-top:auto;" onclick="reset3dScene()">🔄 重置</button>
    </div>
  `;
  setTimeout(() => init3dRenderer(), 100);
  dolLog(`✅ 3D制作窗口已打开`, 'suc');
  return true;
}

function init3dRenderer() {
  const canvas = document.getElementById('scene3dCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const rect = canvas.getBoundingClientRect();
  canvas.width = rect.width;
  canvas.height = rect.height;
  scene3d.ctx = ctx;
  render3dModel();
}

function render3dModel() {
  if (!scene3d.ctx) return;
  const ctx = scene3d.ctx;
  const width = ctx.canvas.width;
  const height = ctx.canvas.height;
  ctx.clearRect(0, 0, width, height);
  
  ctx.save();
  ctx.translate(width / 2 + (scene3d.position.x || 0), height / 2 + (scene3d.position.y || 0));
  ctx.scale(2 * scene3d.scale, 2 * scene3d.scale);
  
  ctx.fillStyle = scene3d.color;
  ctx.strokeStyle = 'rgba(255,255,255,0.3)';
  ctx.lineWidth = scene3d.wireframe ? 2 : 1;
  
  const rx = scene3d.rotation.x * Math.PI / 180;
  const ry = scene3d.rotation.y * Math.PI / 180;
  const rz = scene3d.rotation.z * Math.PI / 180;
  
  const size = scene3d.size;
  
  ctx.rotate(rz);
  
  function project(x, y, z) {
    const cosx = Math.cos(rx), sinx = Math.sin(rx);
    const cosy = Math.cos(ry), siny = Math.sin(ry);
    const y1 = y * cosx - z * sinx;
    const z1 = y * sinx + z * cosx;
    const x1 = x * cosy + z1 * siny;
    const z2 = -x * siny + z1 * cosy;
    const scale = 300 / (300 + z2);
    return { x: x1 * scale, y: y1 * scale, z: z2 };
  }
  
  function drawFace(points) {
    ctx.beginPath();
    const p0 = project(points[0][0], points[0][1], points[0][2]);
    ctx.moveTo(p0.x, p0.y);
    for (let i = 1; i < points.length; i++) {
      const p = project(points[i][0], points[i][1], points[i][2]);
      ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    if (!scene3d.wireframe) {
      if (scene3d.textureImage) {
        ctx.save();
        const img = scene3d.textureImage;
        ctx.clip();
        ctx.drawImage(img, -size/2, -size/2, size, size);
        ctx.restore();
      } else {
        ctx.fill();
      }
    }
    ctx.stroke();
  }
  
  function drawCube(s) {
    const hs = s / 2;
    const faces = [
      [[-hs,-hs,-hs],[hs,-hs,-hs],[hs,hs,-hs],[-hs,hs,-hs]],
      [[-hs,-hs,hs],[hs,-hs,hs],[hs,hs,hs],[-hs,hs,hs]],
      [[-hs,-hs,-hs],[-hs,hs,-hs],[-hs,hs,hs],[-hs,-hs,hs]],
      [[hs,-hs,-hs],[hs,hs,-hs],[hs,hs,hs],[hs,-hs,hs]],
      [[-hs,-hs,-hs],[-hs,-hs,hs],[hs,-hs,hs],[hs,-hs,-hs]],
      [[-hs,hs,-hs],[-hs,hs,hs],[hs,hs,hs],[hs,hs,-hs]]
    ];
    faces.forEach(face => drawFace(face));
  }
  
  function drawSphere(r) {
    const rings = 16;
    const segments = 32;
    for (let i = 0; i < rings; i++) {
      const lat1 = (i / rings) * Math.PI;
      const lat2 = ((i + 1) / rings) * Math.PI;
      ctx.beginPath();
      for (let j = 0; j <= segments; j++) {
        const lng = (j / segments) * Math.PI * 2;
        const x = r * Math.sin(lat1) * Math.cos(lng);
        const y = r * Math.cos(lat1);
        const z = r * Math.sin(lat1) * Math.sin(lng);
        const p = project(x, y, z);
        if (j === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
    }
    for (let j = 0; j < segments; j++) {
      const lng1 = (j / segments) * Math.PI * 2;
      const lng2 = ((j + 1) / segments) * Math.PI * 2;
      ctx.beginPath();
      for (let i = 0; i <= rings; i++) {
        const lat = (i / rings) * Math.PI;
        const x = r * Math.sin(lat) * Math.cos(lng1);
        const y = r * Math.cos(lat);
        const z = r * Math.sin(lat) * Math.sin(lng1);
        const p = project(x, y, z);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
    }
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.8, 0, Math.PI * 2);
    if (!scene3d.wireframe) {
      if (scene3d.textureImage) {
        ctx.save();
        ctx.clip();
        ctx.drawImage(scene3d.textureImage, -r, -r, r * 2, r * 2);
        ctx.restore();
      } else {
        ctx.fill();
      }
    }
  }
  
  function drawTorus(r, tr = r * 0.3) {
    const segments = 32;
    const rings = 16;
    for (let i = 0; i < rings; i++) {
      const phi = (i / rings) * Math.PI * 2;
      ctx.beginPath();
      for (let j = 0; j <= segments; j++) {
        const theta = (j / segments) * Math.PI * 2;
        const x = (r + tr * Math.cos(theta)) * Math.cos(phi);
        const y = (r + tr * Math.cos(theta)) * Math.sin(phi);
        const z = tr * Math.sin(theta);
        const p = project(x, y, z);
        if (j === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
    }
    for (let j = 0; j < segments; j++) {
      const theta = (j / segments) * Math.PI * 2;
      ctx.beginPath();
      for (let i = 0; i <= rings; i++) {
        const phi = (i / rings) * Math.PI * 2;
        const x = (r + tr * Math.cos(theta)) * Math.cos(phi);
        const y = (r + tr * Math.cos(theta)) * Math.sin(phi);
        const z = tr * Math.sin(theta);
        const p = project(x, y, z);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
    }
    if (!scene3d.wireframe) {
      ctx.beginPath();
      ctx.arc(0, 0, r + tr * 0.5, 0, Math.PI * 2);
      ctx.arc(0, 0, r - tr * 0.5, 0, Math.PI * 2, true);
      ctx.closePath();
      if (scene3d.textureImage) {
        ctx.save();
        ctx.clip();
        ctx.drawImage(scene3d.textureImage, -(r + tr), -(r + tr), (r + tr) * 2, (r + tr) * 2);
        ctx.restore();
      } else {
        ctx.fill();
      }
    }
  }
  
  function drawCone(r, h) {
    ctx.beginPath();
    for (let i = 0; i <= 32; i++) {
      const theta = (i / 32) * Math.PI * 2;
      const x = r * Math.cos(theta);
      const z = r * Math.sin(theta);
      const p = project(x, -h/2, z);
      if (i === 0) ctx.moveTo(p.x, p.y);
      else ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    if (!scene3d.wireframe) {
      if (scene3d.textureImage) {
        ctx.save();
        ctx.clip();
        ctx.drawImage(scene3d.textureImage, -r, -h/2, r * 2, h);
        ctx.restore();
      } else {
        ctx.fill();
      }
    }
    ctx.stroke();
    
    for (let i = 0; i < 32; i += 4) {
      const theta = (i / 32) * Math.PI * 2;
      const x = r * Math.cos(theta);
      const z = r * Math.sin(theta);
      const p1 = project(x, -h/2, z);
      const p2 = project(0, h/2, 0);
      ctx.beginPath();
      ctx.moveTo(p1.x, p1.y);
      ctx.lineTo(p2.x, p2.y);
      ctx.stroke();
    }
  }
  
  function drawCylinder(r, h) {
    for (let i = 0; i <= 32; i++) {
      const theta = (i / 32) * Math.PI * 2;
      const x = r * Math.cos(theta);
      const z = r * Math.sin(theta);
      const p1 = project(x, -h/2, z);
      const p2 = project(x, h/2, z);
      ctx.beginPath();
      ctx.moveTo(p1.x, p1.y);
      ctx.lineTo(p2.x, p2.y);
      ctx.stroke();
    }
    
    ctx.beginPath();
    for (let i = 0; i <= 32; i++) {
      const theta = (i / 32) * Math.PI * 2;
      const x = r * Math.cos(theta);
      const z = r * Math.sin(theta);
      const p = project(x, -h/2, z);
      if (i === 0) ctx.moveTo(p.x, p.y);
      else ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    if (!scene3d.wireframe) {
      if (scene3d.textureImage) {
        ctx.save();
        ctx.clip();
        ctx.drawImage(scene3d.textureImage, -r, -h/2, r * 2, h);
        ctx.restore();
      } else {
        ctx.fill();
      }
    }
    ctx.stroke();
    
    ctx.beginPath();
    for (let i = 0; i <= 32; i++) {
      const theta = (i / 32) * Math.PI * 2;
      const x = r * Math.cos(theta);
      const z = r * Math.sin(theta);
      const p = project(x, h/2, z);
      if (i === 0) ctx.moveTo(p.x, p.y);
      else ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    if (!scene3d.wireframe) {
      if (scene3d.textureImage) {
        ctx.save();
        ctx.clip();
        ctx.drawImage(scene3d.textureImage, -r, -h/2, r * 2, h);
        ctx.restore();
      } else {
        ctx.fill();
      }
    }
    ctx.stroke();
  }
  
  switch(scene3d.model) {
    case 'cube': drawCube(size); break;
    case 'sphere': drawSphere(size / 2); break;
    case 'torus': drawTorus(size / 2); break;
    case 'cone': drawCone(size / 2, size); break;
    case 'cylinder': drawCylinder(size / 2, size); break;
  }
  
  ctx.restore();
}

function create3dCube(param) {
  scene3d.model = 'cube';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D立方体 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function create3dSphere(param) {
  scene3d.model = 'sphere';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D球体 (半径: ${scene3d.size / 2})`, 'suc');
  render3dModel();
  return true;
}

function create3dTorus(param) {
  scene3d.model = 'torus';
  scene3d.size = parseInt(param) || 80;
  dolLog(`✅ 创建3D圆环 (半径: ${scene3d.size / 2})`, 'suc');
  render3dModel();
  return true;
}

function create3dCone(param) {
  scene3d.model = 'cone';
  const parts = (param || '50*100').split('*');
  scene3d.size = parseInt(parts[1]) || 100;
  dolLog(`✅ 创建3D圆锥 (半径: ${parts[0]}, 高度: ${parts[1]})`, 'suc');
  render3dModel();
  return true;
}

function create3dCylinder(param) {
  scene3d.model = 'cylinder';
  const parts = (param || '50*100').split('*');
  scene3d.size = parseInt(parts[1]) || 100;
  dolLog(`✅ 创建3D圆柱 (半径: ${parts[0]}, 高度: ${parts[1]})`, 'suc');
  render3dModel();
  return true;
}

function set3dRotation(param) {
  if (!param) {
    dolLog(`🔄 当前旋转: X=${scene3d.rotation.x} Y=${scene3d.rotation.y} Z=${scene3d.rotation.z}`, 'info');
    return true;
  }
  const parts = param.split('*');
  if (parts.length === 3) {
    scene3d.rotation.x = parseInt(parts[0]) || 0;
    scene3d.rotation.y = parseInt(parts[1]) || 0;
    scene3d.rotation.z = parseInt(parts[2]) || 0;
    dolLog(`🔄 旋转角度已设置: X=${scene3d.rotation.x} Y=${scene3d.rotation.y} Z=${scene3d.rotation.z}`, 'suc');
    render3dModel();
  } else {
    dolLog(`❌ 用法: /3d/rotate<X>*<Y>*<Z>`, 'err');
  }
  return true;
}

function update3dRotation(axis, value) {
  scene3d.rotation[axis] = parseInt(value);
  render3dModel();
}

function set3dColor(param) {
  if (!param) {
    dolLog(`🎨 当前颜色: ${scene3d.color}`, 'info');
    return true;
  }
  scene3d.color = param;
  dolLog(`🎨 颜色已设置为: ${param}`, 'suc');
  render3dModel();
  return true;
}

function embed3dScene() {
  const html = `
    <div style="margin:8px 0;padding:12px;background:#0a0a0f;border-radius:8px;border:1px solid #333;">
      <div style="color:#5a9cf0;font-size:14px;margin-bottom:8px;">🎲 3D场景</div>
      <canvas id="embed3dCanvas" style="width:100%;height:300px;background:#000;border-radius:6px;"></canvas>
    </div>
  `;
  showInlineUI(html);
  setTimeout(() => {
    const canvas = document.getElementById('embed3dCanvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
      scene3d.ctx = ctx;
      render3dModel();
    }
  }, 100);
  dolLog(`✅ 3D场景已嵌入页面`, 'suc');
  return true;
}

function reset3dScene() {
  scene3d.rotation = { x: 30, y: 45, z: 0 };
  scene3d.color = '#5a9cf0';
  scene3d.model = 'cube';
  scene3d.size = 100;
  if (scene3d.win) {
    const colorInput = scene3d.win.querySelector('#scene3dColor');
    if (colorInput) colorInput.value = scene3d.color;
    const ranges = scene3d.win.querySelectorAll('input[type="range"]');
    if (ranges[0]) ranges[0].value = scene3d.rotation.x;
    if (ranges[1]) ranges[1].value = scene3d.rotation.y;
    if (ranges[2]) ranges[2].value = scene3d.rotation.z;
  }
  render3dModel();
  dolLog(`🔄 3D场景已重置`, 'info');
  return true;
}

function save3dModel(param) {
  const modelData = {
    model: scene3d.model,
    size: scene3d.size,
    color: scene3d.color,
    rotation: scene3d.rotation,
    texture: scene3d.texture,
    wireframe: scene3d.wireframe,
    scale: scene3d.scale,
    version: '1.0',
    savedAt: new Date().toISOString()
  };
  
  const fileName = param || `model_${Date.now()}.3dmodel`;
  const blob = new Blob([JSON.stringify(modelData, null, 2)], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = fileName;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  
  dolLog(`💾 3D模型已保存为: ${fileName}`, 'suc');
  return true;
}

function load3dModel(param) {
  if (!param) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.3dmodel,.json';
    input.onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        try {
          const data = JSON.parse(ev.target.result);
          scene3d.model = data.model || 'cube';
          scene3d.size = data.size || 100;
          scene3d.color = data.color || '#5a9cf0';
          scene3d.rotation = data.rotation || { x: 30, y: 45, z: 0 };
          scene3d.texture = data.texture || null;
          scene3d.wireframe = data.wireframe || false;
          scene3d.scale = data.scale || 1;
          
          if (scene3d.texture) {
            const img = new Image();
            img.onload = () => {
              scene3d.textureImage = img;
              render3dModel();
            };
            img.src = scene3d.texture;
          }
          
          render3dModel();
          update3dUI();
          dolLog(`✅ 3D模型已加载: ${file.name}`, 'suc');
        } catch (err) {
          dolLog(`❌ 加载模型失败: ${err.message}`, 'err');
        }
      };
      reader.readAsText(file);
    };
    input.click();
  } else {
    try {
      const data = JSON.parse(param);
      scene3d.model = data.model || 'cube';
      scene3d.size = data.size || 100;
      scene3d.color = data.color || '#5a9cf0';
      scene3d.rotation = data.rotation || { x: 30, y: 45, z: 0 };
      scene3d.texture = data.texture || null;
      scene3d.wireframe = data.wireframe || false;
      scene3d.scale = data.scale || 1;
      
      if (scene3d.texture) {
        const img = new Image();
        img.onload = () => {
          scene3d.textureImage = img;
          render3dModel();
        };
        img.src = scene3d.texture;
      }
      
      render3dModel();
      update3dUI();
      dolLog(`✅ 3D模型已从数据加载`, 'suc');
    } catch (err) {
      dolLog(`❌ 加载模型失败: ${err.message}`, 'err');
    }
  }
  return true;
}

function set3dTexture(param) {
  if (!param) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const img = new Image();
        img.onload = () => {
          scene3d.texture = ev.target.result;
          scene3d.textureImage = img;
          render3dModel();
          dolLog(`✅ 纹理已加载: ${file.name}`, 'suc');
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    };
    input.click();
  } else if (param === 'none') {
    scene3d.texture = null;
    scene3d.textureImage = null;
    render3dModel();
    dolLog(`✅ 纹理已移除`, 'suc');
  } else {
    const img = new Image();
    img.onload = () => {
      scene3d.texture = param;
      scene3d.textureImage = img;
      render3dModel();
      dolLog(`✅ 纹理已加载: ${param}`, 'suc');
    };
    img.onerror = () => {
      dolLog(`❌ 无法加载纹理: ${param}`, 'err');
    };
    img.src = param;
  }
  return true;
}

function toggle3dWireframe() {
  scene3d.wireframe = !scene3d.wireframe;
  render3dModel();
  if (scene3d.win) {
    const buttons = scene3d.win.querySelectorAll('button');
    buttons.forEach(btn => {
      if (btn.textContent.includes('线框模式') || btn.textContent.includes('实体模式')) {
        btn.textContent = scene3d.wireframe ? '🔲 实体模式' : '🕸️ 线框模式';
      }
    });
  }
  dolLog(`🔲 线框模式: ${scene3d.wireframe ? '开启' : '关闭'}`, 'info');
  return true;
}

function set3dScale(param) {
  const scale = parseFloat(param);
  if (isNaN(scale) || scale <= 0 || scale > 3) {
    dolLog(`❌ 缩放范围: 0.1-3`, 'err');
    return true;
  }
  scene3d.scale = scale;
  render3dModel();
  dolLog(`📐 缩放比例已设置为: ${scale}x`, 'suc');
  return true;
}

function update3dUI() {
  if (!scene3d.win) return;
  const colorInput = scene3d.win.querySelector('#scene3dColor');
  if (colorInput) colorInput.value = scene3d.color;
  const ranges = scene3d.win.querySelectorAll('input[type="range"]');
  if (ranges[0]) ranges[0].value = scene3d.rotation.x;
  if (ranges[1]) ranges[1].value = scene3d.rotation.y;
  if (ranges[2]) ranges[2].value = scene3d.rotation.z;
}

function set3dJob(job) {
  scene3d.job = job;
  const jobNames = {
    modeler: '建模师',
    sculptor: '雕刻师',
    texture: '材质师',
    animator: '动画师',
    lighter: '灯光师',
    renderer: '渲染师',
    all: '全部职业'
  };
  dolLog(`👤 已切换职业: ${jobNames[job] || job}`, 'suc');
  return true;
}

function list3dJobs() {
  dolLog(`👥 3D建模职业列表:`, 'info');
  dolLog(`  /3d/job_modeler  - 建模师 (几何体创建)`, 'info');
  dolLog(`  /3d/job_sculptor - 雕刻师 (精细塑形)`, 'info');
  dolLog(`  /3d/job_texture  - 材质师 (纹理/材质)`, 'info');
  dolLog(`  /3d/job_animator - 动画师 (动画制作)`, 'info');
  dolLog(`  /3d/job_lighter  - 灯光师 (灯光布置)`, 'info');
  dolLog(`  /3d/job_renderer - 渲染师 (渲染输出)`, 'info');
  dolLog(`  /3d/job_all      - 全部工具模式`, 'info');
  return true;
}

