function restoreSession() {
  const savedSession = localStorage.getItem('dolwrt_session');
  if (savedSession) {
    try {
      const session = JSON.parse(savedSession);
      const now = Date.now();
      if (session.expiresAt && session.expiresAt > now) {
        codeInput.value = session.code || '';
        dolLog(`✅ 已恢复上次会话（有效期至 ${new Date(session.expiresAt).toLocaleString()}）`, 'suc');
      } else {
        localStorage.removeItem('dolwrt_session');
        dolLog(`⏰ 会话已过期，已清除`, 'info');
      }
    } catch (e) {
      localStorage.removeItem('dolwrt_session');
      dolLog(`❌ 会话数据损坏，已清除`, 'err');
    }
  }
}
restoreSession();

function parseHashParams() {
  const hash = window.location.hash.substring(1);
  if (!hash) return;
  
  const params = {};
  hash.split('&').forEach(pair => {
    const [key, value] = pair.split('=');
    if (key && value) {
      params[key] = decodeURIComponent(value);
    }
  });
  
  if (params.dolwrt) {
    try {
      const content = atob(params.dolwrt);
      codeInput.value = content;
      dolLog(`✅ 已从参数加载 .dolwrt 文件内容`, 'suc');
      
      if (params.autorun === '1') {
        dolLog(`🚀 正在自动运行...`, 'info');
        setTimeout(() => {
          run();
        }, 500);
      }
    } catch (e) {
      dolLog(`❌ 文件解码失败: ${e.message}`, 'err');
    }
  }
}
parseHashParams();

function loadSkeuomorphSetting() {
  const savedSettings = JSON.parse(localStorage.getItem('dol_settings') || '{}');
  const skeuomorphValue = savedSettings.skeuomorph !== undefined ? savedSettings.skeuomorph : 70;
  adjustSkeuomorph(skeuomorphValue);
}
loadSkeuomorphSetting();

function minimizeWindow() {
  if (window.resizeTo) {
    window.resizeTo(400, 300);
    window.moveTo(screen.width - 420, screen.height - 320);
  } else {
    window.open('', '_self').close();
  }
}

function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(err => {
      alert('全屏模式不可用，浏览器可能阻止了此操作');
    });
  } else {
    document.exitFullscreen();
  }
}

function toggleLeftHalfScreen() {
  if (window.resizeTo && window.moveTo) {
    const halfWidth = screen.width / 2;
    window.resizeTo(halfWidth, screen.height);
    window.moveTo(0, 0);
  } else {
    alert('窗口定位功能在当前环境不可用');
  }
}

function showHelp() {
  const helpContent = `
DonglaugOL 使用帮助

=== 基本操作 ===
• RUN: 运行代码
• RESET: 重置代码框
• 保存: 保存代码为 .dolwrt 文件
• LOAD: 加载 .dolwrt 文件
• 设置: 打开设置窗口

=== 指令示例 ===
• write.ot<文本> - 输出文本
• input.hint.tg<提示> - 创建输入框
• start.b*/ 文件 =[按钮名] - 创建跳转按钮
• photo<图片.png> - 显示图片

=== 窗口控制 ===
• 缩小: 将窗口缩小到角落
• 全屏: 切换全屏模式
• 左半屏: 将窗口移到左半屏

=== 提示 ===
• 支持拖放 .dolwrt 文件到代码框
• 设置会自动保存到浏览器本地存储
  `;
  alert(helpContent);
}

// 快捷键兼容
codeInput.addEventListener('keydown', (e) => {
  if (e.ctrlKey && e.key === 'Enter') run();
});

// ==================================================
// ========== 【/ns/ 开关和开关作用类指令】 ==========
// ==================================================
function parseNsSwitchCmd(cmd) {
  // /ns/switch<id> 创建开关
  if (cmd.startsWith('/ns/switch<')) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>/);
    if (match) { createNsSwitch(match[1]); return true; }
  }
  // /ns/switch<id>.on 打开开关
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.on$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.on$/);
    if (match) { nsSwitchOn(match[1]); return true; }
  }
  // /ns/switch<id>.off 关闭开关
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.off$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.off$/);
    if (match) { nsSwitchOff(match[1]); return true; }
  }
  // /ns/switch<id>.toggle 切换开关状态
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.toggle$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.toggle$/);
    if (match) { nsSwitchToggle(match[1]); return true; }
  }
  // /ns/switch<id>.status 获取开关状态
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.status$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.status$/);
    if (match) { nsSwitchStatus(match[1]); return true; }
  }
  // /ns/switch<id>.bind<cmd> 绑定指令到开关
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.bind<([^>]+)>$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.bind<([^>]+)>$/);
    if (match) { nsSwitchBind(match[1], match[2]); return true; }
  }
  // /ns/switch<id>.unbind 解绑指令
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.unbind$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.unbind$/);
    if (match) { nsSwitchUnbind(match[1]); return true; }
  }
  // /ns/switch<id>.color<color> 设置开关颜色
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.color<([^>]+)>$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.color<([^>]+)>$/);
    if (match) { nsSwitchColor(match[1], match[2]); return true; }
  }
  // /ns/switch<id>.size<size> 设置开关大小
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.size<([^>]+)>$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.size<([^>]+)>$/);
    if (match) { nsSwitchSize(match[1], match[2]); return true; }
  }
  // /ns/switch<id>.pos<x><y> 设置开关位置
  else if (cmd.match(/^\/ns\/switch<([^>]+)>\.pos<([^>]+)><([^>]+)>$/)) {
    const match = cmd.match(/^\/ns\/switch<([^>]+)>\.pos<([^>]+)><([^>]+)>$/);
    if (match) { nsSwitchPos(match[1], match[2], match[3]); return true; }
  }
  // /ns/switch<id>.label<text> 设置开关标签
