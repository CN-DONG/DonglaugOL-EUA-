function showClassSelector(category) {
  playSound('click');
  
  const selector = classSelectors[category];
  if (!selector) return;
  
  const html = `
    <style>
      .cs-panel { 
        background: rgba(44, 48, 54, 0.95); 
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 15px;
        max-width: 400px;
      }
      .cs-title { 
        color: #fff; 
        font-size: 16px; 
        margin-bottom: 10px;
        font-weight: bold;
      }
      .cs-options { 
        display: grid; 
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
      }
      .cs-option {
        background: rgba(90, 124, 163, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        padding: 8px 12px;
        color: #fff;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 13px;
      }
      .cs-option:hover {
        background: rgba(90, 124, 163, 0.5);
        transform: translateY(-1px);
      }
      .cs-option:active {
        transform: translateY(0);
      }
    </style>
    <div class="cs-panel">
      <div class="cs-title">📋 ${selector.name}</div>
      <div class="cs-options">
        ${selector.options.map(opt => `
          <div class="cs-option" onclick="selectClassOption('${category}', '${opt.value}', '${opt.cmd}')">
            ${opt.name}
          </div>
        `).join('')}
      </div>
    </div>
  `;
  
  const win = createGameWindow(`⚙️ ${selector.name}`, 350, 280, html);
  allComponents.push(win);
}

function selectClassOption(category, value, cmd) {
  playSound('click');
  
  if (cmd) {
    codeInput.value = cmd;
    dolLog(`✅ 已选择：${category} - ${value}`, 'suc');
    playSound('notification');
  } else {
    dolLog(`ℹ️ ${category} - ${value} (待实现)`, 'info');
    playSound('notification');
  }
}

// ==================================================
// ========== 【初代版本全局变量 100%完整保留】 ==========
// ==================================================
let codeInput = document.getElementById('codeInput');
let allComponents = [];
let timerList = [];
// 全局资源注册表：统一管理 interval、animationFrame、mediaStream
let dolIntervals = [];      // setInterval ID 列表
let dolAnimFrames = [];     // requestAnimationFrame ID 列表
let dolMediaStreams = [];   // MediaStream 流列表（摄像头/麦克风）

// 安全包装 setInterval：自动登记到 dolIntervals
function dolSetInterval(fn, delay) {
  const id = setInterval(fn, delay);
  dolIntervals.push(id);
  return id;
}
// 安全包装 setTimeout：自动登记到 timerList
function dolSetTimeout(fn, delay) {
  const id = setTimeout(fn, delay);
  timerList.push(id);
  return id;
}
// 安全包装 requestAnimationFrame：自动登记到 dolAnimFrames
function dolRequestAnimationFrame(fn) {
  const id = requestAnimationFrame(fn);
  dolAnimFrames.push(id);
  return id;
}
// 释放指定 MediaStream 的所有轨道
function dolStopStream(stream) {
  if (!stream) return;
  try {
    stream.getTracks().forEach(t => { t.stop(); t.enabled = false; });
  } catch(e) {}
  const idx = dolMediaStreams.indexOf(stream);
  if (idx > -1) dolMediaStreams.splice(idx, 1);
}
// 清理所有 interval
function dolClearAllIntervals() {
  dolIntervals.forEach(id => clearInterval(id));
  dolIntervals = [];
}
// 清理所有 animationFrame
function dolCancelAllAnimFrames() {
  dolAnimFrames.forEach(id => cancelAnimationFrame(id));
  dolAnimFrames = [];
}
// 清理所有媒体流
function dolStopAllStreams() {
  dolMediaStreams.forEach(s => {
    try { s.getTracks().forEach(t => { t.stop(); t.enabled = false; }); } catch(e) {}
  });
  dolMediaStreams = [];
}
