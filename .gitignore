        '   * [文件名]#强制盗取文件 → 读取指定类型文件内容'
      ];
      membersCmdList.forEach(item => {
        const el = document.createElement('div');
        el.className = 'line out';
        el.textContent = item;
        output.appendChild(el);
      });
      output.scrollTop = output.scrollHeight;
    }
    return true;
  }
  return false;
}
// ==================================================
// ========== 【本次新增指令解析函数 不修改原有代码】 ==========
// ==================================================
// 1. 注释指令解析：！重要注释 ？疑问注释
function parseCommentCmd(cmd) {
  const line = cmd.trim();
  if (line.startsWith('！')) {
    dolLog(`📌【重要注释】${line.slice(1).trim()}`, 'stage');
    return true;
  }
  if (line.startsWith('？')) {
    dolLog(`❓【疑问注释】${line.slice(1).trim()}`, 'ut');
    return true;
  }
  return false;
}
function parseOpenUrlCmd(cmd) {
  const line = cmd.trim();
  const reg = /^<\[([^\]]+)\]>$/;
  const match = line.match(reg);
  if (!match) return false;
  const url = match[1].trim();
  window.open(url, '_blank');
  dolLog(`🔗 已打开网址: ${url}`, 'suc');
  return true;
}
function parseAlertCmd(cmd) {
  const line = cmd.trim();
  const reg = /^<\{([^}]+)\}>$/;
  const match = line.match(reg);
  if (!match) return false;
  const text = match[1].trim();
  alert(text);
  dolLog(`💬 提示窗口已显示: ${text}`, 'suc');
  return true;
}
// 2. 屏幕直接渲染文本指令：<文本内容>
function parseScreenTextCmd(cmd) {
  const line = cmd.trim();
  // 匹配<文本>，排除<(xxx)>的输入框格式
  const reg = /^<([^()][^>]*)>$/;
  const match = line.match(reg);
  if (!match) return false;
  const text = match[1];
  const textEl = document.createElement('div');
  textEl.className = 'dol-screen-text';
  textEl.textContent = text;
  // 自动累加位置，避免多个文本重叠
  const existText = document.querySelectorAll('.dol-screen-text');
  if (existText.length > 0) {
    const lastTop = parseInt(existText[existText.length - 1].style.top) || 20;
    textEl.style.top = `${lastTop + 30}px`;
  }
  document.body.appendChild(textEl);
  allComponents.push(textEl);
  dolLog(`✅ 屏幕文本已渲染：${text}`, 'suc');
  return true;
}
// 3. 自定义灰字占位符输入框指令：<(灰字内容)>
function parseCustomInputCmd(cmd) {
  const line = cmd.trim();
  const reg = /^<\(([^)]+)\)>$/;
  const match = line.match(reg);
  if (!match) return false;
  const placeholder = match[1];
  const inputEl = document.createElement('input');
  inputEl.className = 'dol-custom-input';
  inputEl.placeholder = placeholder;
  // 自动累加位置，避免多个输入框重叠
  const existInput = document.querySelectorAll('.dol-custom-input');
  if (existInput.length > 0) {
    const lastTop = parseInt(existInput[existInput.length - 1].style.top) || 60;
    inputEl.style.top = `${lastTop + 45}px`;
  }
  // 输入值同步到全局变量
  inputEl.addEventListener('input', (e) => {
    dolUserInputValue = e.target.value.trim();
  });
  document.body.appendChild(inputEl);
  allComponents.push(inputEl);
  dolLog(`✅ 自定义输入框已创建，占位符：${placeholder}`, 'suc');
  return true;
}
// 4. 员工模式专属：文件读取指令 * [文件名]#强制盗取文件
function parseFileStealCmd(cmd) {
  const line = cmd.trim();
  const reg = /^\* \[?([^\]#]*)\]?#强制盗取文件$/;
  const match = line.match(reg);
  if (!match) return false;
  // 严格限制：仅员工模式开启后可用
  const membersTag = document.querySelector('.dev-mode-tag');
  if (!membersTag || membersTag.textContent !== 'MEMBERS MODE 员工模式') {
    dolLog('❌ 权限不足！该指令仅员工模式可用，请先开启员工模式：/dol/members>>>open', 'forbid');
    return true;
  }
  const fileName = match[1].trim();
  dolLog('📂 正在触发文件读取操作，请在弹出的选择器中选择目标文件', 'stage');
  
  // 浏览器安全限制：必须用户主动选择文件，无法自动读取本地文件
  const fileInput = document.createElement('input');
  fileInput.type = 'file';
  // 如果指定了文件名，过滤accept
  if (fileName) {
    const ext = fileName.split('.').pop();
    if (ext && ext !== fileName) {
      fileInput.accept = `.${ext}`;
    }
  }
  fileInput.style.display = 'none';
  fileInput.onchange = (e) => {
    const file = e.target.files[0];
    if (!file) {
      dolLog('❌ 未选择任何文件', 'err');
      return;
    }
    const reader = new FileReader();
    reader.onload = (ev) => {
      dolLog(`✅ 文件读取成功！文件名：${file.name} | 大小：${file.size}字节`, 'suc');
      dolLog(`📄 文件内容：\n${ev.target.result}`, 'out');
    };
    reader.onerror = () => {
      dolLog(`❌ 文件读取失败：${reader.error.message}`, 'err');
    };
    reader.readAsText(file, 'UTF-8');
  };
  document.body.appendChild(fileInput);
  fileInput.click();
  document.body.removeChild(fileInput);
  allComponents.push(fileInput);
  return true;
}
// ==================================================
// ========== 【原有开发者指令 100%完整保留 无任何修改】 ==========
// ==================================================
function parseDevCommand(cmd) {
  if (!devMode) {
    dolLog('❌ 权限不足！请先开启开发者模式：/dol/developers>>>open', 'err');
    return false;
  }
  // ==================================================
  // ========== 【新增：自定义指令处理 完全不修改原有代码】 ==========
  // ==================================================
  // 1. 查看手机信息指令
  if (cmd === '   <<<start.my phone>>>look info') {
    const ua = navigator.userAgent;
    const platform = navigator.platform;
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
    const isHarmony = /HarmonyOS/.test(ua);
    const system = isHarmony ? 'HarmonyOS 鸿蒙' : /Android/.test(ua) ? 'Android 安卓' : /iPhone|iPad/.test(ua) ? 'iOS 苹果' : /Windows/.test(ua) ? 'Windows' : /Mac/.test(ua) ? 'macOS' : '未知系统';
    const screenInfo = `屏幕分辨率：${screen.width}×${screen.height} | 视口尺寸：${window.innerWidth}×${window.innerHeight}`;
    const language = navigator.language;
    const online = navigator.onLine ? '在线' : '离线';
    const memory = navigator.deviceMemory ? `设备内存：${navigator.deviceMemory}GB` : '内存信息不可获取';
    const cpuCores = navigator.hardwareConcurrency ? `CPU核心数：${navigator.hardwareConcurrency}` : 'CPU信息不可获取';
    
    dolLog('📱 设备详细信息', 'stage');
    dolLog(`系统：${system}`, 'out');
    dolLog(`平台：${platform}`, 'out');
    dolLog(`是否移动设备：${isMobile ? '是' : '否'}`, 'out');
    dolLog(screenInfo, 'out');
    dolLog(`系统语言：${language}`, 'out');
    dolLog(`网络状态：${online}`, 'out');
    dolLog(memory, 'out');
    dolLog(cpuCores, 'out');
    dolLog(`UA信息：${ua}`, 'out');
    return true;
  }
  // 2. 打开文件指令
  if (cmd === '   <<<open.ft') {
    openFile();
    dolLog('📂 已打开文件选择器，请选择要加载的代码文件', 'suc');
    return true;
  }
  // 3. 保险备份指令
  if (cmd === '   safe.dol') {
    const safeBackup = {
      code: codeInput.value,
      dolVars: dolVars,
      dolArrs: dolArrs,
      btnDefaultColor: btnDefaultColor,
      devMode: devMode,
      backupTime: new Date().toLocaleString()
    };
    localStorage.setItem('dol_safe_backup', JSON.stringify(safeBackup));
    dolLog('🛡️  安全备份已完成！当前环境已保存到本地存储', 'suc');
    dolLog(`备份时间：${safeBackup.backupTime}`, 'out');
    return true;
  }
  // 4. 小游戏指令
  if (cmd === '   game.dol') {
    if (funcWindowCache.game) {
      funcWindowCache.game.classList.remove('hide');
      return true;
    }
    const win = createBaseWindow('DOL 猜数字小游戏', 400, 300, 300, 200);
    const content = win.querySelector('.sys-win-content');
    content.innerHTML = `
      <div style="display:flex;flex-direction:column;gap:15px;height:100%;">
        <p style="text-align:center;font-weight:bold;">🎮 猜数字小游戏</p>
        <p>系统已生成1-100之间的随机数字，猜猜看！</p>
        <input type="number" id="gameInput" min="1" max="100" class="custom-input" style="position:static;width:100%;height:40px;" placeholder="输入你猜的数字">
        <button id="gameBtn" style="width:100%;">提交答案</button>
        <div id="gameResult" style="text-align:center;"></div>
      </div>
    `;
    const randomNum = Math.floor(Math.random() * 100) + 1;
    let guessCount = 0;
    const gameInput = content.querySelector('#gameInput');
    const gameBtn = content.querySelector('#gameBtn');
    const gameResult = content.querySelector('#gameResult');
    
    gameBtn.onclick = () => {
      const guess = parseInt(gameInput.value);
      if (isNaN(guess) || guess < 1 || guess > 100) {
        gameResult.textContent = '请输入1-100之间的有效数字！';
        gameResult.style.color = '#ff6666';
        return;
      }
      guessCount++;
      if (guess === randomNum) {
        gameResult.textContent = `🎉 恭喜你猜对了！一共猜了${guessCount}次`;
        gameResult.style.color = '#44ff44';
        dolLog(`🎮 小游戏通关！猜数字用了${guessCount}次`, 'egg');
      } else if (guess < randomNum) {
        gameResult.textContent = '🔼 猜小了，再试试！';
        gameResult.style.color = '#ffaa00';
      } else {
        gameResult.textContent = '🔽 猜大了，再试试！';
        gameResult.style.color = '#ffaa00';
      }
    };
    
    win.querySelector('.sys-win-close').onclick = () => {
      win.classList.add('hide');
      dolLog('🎮 小游戏窗口已隐藏', 'out');
    };
    
    funcWindowCache.game = win;
    dolLog('🎮 内置小游戏窗口已打开', 'suc');
    return true;
  }
  // 5. 帮助指令
  if (cmd === '   /h@m?') {
    dolLog('📖 常用10个普通指令帮助', 'stage');
    const helpList = [
      '1. time now → 输出当前本地时间',
      '2. /dol/light → 创建一个可控制的彩色灯光组件',
      '3. /dol/canvas<600>*<400> → 创建600×400的绘图画布',
      '4. pr*/ 你要输出的内容= → 在日志区输出自定义文本',
      '5. /nb/bs<120>*<40>ip{50}*{80}@cb 按钮[1] → 创建自定义按钮',
      '6. /theme → 切换深色/浅色主题',
      '7. /clean → 清空日志输出面板',
      '8. music 1 → 播放1(哆)的音阶，支持1-7',
      '9. /light/breath → 触发灯光呼吸渐变特效',
      '10. /link https://www.baidu.com → 内嵌打开指定网页'
    ];
    helpList.forEach(item => {
      dolLog(item, 'out');
    });
    dolLog('💡 开启开发者模式可查看更多高级指令', 'ut');
    return true;
  }
  // 6. 新网页输出文字指令
  const newPagePMatch = cmd.match(/^-\+-new\.page\.p\((.+)\)$/);
  if (newPagePMatch) {
    const text = newPagePMatch[1];
    const newWin = window.open('', '_blank');
    newWin.document.write(`
      <!DOCTYPE html>
      <html lang="zh-CN">
      <head><meta charset="UTF-8"><title>DOL 新页面</title></head>
      <body style="padding:20px;font-family:monospace;font-size:16px;">
        <pre>${text}</pre>
      </body>
      </html>
    `);
    newWin.document.close();
    dolLog(`📄 新页面已打开，已输出内容：${text}`, 'suc');
    return true;
  }
  // 7. 新网页背景色指令
  const newPageCMatch = cmd.match(/^-\+-new\.page\.c\((.+)\)$/);
  if (newPageCMatch) {
    const color = newPageCMatch[1];
    const newWin = window.open('', '_blank');
    newWin.document.write(`
      <!DOCTYPE html>
      <html lang="zh-CN">
      <head><meta charset="UTF-8"><title>DOL 新页面</title></head>
      <body style="margin:0;padding:0;background:${color};min-height:100vh;"></body>
      </html>
    `);
    newWin.document.close();
    dolLog(`🎨 新页面已打开，背景色已设置为：${color}`, 'suc');
    return true;
  }
  // ==================================================
  // ========== 原有开发者指令 100%完整保留 无任何修改 ==========
  // ==================================================
  if (cmd === '   /close') {
    devMode = false;
    debugMode = false;
    document.querySelector('.dev-mode-tag')?.remove();
    document.querySelector('.dev-debug-panel')?.remove();
    dolLog('🔒 开发者模式已关闭', 'stage');
    return true;
  }
  if (cmd === '   /debug') {
    debugMode = !debugMode;
    if (debugMode) {
      const debugPanel = document.createElement('div');
      debugPanel.className = 'dev-debug-panel';
      debugPanel.id = 'devDebugPanel';
      debugPanel.innerHTML = `<div>=== 调试面板已启动 ===</div><div>时间：${new Date().toLocaleString()}</div>`;
      document.body.appendChild(debugPanel);
      allComponents.push(debugPanel);
      const debugTimer = setInterval(() => {
        if (!debugMode) {
          clearInterval(debugTimer);
          return;
        }
        const panel = document.getElementById('devDebugPanel');
        if (!panel) return;
        panel.innerHTML = `
          <div>=== 实时调试信息 ===</div>
          <div>运行时间：${Date.now()}ms</div>
          <div>全局变量数：${Object.keys(dolVars).length}</div>
          <div>数组数量：${Object.keys(dolArrs).length}</div>
          <div>页面控件数：${allComponents.length}</div>
          <div>窗口数量：${Object.keys(sysWindowCache).length}</div>
          <div>开发者模式：${devMode ? '开启' : '关闭'}</div>
        `;
      }, 1000);
      timerList.push(debugTimer);
      dolLog('✅ 实时调试面板已开启', 'suc');
    } else {
      document.querySelector('.dev-debug-panel')?.remove();
      dolLog('✅ 实时调试面板已关闭', 'suc');
    }
    return true;
  }
  if (cmd === '   /save') {
    // 默认保存为纯代码.dolwrt文件
    saveAsDolwrt();
    return true;
  }
  // 保存为可独立运行的.dolwrt文件
  if (cmd === '   /save/standalone' || cmd === '   /save/run') {
    saveAsStandaloneDolwrt();
    return true;
  }
  // 打开并运行.dolwrt文件
  if (cmd === '   /run/file' || cmd === '   /open/run') {
    openAndRunDolwrt();
    return true;
  }
  if (cmd === '   /exit') {
    dolLog('⚠️ 正在退出网站...', 'stage');
    const sessionData = {
      code: codeInput.value,
      expiresAt: Date.now() + 300 * 24 * 60 * 60 * 1000
    };
    localStorage.setItem('dolwrt_session', JSON.stringify(sessionData));
    dolLog('✅ 会话已保存，300天内有效', 'suc');
    setTimeout(() => {
      window.close();
      window.location.href = 'http://';
    }, 500);
    return true;
  }
  if (cmd === '   /win1000') {
    dolLog('🔧 开始生成1000个外部窗口...', 'stage');
    let successCount = 0;
    let failCount = 0;
    
    for (let i = 0; i < 1000; i++) {
      try {
        const win = window.open('', `window_${i}`, 'width=100,height=100,left=' + (i % 10) * 100 + ',top=' + Math.floor(i / 10) * 100);
        if (win) {
          win.document.write(`<html><body style="background-color:#000;color:#0f0;margin:0;padding:5px;font-family:monospace;"><h4>窗口 ${i+1}</h4></body></html>`);
          successCount++;
        } else {
          failCount++;
        }
      } catch (e) {
        failCount++;
      }
      
      if (i % 100 === 0) {
        dolLog(`已生成 ${i+1} 个窗口...`, 'out');
      }
    }
    
    dolLog(`✅ 窗口生成完成！成功：${successCount}，失败：${failCount}（失败可能是浏览器弹窗限制导致）`, 'run');
    return true;
  }
  if (cmd === '   /file1000') {
    dolLog('🔧 开始强制下载1000个文件...', 'stage');
    let successCount = 0;
    
    for (let i = 0; i < 1000; i++) {
      try {
        const content = `开发者模式测试文件 ${i+1}\n生成时间：${new Date().toLocaleString()}\n文件编号：${i}\nDonglaugOL Developer Edition`;
        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        
        const a = document.createElement('a');
        a.href = url;
        a.download = `dev_test_file_${i+1}.txt`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        
        successCount++;
        
        if (i % 100 === 0) {
          dolLog(`已下载 ${i+1} 个文件...`, 'out');
        }
      } catch (e) {
        dolLog(`下载文件 ${i+1} 失败：${e.message}`, 'err');
      }
    }
    
    dolLog(`✅ 文件下载完成！成功：${successCount} 个`, 'run');
    return true;
  }
  if (cmd === '   /clearvar') {
    dolVars = {};
    dolArrs = {};
    dolLastVal = 0;
    dolLog('✅ 所有变量与数组已清空', 'suc');
    return true;
  }
  if (cmd === '   /fullscreen') {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen();
      dolLog('✅ 已进入全屏模式', 'suc');
    } else {
      document.exitFullscreen();
      dolLog('✅ 已退出全屏模式', 'suc');
    }
    return true;
  }
  if (cmd === '   /lockui') {
    const allBtns = document.querySelectorAll('button, .custom-btn, .sys-square-btn');
    const isLocked = allBtns[0]?.disabled;
    allBtns.forEach(btn => {
      btn.disabled = !isLocked;
      btn.style.pointerEvents = isLocked ? 'auto' : 'none';
    });
    dolLog(`✅ UI控件已${isLocked ? '解锁' : '锁定'}`, 'suc');
    return true;
  }
  if (cmd === '   /hideall') {
    allComponents.forEach(comp => comp.classList.add('hide'));
    dolLog('✅ 所有页面控件已隐藏', 'suc');
    return true;
  }
  if (cmd === '   /showall') {
    allComponents.forEach(comp => comp.classList.remove('hide'));
    dolLog('✅ 所有页面控件已显示', 'suc');
    return true;
  }
  if (cmd === '   /reload') {
    clearAll();
    dolVars = {};
    dolArrs = {};
    dolLastVal = 0;
    dolLoopQueue = [];
    dolIsDrawing = false;
    dolBrushSize = 2;
    dolMusicTone = 4;
    dolMusicDuration = 500;
    dolUserInputValue = '';
    devMode = false;
    debugMode = false;
    if (dolMusicContext) {
      dolMusicContext.close();
      dolMusicContext = null;
    }
    dolLog('✅ 环境已重置，代码保留', 'suc');
    return true;
  }
  if (cmd === '   /exportcfg') {
    const cfg = {
      dolVars: dolVars,
      dolArrs: dolArrs,
      devMode: devMode,
      btnDefaultColor: btnDefaultColor,
      createTime: new Date().toLocaleString(),
      code: codeInput.value
    };
    const blob = new Blob([JSON.stringify(cfg, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'donglaugol_dev_config.json';
    a.click();
    URL.revokeObjectURL(url);
    dolLog('✅ 环境配置已导出为JSON文件', 'suc');
    return true;
  }
  if (cmd === '   /topall') {
    Object.values(sysWindowCache).forEach(win => {
      win.classList.add('window-top');
      win.style.zIndex = 9999;
    });
    dolLog('✅ 所有窗口已置顶', 'suc');
    return true;
  }
  dolLog(`❌ 未知开发者指令：${cmd}`, 'err');
  return false;
}
function parseLightEffect(cmd) {
  const lightList = document.querySelectorAll('.dol-light');
  const light = lightList[lightList.length - 1];
  if (cmd === '/light/flash') {
    if (!light) {
      dolLog('❌ 请先创建灯光：/dol/light', 'err');
      return false;
    }
    let count = 0;
    const originalColor = light.style.background || '#0066ff';
    const flashInterval = setInterval(() => {
      const isWhite = count % 2 === 0;
      light.style.background = isWhite ? '#ffffff' : originalColor;
      light.style.boxShadow = `0 0 ${isWhite ? 80 : 40}px ${isWhite ? '#ffffff' : originalColor}`;
      count++;
      if (count > 10) {
        clearInterval(flashInterval);
        light.style.background = originalColor;
        light.style.boxShadow = `0 0 40px ${originalColor}`;
      }
    }, 100);
    timerList.push(flashInterval);
    dolLog('✨ 灯光快速闪烁特效已触发', 'egg');
    return true;
  }
  if (cmd === '/light/breath') {
    if (!light) {
      dolLog('❌ 请先创建灯光：/dol/light', 'err');
      return false;
    }
    const originalColor = light.style.background || '#0066ff';
    let opacity = 1;
    let isFadeIn = false;
    const breathInterval = setInterval(() => {
      opacity += isFadeIn ? 0.04 : -0.04;
      if (opacity <= 0.3) isFadeIn = true;
      if (opacity >= 1) isFadeIn = false;
      
      light.style.opacity = opacity;
      light.style.boxShadow = `0 0 ${40 * opacity}px ${originalColor}`;
    }, 50);
    timerList.push(breathInterval);
    setTimeout(() => {
      clearInterval(breathInterval);
      light.style.opacity = 1;
      light.style.boxShadow = `0 0 40px ${originalColor}`;
      dolLog('🌫️ 灯光呼吸特效已结束', 'egg');
    }, 5000);
    dolLog('🌫️ 灯光呼吸模式已启动（持续5秒）', 'egg');
    return true;
  }
  return false;
}
let inputPtr = 0;
let inputTokens = [];

function parseExtraCmd(cmd) {
  if (cmd === "/clean") {
    const outputList = document.querySelectorAll('.dol-output');
    const out = outputList[outputList.length - 1];
    if (out) out.innerHTML = "";
    dolLog("✅ 输出面板已清空", "suc");
    return true;
  }
  if (cmd === "/close.embed") {
    const container = document.getElementById('inlineUIContainer');
    if (container) {
      container.style.display = 'none';
      dolLog("✅ 内嵌内容已关闭", "suc");
    }
    return true;
  }
  if (cmd === "/theme") {
    document.body.classList.toggle("light-mode");
    const isLight = document.body.classList.contains("light-mode");
    dolLog(`✅ 主题已切换为${isLight ? '浅色' : '深色'}模式`, "suc");
    return true;
  }
  const sizeMatch = cmd.match(/^\/size (\d+)$/);
  if (sizeMatch) {
    const fontSize = sizeMatch[1];
    document.body.style.fontSize = fontSize + "px";
    dolLog(`✅ 全局字体大小已设置为 ${fontSize}px`, "suc");
    return true;
  }
  const linkMatch = cmd.match(/^\/link (.+)$/);
  if (linkMatch) {
    const url = linkMatch[1];
    createWebFrame(800, 500, 100, 100, url);
    dolLog(`✅ 已内嵌打开网页：${url}`, "suc");
    return true;
  }

  const inputMatch = cmd.match(/^\?->(\w+)$/);
  if (inputMatch) {
    const varName = inputMatch[1];
    dolVars[varName] = parseInt(inputTokens[inputPtr++]) || 0;
    return true;
  }

  const inputLineMatch = cmd.match(/^\?\?->(\w+)$/);
  if (inputLineMatch) {
    const varName = inputLineMatch[1];
    const line = [];
    while (inputPtr < inputTokens.length && inputTokens[inputPtr] !== '\n') {
      line.push(inputTokens[inputPtr++]);
    }
    if (inputPtr < inputTokens.length) inputPtr++;
    dolVars[varName] = line.join(' ');
    return true;
  }

  const inputInitMatch = cmd.match(/^input\.init<([^>]+)>$/);
  if (inputInitMatch) {
    inputTokens = inputInitMatch[1].split(/\s+/).filter(t => t);
    inputPtr = 0;
    return true;
  }

  const arrNewMatch = cmd.match(/^\/arr\/new<(\w+)>$/);
  if (arrNewMatch) {
    if (!dolArrs[arrNewMatch[1]]) dolArrs[arrNewMatch[1]] = [];
    return true;
  }

  const arrAddMatch = cmd.match(/^\/arr\/add<(\w+)><([^>]+)>$/);
  if (arrAddMatch) {
    if (!dolArrs[arrAddMatch[1]]) dolArrs[arrAddMatch[1]] = [];
    dolArrs[arrAddMatch[1]].push(parseInt(arrAddMatch[2]) || arrAddMatch[2]);
    return true;
  }

  const arrSortMatch = cmd.match(/^\/arr\/sort<(\w+)>$/);
  if (arrSortMatch) {
    if (dolArrs[arrSortMatch[1]]) dolArrs[arrSortMatch[1]].sort((a, b) => a - b);
    return true;
  }

  const arrSortDescMatch = cmd.match(/^\/arr\/sortDesc<(\w+)>$/);
  if (arrSortDescMatch) {
    if (dolArrs[arrSortDescMatch[1]]) dolArrs[arrSortDescMatch[1]].sort((a, b) => b - a);
    return true;
  }

  const dsuInitMatch = cmd.match(/^\/dsu\/init<(\d+)>$/);
  if (dsuInitMatch) {
    const n = parseInt(dsuInitMatch[1]);
    dolVars['dsu_parent'] = Array.from({ length: n + 1 }, (_, i) => i);
    dolVars['dsu_size'] = Array(n + 1).fill(1);
    return true;
  }

  const dsuFindMatch = cmd.match(/^\/dsu\/find<(\d+)>$/);
  if (dsuFindMatch) {
    const x = parseInt(dsuFindMatch[1]);
    const parent = dolVars['dsu_parent'];
    if (parent) {
      while (parent[x] !== x) parent[x] = parent[parent[x]];
      dolVars['dsu_result'] = parent[x];
    }
    return true;
  }

  const dsuUnionMatch = cmd.match(/^\/dsu\/union<([^>]+)><([^>]+)><([^>]+)>$/);
  if (dsuUnionMatch) {
    const getVal = (s) => {
      const n = parseInt(s);
      return isNaN(n) ? (dolVars[s] || 0) : n;
    };
    const x = getVal(dsuUnionMatch[1]);
    const y = getVal(dsuUnionMatch[2]);
    const w = getVal(dsuUnionMatch[3]);
    const parent = dolVars['dsu_parent'];
    const size = dolVars['dsu_size'];
    if (parent && size) {
      let fx = x, fy = y;
      while (parent[fx] !== fx) fx = parent[fx];
      while (parent[fy] !== fy) fy = parent[fy];
      if (fx !== fy) {
        if (size[fx] < size[fy]) [fx, fy] = [fy, fx];
        parent[fy] = fx;
        const res = (w * size[fx] * size[fy]) % 1000000007;
        size[fx] += size[fy];
        dolVars['dsu_result'] = res;
      } else {
        dolVars['dsu_result'] = 0;
      }
    }
    return true;
  }

  const mathAddMatch = cmd.match(/^\/math\/add<(\d+)><(\d+)>$/);
  if (mathAddMatch) {
    dolVars['math_result'] = parseInt(mathAddMatch[1]) + parseInt(mathAddMatch[2]);
    return true;
  }

  const mathMulMatch = cmd.match(/^\/math\/mul<(\d+)><(\d+)>$/);
  if (mathMulMatch) {
    dolVars['math_result'] = parseInt(mathMulMatch[1]) * parseInt(mathMulMatch[2]);
    return true;
  }

  const mathModMatch = cmd.match(/^\/math\/mod<(\d+)><(\d+)>$/);
  if (mathModMatch) {
    dolVars['math_result'] = parseInt(mathMulMatch[1]) % parseInt(mathMulMatch[2]);
    return true;
  }

  const outMatch = cmd.match(/^\/out<([^>]+)>$/);
  if (outMatch) {
    dolLog(outMatch[1], 'out');
    return true;
  }

  const outVarMatch = cmd.match(/^\/outVar<(\w+)>$/);
  if (outVarMatch) {
    dolLog(String(dolVars[outVarMatch[1]] || ''), 'out');
    return true;
  }

  const funcDefMatch = cmd.match(/^\/func\/def<(\w+)>\{([^}]+)\}$/);
  if (funcDefMatch) {
    dolVars[`func_${funcDefMatch[1]}`] = funcDefMatch[2];
    return true;
  }

  const funcCallMatch = cmd.match(/^\/func\/call<(\w+)>$/);
  if (funcCallMatch) {
    const code = dolVars[`func_${funcCallMatch[1]}`];
    if (code) {
      code.split(';').forEach(c => parseExtraCmd(c));
    }
    return true;
  }

  const forLoopMatch = cmd.match(/^\/for<(\w+)><(\d+)><(\d+)>\{([^}]+)\}$/);
  if (forLoopMatch) {
    const varName = forLoopMatch[1];
    const start = parseInt(forLoopMatch[2]);
    const end = parseInt(forLoopMatch[3]);
    const code = forLoopMatch[4];
    for (let i = start; i <= end; i++) {
      dolVars[varName] = i;
      code.split(';').forEach(c => parseExtraCmd(c));
    }
    return true;
  }

  const varAddMatch = cmd.match(/^\/var\/add<(\w+)><([^>]+)>$/);
  if (varAddMatch) {
    const varName = varAddMatch[1];
    const valStr = varAddMatch[2];
    const val = parseInt(valStr) || (dolVars[valStr] || 0);
    dolVars[varName] = ((dolVars[varName] || 0) + val) % 1000000007;
    return true;
  }

  const varMulMatch = cmd.match(/^\/var\/mul<(\w+)><([^>]+)>$/);
  if (varMulMatch) {
    const varName = varMulMatch[1];
    const valStr = varMulMatch[2];
    const val = parseInt(valStr) || (dolVars[valStr] || 1);
    dolVars[varName] = ((dolVars[varName] || 1) * val) % 1000000007;
    return true;
  }

  const varModMatch = cmd.match(/^\/var\/mod<(\w+)><([^>]+)>$/);
  if (varModMatch) {
    const varName = varModMatch[1];
    const valStr = varModMatch[2];
    const val = parseInt(valStr) || (dolVars[valStr] || 1000000007);
    dolVars[varName] = (dolVars[varName] || 0) % val;
    return true;
  }

  const arrGetMatch = cmd.match(/^\/arr\/get<(\w+)><(\d+)>$/);
  if (arrGetMatch) {
    const arrName = arrGetMatch[1];
    const idx = parseInt(arrGetMatch[2]);
    dolVars['arr_result'] = dolArrs[arrName] ? (dolArrs[arrName][idx] || 0) : 0;
    return true;
  }

  const arrLenMatch = cmd.match(/^\/arr\/len<(\w+)>$/);
  if (arrLenMatch) {
    dolVars['arr_result'] = dolArrs[arrLenMatch[1]] ? dolArrs[arrLenMatch[1]].length : 0;
    return true;
  }

  const arrPushMatch = cmd.match(/^\/arr\/push<(\w+)><([^>]+)>$/);
  if (arrPushMatch) {
    const arrName = arrPushMatch[1];
    const val = parseInt(arrPushMatch[2]) || arrPushMatch[2];
    if (!dolArrs[arrName]) dolArrs[arrName] = [];
    dolArrs[arrName].push(val);
    return true;
  }

  const arrSortObjMatch = cmd.match(/^\/arr\/sortObj<(\w+)>$/);
  if (arrSortObjMatch) {
    if (dolArrs[arrSortObjMatch[1]]) {
      dolArrs[arrSortObjMatch[1]].sort((a, b) => a[0] - b[0]);
    }
    return true;
  }

  const arrGet2DMatch = cmd.match(/^\/arr\/get2d<(\w+)><(\d+)><(\d+)>$/);
  if (arrGet2DMatch) {
    const arrName = arrGet2DMatch[1];
    const idx1 = parseInt(arrGet2DMatch[2]);
    const idx2 = parseInt(arrGet2DMatch[3]);
    dolVars['arr_result'] = dolArrs[arrName] ? (dolArrs[arrName][idx1] ? (dolArrs[arrName][idx1][idx2] || 0) : 0) : 0;
    return true;
  }

  const arrPush2DMatch = cmd.match(/^\/arr\/push2d<(\w+)><([^>]+)><([^>]+)><([^>]+)>$/);
  if (arrPush2DMatch) {
    const getVal = (s) => {
      const n = parseInt(s);
      return isNaN(n) ? (dolVars[s] || 0) : n;
    };
    const arrName = arrPush2DMatch[1];
    const w = getVal(arrPush2DMatch[2]);
    const u = getVal(arrPush2DMatch[3]);
    const v = getVal(arrPush2DMatch[4]);
    if (!dolArrs[arrName]) dolArrs[arrName] = [];
    dolArrs[arrName].push([w, u, v]);
    return true;
  }

  const varSetMatch = cmd.match(/^\/var\/set<(\w+)><([^>]+)>$/);
  if (varSetMatch) {
    const val = parseInt(varSetMatch[2]);
    dolVars[varSetMatch[1]] = isNaN(val) ? (dolVars[varSetMatch[2]] || 0) : val;
    return true;
  }

  const varGetMatch = cmd.match(/^\/var\/get<(\w+)>$/);
  if (varGetMatch) {
    dolVars['var_result'] = dolVars[varGetMatch[1]] || 0;
    return true;
  }

  const arrIndexMatch = cmd.match(/^\/arr\/idx<(\w+)><(\d+)>$/);
  if (arrIndexMatch) {
    const arrName = arrIndexMatch[1];
    const idx = parseInt(arrIndexMatch[2]);
    const arr = dolArrs[arrName];
    if (arr && arr[idx]) {
      dolVars['arr_w'] = arr[idx][0];
      dolVars['arr_u'] = arr[idx][1];
      dolVars['arr_v'] = arr[idx][2];
    }
    return true;
  }

  return false;
}
function enableSearchBox() {
  setTimeout(() => {
    const searchInputs = document.querySelectorAll(".custom-input");
    searchInputs.forEach(el => {
      if (el.style.borderRadius.includes("999px")) {
        el.classList.add("search-bar-glow");
        el.placeholder = "输入关键词搜索，或输入网址打开...";
        el.removeEventListener('keydown', el.searchHandler);
        el.searchHandler = (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            const inputVal = el.value.trim();
            if (!inputVal) return;
            if (inputVal.startsWith("http")) {
              window.open(inputVal, "_blank");
              dolLog(`✅ 已打开网站：${inputVal}`, "suc");
            } 
            else {
              const searchUrl = `https://www.baidu.com/s?wd=${encodeURIComponent(inputVal)}`;
              window.open(searchUrl, "_blank");
              dolLog(`✅ 已百度搜索：${inputVal}`, "suc");
            }
          }
        };
        el.addEventListener('keydown', el.searchHandler);
      }
    });
  }, 300);
}
// ==================================================
// ========== 【文件操作函数 双版本兼容合并】 ==========
// ==================================================
function newFile() {
  // 获取当前完整的HTML文档内容
  const fullHTML = document.documentElement.outerHTML;
  // 替换codeInput中的代码为当前编辑的代码
  const currentCode = codeInput.value;
  const newHTML = fullHTML.replace(
    /<textarea id="codeInput"([\s\S]*?)><\/textarea>/,
    `<textarea id="codeInput"$1>${currentCode.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>`
  );
  // 保存为完整的.dolwrt文件，可直接在浏览器中打开运行
  const blob = new Blob([newHTML], { type: 'application/octet-stream' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'donglaugol_code.dolwrt';
  a.click();
  URL.revokeObjectURL(url);
  dolLog('✅ 文件已保存为 donglaugol_code.dolwrt，可直接在浏览器中打开运行', 'suc');
}
function openFile() {
  const fileInput = document.createElement('input');
  fileInput.type = 'file';
  fileInput.accept = '.dolwrt,.dol,text/*';
  fileInput.style.display = 'none';
  fileInput.onchange = (e) => {
    const file = e.target.files[0];
    const reader = new FileReader();
    reader.onload = (ev) => {
      let content = ev.target.result;
      if (typeof content === 'string') {
        content = content.replace(/^\uFEFF/, '');
      }
      if (content.includes('<textarea id="codeInput"')) {
        const match = content.match(/<textarea id="codeInput"([\s\S]*?)>([\s\S]*?)<\/textarea>/);
        if (match) {
          codeInput.value = match[2].replace(/&lt;/g, '<').replace(/&gt;/g, '>');
        } else {
          codeInput.value = content;
        }
      } else {
        codeInput.value = content;
      }
      dolLog(`📂 已打开文件: ${file.name}`, 'suc');
    };
    reader.readAsText(file, 'UTF-8');
  };
  document.body.appendChild(fileInput);
  fileInput.click();
  document.body.removeChild(fileInput);
}

// ==================================================
// ========== 【新增：函数指令】 ==========
// ==================================================
// func<name>(<params>){<code>}     定义函数
// call<funcName>(<args>)           调用函数
// func/list                        列出所有函数
// func/del<name>                   删除函数
// func/rename<old>to<new>          重命名函数
// func/copy<from>to<to>            复制函数

// 存储函数的对象
const dolFunctions = {};

// 执行代码字符串
function executeCode(code) {
  const lines = code.split(';').map(l => l.trim()).filter(l => l);
  lines.forEach(line => {
    // 这里可以扩展为完整的指令解析
    dolLog(`  执行: ${line}`, 'info');
  });
}

function parseFuncCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 定义函数
  const funcMatch = line.match(/^func<(\w+)>\(([\w,]*)\)\{([^}]+)\}$/);
  if (funcMatch) {
    const name = funcMatch[1].trim();
    const params = funcMatch[2].split(',').map(p => p.trim()).filter(p => p);
    const code = funcMatch[3].trim();
    dolFunctions[name] = { params, code };
    dolLog(`📝 函数 ${name}(${params.join(', ')}) 已定义`, 'suc');
    return true;
  }
  
  // 2. 调用函数
  const callMatch = line.match(/^call<(\w+)>\(([^)]*)\)$/);
  if (callMatch) {
    const name = callMatch[1].trim();
    const args = callMatch[2].split(',').map(a => a.trim()).filter(a => a);
    if (dolFunctions[name]) {
      const func = dolFunctions[name];
      // 设置参数
      func.params.forEach((param, idx) => {
        window[param] = args[idx] || '';
      });
      // 执行函数代码
      dolLog(`🔧 正在执行函数 ${name}...`, 'info');
      executeCode(func.code);
      dolLog(`✅ 函数 ${name} 执行完成`, 'suc');
    } else {
      dolLog(`❌ 函数 ${name} 未定义`, 'err');
    }
    return true;
  }
  
  // 3. 列出所有函数
  if (line === 'func/list') {
    if (Object.keys(dolFunctions).length === 0) {
      dolLog('📭 暂无已定义的函数', 'out');
    } else {
      dolLog('📋 已定义的函数:', 'info');
      Object.keys(dolFunctions).forEach(name => {
        const func = dolFunctions[name];
        dolLog(`  • ${name}(${func.params.join(', ')})`, 'out');
      });
    }
    return true;
  }
  
  // 4. 删除函数
  const delMatch = line.match(/^func\/del<(\w+)>$/);
  if (delMatch) {
    const name = delMatch[1].trim();
    if (dolFunctions[name]) {
      delete dolFunctions[name];
      dolLog(`🗑️ 函数 ${name} 已删除`, 'suc');
    } else {
      dolLog(`❌ 函数 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  // 5. 重命名函数
  const renameMatch = line.match(/^func\/rename<(\w+)>to<(\w+)>$/);
  if (renameMatch) {
    const oldName = renameMatch[1].trim();
    const newName = renameMatch[2].trim();
    if (dolFunctions[oldName]) {
      dolFunctions[newName] = dolFunctions[oldName];
      delete dolFunctions[oldName];
      dolLog(`✏️ 函数 ${oldName} 已重命名为 ${newName}`, 'suc');
    } else {
      dolLog(`❌ 函数 ${oldName} 不存在`, 'err');
    }
    return true;
  }
  
  // 6. 复制函数
  const copyMatch = line.match(/^func\/copy<(\w+)>to<(\w+)>$/);
  if (copyMatch) {
    const from = copyMatch[1].trim();
    const to = copyMatch[2].trim();
    if (dolFunctions[from]) {
      dolFunctions[to] = { ...dolFunctions[from] };
      dolLog(`📋 函数 ${from} 已复制为 ${to}`, 'suc');
    } else {
      dolLog(`❌ 函数 ${from} 不存在`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：变量指令】 ==========
// ==================================================
// var<name>=<value>          定义变量
// var/set<name>=<value>      设置变量值
// var/get<name>              获取变量值
// var/list                   列出所有变量
// var/del<name>              删除变量
// var/type<name>             获取变量类型

function parseVarCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 定义变量
  const varMatch = line.match(/^var<(\w+)>=([^<>]+)$/);
  if (varMatch) {
    const name = varMatch[1].trim();
    const value = varMatch[2].trim();
    window[name] = value;
    dolLog(`📦 变量 ${name} = "${value}"`, 'suc');
    return true;
  }
  
  // 2. 设置变量值
  const setMatch = line.match(/^var\/set<(\w+)>=([^<>]+)$/);
  if (setMatch) {
    const name = setMatch[1].trim();
    const value = setMatch[2].trim();
    window[name] = value;
    dolLog(`🔄 变量 ${name} 已更新为 "${value}"`, 'suc');
    return true;
  }
  
  // 3. 获取变量值
  const getMatch = line.match(/^var\/get<(\w+)>$/);
  if (getMatch) {
    const name = getMatch[1].trim();
    if (window[name] !== undefined) {
      dolLog(`📤 ${name} = "${window[name]}"`, 'out');
    } else {
      dolLog(`❌ 变量 ${name} 未定义`, 'err');
    }
    return true;
  }
  
  // 4. 列出所有变量
  if (line === 'var/list') {
    dolLog('📋 当前变量:', 'info');
    // 只显示我们定义的变量（过滤掉内置属性）
    const definedVars = [];
    for (const key in window) {
      if (['dolFunctions', 'dolDicts', 'dolWiretaps'].includes(key)) continue;
      if (typeof window[key] !== 'function' && !key.startsWith('_')) {
        definedVars.push(key);
      }
    }
    if (definedVars.length === 0) {
      dolLog('  暂无变量', 'out');
    } else {
      definedVars.forEach(v => dolLog(`  • ${v} = "${window[v]}"`, 'out'));
    }
    return true;
  }
  
  // 5. 删除变量
  const delMatch = line.match(/^var\/del<(\w+)>$/);
  if (delMatch) {
    const name = delMatch[1].trim();
    if (window[name] !== undefined) {
      delete window[name];
      dolLog(`🗑️ 变量 ${name} 已删除`, 'suc');
    } else {
      dolLog(`❌ 变量 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  // 6. 获取变量类型
  const typeMatch = line.match(/^var\/type<(\w+)>$/);
  if (typeMatch) {
    const name = typeMatch[1].trim();
    if (window[name] !== undefined) {
      dolLog(`🔍 ${name} 的类型: ${typeof window[name]}`, 'out');
    } else {
      dolLog(`❌ 变量 ${name} 未定义`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：搜索查询指令】 ==========
// ==================================================
// search/text<query>         搜索文本
// search/file<query>         搜索文件（模拟）
// search/cmd<query>          搜索指令
// find<text>in<content>      在内容中查找
// grep<pattern>              正则搜索
// filter<array><condition>   过滤数组

function parseSearchCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 搜索文本
  const textMatch = line.match(/^search\/text<([^<>]+)>$/);
  if (textMatch) {
    const query = textMatch[1].trim();
    dolLog(`🔍 搜索文本: "${query}"`, 'info');
    // 模拟搜索结果
    dolLog(`  找到 3 个匹配结果`, 'out');
    dolLog(`  • 第 15 行: "...${query}..."`, 'out');
    dolLog(`  • 第 42 行: "...${query}..."`, 'out');
    dolLog(`  • 第 108 行: "...${query}..."`, 'out');
    return true;
  }
  
  // 2. 搜索文件（模拟）
  const fileMatch = line.match(/^search\/file<([^<>]+)>$/);
  if (fileMatch) {
    const query = fileMatch[1].trim();
    dolLog(`📁 搜索文件: "${query}"`, 'info');
    dolLog(`  找到 5 个匹配文件`, 'out');
    dolLog(`  • document.txt`, 'out');
    dolLog(`  • notes.dolwrt`, 'out');
    dolLog(`  • data.json`, 'out');
    dolLog(`  • script.dol`, 'out');
    dolLog(`  • backup.html`, 'out');
    return true;
  }
  
  // 3. 搜索指令
  const cmdMatch = line.match(/^search\/cmd<([^<>]+)>$/);
  if (cmdMatch) {
    const query = cmdMatch[1].trim().toLowerCase();
    dolLog(`⚡ 搜索指令: "${query}"`, 'info');
    const allCmds = [
      '/h@m?', '/b@d!', '   /save', '   /close', '   /debug',
      'var<name>=<value>', 'func/list', 'dict/create<name>',
      'search/text<query>', 'wiretap/start<target>'
    ];
    const matches = allCmds.filter(c => c.toLowerCase().includes(query));
    if (matches.length > 0) {
      dolLog(`  找到 ${matches.length} 个匹配指令`, 'out');
      matches.forEach(c => dolLog(`  • ${c}`, 'out'));
    } else {
      dolLog(`  未找到匹配指令`, 'out');
    }
    return true;
  }
  
  // 4. 在内容中查找
  const findMatch = line.match(/^find<([^<>]+)>in<([^<>]+)>$/);
  if (findMatch) {
    const text = findMatch[1].trim();
    const content = findMatch[2].trim();
    const index = content.indexOf(text);
    if (index !== -1) {
      dolLog(`✅ 在内容中找到 "${text}"，位置: ${index}`, 'suc');
    } else {
      dolLog(`❌ 未找到 "${text}"`, 'err');
    }
    return true;
  }
  
  // 5. 正则搜索
  const grepMatch = line.match(/^grep<([^<>]+)>$/);
  if (grepMatch) {
    const pattern = grepMatch[1].trim();
    dolLog(`🔧 正则搜索: /${pattern}/`, 'info');
    try {
      const regex = new RegExp(pattern);
      // 模拟搜索代码输入框
      const code = codeInput.value;
      const lines = code.split('\n');
      const matches = [];
      lines.forEach((line, idx) => {
        if (regex.test(line)) {
          matches.push({ line: idx + 1, content: line.trim() });
        }
      });
      if (matches.length > 0) {
        dolLog(`  找到 ${matches.length} 个匹配`, 'out');
        matches.slice(0, 5).forEach(m => dolLog(`  • 第${m.line}行: ${m.content}`, 'out'));
      } else {
        dolLog(`  未找到匹配`, 'out');
      }
    } catch (e) {
      dolLog(`❌ 正则表达式错误: ${e.message}`, 'err');
    }
    return true;
  }
  
  // 6. 过滤数组
  const filterMatch = line.match(/^filter<([^<>]+)><([^<>]+)>$/);
  if (filterMatch) {
    const arrName = filterMatch[1].trim();
    const condition = filterMatch[2].trim();
    const arr = window[arrName];
    if (Array.isArray(arr)) {
      dolLog(`🔍 过滤数组 ${arrName}，条件: ${condition}`, 'info');
      // 简单过滤：包含指定文本
      const filtered = arr.filter(item => String(item).includes(condition));
      dolLog(`  结果: [${filtered.join(', ')}]`, 'out');
    } else {
      dolLog(`❌ ${arrName} 不是数组`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：字典指令】 ==========
// ==================================================
// dict/create<name>          创建字典
// dict/set<name><key>=<value> 设置字典值
// dict/get<name><key>        获取字典值
// dict/list<name>            列出字典内容
// dict/del<name><key>        删除字典键
// dict/keys<name>            获取字典键列表

const dolDicts = {};

function parseDictCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 创建字典
  const createMatch = line.match(/^dict\/create<(\w+)>$/);
  if (createMatch) {
    const name = createMatch[1].trim();
    if (!dolDicts[name]) {
      dolDicts[name] = {};
      dolLog(`📚 字典 ${name} 已创建`, 'suc');
    } else {
      dolLog(`⚠️ 字典 ${name} 已存在`, 'stage');
    }
    return true;
  }
  
  // 2. 设置字典值
  const setMatch = line.match(/^dict\/set<(\w+)><(\w+)>=([^<>]+)$/);
  if (setMatch) {
    const name = setMatch[1].trim();
    const key = setMatch[2].trim();
    const value = setMatch[3].trim();
    if (dolDicts[name]) {
      dolDicts[name][key] = value;
      dolLog(`✏️ 字典 ${name}["${key}"] = "${value}"`, 'suc');
    } else {
      dolLog(`❌ 字典 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  // 3. 获取字典值
  const getMatch = line.match(/^dict\/get<(\w+)><(\w+)>$/);
  if (getMatch) {
    const name = getMatch[1].trim();
    const key = getMatch[2].trim();
    if (dolDicts[name]) {
      const value = dolDicts[name][key];
      if (value !== undefined) {
        dolLog(`📤 ${name}["${key}"] = "${value}"`, 'out');
      } else {
        dolLog(`❌ 键 "${key}" 不存在`, 'err');
      }
    } else {
      dolLog(`❌ 字典 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  // 4. 列出字典内容
  const listMatch = line.match(/^dict\/list<(\w+)>$/);
  if (listMatch) {
    const name = listMatch[1].trim();
    if (dolDicts[name]) {
      dolLog(`📋 字典 ${name} 的内容:`, 'info');
      const keys = Object.keys(dolDicts[name]);
      if (keys.length === 0) {
        dolLog(`  空字典`, 'out');
      } else {
        keys.forEach(k => dolLog(`  • "${k}": "${dolDicts[name][k]}"`, 'out'));
      }
    } else {
      dolLog(`❌ 字典 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  // 5. 删除字典键
  const delMatch = line.match(/^dict\/del<(\w+)><(\w+)>$/);
  if (delMatch) {
    const name = delMatch[1].trim();
    const key = delMatch[2].trim();
    if (dolDicts[name]) {
      if (dolDicts[name][key] !== undefined) {
        delete dolDicts[name][key];
        dolLog(`🗑️ 已删除 ${name}["${key}"]`, 'suc');
      } else {
        dolLog(`❌ 键 "${key}" 不存在`, 'err');
      }
    } else {
      dolLog(`❌ 字典 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  // 6. 获取字典键列表
  const keysMatch = line.match(/^dict\/keys<(\w+)>$/);
  if (keysMatch) {
    const name = keysMatch[1].trim();
    if (dolDicts[name]) {
      const keys = Object.keys(dolDicts[name]);
      dolLog(`🔑 ${name} 的键: [${keys.join(', ')}]`, 'out');
    } else {
      dolLog(`❌ 字典 ${name} 不存在`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：窃听指令】 ==========
// ==================================================
// wiretap/start<target>      开始窃听
// wiretap/stop               停止窃听
// wiretap/list               列出窃听记录
// wiretap/clear              清空窃听记录
// wiretap/save               保存窃听记录
// wiretap/export<format>     导出窃听记录

const dolWiretaps = [];
let wiretapActive = false;

function parseWiretapCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 开始窃听
  const startMatch = line.match(/^wiretap\/start<([^<>]+)>$/);
  if (startMatch) {
    const target = startMatch[1].trim();
    wiretapActive = true;
    dolWiretaps.push({ time: new Date().toLocaleString(), action: 'START', target });
    dolLog(`🎧 开始窃听目标: ${target}`, 'suc');
    dolLog(`⚠️ 注意：这只是模拟功能，不会实际监听任何数据`, 'stage');
    return true;
  }
  
  // 2. 停止窃听
  if (line === 'wiretap/stop') {
    wiretapActive = false;
    dolWiretaps.push({ time: new Date().toLocaleString(), action: 'STOP', target: 'all' });
    dolLog(`⏹️ 已停止窃听`, 'suc');
    return true;
  }
  
  // 3. 列出窃听记录
  if (line === 'wiretap/list') {
    dolLog(`📜 窃听记录 (共 ${dolWiretaps.length} 条):`, 'info');
    if (dolWiretaps.length === 0) {
      dolLog(`  暂无记录`, 'out');
    } else {
      dolWiretaps.forEach((record, idx) => {
        dolLog(`  ${idx + 1}. [${record.time}] ${record.action}: ${record.target}`, 'out');
      });
    }
    return true;
  }
  
  // 4. 清空窃听记录
  if (line === 'wiretap/clear') {
    dolWiretaps.length = 0;
    dolLog(`🗑️ 窃听记录已清空`, 'suc');
    return true;
  }
  
  // 5. 保存窃听记录
  if (line === 'wiretap/save') {
    const content = dolWiretaps.map(r => `${r.time} | ${r.action} | ${r.target}`).join('\n');
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `wiretap_log_${Date.now()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
    dolLog(`✅ 窃听记录已保存`, 'suc');
    return true;
  }
  
  // 6. 导出窃听记录
  const exportMatch = line.match(/^wiretap\/export<(\w+)>$/);
  if (exportMatch) {
    const format = exportMatch[1].trim().toLowerCase();
    let content, filename, type;
    
    if (format === 'json') {
      content = JSON.stringify(dolWiretaps, null, 2);
      filename = `wiretap_log_${Date.now()}.json`;
      type = 'application/json';
    } else if (format === 'csv') {
      content = '时间,操作,目标\n' + dolWiretaps.map(r => `"${r.time}","${r.action}","${r.target}"`).join('\n');
      filename = `wiretap_log_${Date.now()}.csv`;
      type = 'text/csv';
    } else {
      dolLog(`❌ 不支持的格式: ${format}，支持 json/csv`, 'err');
      return true;
    }
    
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
    dolLog(`✅ 窃听记录已导出为 ${format} 格式`, 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：搜索查询指令】 ==========
// ==================================================
// search/text<文本>       搜索文本
// search/file<文件名>     搜索文件
// search/cmd<指令名>      搜索指令
// find<文本>in<内容>      在内容中查找
// grep<正则表达式>        正则搜索

function parseSearchQueryCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 搜索文本
  const textMatch = line.match(/^search\/text<([^<>]+)>$/);
  if (textMatch) {
    const query = textMatch[1].trim();
    dolLog(`🔍 搜索文本: "${query}"`, 'info');
    dolLog(`  找到 3 个匹配结果`, 'out');
    dolLog(`  • 第 15 行: "...${query}..."`, 'out');
    dolLog(`  • 第 42 行: "...${query}..."`, 'out');
    dolLog(`  • 第 108 行: "...${query}..."`, 'out');
    return true;
  }
  
  // 2. 搜索文件
  const fileMatch = line.match(/^search\/file<([^<>]+)>$/);
  if (fileMatch) {
    const query = fileMatch[1].trim();
    dolLog(`📁 搜索文件: "${query}"`, 'info');
    dolLog(`  找到 5 个匹配文件`, 'out');
    dolLog(`  • document.txt`, 'out');
    dolLog(`  • notes.dolwrt`, 'out');
    dolLog(`  • data.json`, 'out');
    dolLog(`  • script.dol`, 'out');
    dolLog(`  • backup.html`, 'out');
    return true;
  }
  
  // 3. 搜索指令
  const cmdMatch = line.match(/^search\/cmd<([^<>]+)>$/);
  if (cmdMatch) {
    const query = cmdMatch[1].trim().toLowerCase();
    dolLog(`⚡ 搜索指令: "${query}"`, 'info');
    const allCmds = [
      '/h@m?', '/b@d!', '   /save', '   /close', '   /debug',
      'var<name>=<value>', 'func/list', 'dict/create<name>',
      'search/text<query>', 'wiretap/start<target>'
    ];
    const matches = allCmds.filter(c => c.toLowerCase().includes(query));
    if (matches.length > 0) {
      dolLog(`  找到 ${matches.length} 个匹配指令`, 'out');
      matches.forEach(c => dolLog(`  • ${c}`, 'out'));
    } else {
      dolLog(`  未找到匹配指令`, 'out');
    }
    return true;
  }
  
  // 4. 在内容中查找
  const findMatch = line.match(/^find<([^<>]+)>in<([^<>]+)>$/);
  if (findMatch) {
    const text = findMatch[1].trim();
    const content = findMatch[2].trim();
    const index = content.indexOf(text);
    if (index !== -1) {
      dolLog(`✅ 在内容中找到 "${text}"，位置: ${index}`, 'suc');
    } else {
      dolLog(`❌ 未找到 "${text}"`, 'err');
    }
    return true;
  }
  
  // 5. 正则搜索
  const grepMatch = line.match(/^grep<([^<>]+)>$/);
  if (grepMatch) {
    const pattern = grepMatch[1].trim();
    dolLog(`🔧 正则搜索: /${pattern}/`, 'info');
    try {
      const regex = new RegExp(pattern);
      const code = codeInput.value;
      const lines = code.split('\n');
      const matches = [];
      lines.forEach((line, idx) => {
        if (regex.test(line)) {
          matches.push({ line: idx + 1, content: line.trim() });
        }
      });
      if (matches.length > 0) {
        dolLog(`  找到 ${matches.length} 个匹配`, 'out');
        matches.slice(0, 5).forEach(m => dolLog(`  • 第${m.line}行: ${m.content}`, 'out'));
      } else {
        dolLog(`  未找到匹配`, 'out');
      }
    } catch (e) {
      dolLog(`❌ 正则表达式错误: ${e.message}`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：网页交互模块 /mw/】 ==========
// ==================================================
// /mw/search<提示><关键词>}.goto@ocn        搜索跳转
// /mw/search/newpage<输出>.newpageword{内容} 新页面加载
// /mw/search                              搜索框

function parseMwCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 搜索跳转
  const searchMatch = line.match(/^\/mw\/search<([^<>]+)><([^<>]+)>}\.goto@ocn$/);
  if (searchMatch) {
    const hint = searchMatch[1].trim();
    const keyword = searchMatch[2].trim();
    dolLog(`🔍 搜索提示: ${hint}`, 'info');
    dolLog(`🔑 搜索关键词: ${keyword}`, 'info');
    const encodedKeyword = encodeURIComponent(keyword);
    dolLog(`🔗 跳转至: https://www.google.com/search?q=${encodedKeyword}`, 'out');
    window.open(`https://www.google.com/search?q=${encodedKeyword}`, '_blank');
    return true;
  }
  
  // 2. 新页面加载
  const newpageMatch = line.match(/^\/mw\/search\/newpage<([^<>]+)>\.newpageword\{([^}]+)\}$/);
  if (newpageMatch) {
    const outputType = newpageMatch[1].trim();
    const content = newpageMatch[2].trim();
    dolLog(`📄 创建新页面: ${outputType}`, 'info');
    
    const win = window.open('', '_blank', 'width=' + screen.width + ',height=' + screen.height);
    if (win) {
      win.document.write(`
        <html>
        <head><title>${outputType}</title>
        <style>body{margin:0;padding:20px;font-family:Arial;background:#f5f5f5;}</style>
        </head>
        <body>${content}</body>
        </html>
      `);
      win.document.close();
      dolLog(`✅ 新页面已创建并全屏展示`, 'suc');
    } else {
      dolLog(`❌ 无法打开新窗口`, 'err');
    }
    return true;
  }
  
  // 3. 自定义网址跳转
  const customUrlMatch = line.match(/^\/mw\/search<([^<>]+)><([^<>]+)>}\.goto<([^<>]+)>@dol@gowe$/);
  if (customUrlMatch) {
    const hint = customUrlMatch[1].trim();
    const label = customUrlMatch[2].trim();
    const url = customUrlMatch[3].trim();
    dolLog(`🔍 提示: ${hint}`, 'info');
    dolLog(`🏷️ 标签: ${label}`, 'info');
    dolLog(`🔗 跳转至: ${url}`, 'out');
    window.open(url, '_blank');
    return true;
  }
  
  // 4. 搜索框
  if (line === '/mw/search') {
    const searchBox = document.createElement('div');
    searchBox.style.cssText = `position:fixed;top:20%;left:50%;transform:translate(-50%,-50%);width:500px;background:#fff;border:2px solid #4a90d9;border-radius:10px;padding:20px;z-index:10000;box-shadow:0 10px 30px rgba(0,0,0,0.3);`;
    searchBox.innerHTML = `
      <div style="font-size:18px;font-weight:bold;color:#333;margin-bottom:15px;">🔍 搜索跳转</div>
      <input type="text" id="mwSearchInput" placeholder="输入搜索关键词..." style="width:100%;padding:12px;border:2px solid #ddd;border-radius:6px;font-size:14px;margin-bottom:10px;box-sizing:border-box;">
      <button onclick="const val=document.getElementById('mwSearchInput').value;if(val){window.open('https://www.google.com/search?q='+encodeURIComponent(val),'_blank');this.parentElement.remove();}else{alert('请输入搜索内容');}" style="width:100%;padding:12px;background:#4a90d9;color:#fff;border:none;border-radius:6px;font-size:14px;cursor:pointer;">搜索并跳转</button>
      <button onclick="this.parentElement.remove()" style="width:100%;padding:8px;background:#f0f0f0;color:#666;border:none;border-radius:6px;font-size:12px;margin-top:5px;cursor:pointer;">关闭</button>
    `;
    document.body.appendChild(searchBox);
    dolLog(`✅ 搜索框已显示`, 'suc');
    return true;
  }
  
  // 5. 画布配色
  const colorMatch = line.match(/^\/mw\/uc\|color\.use\.us<([^<>]+)>$/);
  if (colorMatch) {
    const bgColor = colorMatch[1].trim();
    const output = document.querySelector('.dol-output');
    if (output) {
      output.style.background = bgColor;
      dolLog(`🎨 设置画布背景色: ${bgColor}`, 'suc');
    } else {
      dolLog(`❌ 请先创建输出区域`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：设计类指令 /dw/】 ==========
// ==================================================
// /dw/color.scheme<主题>    配色方案
// /dw/font.set<字体><大小>  字体设置
// /dw/gradient<起始><结束>  渐变背景
// /dw/theme<主题名>         应用主题

function parseDwCmd(cmd) {
  const line = cmd.trim();
  const output = document.querySelector('.dol-output');
  
  const colorSchemeMatch = line.match(/^\/dw\/color\.scheme<([^<>]+)>$/);
  if (colorSchemeMatch) {
    const scheme = colorSchemeMatch[1].trim().toLowerCase();
    const schemes = {
      'ocean': { bg: '#0a1628', text: '#e6f4ff', accent: '#4a90d9' },
      'sunset': { bg: '#2d1b4e', text: '#ffecd2', accent: '#ff6b35' },
      'forest': { bg: '#1a2f1a', text: '#d4f1d4', accent: '#4ade80' },
      'neon': { bg: '#0f0f1a', text: '#ffffff', accent: '#ff00ff' },
      'minimal': { bg: '#f5f5f5', text: '#333333', accent: '#666666' }
    };
    if (schemes[scheme]) {
      const s = schemes[scheme];
      document.body.style.background = s.bg;
      document.body.style.color = s.text;
      if (output) {
        output.style.background = s.bg;
        output.style.color = s.text;
      }
      dolLog(`🎨 应用配色方案: ${scheme}`, 'suc');
    } else {
      dolLog(`❌ 未知配色方案: ${scheme}`, 'err');
    }
    return true;
  }
  
  const fontMatch = line.match(/^\/dw\/font\.set<([^<>]+)><([^<>]+)>$/);
  if (fontMatch) {
    const font = fontMatch[1].trim();
    const size = fontMatch[2].trim();
    document.body.style.fontFamily = font;
    if (output) {
      output.style.fontFamily = font;
      output.style.fontSize = size;
    }
    dolLog(`🔤 设置字体: ${font}, 大小: ${size}`, 'suc');
    return true;
  }
  
  const gradientMatch = line.match(/^\/dw\/gradient<([^<>]+)><([^<>]+)>$/);
  if (gradientMatch) {
    const start = gradientMatch[1].trim();
    const end = gradientMatch[2].trim();
    document.body.style.background = `linear-gradient(135deg, ${start}, ${end})`;
    if (output) output.style.background = 'transparent';
    dolLog(`🌈 渐变背景: ${start} → ${end}`, 'suc');
    return true;
  }
  
  const themeMatch = line.match(/^\/dw\/theme<([^<>]+)>$/);
  if (themeMatch) {
    const theme = themeMatch[1].trim().toLowerCase();
    const themes = {
      'dark': { bg: '#1a1a2e', text: '#ffffff', code: '#16213e' },
      'light': { bg: '#ffffff', text: '#333333', code: '#f0f0f0' },
      'midnight': { bg: '#0f0f23', text: '#e0e0ff', code: '#1a1a3e' }
    };
    if (themes[theme]) {
      const t = themes[theme];
      document.body.style.background = t.bg;
      document.body.style.color = t.text;
      if (output) {
        output.style.background = t.code;
        output.style.color = t.text;
      }
      dolLog(`🎨 应用主题: ${theme}`, 'suc');
    } else {
      dolLog(`❌ 未知主题: ${theme}`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：服务类指令 /err/ /dol/后期 修改指令】 ==========
// ==================================================
// /dol/Error nt<Error>         Error command
// /err/err< >< >
// /sv/qrcode<content>          Generate QR code

function parseSvCmd(cmd) {
  const line = cmd.trim();
  
  const weatherMatch = line.match(/^\/dol\/Error nt<([^<>]+)>$/);
  if (weatherMatch) {
    const city = weatherMatch[1].trim();
     dolLog('>>> A ERROR BUG', 'err');
      dolLog('>❌Error!!! [stop run 1 line(code)] ', 'err');
      dolLog('Error:! Because "developers" no use this "烫烫烫[@waedr"code sorry my freind [stop now 1]', 'err');
      dolLog('only : .dolwrt / .dol <<<|end output log ', 'err');
    return true;
  }
  
  const translateMatch = line.match(/^\/err\/err<([^<>]+)>@([^<>]+)$/);
  if (translateMatch) {
    const text = translateMatch[1].trim();
    const target = translateMatch[2].trim();
     dolLog('>>> A ERROR BUG', 'err');
      dolLog('>❌Error!!! [stop run 1 line(code)] ', 'err');
      dolLog('Error:! Because "developers" no use this "try"code sorry my freind [stop now 1]', 'err');
      dolLog('only : .dolwrt / .dol <<<|end output log ', 'err');
    return true;
  }
  
  const qrcodeMatch = line.match(/^\/sv\/qrcode<([^<>]+)>$/);
  if (qrcodeMatch) {
    const content = qrcodeMatch[1].trim();
    dolLog(`📱 : ${content}`, 'info');
    const qrDiv = document.createElement('div');
    qrDiv.style.cssText = 'padding:20px;background:#fff;margin:10px;display:inline-block;';
    qrDiv.innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(content)}">`;
    const output = document.querySelector('.dol-output');
    if (output) output.appendChild(qrDiv);
    return true;
  }
  
  const unitMatch = line.match(/^\/sv\/unit<([^<>]+)><([^<>]+)>@([^<>]+)$/);
  if (unitMatch) {
    const value = unitMatch[1].trim();
    const from = unitMatch[2].trim();
    const to = unitMatch[3].trim();
    dolLog(`📏 ${value} ${from} → ${to}`, 'info');
    const conversions = {
      'cm->m': parseFloat(value) / 100,
      'm->km': parseFloat(value) / 1000,
      'kg->lb': parseFloat(value) * 2.20462,
      'c->f': parseFloat(value) * 1.8 + 32
    };
    const key = `${from}->${to}`;
    if (conversions[key]) {
      dolLog(`  结果: ${conversions[key]} ${to}`, 'out');
    } else {
      dolLog(`  结果: [模拟单位转换]`, 'out');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：录屏/直播/麦克风指令】 ==========
// ==================================================
// /ur/start       开始录屏
// /ur/stop        停止录屏
// /ur/live.b      开始直播
// /um/test        麦克风测试
// /um/on          麦克风开启
// /um/off         麦克风关闭

let recordingStream = null;
let mediaRecorder = null;
let recordedChunks = [];
let isLiveStreaming = false;

function parseRecordingCmd(line) {
  const trimmedLine = line.trim();
  
  if (trimmedLine === '/ur/start') {
    startRecording();
    return true;
  }
  
  if (trimmedLine === '/ur/live.b') {
    startLiveStream();
    return true;
  }
  
  if (trimmedLine === '/ur/stop') {
    stopRecording();
    return true;
  }
  
  if (trimmedLine === '/ur/status') {
    showRecordingStatus();
    return true;
  }
  
  return false;
}

function parseMicrophoneCmd(line) {
  const trimmedLine = line.trim();
  
  if (trimmedLine === '/um/test') {
    testMicrophone();
    return true;
  }
  
  if (trimmedLine === '/um/on') {
    toggleMicrophone(true);
    return true;
  }
  
  if (trimmedLine === '/um/off') {
    toggleMicrophone(false);
    return true;
  }
  
  return false;
}

function startRecording() {
  navigator.mediaDevices.getDisplayMedia({
    video: { cursor: 'always' },
    audio: true
  }).then(stream => {
    recordingStream = stream;
    dolMediaStreams.push(stream); // 注册到全局，便于统一清理
    recordedChunks = [];
    
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) recordedChunks.push(e.data);
    };
    mediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `recording_${Date.now()}.webm`;
      a.click();
      URL.revokeObjectURL(url);
      dolLog(`✅ 录屏已保存`, 'suc');
    };
    
    mediaRecorder.start();
    dolLog(`✅ 录屏已开始`, 'suc');
    dolLog(`💡 使用 /ur/stop 停止录屏`, 'info');
    
    stream.getVideoTracks()[0].onended = () => {
      dolLog(`⚠️ 用户停止了屏幕共享`, 'warn');
      stopRecording();
    };
  }).catch(err => {
    dolLog(`❌ 无法开始录屏: ${err.message}`, 'err');
  });
}

function startLiveStream() {
  navigator.mediaDevices.getDisplayMedia({
    video: { cursor: 'always' },
    audio: true
  }).then(stream => {
    recordingStream = stream;
    dolMediaStreams.push(stream); // 注册到全局，便于统一清理
    isLiveStreaming = true;
    
    // 创建直播窗口
    const liveWin = document.createElement('div');
    liveWin.id = 'liveStreamWindow';
    liveWin.style.cssText = `position:fixed;top:60px;left:10px;right:10px;bottom:100px;background:#000;z-index:9999;border-radius:10px;`;
    
    const video = document.createElement('video');
    video.srcObject = stream;
    video.autoplay = true;
    video.style.cssText = 'width:100%;height:100%;object-fit:contain;';
    
    liveWin.appendChild(video);
    document.body.appendChild(liveWin);
    
    dolLog(`✅ 直播已开始`, 'suc');
    dolLog(`💡 使用 /ur/stop 停止直播`, 'info');
    
    stream.getVideoTracks()[0].onended = () => {
      dolLog(`⚠️ 用户停止了屏幕共享`, 'warn');
      stopRecording();
    };
  }).catch(err => {
    dolLog(`❌ 无法开始直播: ${err.message}`, 'err');
  });
}

function stopRecording() {
  if (mediaRecorder && mediaRecorder.state !== 'inactive') {
    mediaRecorder.stop();
  }
  if (recordingStream) {
    recordingStream.getTracks().forEach(track => track.stop());
    recordingStream = null;
  }
  isLiveStreaming = false;
  
  const liveWin = document.getElementById('liveStreamWindow');
  if (liveWin) liveWin.remove();
  
  dolLog(`✅ 录屏/直播已停止`, 'suc');
}

function showRecordingStatus() {
  dolLog(`📊 录屏状态:`, 'info');
  dolLog(`  正在录制: ${mediaRecorder && mediaRecorder.state === 'recording' ? '是' : '否'}`, 'out');
  dolLog(`  正在直播: ${isLiveStreaming ? '是' : '否'}`, 'out');
  dolLog(`  数据块数: ${recordedChunks.length}`, 'out');
}

function testMicrophone() {
  navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
    dolLog(`✅ 麦克风测试成功`, 'suc');
    stream.getTracks().forEach(track => track.stop());
  }).catch(err => {
    dolLog(`❌ 麦克风测试失败: ${err.message}`, 'err');
  });
}

function toggleMicrophone(on) {
  dolLog(`${on ? '✅' : '❌'} 麦克风${on ? '开启' : '关闭'}（模拟）`, 'info');
}

// ==================================================
// ========== 【社交类指令 /sc/】 ==========
// ==================================================
// /sc/share<平台><内容>    分享内容
// /sc/message<用户><内容> 发送消息
// /sc/follow<用户>       关注用户
// /sc/unfollow<用户>     取消关注
// /sc/profile<用户>      查看用户资料
// /sc/notify<内容>       发送通知
// /sc/like<内容>         点赞

function parseScCmd(cmd) {
  const line = cmd.trim();
  
  const shareMatch = line.match(/^\/sc\/share<([^<>]+)><([^<>]+)>$/);
  if (shareMatch) {
    const platform = shareMatch[1].trim();
    const content = shareMatch[2].trim();
    dolLog(`📤 分享到 ${platform}: ${content}`, 'info');
    dolLog(`  ✅ 分享成功`, 'suc');
    return true;
  }
  
  const messageMatch = line.match(/^\/sc\/message<([^<>]+)><([^<>]+)>$/);
  if (messageMatch) {
    const user = messageMatch[1].trim();
    const content = messageMatch[2].trim();
    dolLog(`💬 发送消息给 ${user}: ${content}`, 'info');
    dolLog(`  ✅ 消息已发送`, 'suc');
    return true;
  }
  
  const followMatch = line.match(/^\/sc\/follow<([^<>]+)>$/);
  if (followMatch) {
    const user = followMatch[1].trim();
    dolLog(`➕ 关注用户: ${user}`, 'info');
    dolLog(`  ✅ 关注成功`, 'suc');
    return true;
  }
  
  const unfollowMatch = line.match(/^\/sc\/unfollow<([^<>]+)>$/);
  if (unfollowMatch) {
    const user = unfollowMatch[1].trim();
    dolLog(`➖ 取消关注: ${user}`, 'info');
    dolLog(`  ✅ 已取消关注`, 'suc');
    return true;
  }
  
  const profileMatch = line.match(/^\/sc\/profile<([^<>]+)>$/);
  if (profileMatch) {
    const user = profileMatch[1].trim();
    dolLog(`👤 用户资料: ${user}`, 'info');
    dolLog(`  📊 粉丝: 1,234`, 'out');
    dolLog(`  📝 动态: 56`, 'out');
    dolLog(`  🏷️ 标签: 开发者,设计师`, 'out');
    return true;
  }
  
  const notifyMatch = line.match(/^\/sc\/notify<([^<>]+)>$/);
  if (notifyMatch) {
    const content = notifyMatch[1].trim();
    dolLog(`🔔 发送通知: ${content}`, 'info');
    if (Notification.permission === 'granted') {
      new Notification('通知', { body: content });
    } else {
      Notification.requestPermission();
    }
    return true;
  }
  
  const likeMatch = line.match(/^\/sc\/like<([^<>]+)>$/);
  if (likeMatch) {
    const content = likeMatch[1].trim();
    dolLog(`❤️ 点赞: ${content}`, 'info');
    dolLog(`  ✅ 点赞成功`, 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【导入第三方扩展类指令 /ex/】 ==========
// ==================================================
// /ex/import<库名>     导入第三方库（jquery/vue/react/chartjs）
// /ex/load<URL>        加载外部脚本
// /ex/css<URL>         加载外部样式
// /ex/use<插件名>      使用插件
// /ex/list             列出已加载扩展
// /ex/unload<库名>     卸载扩展
// /ex/check<库名>      检查扩展状态

function parseExCmd(cmd) {
  const line = cmd.trim();
  
  const importMatch = line.match(/^\/ex\/import<([^<>]+)>$/);
  if (importMatch) {
    const lib = importMatch[1].trim().toLowerCase();
    const libs = {
      'jquery': 'https://code.jquery.com/jquery-3.6.0.min.js',
      'vue': 'https://unpkg.com/vue@3/dist/vue.global.js',
      'react': 'https://unpkg.com/react@18/umd/react.development.js',
      'chartjs': 'https://cdn.jsdelivr.net/npm/chart.js'
    };
    if (libs[lib]) {
      const script = document.createElement('script');
      script.src = libs[lib];
      script.onload = () => dolLog(`✅ 已加载 ${lib}`, 'suc');
      script.onerror = () => dolLog(`❌ 加载 ${lib} 失败`, 'err');
      document.head.appendChild(script);
      dolLog(`📦 正在加载 ${lib}...`, 'info');
    } else {
      dolLog(`❌ 未知库: ${lib}`, 'err');
    }
    return true;
  }
  
  const loadMatch = line.match(/^\/ex\/load<([^<>]+)>$/);
  if (loadMatch) {
    const url = loadMatch[1].trim();
    const script = document.createElement('script');
    script.src = url;
    script.onload = () => dolLog(`✅ 已加载 ${url}`, 'suc');
    script.onerror = () => dolLog(`❌ 加载 ${url} 失败`, 'err');
    document.head.appendChild(script);
    dolLog(`📥 正在加载脚本: ${url}...`, 'info');
    return true;
  }
  
  const cssMatch = line.match(/^\/ex\/css<([^<>]+)>$/);
  if (cssMatch) {
    const url = cssMatch[1].trim();
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = url;
    link.onload = () => dolLog(`✅ 已加载样式: ${url}`, 'suc');
    link.onerror = () => dolLog(`❌ 加载样式失败`, 'err');
    document.head.appendChild(link);
    dolLog(`🎨 正在加载样式: ${url}...`, 'info');
    return true;
  }
  
  const useMatch = line.match(/^\/ex\/use<([^<>]+)>$/);
  if (useMatch) {
    const plugin = useMatch[1].trim();
    dolLog(`🔌 使用插件: ${plugin}`, 'info');
    dolLog(`  ✅ 插件已激活`, 'suc');
    return true;
  }
  
  if (line === '/ex/list') {
    dolLog(`📋 已加载扩展:`, 'info');
    const scripts = document.querySelectorAll('script[src]');
    scripts.forEach(s => dolLog(`  • ${s.src}`, 'out'));
    return true;
  }
  
  const unloadMatch = line.match(/^\/ex\/unload<([^<>]+)>$/);
  if (unloadMatch) {
    const lib = unloadMatch[1].trim();
    dolLog(`🗑️ 卸载扩展: ${lib}`, 'info');
    dolLog(`  ✅ 已卸载`, 'suc');
    return true;
  }
  
  const checkMatch = line.match(/^\/ex\/check<([^<>]+)>$/);
  if (checkMatch) {
    const lib = checkMatch[1].trim();
    dolLog(`🔍 检查扩展: ${lib}`, 'info');
    dolLog(`  状态: 已加载`, 'out');
    dolLog(`  版本: 1.0.0`, 'out');
    return true;
  }
  
  return false;
}

