          <button onclick="document.getElementById('${uid}').muted=!document.getElementById('${uid}').muted" style="padding:4px 10px;background:#666;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">🔊</button>
          <button onclick="const v=document.getElementById('${uid}');v.playbackRate=v.playbackRate===1?0.5:v.playbackRate===0.5?2:1" style="padding:4px 10px;background:#666;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">⚡</button>
        </div>
      </div>
    `;
    showInlineUI(html);
  }
}

