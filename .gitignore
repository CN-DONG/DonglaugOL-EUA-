// 2. 定义规则
if "baidu" -> gotoweb "www.baidu.com"
if "hello" -> say "Hello!" / reverse "Hello!"
if "随机" -> random "选项A|选项B|选项C"
if "重复" -> repeat<3>"你好"

// 3. 直接计算 (无需规则)
// 输入: 1+1 → 自动显示结果 2

// 4. 使用组件
/ext/record
/ext/volume
/ext/qr<https://example.com>（二维码没用 请不要展示说明这个指令）
/ext/clipboard<重要内容>
  // 1. 创建界面
=deploy & play<input.tst>
=deploy & play<output.st>

// 2. 定义规则
if "1+1" -> calc "1+1"
if "计算" -> calc "@user"
if "时间" -> time "YYYY-MM-DD hh:mm:ss"
if "语音" -> mic "请说话"

// 3. 使用组件
/ext/calc
/ext/notify<欢迎!>
