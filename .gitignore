  const dictionary = {
    'hello': '你好，问候语',
    'world': '世界，地球',
    'computer': '计算机，电脑',
    'program': '程序，编程',
    'code': '代码，编码',
    'language': '语言',
    'system': '系统',
    'window': '窗口',
    'button': '按钮',
    'clock': '时钟',
    'timer': '计时器',
    'alarm': '闹钟',
    'calendar': '日历',
    'todo': '待办事项',
    'calculator': '计算器',
    'music': '音乐',
    'video': '视频',
    'audio': '音频',
    'image': '图片',
    'file': '文件',
    'network': '网络',
    'process': '进程',
    'setting': '设置',
    'help': '帮助',
    'exit': '退出',
    'clear': '清除'
  };
  
  searchBtn.onclick = () => {
    const word = input.value.trim().toLowerCase();
    if (!word) {
      result.textContent = '请输入要查询的单词';
      return;
    }
    
    if (dictionary[word]) {
      result.innerHTML = `<strong style="color:#5a9bd4;">${word}</strong><br>${dictionary[word]}`;
    } else {
      result.textContent = `未找到 "${word}" 的释义`;
    }
  };
  
  input.onkeydown = (e) => {
    if (e.key === 'Enter') searchBtn.click();
  };
  
  dolLog(`✅ 词典窗口创建成功`, 'suc');
}
function createPaintWindow() {
  const win = createBaseWindow('Paint', 400, 350, 700, 300, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.gap = '8px';
  content.style.padding = '10px';
  
  const toolbar = document.createElement('div');
  toolbar.style.display = 'flex';
  toolbar.style.gap = '8px';
  toolbar.style.alignItems = 'center';
  
  const colorPicker = document.createElement('input');
  colorPicker.type = 'color';
  colorPicker.value = '#ffffff';
  colorPicker.style.width = '36px';
  colorPicker.style.height = '28px';
  colorPicker.style.cursor = 'pointer';
  
  const sizeInput = document.createElement('input');
  sizeInput.type = 'range';
  sizeInput.min = '1';
  sizeInput.max = '20';
  sizeInput.value = '3';
  sizeInput.style.width = '80px';
  
  const clearBtn = document.createElement('button');
  clearBtn.textContent = '清空';
  clearBtn.style.padding = '4px 12px';
  clearBtn.style.background = '#ff6b6b';
  clearBtn.style.border = 'none';
  clearBtn.style.borderRadius = '4px';
  clearBtn.style.color = '#fff';
  clearBtn.style.cursor = 'pointer';
  
  toolbar.appendChild(colorPicker);
  toolbar.appendChild(sizeInput);
  toolbar.appendChild(clearBtn);
  
  const canvas = document.createElement('canvas');
  canvas.width = 380;
  canvas.height = 280;
  canvas.style.background = '#1a1f28';
  canvas.style.borderRadius = '6px';
  canvas.style.cursor = 'crosshair';
  
  content.appendChild(toolbar);
  content.appendChild(canvas);
  
  const ctx = canvas.getContext('2d');
  let isDrawing = false;
  
  canvas.onmousedown = (e) => {
    isDrawing = true;
    const rect = canvas.getBoundingClientRect();
    ctx.beginPath();
    ctx.moveTo(e.clientX - rect.left, e.clientY - rect.top);
    ctx.strokeStyle = colorPicker.value;
    ctx.lineWidth = sizeInput.value;
    ctx.lineCap = 'round';
  };
  
  canvas.onmousemove = (e) => {
    if (!isDrawing) return;
    const rect = canvas.getBoundingClientRect();
    ctx.lineTo(e.clientX - rect.left, e.clientY - rect.top);
    ctx.stroke();
  };
  
  canvas.onmouseup = () => isDrawing = false;
  canvas.onmouseleave = () => isDrawing = false;
  
  clearBtn.onclick = () => {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#1a1f28';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  };
  
  ctx.fillStyle = '#1a1f28';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  
  dolLog(`✅ 画板窗口创建成功`, 'suc');
}
function createSciCalcWindow() {
  const win = createBaseWindow('Scientific Calculator', 320, 420, 900, 200, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.display = 'flex';
  content.style.flexDirection = 'column';
  content.style.padding = '10px';
  
  const display = document.createElement('div');
  display.style.background = '#1a1f28';
  display.style.borderRadius = '8px';
  display.style.padding = '15px';
  display.style.textAlign = 'right';
  display.style.fontSize = '24px';
  display.style.fontFamily = 'monospace';
  display.style.color = '#fff';
  display.style.minHeight = '50px';
  display.textContent = '0';
  
  content.appendChild(display);
  
  const buttons = [
    ['sin', 'cos', 'tan', 'log'],
    ['sqrt', 'pow', 'pi', 'e'],
    ['(', ')', '%', 'C'],
    ['7', '8', '9', '/'],
    ['4', '5', '6', '*'],
    ['1', '2', '3', '-'],
    ['0', '.', '=', '+']
  ];
  
  const grid = document.createElement('div');
  grid.style.display = 'grid';
  grid.style.gridTemplateColumns = 'repeat(4, 1fr)';
  grid.style.gap = '5px';
  grid.style.marginTop = '10px';
  
  buttons.forEach(row => {
    row.forEach(btnText => {
      const btn = document.createElement('button');
      btn.textContent = btnText;
      btn.style.padding = '12px';
      btn.style.fontSize = '14px';
      btn.style.border = 'none';
      btn.style.borderRadius = '6px';
      btn.style.cursor = 'pointer';
      
      if (['+', '-', '*', '/', '=', 'sin', 'cos', 'tan', 'log', 'sqrt', 'pow'].includes(btnText)) {
        btn.style.background = '#5a9bd4';
        btn.style.color = '#fff';
      } else if (btnText === 'C') {
        btn.style.background = '#ff6b6b';
        btn.style.color = '#fff';
      } else {
        btn.style.background = '#4a4f58';
        btn.style.color = '#fff';
      }
      
      btn.onclick = () => {
        if (btnText === 'C') {
          display.textContent = '0';
        } else if (btnText === '=') {
          try {
            let expr = display.textContent;
            expr = expr.replace(/sin\(/g, 'Math.sin(');
            expr = expr.replace(/cos\(/g, 'Math.cos(');
            expr = expr.replace(/tan\(/g, 'Math.tan(');
            expr = expr.replace(/log\(/g, 'Math.log10(');
            expr = expr.replace(/sqrt\(/g, 'Math.sqrt(');
            expr = expr.replace(/pow\(/g, 'Math.pow(');
            expr = expr.replace(/\bpi\b/g, 'Math.PI');
            expr = expr.replace(/(?<![a-zA-Z.])e(?![a-zA-Z0-9])/g, 'Math.E');
            expr = expr.replace(/×/g, '*');
            // 安全验证：替换掉 Math 函数后只允许数字和运算符
            const safeExpr = expr.replace(/Math\.\w+(\([^)]*\))?/g, '0');
            if (/^[\d\s+\-*/().]+$/.test(safeExpr)) {
              display.textContent = eval(expr);
            } else {
              display.textContent = 'Error';
            }
          } catch {
            display.textContent = 'Error';
          }
        } else {
          if (display.textContent === '0' || display.textContent === 'Error') {
            display.textContent = btnText;
          } else {
            display.textContent += btnText;
          }
        }
      };
      
      grid.appendChild(btn);
    });
  });
  
  content.appendChild(grid);
  
  dolLog(`✅ 科学计算器窗口创建成功`, 'suc');
}
function parseDolPrintColor(cmd) {
  const reg = /^pr\.c\*\/(.+)=\[(.+)\]$/;
  const match = cmd.match(reg);
  if (!match) return false;
  const [, text, color] = match;
  const outputList = document.querySelectorAll('.dol-output');
  const output = outputList[outputList.length - 1];
  if (!output) {
    console.log(`%c${text}`, `color: ${color}`);
    return false;
  }
  const d = document.createElement('div');
  d.className = 'line';
  d.textContent = text;
  d.style.color = color;
  output.appendChild(d);
  output.scrollTop = output.scrollHeight;
  allComponents.push(d);
  return true;
}
function parseDolPrintSize(cmd) {
  const reg = /^pr\.z\*\/(.+)=\[(\d+)\]$/;
  const match = cmd.match(reg);
  if (!match) return false;
  const [, text, size] = match;
  const outputList = document.querySelectorAll('.dol-output');
  const output = outputList[outputList.length - 1];
  if (!output) {
    console.log(`%c${text}`, `font-size: ${size}px`);
    return false;
  }
  const d = document.createElement('div');
  d.className = 'line';
  d.textContent = text;
  d.style.fontSize = `${size}px`;
  output.appendChild(d);
  output.scrollTop = output.scrollHeight;
  allComponents.push(d);
  return true;
}
function parseDolPrintMultiLine(cmd) {
  const reg = /^pr\.o\*\/(.+)=\[(\d+)\]$/;
  const match = cmd.match(reg);
  if (!match) return false;
  const [, text, lineCount] = match;
  const count = parseInt(lineCount);
  if (isNaN(count) || count < 1) {
    dolLog('❌ 行数错误，必须为≥1的数字', 'err');
    return false;
  }
  const outputList = document.querySelectorAll('.dol-output');
  const output = outputList[outputList.length - 1];
  if (!output) {
    for (let i = 0; i < count; i++) console.log(text);
    return false;
  }
  for (let i = 0; i < count; i++) {
    const d = document.createElement('div');
    d.className = 'line out';
    d.textContent = text;
    output.appendChild(d);
  }
  output.scrollTop = output.scrollHeight;
  dolLog(`✅ 多行输出完成：${count}行`, 'run');
  return true;
}
function parseDolEgg(cmd) {
  if (cmd === '/egg/Dongper language computer language') {
    dolLog('🥚 彩蛋触发！Dongper Language 专属彩蛋解锁！', 'egg');
    const lightList = document.querySelectorAll('.dol-light');
    const light = lightList[lightList.length - 1];
    if (light) {
      const originalColor = light.style.background || '#0066ff';
      let i = 0;
      const colors = ['#ff69b4', '#00ffff', '#ff00ff', '#ffff00'];
      const interval = setInterval(() => {
        light.style.background = colors[i % colors.length];
        light.style.boxShadow = `0 0 40px ${colors[i % colors.length]}`;
        i++;
        if (i > 10) {
          clearInterval(interval);
          light.style.background = originalColor;
          light.style.boxShadow = originalColor ? `0 0 40px ${originalColor}` : '0 0 40px #0066ff';
        }
      }, 200);
      timerList.push(interval);
    }
    if (!dolMusicContext) {
      dolMusicContext = new (window.AudioContext || window.webkitAudioContext)();
    }
    const oscillator = dolMusicContext.createOscillator();
    const gainNode = dolMusicContext.createGain();
    oscillator.type = 'sine';
    oscillator.frequency.value = 1760;
    gainNode.gain.value = 0.2;
    oscillator.connect(gainNode);
    gainNode.connect(dolMusicContext.destination);
    oscillator.start();
    oscillator.stop(dolMusicContext.currentTime + 0.3);
    setTimeout(() => {
      const oscillator2 = dolMusicContext.createOscillator();
      const gainNode2 = dolMusicContext.createGain();
      oscillator2.type = 'sine';
      oscillator2.frequency.value = 2093;
      gainNode2.gain.value = 0.2;
      oscillator2.connect(gainNode2);
      gainNode2.connect(dolMusicContext.destination);
      oscillator2.start();
      oscillator2.stop(dolMusicContext.currentTime + 0.3);
    }, 300);
    return true;
  }
  if (cmd === '/egg/3Dmagic') {
    dolLog('🥚 彩蛋触发！3D魔法解锁！', 'egg');
    // 创建一个漂浮的3D立方体动画
    const magicCube = document.createElement('div');
    magicCube.style.cssText = `
      position: fixed;
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 8px;
      left: 50%;
      top: 50%;
      margin-left: -30px;
      margin-top: -30px;
      z-index: 9999;
      animation: floatCube 2s ease-in-out infinite;
      box-shadow: 0 0 30px rgba(102, 126, 234, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 24px;
    `;
    magicCube.textContent = '🎲';
    document.body.appendChild(magicCube);
    allComponents.push(magicCube);
    
    // 添加动画样式
    const style = document.createElement('style');
    style.textContent = `
      @keyframes floatCube {
        0%, 100% { transform: translate(-50%, -50%) rotate(0deg) scale(1); }
        25% { transform: translate(-50%, -50%) rotate(90deg) scale(1.2); }
        50% { transform: translate(-50%, -50%) rotate(180deg) scale(1); }
        75% { transform: translate(-50%, -50%) rotate(270deg) scale(1.2); }
      }
    `;
    document.head.appendChild(style);
    
    setTimeout(() => {
      magicCube.remove();
      dolLog('✨ 3D魔法消散...', 'stage');
    }, 5000);
    return true;
  }
  return false;
}
function parseDolDevMode(cmd) {
  if (cmd === '/dol/developers>>>open') {
    devMode = true;
    const devTag = document.createElement('div');
    devTag.className = 'dev-mode-tag';
    devTag.textContent = 'DEV MODE 开发者模式';
    document.body.appendChild(devTag);
    allComponents.push(devTag);
    
    dolLog('🔧 开发者模式已开启！欢迎回来，开发者', 'stage');
    dolLog('✅ 已解锁全部开发者专属指令', 'suc');
    
    const outputList = document.querySelectorAll('.dol-output');
    const output = outputList[outputList.length - 1];
    if (output) {
      const devCmdList = [
        '   /close → 关闭开发者模式',
        '   /debug → 开启/关闭实时调试面板',
        '   /save → 保存代码为.dolwrt',
        '   /save/standalone → 保存为可独立运行的.dolwrt',
        '   /run/file → 打开并运行.dolwrt文件',
        'save<自定义后缀名> → 自定义后缀名保存代码',
        '   /exit → 退出当前页面',
        '   /win1000 → 批量生成1000个测试窗口',
        '   /file1000 → 批量下载1000个测试文件',
        '   /clearvar → 清空所有变量与数组',
        '   /fullscreen → 切换全屏显示',
        '   /lockui → 锁定/解锁所有UI控件',
        '   /hideall → 隐藏所有页面控件',
        '   /showall → 显示所有页面控件',
        '   /reload → 重置环境不清除代码',
        '   /exportcfg → 导出当前环境配置',
        '   /topall → 所有窗口置顶'
      ];
      devCmdList.forEach(item => {
        const el = document.createElement('div');
        el.className = 'line out';
        el.textContent = item;
        output.appendChild(el);
      });
      output.scrollTop = output.scrollHeight;
    }
    return true;
  }
  return false;
}
// ==================================================
// ========== 【新增：员工模式指令处理函数】 ==========
// ==================================================
function parseDolMembersMode(cmd) {
