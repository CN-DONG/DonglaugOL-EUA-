function createSetWindow() {
  if (funcWindowCache.set) {funcWindowCache.set.classList.remove('hide');return funcWindowCache.set;}
  const win = createBaseWindow('系统设置', 500, 500, 600, 200);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div class="sys-setting">
      <div class="sys-setting-item">
        <label class="sys-setting-label">桌面背景色：</label>
        <input type="color" class="sys-setting-input" id="bgColor" value="#2c3036">
      </div>
      <div class="sys-setting-item">
        <label class="sys-setting-label">桌面背景图：</label>
        <label class="sys-setting-btn" style="margin:0;padding:5px 10px;" for="bgImageInput">选择图片</label>
        <input type="file" class="sys-img-input" id="bgImageInput" accept="image/*" style="display:none;">
      </div>
      <div class="sys-setting-item">
        <label class="sys-setting-label">按钮默认色：</label>
        <input type="color" class="sys-setting-input" id="btnColor" value="#5a7ca3">
      </div>
      <div class="sys-setting-item">
        <label class="sys-setting-label">全局字体大小：</label>
        <input type="number" class="sys-setting-input" id="fontSize" value="14" min="8" max="32">
      </div>
      <div class="sys-setting-item">
        <label class="sys-setting-label">日志区高度：</label>
        <input type="number" class="sys-setting-input" id="logHeight" value="320" min="100" max="800">
      </div>
      <button class="sys-setting-btn" id="saveSet">保存设置</button>
    </div>
  `;
  
  // 背景图预览
  const bgImageInput = win.querySelector('#bgImageInput');
  bgImageInput.onchange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      document.body.style.backgroundImage = `url(${ev.target.result})`;
      document.body.style.backgroundSize = 'cover';
      document.body.style.backgroundPosition = 'center';
      document.body.style.backgroundRepeat = 'no-repeat';
      dolLog('✅ 背景图设置成功', 'suc');
    };
    reader.readAsDataURL(file);
  };
  
  // 保存设置
  win.querySelector('#saveSet').onclick = () => {
    const bgColor = win.querySelector('#bgColor').value;
    const btnColor = win.querySelector('#btnColor').value;
    const fontSize = win.querySelector('#fontSize').value + 'px';
    const logHeight = win.querySelector('#logHeight').value + 'px';
    
    // 背景色设置
    document.body.style.background = bgColor;
    document.body.style.backgroundImage = 'none';
    // 按钮色设置
    btnDefaultColor = btnColor;
    document.querySelectorAll('.sys-square-btn:not(.btn-disable):not(.switch-on)').forEach(btn => {
      btn.style.backgroundColor = btnColor;
    });
    // 字体大小设置
    document.body.style.fontSize = fontSize;
    // 日志区高度设置
    const outputList = document.querySelectorAll('.dol-output');
    const lastOutput = outputList[outputList.length - 1];
    if (lastOutput) lastOutput.style.setProperty('height', logHeight);
    
    dolLog(`✅ 系统设置已保存`, 'suc');
    dolLog(`背景色：${bgColor} | 按钮色：${btnColor} | 字体大小：${fontSize} | 日志高度：${logHeight}`, 'out');
  };
  
  funcWindowCache.set = win;
  dolLog(`✅ 系统设置窗口已创建`, 'suc');
  return win;
}

