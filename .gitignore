function embedCalc() {
  const uid = 'embed_calc_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <input type="text" id="${uid}_display" style="width:100%;background:#0a0a0f;color:#fff;border:none;padding:12px;font-size:20px;font-family:monospace;text-align:right;outline:none;border-radius:4px;margin-bottom:8px;" readonly />
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;">
        <button onclick="calcAppend('7')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">7</button>
        <button onclick="calcAppend('8')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">8</button>
        <button onclick="calcAppend('9')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">9</button>
        <button onclick="calcAppend('/')" style="padding:10px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;">÷</button>
        <button onclick="calcAppend('4')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">4</button>
        <button onclick="calcAppend('5')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">5</button>
        <button onclick="calcAppend('6')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">6</button>
        <button onclick="calcAppend('*')" style="padding:10px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;">×</button>
        <button onclick="calcAppend('1')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">1</button>
        <button onclick="calcAppend('2')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">2</button>
        <button onclick="calcAppend('3')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">3</button>
        <button onclick="calcAppend('-')" style="padding:10px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;">−</button>
        <button onclick="calcAppend('0')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">0</button>
        <button onclick="calcAppend('.')" style="padding:10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;">.</button>
        <button onclick="calcClear()" style="padding:10px;background:#666;color:#fff;border:none;border-radius:4px;cursor:pointer;">C</button>
        <button onclick="calcAppend('+')" style="padding:10px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;">+</button>
        <button onclick="calcEqual()" style="grid-column:span 4;padding:10px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:18px;">=</button>
      </div>
    </div>
  `;
  showInlineUI(html);
  
  const display = document.getElementById(uid + '_display');
  
  window.calcAppend = (v) => { display.value += v; };
  window.calcClear = () => { display.value = ''; };
  window.calcEqual = () => {
    try { display.value = eval(display.value); }
    catch { display.value = '错误'; }
  };
  dolLog(`✅ 计算器已嵌入`, 'suc');
}

function embedQRCode() {
  const uid = 'embed_qr_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div style="display:flex;gap:12px;align-items:center;">
        <canvas id="${uid}" width="128" height="128" style="border-radius:8px;background:#fff;"></canvas>
        <div>
          <input type="text" id="${uid}_input" style="width:200px;background:#0a0a0f;color:#fff;border:1px solid #333;padding:6px 8px;border-radius:4px;outline:none;" placeholder="输入内容生成二维码" />
          <button onclick="generateQR()" style="margin-top:8px;padding:6px 12px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;">生成</button>
        </div>
      </div>
    </div>
  `;
  showInlineUI(html);
  
  const canvas = document.getElementById(uid);
  const ctx = canvas.getContext('2d');
  const input = document.getElementById(uid + '_input');
  
  window.generateQR = () => {
    const text = input.value || 'Hello!';
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, 128, 128);
    ctx.fillStyle = '#000';
    for (let i = 0; i < 128; i += 8) {
      for (let j = 0; j < 128; j += 8) {
        if ((i < 24 && j < 24) || (i < 24 && j > 104) || (i > 104 && j < 24)) {
          ctx.fillRect(i, j, 8, 8);
        } else {
          const hash = text.split('').reduce((a, b) => a + b.charCodeAt(0), 0);
          if ((hash + i + j) % 3 === 0) ctx.fillRect(i, j, 8, 8);
        }
      }
    }
  };
  generateQR();
  dolLog(`✅ 二维码生成器已嵌入`, 'suc');
}

function embedColor() {
  const uid = 'embed_color_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div style="display:flex;gap:12px;align-items:center;">
        <input type="color" id="${uid}_picker" style="width:60px;height:60px;border:none;border-radius:8px;cursor:pointer;" />
        <div>
          <div id="${uid}_hex" style="color:#fff;font-family:monospace;margin-bottom:4px;">#000000</div>
          <div id="${uid}_rgb" style="color:#888;font-size:12px;">rgb(0, 0, 0)</div>
        </div>
      </div>
    </div>
  `;
  showInlineUI(html);
  
  const picker = document.getElementById(uid + '_picker');
  const hex = document.getElementById(uid + '_hex');
  const rgb = document.getElementById(uid + '_rgb');
  
  picker.addEventListener('input', () => {
    hex.textContent = picker.value.toUpperCase();
    const r = parseInt(picker.value.slice(1, 3), 16);
    const g = parseInt(picker.value.slice(3, 5), 16);
    const b = parseInt(picker.value.slice(5, 7), 16);
    rgb.textContent = `rgb(${r}, ${g}, ${b})`;
  });
  dolLog(`✅ 颜色选择器已嵌入`, 'suc');
}

function embedClock() {
  const uid = 'embed_clock_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div id="${uid}" style="font-family:monospace;font-size:36px;text-align:center;color:#5a9cf0;">--:--:--</div>
    </div>
  `;
  showInlineUI(html);
  
  const el = document.getElementById(uid);
  function update() {
    const now = new Date();
    el.textContent = now.toLocaleTimeString('zh-CN');
  }
  update();
  setInterval(update, 1000);
  dolLog(`✅ 时钟已嵌入`, 'suc');
}

function embedCalendar() {
  const uid = 'embed_cal_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div id="${uid}" style="font-size:14px;color:#fff;"></div>
    </div>
  `;
  showInlineUI(html);
  
  const el = document.getElementById(uid);
  const now = new Date();
  const year = now.getFullYear();
  const month = now.getMonth();
  const days = ['日', '一', '二', '三', '四', '五', '六'];
  
  let table = `<div style="text-align:center;font-size:18px;margin-bottom:8px;">${year}年${month + 1}月</div>`;
  table += `<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;">`;
  days.forEach(d => table += `<div style="text-align:center;color:#888;font-size:12px;">${d}</div>`);
  
  const firstDay = new Date(year, month, 1).getDay();
  const totalDays = new Date(year, month + 1, 0).getDate();
  
  for (let i = 0; i < firstDay; i++) table += `<div></div>`;
  for (let i = 1; i <= totalDays; i++) {
    const isToday = i === now.getDate();
    table += `<div style="text-align:center;padding:4px;border-radius:4px;${isToday ? 'background:#5a9cf0;color:#fff;' : ''}">${i}</div>`;
  }
  table += `</div>`;
  el.innerHTML = table;
  dolLog(`✅ 日历已嵌入`, 'suc');
}

function embedCountdown(param) {
  const uid = 'embed_countdown_' + Date.now();
  const target = param ? new Date(param).getTime() : new Date().getTime() + 60000;
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div id="${uid}" style="font-family:monospace;font-size:24px;text-align:center;color:#ff6b6b;">--:--:--</div>
    </div>
  `;
  showInlineUI(html);
  
  const el = document.getElementById(uid);
  function update() {
    const diff = target - new Date().getTime();
    if (diff <= 0) { el.textContent = '00:00:00'; return; }
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    el.textContent = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  }
  update();
  setInterval(update, 1000);
  dolLog(`✅ 倒计时已嵌入`, 'suc');
}

function embedMarkdown() {
  const uid = 'embed_md_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <textarea id="${uid}_input" style="width:100%;height:100px;border:none;background:#0a0a0f;color:#fff;padding:8px;font-family:monospace;font-size:13px;resize:none;outline:none;border-radius:4px;"># 标题

**粗体** 和 *斜体*

- 列表项1
- 列表项2</textarea>
      <button onclick="renderMD()" style="margin-top:4px;padding:4px 12px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;">预览</button>
      <div id="${uid}_output" style="margin-top:4px;padding:8px;background:#0a0a0f;border-radius:4px;color:#fff;"></div>
    </div>
  `;
  showInlineUI(html);
  
  const input = document.getElementById(uid + '_input');
  const output = document.getElementById(uid + '_output');
  
  window.renderMD = () => {
    let md = input.value;
    md = md.replace(/^### (.*)$/gm, '<h3 style="margin:0;">$1</h3>');
    md = md.replace(/^## (.*)$/gm, '<h2 style="margin:0;">$1</h2>');
    md = md.replace(/^# (.*)$/gm, '<h1 style="margin:0;">$1</h1>');
    md = md.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    md = md.replace(/\*(.*?)\*/g, '<em>$1</em>');
    md = md.replace(/^- (.*)$/gm, '<li>$1</li>');
    md = md.replace(/\n/g, '<br>');
    output.innerHTML = md;
  };
  renderMD();
  dolLog(`✅ Markdown编辑器已嵌入`, 'suc');
}

function embedTodo() {
  const uid = 'embed_todo_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <input type="text" id="${uid}_input" style="width:100%;background:#0a0a0f;color:#fff;border:none;padding:6px 8px;border-radius:4px;outline:none;margin-bottom:8px;" placeholder="添加待办事项..." />
      <ul id="${uid}_list" style="list-style:none;padding:0;margin:0;"></ul>
    </div>
  `;
  showInlineUI(html);
  
  const input = document.getElementById(uid + '_input');
  const list = document.getElementById(uid + '_list');
  
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && input.value.trim()) {
      const li = document.createElement('li');
      li.style.cssText = 'padding:6px 8px;border-bottom:1px solid #333;color:#fff;display:flex;align-items:center;gap:8px;';
      li.innerHTML = `<input type="checkbox" onchange="this.parentElement.style.textDecoration=this.checked?'line-through':'none'" />${input.value}<button onclick="this.parentElement.remove()" style="margin-left:auto;padding:2px 6px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:10px;">删除</button>`;
      list.appendChild(li);
      input.value = '';
    }
  });
  dolLog(`✅ 待办事项已嵌入`, 'suc');
}

