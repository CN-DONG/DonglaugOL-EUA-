  }

  // /dol/asl<ese>exit - 全屏模式（显示按钮）
  const fullscreenMatch = line.match(/^\/dol\/asl<([^>]+)>exit$/);
  if (fullscreenMatch) {
    const fullscreenBtn = document.createElement('button');
    fullscreenBtn.textContent = '⛶ 全屏';
    fullscreenBtn.style.cssText = `
