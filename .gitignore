    dolLog('存储位置选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  // /ns/audio 音频格式选择框
  if (line === '/ns/audio' || line.startsWith('/ns/audio<')) {
    const labelMatch = line.match(/^\/ns\/audio(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nsaud' + Date.now();
    let html = '<div style="width:320px;padding:10px;border-radius:12px;background:#e0e4eb;margin:10px;">';
    if (customLabel) { html += '<div style="color:#333;font-size:14px;margin-bottom:6px;font-weight:500;">' + escapeHtml(customLabel) + '</div>'; }
    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>MP3</option><option>WAV</option><option>FLAC</option><option>AAC</option><option>OGG</option></select></div>';
    showInlineUI(html);
    var audEl = document.getElementById(uid);
    if (audEl) audEl.addEventListener('change', function() { const act = window.__nsCustomAction || '音频格式选择'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('音频格式选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  // /ns/video 视频格式选择框
  if (line === '/ns/video' || line.startsWith('/ns/video<')) {
    const labelMatch = line.match(/^\/ns\/video(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nsvid' + Date.now();
