}

function parsePrImport(cmd) {
  const match = cmd.match(/^pr\.import<(.+)>$/);
  if (!match) return false;
  const file = match[1];
  dolLog(`📥 导入文件: ${file}`, 'info');
  return true;
}

function parseFileExport(cmd) {
  const match = cmd.match(/^file\.export<(.+)>@<(html|pdf|md|txt)>$/);
  if (!match) return false;
  const varName = match[1];
  const format = match[2];
  const content = dolVars[varName] || '';
  let mimeType = 'text/plain';
  let ext = 'txt';
  
  if (format === 'html') {
    mimeType = 'text/html';
    ext = 'html';
  } else if (format === 'pdf') {
    mimeType = 'application/pdf';
    ext = 'pdf';
  } else if (format === 'md') {
    mimeType = 'text/markdown';
    ext = 'md';
  }
  
  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `export_${Date.now()}.${ext}`;
  a.click();
  URL.revokeObjectURL(url);
  dolLog(`📤 已导出: ${varName} (${format})`, 'suc');
  return true;
}

function parseFileTemplate(cmd) {
  const match = cmd.match(/^file\.template<(.+)>$/);
  if (!match) return false;
  const type = match[1];
  const templates = {
    'html': '<!DOCTYPE html><html><head><title></title></head><body></body></html>',
    'csv': 'name,value\n',
    'json': '{}'
  };
  dolVars['template'] = templates[type] || '';
  dolLog(`📋 模板已加载: ${type}`, 'suc');
  return true;
}

function parseFileApply(cmd) {
  const match = cmd.match(/^file\.apply<(.+)>$/);
  if (!match) return false;
  const template = match[1];
  dolLog(`🔧 应用模板: ${template}`, 'info');
  return true;
}

function parseFileBatch(cmd) {
  const match = cmd.match(/^file\.batch<(.+)>$/);
  if (!match) return false;
  const commands = match[1].split(',');
  dolLog(`📦 批量处理 ${commands.length} 个文件`, 'suc');
  return true;
}

function parseFileAnalyze(cmd) {
  const match = cmd.match(/^file\.analyze<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const content = dolVars[varName] || '';
  const lines = content.split('\n').length;
  const chars = content.length;
  dolLog(`📊 分析结果: ${lines}行, ${chars}字符`, 'out');
  return true;
}

function parseFileValidate(cmd) {
  const match = cmd.match(/^file\.validate<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const content = dolVars[varName] || '';
  let isValid = true;
  if (content.length > 1000000) isValid = false;
  dolLog(`✅ 验证${isValid ? '通过' : '失败'}`, isValid ? 'suc' : 'err');
  return true;
}

function parseFileStat(cmd) {
  const match = cmd.match(/^file\.stat<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const content = dolVars[varName] || '';
  const stats = {
    lines: content.split('\n').length,
    chars: content.length,
    words: content.split(/\s+/).length,
    size: (new Blob([content])).size
  };
  dolLog(`📊 文件统计: ${JSON.stringify(stats)}`, 'out');
  return true;
}

function parseSearchList(cmd) {
  const match = cmd.match(/^search\.list<(.+)>$/);
  if (!match) return false;
  const keywords = match[1];
  dolLog(`🔍 搜索列表: ${keywords}`, 'info');
  return true;
}

function parseSearchFilter(cmd) {
  const match = cmd.match(/^search\.filter<(.+)>$/);
  if (!match) return false;
  const filter = match[1];
  dolLog(`🔍 搜索过滤: ${filter}`, 'info');
  return true;
}

function parseSearchHighlight(cmd) {
  const match = cmd.match(/^search\.highlight<(.+)>$/);
  if (!match) return false;
  const keyword = match[1];
  dolLog(`🔍 高亮搜索: ${keyword}`, 'info');
  return true;
}

function parseSearchHistory(cmd) {
  if (cmd !== 'search.history') return false;
  const history = localStorage.getItem('searchHistory');
  dolLog(`🔍 搜索历史: ${history ? escapeHtml(history) : '空'}`, 'info');
  return true;
}

function parseJsCmd(cmd) {
  const match = cmd.match(/^js<(.+)>$/);
  if (!match) return false;
  const code = match[1];
  // 安全校验：禁止危险操作
  const dangerous = /\b(?:cookie|localStorage|sessionStorage|fetch|XMLHttpRequest|WebSocket|eval|Function|document|window|self|top|parent|frames|navigator|location|import|require|process|globalThis|__proto__|constructor|prototype)\b/i;
  if (dangerous.test(code) || /[[(]/.test(code)) {
    dolLog(`❌ 禁止执行危险操作`, 'err');
    return true;
  }
  try {
    const result = new Function('console', 'Math', 'Date', 'Array', 'Object', 'String', 'Number', 'JSON', '"use strict"; ' + code)(console, Math, Date, Array, Object, String, Number, JSON);
    dolLog(`📜 JS执行: ${result}`, 'suc');
  } catch (e) {
    dolLog(`❌ JS错误: ${e.message}`, 'err');
  }
  return true;
}

function parseJsonCmd(cmd) {
  const match = cmd.match(/^json<(.+)>$/);
  if (!match) return false;
  const json = match[1];
  try {
    const obj = JSON.parse(json);
    dolLog(`📋 JSON解析成功`, 'suc');
  } catch {
    dolLog(`❌ JSON格式错误`, 'err');
  }
  return true;
}

function parseDolUt(cmd) {
  const match = cmd.match(/^ut\[(.+)\]$/);
  if (!match) return false;
  const text = match[1];
  dolLog(`📝 UT: ${text}`, 'out');
  return true;
}

function parseDolLight(cmd) {
  const match = cmd.match(/^light<(.+)>$/);
  if (!match) return false;
  const color = match[1];
  document.body.style.background = color;
  dolLog(`🎨 灯光效果: ${color}`, 'suc');
  return true;
}

function parseDolCanvas(cmd) {
  const match = cmd.match(/^\/dol\/canvas<(\d+)x(\d+)>$/);
  if (!match) return false;
  const width = match[1];
  const height = match[2];
  const canvas = document.createElement('canvas');
  canvas.width = width;
  canvas.height = height;
  canvas.style.border = '2px solid #5a7ca3';
  canvas.style.borderRadius = '8px';
  canvas.style.backgroundColor = '#000';
  document.body.appendChild(canvas);
  allComponents.push(canvas);
  dolLog(`🎨 画布已创建: ${width}x${height}`, 'suc');
  return true;
}

function parseDol3dSubCmd(cmd) {
  // 将 /dol/3d/ 转换为 /3d/ 格式
  const convertedCmd = '/3d/' + cmd.substring(7);
  return parse3dCmd(convertedCmd);
}

function parseDol3DFabric(cmd) {
  const reg = /^\/dol\/3Dfabric<(\d+)>\*<(\d+)>$/;
  const match = cmd.match(reg);
  let w = 800, h = 600;
  if (match) {
    w = parseInt(match[1]);
    h = parseInt(match[2]);
  }
  if (scene3d.win && document.body.contains(scene3d.win)) {
    scene3d.win.remove();
  }
  scene3d.win = createBaseWindow('🎲 3D制作工作室', w, h, 200, 100, false, true);
  const content = scene3d.win.querySelector('.sys-win-content');
  content.style.padding = '10px';
  content.style.background = '#0a0a0f';
  content.style.display = 'flex';
  content.style.gap = '10px';
  content.innerHTML = `
    <div style="flex:1;background:#000;border-radius:8px;overflow:hidden;position:relative;">
      <canvas id="scene3dCanvas" style="width:100%;height:100%;"></canvas>
      <div style="position:absolute;top:10px;left:10px;color:#fff;font-size:12px;background:rgba(0,0,0,0.7);padding:5px 10px;border-radius:4px;">
        🎲 ${scene3d.model.toUpperCase()} | ${scene3d.color}
      </div>
    </div>
    <div style="width:200px;background:#1a1a24;border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:10px;overflow-y:auto;max-height:${h-80}px;">
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;">🎨 模型类型</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dCube('100')">🟦 立方体</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dSphere('50')">🔵 球体</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dTorus('40')">⭕ 圆环</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dCone('50*100')">🔺 圆锥</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="create3dCylinder('50*100')">🔷 圆柱</button>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🎨 颜色</div>
      <input type="color" id="scene3dColor" value="${scene3d.color}" oninput="set3dColor(this.value)" style="width:100%;height:30px;border:none;border-radius:4px;cursor:pointer;">
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🔄 旋转角度</div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="0" max="360" value="${scene3d.rotation.x}" oninput="update3dRotation('x', this.value)" style="flex:1;">
        <span style="color:#888;font-size:11px;">X</span>
      </div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="0" max="360" value="${scene3d.rotation.y}" oninput="update3dRotation('y', this.value)" style="flex:1;">
        <span style="color:#888;font-size:11px;">Y</span>
      </div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="0" max="360" value="${scene3d.rotation.z}" oninput="update3dRotation('z', this.value)" style="flex:1;">
        <span style="color:#888;font-size:11px;">Z</span>
      </div>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">📐 缩放</div>
      <div style="display:flex;gap:4px;">
        <input type="range" min="10" max="300" value="${scene3d.scale * 100}" oninput="set3dScale(this.value/100)" style="flex:1;">
        <span style="color:#888;font-size:11px;">${scene3d.scale}x</span>
      </div>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🎭 纹理</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="set3dTexture()">📷 加载纹理</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="set3dTexture('none')">❌ 移除纹理</button>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🔲 模式</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="toggle3dWireframe()">${scene3d.wireframe ? '🔲 实体模式' : '🕸️ 线框模式'}</button>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">💾 保存/加载</div>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="save3dModel()">💾 保存模型</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;" onclick="load3dModel()">📂 加载模型</button>
      <button class="sys-calc-btn" style="font-size:12px;padding:6px;margin-top:auto;" onclick="reset3dScene()">🔄 重置</button>
    </div>
  `;
  setTimeout(() => init3dRenderer(), 100);
  dolLog(`✅ 3D制作窗口已打开: ${w}x${h}`, 'suc');
  return true;
}

function parseBtnMusic(cmd) {
  const match = cmd.match(/^btn\.music<(.+)>$/);
  if (!match) return false;
  const text = match[1];
  const btn = document.createElement('button');
  btn.textContent = text;
  btn.onclick = () => {
    if (soundEffects.click) soundEffects.click();
  };
  document.body.appendChild(btn);
  allComponents.push(btn);
  dolLog(`🔘 音乐按钮已创建`, 'suc');
  return true;
}

function parseBtnDraw(cmd) {
  const match = cmd.match(/^btn\.draw<(.+)>$/);
  if (!match) return false;
  const text = match[1];
  const btn = document.createElement('button');
  btn.textContent = text;
  btn.onclick = () => {
    dolIsDrawing = !dolIsDrawing;
  };
  document.body.appendChild(btn);
  allComponents.push(btn);
  dolLog(`🔘 绘图按钮已创建`, 'suc');
  return true;
}

function parseDolMusic(cmd) {
  const match = cmd.match(/^music<(.+)>$/);
  if (!match) return false;
  const notes = match[1];
  dolLog(`🎵 音乐: ${notes}`, 'info');
  return true;
}

function parseDolVar(cmd) {
  const match = cmd.match(/^var<(.+)>=<(.+)>$/);
  if (!match) {
    const dictDefMatch = cmd.match(/^new@dol\.di<(.+)>$/);
    if (dictDefMatch) {
      const dictName = dictDefMatch[1].trim();
      if (!dolDicts[dictName]) {
        dolDicts[dictName] = {};
        dolLog(`📚 字典 ${dictName} 已创建`, 'suc');
      } else {
        dolLog(`⚠️ 字典 ${dictName} 已存在`, 'stage');
      }
      return true;
    }

    const dictInitMatch = cmd.match(/^(\w+)=\{([^}]+)\}$/);
    if (dictInitMatch) {
      const dictName = dictInitMatch[1].trim();
      const elements = dictInitMatch[2].split(',').map(e => e.trim().replace(/['"]/g, '')).filter(e => e !== '');
      const dictData = {};
      elements.forEach((val, idx) => {
        dictData[idx] = val;
      });
      dolDicts[dictName] = dictData;
      dolLog(`📚 字典 ${dictName} 已初始化: {${elements.join(', ')}}`, 'suc');
      return true;
    }

    return false;
  }
  const varName = match[1];
  const value = match[2];
  dolVars[varName] = value;
  dolLog(`📦 变量: ${varName} = ${value}`, 'suc');
  return true;
}

function parseDolCondition(cmd) {
  const match = cmd.match(/^@m<(.+)>$/);
  if (!match) return false;
  const condition = match[1];
  dolLog(`🔍 条件: ${condition}`, 'info');
  return true;
}

function parseDolWindow(cmd) {
  const match = cmd.match(/^\/dol\/window<(\d+)x(\d+)>@<(.+)>$/);
  if (!match) return false;
  const width = match[1];
  const height = match[2];
  const title = match[3];
  const win = createGameWindow(title, width, height, '');
  dolLog(`🪟 窗口已创建: ${title}`, 'suc');
  return true;
}

function parseLegacySquareBtn(cmd) {
  const match = cmd.match(/^sys\.square\.btn<(.+)>@<(.+)>$/);
  if (!match) return false;
  const text = match[1];
  const action = match[2];
  const btn = document.createElement('button');
  btn.className = 'sys-square-btn';
  btn.textContent = text;
  btn.onclick = () => parseLine(action);
  document.body.appendChild(btn);
  allComponents.push(btn);
  dolLog('🔘 系统方块按钮已创建', 'suc');
  return true;
}

function parseLegacyWindow(cmd) {
  const match = cmd.match(/^sys\.window<(.+)>@<(\d+)x(\d+)>$/);
  if (!match) return false;
  const title = match[1];
  const width = match[2];
  const height = match[3];
  const win = createGameWindow(title, width, height, '');
  dolLog('🪟 系统窗口已创建: ' + title, 'suc');
  return true;
}

function parseDolPrintColor(cmd) {
  const match = cmd.match(/^pr\.c\*\/(.+)@<(.+)>$/);
  if (!match) return false;
  const text = match[1];
  const color = match[2];
  const div = document.createElement('div');
  div.style.color = color;
  div.textContent = text;
  document.body.appendChild(div);
  allComponents.push(div);
  dolLog(`🖨️ 彩色打印: ${text}`, 'suc');
  return true;
}

function parseDolPrintSize(cmd) {
  const match = cmd.match(/^pr\.z\*\/(.+)@<(\d+)>$/);
  if (!match) return false;
  const text = match[1];
  const size = match[2];
  const div = document.createElement('div');
  div.style.fontSize = `${size}px`;
  div.textContent = text;
  document.body.appendChild(div);
  allComponents.push(div);
  dolLog(`🖨️ 字号打印: ${text}`, 'suc');
  return true;
}

function parseImgBtn(cmd) {
  const match = cmd.match(/^img\.btn<(.+)>@<(.+)>$/);
  if (!match) return false;
  const url = match[1];
  const action = match[2];
  const btn = document.createElement('button');
  btn.innerHTML = `<img src="${url}" style="width:50px;height:50px;">`;
  btn.onclick = () => parseLine(action);
  document.body.appendChild(btn);
  allComponents.push(btn);
  dolLog(`🖼️ 图片按钮已创建`, 'suc');
  return true;
}

function parseImgBtnCmd(cmd) {
  const match = cmd.match(/^imgbtn<(.+)>@<(.+)>$/);
  if (!match) return false;
  const url = match[1];
  const action = match[2];
  const btn = document.createElement('button');
  btn.innerHTML = `<img src="${url}" style="width:50px;height:50px;">`;
  btn.onclick = () => parseLine(action);
  document.body.appendChild(btn);
  allComponents.push(btn);
  dolLog(`🖼️ 图片按钮已创建`, 'suc');
  return true;
}

function parseJuFormat(cmd) {
  const match = cmd.match(/^ju\.format<(.+)>@<(.+)>$/);
  if (!match) return false;
  const text = match[1];
  const format = match[2];
  let result = text;
  switch (format) {
    case 'upper': result = text.toUpperCase(); break;
    case 'lower': result = text.toLowerCase(); break;
    case 'trim': result = text.trim(); break;
    default: result = text;
  }
  dolLog(`📝 格式转换: ${result}`, 'out');
  return true;
}

function parseJuLang(cmd) {
  const match = cmd.match(/^ju\.lang<(.+)>$/);
  if (!match) return false;
  const lang = match[1];
  dolLog(`🌐 语言: ${lang}`, 'info');
  return true;
}

function parseJuReset(cmd) {
  if (cmd !== 'ju.reset') return false;
  dolLog(`🔄 文本处理已重置`, 'suc');
  return true;
}

function startWatcher() {
  if (dolWatcher.isWatching) {
    dolLog('⚠️ 监视者已在运行', 'warn');
    return;
  }
  
  dolWatcher.isWatching = true;
  dolWatcher.startTime = Date.now();
  dolWatcher.logs = [];
  dolWatcher.mouseTrack = [];
  dolWatcher.keyTrack = [];
  dolWatcher.clickTrack = [];
  dolWatcher.scrollTrack = [];
  dolWatcher.inputTrack = [];
  
  // 添加事件监听器
  document.addEventListener('mousemove', handleWatcherMouseMove);
  document.addEventListener('keydown', handleWatcherKeyDown);
  document.addEventListener('click', handleWatcherClick);
  document.addEventListener('scroll', handleWatcherScroll);
  
  // 监听输入框变化
  const inputs = document.querySelectorAll('input, textarea');
  inputs.forEach(input => {
    input.addEventListener('input', handleWatcherInput);
  });
  
  dolLog('✅ 监视者已启动！', 'suc');
  dolLog('💡 使用 /watch/stop 停止监视', 'info');
  dolLog('💡 使用 /watch/export 导出日志', 'info');
  
  // 显示监视指示器
  showWatcherIndicator();
  
  // 记录启动事件
  addWatcherLog('watcher_start', '监视者启动');
}

function stopWatcher() {
  if (!dolWatcher.isWatching) {
    dolLog('⚠️ 监视者未运行', 'warn');
    return;
  }
  
  dolWatcher.isWatching = false;
  
  // 移除事件监听器
  document.removeEventListener('mousemove', handleWatcherMouseMove);
  document.removeEventListener('keydown', handleWatcherKeyDown);
  document.removeEventListener('click', handleWatcherClick);
  document.removeEventListener('scroll', handleWatcherScroll);
  
  const inputs = document.querySelectorAll('input, textarea');
  inputs.forEach(input => {
    input.removeEventListener('input', handleWatcherInput);
  });
  
  // 记录停止事件
  addWatcherLog('watcher_stop', '监视者停止');
  
  const duration = (Date.now() - dolWatcher.startTime) / 1000;
  dolLog(`✅ 监视者已停止，运行时长: ${duration.toFixed(2)}秒`, 'suc');
  dolLog(`📊 记录事件数: ${dolWatcher.logs.length}`, 'info');
  
  // 移除监视指示器
  hideWatcherIndicator();
}

function handleWatcherMouseMove(e) {
  if (!dolWatcher.isWatching) return;
  
  // 每隔100ms记录一次鼠标位置，避免数据过多
  if (dolWatcher.mouseTrack.length === 0 || 
      Date.now() - dolWatcher.mouseTrack[dolWatcher.mouseTrack.length - 1].time > 100) {
    dolWatcher.mouseTrack.push({
      time: Date.now(),
      x: e.clientX,
      y: e.clientY,
      target: e.target.tagName || 'unknown'
    });
  }
}

function handleWatcherKeyDown(e) {
  if (!dolWatcher.isWatching) return;
  
  // 不记录敏感信息（密码输入框）
  if (e.target.type === 'password') return;
  
  dolWatcher.keyTrack.push({
    time: Date.now(),
    key: e.key,
    code: e.code,
    ctrl: e.ctrlKey,
    shift: e.shiftKey,
    alt: e.altKey,
    target: e.target.tagName || 'unknown'
  });
  
  addWatcherLog('keydown', `按键: ${e.key} (${e.code})`);
}

function handleWatcherClick(e) {
  if (!dolWatcher.isWatching) return;
  
  dolWatcher.clickTrack.push({
    time: Date.now(),
    x: e.clientX,
    y: e.clientY,
    target: e.target.tagName || 'unknown',
    targetId: e.target.id || '',
    targetClass: e.target.className || ''
  });
  
  addWatcherLog('click', `点击: (${e.clientX}, ${e.clientY}) - ${e.target.tagName}`);
}

function handleWatcherScroll(e) {
  if (!dolWatcher.isWatching) return;
  
  dolWatcher.scrollTrack.push({
    time: Date.now(),
    scrollX: window.scrollX,
    scrollY: window.scrollY
  });
}

function handleWatcherInput(e) {
  if (!dolWatcher.isWatching) return;
  
  // 不记录密码输入
  if (e.target.type === 'password') return;
  
  dolWatcher.inputTrack.push({
    time: Date.now(),
    value: e.target.value.slice(-50), // 只记录最后50个字符
    target: e.target.tagName || 'unknown',
    targetId: e.target.id || ''
  });
}

function addWatcherLog(type, message) {
  dolWatcher.logs.push({
    time: Date.now(),
    timestamp: new Date().toISOString(),
    type: type,
    message: message
  });
}

function exportWatcherLog() {
  if (dolWatcher.logs.length === 0) {
    dolLog('⚠️ 没有监视日志', 'warn');
    return;
  }
  
  const exportData = {
    startTime: new Date(dolWatcher.startTime).toISOString(),
    endTime: new Date().toISOString(),
    duration: (Date.now() - dolWatcher.startTime) / 1000,
    totalEvents: dolWatcher.logs.length,
    summary: {
      mouseEvents: dolWatcher.mouseTrack.length,
      keyEvents: dolWatcher.keyTrack.length,
      clickEvents: dolWatcher.clickTrack.length,
      scrollEvents: dolWatcher.scrollTrack.length,
      inputEvents: dolWatcher.inputTrack.length
    },
    logs: dolWatcher.logs,
    mouseTrack: dolWatcher.mouseTrack,
    keyTrack: dolWatcher.keyTrack,
    clickTrack: dolWatcher.clickTrack,
    scrollTrack: dolWatcher.scrollTrack,
    inputTrack: dolWatcher.inputTrack
  };
  
  const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const filename = `DonglaugOL_WatchLog_${new Date().toISOString().slice(0,19).replace(/:/g,'-')}.json`;
  
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  
  URL.revokeObjectURL(url);
  
  dolLog(`✅ 监视日志已导出: ${filename}`, 'suc');
  dolLog(`📊 文件大小: ${(blob.size / 1024).toFixed(2)} KB`, 'info');
}

function clearWatcherLog() {
  dolWatcher.logs = [];
  dolWatcher.mouseTrack = [];
  dolWatcher.keyTrack = [];
  dolWatcher.clickTrack = [];
  dolWatcher.scrollTrack = [];
  dolWatcher.inputTrack = [];
  
  dolLog('✅ 监视日志已清除', 'suc');
}

function showWatcherStatus() {
  dolLog('📊 ========== 监视者状态 ==========', 'info');
  dolLog(`📊 是否监视: ${dolWatcher.isWatching ? '是' : '否'}`, 'info');
  
  if (dolWatcher.startTime) {
    const duration = (Date.now() - dolWatcher.startTime) / 1000;
    dolLog(`📊 运行时长: ${duration.toFixed(2)}秒`, 'info');
  }
  
  dolLog(`📊 总事件数: ${dolWatcher.logs.length}`, 'info');
  dolLog(`📊 鼠标移动: ${dolWatcher.mouseTrack.length}`, 'info');
  dolLog(`📊 键盘事件: ${dolWatcher.keyTrack.length}`, 'info');
  dolLog(`📊 点击事件: ${dolWatcher.clickTrack.length}`, 'info');
  dolLog(`📊 滚动事件: ${dolWatcher.scrollTrack.length}`, 'info');
  dolLog(`📊 输入事件: ${dolWatcher.inputTrack.length}`, 'info');
  dolLog('📊 ==================================', 'info');
}

function showWatcherStats() {
  if (dolWatcher.logs.length === 0) {
    dolLog('⚠️ 没有监视数据', 'warn');
    return;
  }
  
  dolLog('📊 ========== 监视统计 ==========', 'info');
  
  // 计算鼠标移动距离
  let totalMouseDistance = 0;
  for (let i = 1; i < dolWatcher.mouseTrack.length; i++) {
    const prev = dolWatcher.mouseTrack[i - 1];
    const curr = dolWatcher.mouseTrack[i];
    totalMouseDistance += Math.sqrt(Math.pow(curr.x - prev.x, 2) + Math.pow(curr.y - prev.y, 2));
  }
  dolLog(`📊 鼠标移动距离: ${totalMouseDistance.toFixed(0)}像素`, 'info');
  
  // 统计按键类型
  const keyStats = {};
  dolWatcher.keyTrack.forEach(k => {
    keyStats[k.key] = (keyStats[k.key] || 0) + 1;
  });
  const topKeys = Object.entries(keyStats).sort((a, b) => b[1] - a[1]).slice(0, 5);
  dolLog(`📊 最常用按键: ${topKeys.map(k => `${k[0]}(${k[1]})`).join(', ')}`, 'info');
  
  // 统计点击目标
  const clickTargets = {};
  dolWatcher.clickTrack.forEach(c => {
    clickTargets[c.target] = (clickTargets[c.target] || 0) + 1;
  });
  dolLog(`📊 点击目标分布: ${Object.entries(clickTargets).map(t => `${t[0]}(${t[1]})`).join(', ')}`, 'info');
  
  dolLog('📊 ==================================', 'info');
}

function showWatcherIndicator() {
  const indicator = document.createElement('div');
  indicator.id = 'dol-watcher-indicator';
  indicator.innerHTML = '👁️ 监视者运行中';
  indicator.style.cssText = `
    position: fixed;
    top: 10px;
    left: 10px;
    padding: 10px 20px;
    background: rgba(0, 100, 255, 0.8);
    color: white;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
    z-index: 10001;
    animation: pulse 1s ease-in-out infinite;
  `;
  document.body.appendChild(indicator);
}

// ==================================================
// ========== 【直播共享投屏功能】 ==========
// ==================================================
// /re/live.b     开始直播共享投屏
// /re/live.stop  停止直播
// /re/live.status 查看直播状态

let dolLiveStream = {
  isLive: false,
  stream: null,
  videoElement: null,
  startTime: null,
  liveContainer: null,
  connectionId: null
};

function startLiveStreaming() {
  if (dolLiveStream.isLive) {
    dolLog('⚠️ 直播已在进行中', 'warn');
    return;
  }
  
  if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
    dolLog('❌ 浏览器不支持屏幕共享 API', 'err');
    dolLog('💡 请使用 Chrome、Edge 或 Firefox 浏览器', 'info');
    return;
  }
  
  const constraints = {
    video: {
      cursor: 'always',
      displaySurface: 'monitor'
    }
  };
  
  try {
    navigator.mediaDevices.getDisplayMedia(constraints).then(stream => {
      dolLiveStream.stream = stream;
      dolLiveStream.isLive = true;
      dolLiveStream.startTime = Date.now();
      dolLiveStream.connectionId = 'LIVE_' + Date.now();
      
      createLiveContainer();
      
      const video = document.createElement('video');
      video.id = 'dol-live-video';
      video.srcObject = stream;
      video.autoplay = true;
      video.playsInline = true;
      video.muted = true;
      video.style.cssText = `
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #000;
      `;
      
      dolLiveStream.videoElement = video;
      
      try {
        dolLiveStream.liveContainer.appendChild(video);
      } catch (e) {
        dolLog(`❌ 添加视频元素失败: ${e.message}`, 'err');
        stream.getTracks().forEach(track => track.stop());
        return;
      }
      
      stream.getVideoTracks().forEach(track => {
        track.onended = () => {
          dolLog('⚠️ 用户停止了屏幕共享', 'warn');
          stopLiveStreaming();
        };
      });
      
      showLiveIndicator();
      
      dolLog('✅ 直播共享投屏已开始！', 'suc');
      dolLog(`📡 连接ID: ${dolLiveStream.connectionId}`, 'info');
      dolLog('💡 使用 /re/live.stop 或按 ESC 停止直播', 'info');
      
    }).catch(err => {
      dolLog(`❌ 无法开始直播: ${err.name} - ${err.message}`, 'err');
      if (err.name === 'NotAllowedError') {
        dolLog('💡 用户拒绝了屏幕共享请求，请允许浏览器访问屏幕', 'info');
      } else if (err.name === 'NotSupportedError') {
        dolLog('💡 浏览器不支持屏幕共享', 'info');
      } else if (err.name === 'InvalidStateError') {
        dolLog('💡 当前没有可用的屏幕源', 'info');
      }
    });
  } catch (e) {
    dolLog(`❌ 直播初始化错误: ${e.message}`, 'err');
  }
}

function stopLiveStreaming() {
  if (!dolLiveStream.isLive && !dolLiveStream.stream) {
    dolLog('⚠️ 当前没有进行直播', 'warn');
    return;
  }
  
  dolLiveStream.isLive = false;
  
  try {
    if (dolLiveStream.videoElement) {
      try {
        dolLiveStream.videoElement.srcObject = null;
        dolLiveStream.videoElement.remove();
      } catch (e) {}
      dolLiveStream.videoElement = null;
    }
    
    if (dolLiveStream.stream) {
      dolLiveStream.stream.getTracks().forEach(track => {
        try { track.stop(); } catch(e) {}
      });
      dolLiveStream.stream = null;
    }
    
    const container = document.getElementById('dol-live-container');
    if (container) {
      try { container.remove(); } catch(e) {}
    }
    dolLiveStream.liveContainer = null;
    
    hideLiveIndicator();
    
    const duration = dolLiveStream.startTime ? (Date.now() - dolLiveStream.startTime) / 1000 : 0;
    dolLog(`✅ 直播已停止，时长: ${duration.toFixed(2)}秒`, 'suc');
    
    dolLiveStream.startTime = null;
    dolLiveStream.connectionId = null;
    
  } catch (e) {
    dolLog(`❌ 停止直播时出错: ${e.message}`, 'err');
  }
}

function createLiveContainer() {
  // 创建直播视图容器
  const container = document.createElement('div');
  container.id = 'dol-live-container';
  container.style.cssText = `
    position: fixed;
    top: 60px;
    left: 10px;
    right: 10px;
    bottom: 100px;
    background: rgba(0, 0, 0, 0.95);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  `;
  
  // 添加标题栏
  const header = document.createElement('div');
  header.style.cssText = `
    padding: 10px 20px;
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    display: flex;
    justify-content: space-between;
    align-items: center;
  `;
  
  const title = document.createElement('span');
  title.textContent = '🔴 直播共享投屏';
  title.style.cssText = `
    color: white;
    font-weight: bold;
    font-size: 16px;
  `;
  
  const timer = document.createElement('span');
  timer.id = 'dol-live-timer';
  timer.textContent = '00:00';
  timer.style.cssText = `
    color: white;
    font-family: monospace;
    font-size: 14px;
  `;
  
  header.appendChild(title);
  header.appendChild(timer);
  container.appendChild(header);
  
  // 添加内容区域
  const content = document.createElement('div');
  content.style.cssText = `
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  `;
  container.appendChild(content);
  
  // 添加底部信息
  const footer = document.createElement('div');
  footer.style.cssText = `
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
  `;
  
  const info = document.createElement('span');
  info.textContent = `连接ID: ${dolLiveStream.connectionId}`;
  info.style.cssText = `
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  `;
  
  const tips = document.createElement('span');
  tips.textContent = '按 ESC 或使用 /re/live.stop 停止直播';
  tips.style.cssText = `
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  `;
  
  footer.appendChild(info);
  footer.appendChild(tips);
  container.appendChild(footer);
  
  document.body.appendChild(container);
  dolLiveStream.liveContainer = content;
  
  // 添加ESC键停止直播
  document.addEventListener('keydown', handleLiveEscape);
  
  // 更新计时器
  updateLiveTimer();
}

function handleLiveEscape(e) {
  if (e.key === 'Escape' && dolLiveStream.isLive) {
    stopLiveStreaming();
  }
}

function updateLiveTimer() {
  if (!dolLiveStream.isLive) return;
  
  const timer = document.getElementById('dol-live-timer');
  if (timer) {
    const elapsed = Date.now() - dolLiveStream.startTime;
    const minutes = Math.floor(elapsed / 60000);
    const seconds = Math.floor((elapsed % 60000) / 1000);
    timer.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
  }
  
  setTimeout(updateLiveTimer, 1000);
}

function showLiveIndicator() {
  const indicator = document.createElement('div');
  indicator.id = 'dol-live-indicator';
  indicator.innerHTML = '🔴 LIVE - 直播中';
  indicator.style.cssText = `
    position: fixed;
    top: 60px;
    right: 10px;
    padding: 8px 16px;
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    color: white;
    border-radius: 15px;
    font-size: 12px;
    font-weight: bold;
    z-index: 10002;
    animation: blink 1s ease-in-out infinite;
  `;
  document.body.appendChild(indicator);
  
  // 添加动画样式
  const style = document.createElement('style');
  style.textContent = `
    @keyframes blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0.7; }
    }
  `;
  document.head.appendChild(style);
}

function hideLiveIndicator() {
  const indicator = document.getElementById('dol-live-indicator');
  if (indicator) {
    indicator.remove();
  }
}

function showLiveStatus() {
  dolLog('📊 ========== 直播状态 ==========', 'info');
  dolLog(`📊 是否直播: ${dolLiveStream.isLive ? '是' : '否'}`, 'info');
  
  if (dolLiveStream.isLive) {
    const duration = dolLiveStream.startTime ? (Date.now() - dolLiveStream.startTime) / 1000 : 0;
    dolLog(`📊 直播时长: ${duration.toFixed(2)}秒`, 'info');
    dolLog(`📡 连接ID: ${dolLiveStream.connectionId}`, 'info');
    
    if (dolLiveStream.stream) {
      const videoTracks = dolLiveStream.stream.getVideoTracks();
      const audioTracks = dolLiveStream.stream.getAudioTracks();
      dolLog(`📹 视频轨道: ${videoTracks.length}`, 'info');
      dolLog(`🎙️ 音频轨道: ${audioTracks.length}`, 'info');
    }
  }
  
  dolLog('📊 ==================================', 'info');
}

function hideWatcherIndicator() {
  const indicator = document.getElementById('dol-watcher-indicator');
  if (indicator) {
    indicator.remove();
  }
}

// ==================================================
// ========== 【新增：彩蛋指令】 ==========
// ==================================================
// /egg/Dongper              显示 Dongper 彩蛋
// /egg/@dolgo to learn other<语言>bye dol@dol  学习语言彩蛋

function parseEasterEggCmd(cmd) {
  const line = cmd.trim();
  
  // 1. Dongper 彩蛋
  if (line === '/egg/Dongper') {
    // 创建全屏彩蛋窗口，显示 Dongper 图片
    const eggWin = document.createElement('div');
    eggWin.className = 'sys-window';
    eggWin.style.width = '100vw';
    eggWin.style.height = '100vh';
    eggWin.style.left = '0';
    eggWin.style.top = '0';
    eggWin.style.position = 'fixed';
    eggWin.style.zIndex = '9999';
    
    eggWin.innerHTML = `
      <div style="width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#1a1a2e;">
        <svg width="400" height="400" viewBox="0 0 400 400">
          <defs>
            <linearGradient id="dongperGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ff0000"/>
              <stop offset="50%" stop-color="#8b00ff"/>
              <stop offset="100%" stop-color="#0000ff"/>
            </linearGradient>
          </defs>
          <!-- 正方形背景 -->
          <rect x="20" y="20" width="360" height="360" fill="url(#dongperGradient)"/>
          <!-- Dongqper 文字（手写风格） -->
          <text x="45" y="320" font-family="cursive" font-size="60" font-weight="bold" fill="white">
            Dongqper
          </text>
        </svg>
        <div style="margin-top:20px;color:#888;font-size:14px;">按 ESC 或点击关闭</div>
      </div>
    `;
    
    document.body.appendChild(eggWin);
    allComponents.push(eggWin);
    
    // 添加关闭事件
    const closeEgg = () => {
      eggWin.remove();
      const idx = allComponents.indexOf(eggWin);
      if (idx > -1) allComponents.splice(idx, 1);
      document.removeEventListener('keydown', handleKeyDown);
    };
    
    const handleKeyDown = (e) => {
      if (e.key === 'Escape') closeEgg();
    };
    
    document.addEventListener('keydown', handleKeyDown);
    eggWin.addEventListener('click', closeEgg);
    
    dolLog(`🥚 Dongper 彩蛋已开启！`, 'suc');
    return true;
  }
  
  // 2. 学习语言彩蛋
  const learnMatch = line.match(/^\/egg\/@dolgo\s+to\s+learn\s+other<([^<>]+)>bye\s+dol@dol$/);
  if (learnMatch) {
    const language = learnMatch[1].trim();
    const encouragement = [
      `🎯 加油！学习 ${language} 是个很棒的选择！`,
      `📚 ${language} 是一门非常强大的语言，祝你学习顺利！`,
      `💪 学习 ${language} 开启你的编程之旅！`,
      `🌟 ${language} 编程入门，未来可期！`
    ];
    const randomMsg = encouragement[Math.floor(Math.random() * encouragement.length)];
    
    dolLog(randomMsg, 'suc');
    dolLog(`📖 开始学习 ${language} 吧！记住：熟能生巧！`, 'info');
    return true;
  }
  
  // 3. 额外彩蛋：/egg/surprise
  if (line === '/egg/surprise') {
    const surprises = [
      '🎉 恭喜你发现了隐藏彩蛋！',
      '🌟 你真是个细心的探险家！',
      '✨ DonglaugOL 感谢你的使用！',
      '🎊 彩蛋解锁成功！',
      '🎈 祝你使用愉快！'
    ];
    const randomSurprise = surprises[Math.floor(Math.random() * surprises.length)];
    dolLog(randomSurprise, 'suc');
    return true;
  }
  
  // 4. 额外彩蛋：/egg/secret
  if (line === '/egg/secret') {
    dolLog(`🔒 发现秘密指令！`, 'info');
    dolLog(`💡 提示：试试 /egg/Dongper 看看有什么惊喜！`, 'stage');
    return true;
  }
  
  return false;
}

function parseExtendedCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 展示图片(带大小): [look bs<宽>*<高> {图片名}
  const imgWithSizeMatch = line.match(/^\[look\s+bs<(\d+)>\*<(\d+)>\s+\{([^{}]+)\}$/);
  if (imgWithSizeMatch) {
    const width = parseInt(imgWithSizeMatch[1]);
    const height = parseInt(imgWithSizeMatch[2]);
    const rawPath = imgWithSizeMatch[3].trim();
    const safePath = sanitizeFilePath(rawPath);
    
    if (!safePath) {
      dolLog(`❌ 无效的图片路径: ${rawPath}`, 'err');
      return true;
    }
    
    const imgWin = document.createElement('div');
    imgWin.className = 'sys-window';
    imgWin.style.width = `${width}px`;
    imgWin.style.height = `${height}px`;
    imgWin.style.left = '50%';
    imgWin.style.top = '50%';
    imgWin.style.transform = 'translate(-50%, -50%)';
    imgWin.style.background = '#1e2126';
    imgWin.style.border = '2px solid #5a7ca3';
    imgWin.style.borderRadius = '8px';
    imgWin.style.overflow = 'hidden';
    imgWin.style.zIndex = '1000';
    document.body.appendChild(imgWin);
    allComponents.push(imgWin);
    
    const img = document.createElement('img');
    img.src = safePath;
    img.style.width = '100%';
    img.style.height = '100%';
    img.style.objectFit = 'contain';
    imgWin.appendChild(img);
    
    img.onerror = () => {
      imgWin.innerHTML = `<div style="width:100%;height:100%;display:flex;justify-content:center;align-items:center;color:#ff6666;">❌ 图片加载失败: ${safePath}</div>`;
    };
    
    dolLog(`🖼️ 图片展示: ${safePath} (${width}×${height})`, 'suc');
    return true;
  }
  
  // 2. 展示图片: {图片名} - 支持带空格和括号的文件名
  const imgMatch = line.match(/^\{([^{}]+)\}$/);
  if (imgMatch) {
    const rawPath = imgMatch[1].trim();
    const safePath = sanitizeFilePath(rawPath);
    
    if (!safePath) {
      dolLog(`❌ 无效的图片路径: ${rawPath}`, 'err');
      return true;
    }
    
    // 支持所有图片格式
    const validExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.svg', '.ico', '.tiff'];
    const ext = safePath.toLowerCase().substring(safePath.lastIndexOf('.'));
    if (ext && !validExtensions.includes(ext)) {
      dolLog(`⚠️ 警告: 图片格式 ${ext} 可能无法正常显示`, 'info');
    }
    
    const imgWin = document.createElement('div');
    imgWin.className = 'sys-window';
    imgWin.style.width = '400px';
    imgWin.style.height = '300px';
    imgWin.style.left = '50%';
    imgWin.style.top = '50%';
    imgWin.style.transform = 'translate(-50%, -50%)';
    imgWin.style.background = '#1e2126';
    imgWin.style.border = '2px solid #5a7ca3';
    imgWin.style.borderRadius = '8px';
    imgWin.style.overflow = 'hidden';
    imgWin.style.zIndex = '1000';
    document.body.appendChild(imgWin);
    allComponents.push(imgWin);
    
    const img = document.createElement('img');
    img.src = safePath;
    img.style.width = '100%';
    img.style.height = '100%';
    img.style.objectFit = 'contain';
    imgWin.appendChild(img);
    
    img.onerror = () => {
      imgWin.innerHTML = `<div style="width:100%;height:100%;display:flex;justify-content:center;align-items:center;color:#ff6666;">❌ 图片加载失败: ${safePath}</div>`;
    };
    
    dolLog(`🖼️ 图片展示: ${safePath}`, 'suc');
    return true;
  }
  
  // 2. 跳转到文件: {[文件名]} - 支持所有文件类型和带空格的文件名
  const gotoMatch = line.match(/^\{\[([\s\S]+?)\]\}$/);
  if (gotoMatch) {
    const rawPath = gotoMatch[1].trim();
    const safePath = sanitizeFilePath(rawPath);
    
    if (!safePath) {
      dolLog(`❌ 无效的文件路径: ${rawPath}`, 'err');
      return true;
    }
    
    dolLog(`📂 准备跳转到: ${safePath}`, 'info');
    // 创建一个模拟的页面加载窗口
    const gotoWin = createGameWindow(`🔗 ${safePath}`, 600, 400, `
      <div style="width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#1e2126;">
        <div style="font-size:24px;margin-bottom:20px;">📄 ${safePath}</div>
        <div style="color:#888;">页面加载中...</div>
        <div style="margin-top:20px;padding:10px 20px;background:#5a7ca3;color:#fff;border-radius:5px;cursor:pointer;" onclick="window.location.href='${safePath}'">
          点击跳转
        </div>
      </div>
    `);
    return true;
  }
  
  // 3. 动画布局大小设置: LE: L200 L400
  const layoutMatch = line.match(/^LE:\s*L(\d+)\s+L(\d+)$/);
  if (layoutMatch) {
    animLayoutWidth = parseInt(layoutMatch[1]);
    animLayoutHeight = parseInt(layoutMatch[2]);
    dolLog(`📐 动画布局大小已设置: ${animLayoutWidth} x ${animLayoutHeight}`, 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：高级功能指令 adv.*】 ==========
// ==================================================
// adv.http<GET|POST|PUT|DELETE>=<URL>      HTTP请求
// adv.chart<bar|line|pie>@<数据>           生成图表
// adv.encrypt<文本>                        文本加密
// adv.decrypt<密文>                        文本解密
// adv.regex<正则>@<文本>                   正则验证
// adv.timer<start|stop|status>@<秒>       定时器
// adv.validate<类型>@<值>                  数据验证
// adv.animation<类型>@<目标>                动画效果
// adv.hash<算法>@<文本>                    哈希计算
// adv.storage<save|load|remove|clear>@<键> 本地存储

function parseAdvHttp(cmd) {
  const match = cmd.match(/^adv\.http<(GET|POST|PUT|DELETE)>=<(.+)>$/);
  if (!match) return false;
  const method = match[1];
  const url = match[2];
  const allowedDomains = ['api.qrserver.com', 'google.com', 'bing.com', 'wikipedia.org', 'jsonplaceholder.typicode.com', 'httpbin.org', 'github.com'];
  
  try {
    const urlObj = new URL(url);
    const hostname = urlObj.hostname.toLowerCase();
    if (hostname.startsWith('192.168.') || hostname.startsWith('10.') || hostname.startsWith('172.16.') || hostname === '127.' || hostname === 'localhost') {
      dolLog(`❌ 禁止访问内网或本地文件`, 'err');
      return true;
    }
    const isAllowed = allowedDomains.some(domain => hostname === domain || hostname.endsWith('.' + domain));
    if (!isAllowed) {
      dolLog(`❌ 禁止访问未授权域名: ${hostname}`, 'err');
      return true;
    }
  } catch (e) {
    dolLog(`❌ 无效的URL格式`, 'err');
    return true;
  }
  
  dolLog(`🌐 发送${method}请求: ${url}`, 'out');
  fetch(url, { method: method })
    .then(res => res.text())
    .then(data => {
      dolLog(`✅ 请求成功 (${data.length} 字符)`, 'suc');
      dolVars['httpResponse'] = data;
    })
    .catch(err => {
      dolLog(`❌ 请求失败: ${err.message}`, 'err');
    });
  return true;
}

function parseAdvChart(cmd) {
  const match = cmd.match(/^adv\.chart<(bar|line|pie)>@<(.+)>$/);
  if (!match) return false;
  const type = match[1];
  const dataStr = match[2];
  
  const chart = document.createElement('div');
  chart.style.cssText = 'background:rgba(20,22,27,0.95);padding:20px;border-radius:8px;margin:10px 0;max-width:500px;';
  
  let html = `<h3 style="color:#5a7ca3;margin:0 0 15px 0;">📊 ${type.toUpperCase()} 图表</h3>`;
  
  if (type === 'bar') {
    const values = dataStr.split(',').map(v => parseFloat(v.trim()));
    const max = Math.max(...values);
    html += '<div style="display:flex;align-items:flex-end;height:200px;gap:10px;">';
    values.forEach((v, i) => {
      const height = (v / max) * 180;
      html += `<div style="flex:1;display:flex;flex-direction:column;align-items:center;">
        <div style="width:100%;height:${height}px;background:linear-gradient(180deg,#5a7ca3,#3a5a83);border-radius:4px 4px 0 0;"></div>
        <div style="color:#888;font-size:12px;margin-top:5px;">${v}</div>
      </div>`;
    });
    html += '</div>';
  } else if (type === 'pie') {
    const items = dataStr.split(',');
    const colors = ['#5a7ca3', '#4ade80', '#f87171', '#fbbf24', '#60a5fa', '#a78bfa'];
    html += '<div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;">';
    items.forEach((item, i) => {
      const [label, value] = item.split(':');
      const percent = parseFloat(value);
      const color = colors[i % colors.length];
      html += `<div style="display:flex;align-items:center;gap:8px;padding:5px 10px;background:rgba(58,74,99,0.5);border-radius:4px;">
        <div style="width:15px;height:15px;background:${color};border-radius:2px;"></div>
        <span style="color:#e2e2e2;font-size:12px;">${label}: ${percent}%</span>
      </div>`;
    });
    html += '</div>';
  } else {
    const values = dataStr.split(',').map(v => parseFloat(v.trim()));
    html += '<svg width="100%" height="200" style="background:rgba(58,74,99,0.3);border-radius:4px;">';
    let pathD = '';
    values.forEach((v, i) => {
      const x = (i / (values.length - 1)) * 480 + 10;
      const y = 180 - (v / Math.max(...values)) * 160;
      pathD += (i === 0 ? 'M' : 'L') + x + ',' + y;
    });
    html += `<polyline points="${pathD.replace(/,/g,' ')}" fill="none" stroke="#5a7ca3" stroke-width="2"/>`;
    html += '</svg>';
  }
  
  chart.innerHTML = html;
  document.body.appendChild(chart);
  allComponents.push(chart);
  dolLog(`📊 ${type} 图表已生成`, 'suc');
  return true;
}

function parseAdvEncrypt(cmd) {
  const match = cmd.match(/^adv\.encrypt<(.+)>$/);
  if (!match) return false;
  const text = match[1];
  const encoded = btoa(unescape(encodeURIComponent(text)));
  dolLog(`🔐 加密结果: ${encoded}`, 'out');
  dolVars['encrypted'] = encoded;
  return true;
}

function parseAdvDecrypt(cmd) {
  const match = cmd.match(/^adv\.decrypt<(.+)>$/);
  if (!match) return false;
  const code = match[1];
  try {
    const decoded = decodeURIComponent(escape(atob(code)));
    dolLog(`🔓 解密结果: ${decoded}`, 'out');
    dolVars['decrypted'] = decoded;
  } catch (e) {
    dolLog(`❌ 解密失败: 无效的加密字符串`, 'err');
  }
  return true;
}

function parseAdvRegex(cmd) {
  const match = cmd.match(/^adv\.regex<(.+)>@<(.+)>$/);
  if (!match) return false;
  const pattern = match[1];
  const text = match[2];
  try {
    const regex = new RegExp(pattern);
    const matches = text.match(regex);
    if (matches) {
      dolLog(`✅ 正则匹配成功: ${matches[0]}`, 'suc');
      dolVars['regexMatch'] = matches[0];
    } else {
      dolLog(`❌ 正则匹配失败`, 'err');
    }
  } catch (e) {
    dolLog(`❌ 正则表达式错误: ${e.message}`, 'err');
  }
  return true;
}

function parseAdvTimer(cmd) {
  const match = cmd.match(/^adv\.timer<(start|stop|status)>@<(\d+)>$/);
  if (!match) return false;
  const action = match[1];
  const seconds = parseInt(match[2]);
  
  if (action === 'start') {
    const timerId = setTimeout(() => {
      dolLog(`⏰ 定时器响了！已过 ${seconds} 秒`, 'suc');
      delete dolVars['timerId'];
    }, seconds * 1000);
    dolVars['timerId'] = timerId;
    dolLog(`⏱️ 定时器已启动 (${seconds}秒)`, 'suc');
  } else if (action === 'stop') {
    if (dolVars['timerId']) {
      clearTimeout(dolVars['timerId']);
      delete dolVars['timerId'];
      dolLog(`⏹️ 定时器已停止`, 'suc');
    }
  } else if (action === 'status') {
    const status = dolVars['timerId'] ? '运行中' : '未启动';
    dolLog(`⏱️ 定时器状态: ${status}`, 'out');
  }
  return true;
}

function parseAdvValidate(cmd) {
  const match = cmd.match(/^adv\.validate<(\w+)>@<(.+)>$/);
  if (!match) return false;
  const type = match[1];
  const value = match[2];
  let valid = false;
  let message = '';
  
  switch (type) {
    case 'email':
      valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      message = valid ? '有效的邮箱' : '无效的邮箱格式';
      break;
    case 'phone':
      valid = /^1[3-9]\d{9}$/.test(value);
      message = valid ? '有效的手机号' : '无效的手机号格式';
      break;
    case 'url':
      valid = /^https?:\/\/.+/.test(value);
      message = valid ? '有效的URL' : '无效的URL格式';
      break;
    case 'ip':
      valid = /^(\d{1,3}\.){3}\d{1,3}$/.test(value);
      message = valid ? '有效的IP地址' : '无效的IP地址格式';
      break;
    default:
      message = '未知验证类型';
  }
  
  if (valid) {
    dolLog(`✅ ${message}: ${value}`, 'suc');
  } else {
    dolLog(`❌ ${message}: ${value}`, 'err');
  }
  return true;
}

function parseAdvStorage(cmd) {
  const match = cmd.match(/^adv\.storage<(save|load|remove|clear)>@<(\w+)>?(=<(.+)>)?$/);
  if (!match) return false;
  const action = match[1];
  const key = match[2];
  const value = match[4];
  
  switch (action) {
    case 'save':
      localStorage.setItem(`dol_${key}`, value);
      dolLog(`💾 已保存: ${key} = ${value}`, 'suc');
      break;
    case 'load':
      const loaded = localStorage.getItem(`dol_${key}`);
      if (loaded) {
        dolLog(`📂 已加载: ${key} = ${loaded}`, 'out');
        dolVars[key] = loaded;
      } else {
        dolLog(`❌ 找不到: ${key}`, 'err');
      }
      break;
    case 'remove':
      localStorage.removeItem(`dol_${key}`);
      dolLog(`🗑️ 已删除: ${key}`, 'suc');
      break;
    case 'clear':
      const keys = Object.keys(localStorage).filter(k => k.startsWith('dol_'));
      keys.forEach(k => localStorage.removeItem(k));
      dolLog(`🧹 已清空所有存储 (${keys.length}项)`, 'suc');
      break;
  }
  return true;
}

function parseAdvCmd(cmd) {
  if (cmd.startsWith('adv.http<')) return parseAdvHttp(cmd);
  if (cmd.startsWith('adv.chart<')) return parseAdvChart(cmd);
  if (cmd.startsWith('adv.encrypt<')) return parseAdvEncrypt(cmd);
  if (cmd.startsWith('adv.decrypt<')) return parseAdvDecrypt(cmd);
  if (cmd.startsWith('adv.regex<')) return parseAdvRegex(cmd);
  if (cmd.startsWith('adv.timer<')) return parseAdvTimer(cmd);
  if (cmd.startsWith('adv.validate<')) return parseAdvValidate(cmd);
  if (cmd.startsWith('adv.storage<')) return parseAdvStorage(cmd);
  return false;
}

// ==================================================
// ========== 【新增：文件处理指令 file.*】 ==========
// ==================================================
// file.split<文件名>@<行数>    分割大文件
// file.merge<文件列表>        合并文件
// file.read<路径>            读取文件
// file.write<文件名>@<内容>   写入文件
// file.size<变量>            获取文件大小
// file.count<变量>@<类型>     统计行数/词数
// file.search<变量>@<关键词>  搜索内容
// file.replace<变量>@<旧>=<新> 批量替换
// file.sort<变量>@<类型>      排序
// file.filter<变量>@<条件>    过滤行
// file.format<变量>@<格式>    格式化内容

function parseFileRead(cmd) {
  const match = cmd.match(/^file\.read<(.+)>$/);
  if (!match) return false;
  const path = match[1];
  const input = document.createElement('input');
  input.type = 'file';
  input.onchange = (e) => {
    const file = e.target.files[0];
    const reader = new FileReader();
    reader.onload = (ev) => {
      dolVars['fileContent'] = ev.target.result;
      const lines = ev.target.result.split('\n').length;
      dolLog(`📖 已读取文件: ${file.name} (${lines}行, ${ev.target.result.length}字符)`, 'suc');
    };
    reader.readAsText(file, 'UTF-8');
  };
  input.click();
  return true;
}

function parseFileWrite(cmd) {
  const match = cmd.match(/^file\.write<(.+)>@<([\s\S]+)>$/);
  if (!match) return false;
  const filename = match[1];
  const content = match[2];
  const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
  dolLog(`💾 文件已保存: ${filename} (${content.length}字符)`, 'suc');
  return true;
}

function parseFileSize(cmd) {
  const match = cmd.match(/^file\.size<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const content = dolVars[varName] || '';
  const size = content.length;
  let sizeStr = '';
  if (size > 1024 * 1024) sizeStr = (size / (1024 * 1024)).toFixed(2) + ' MB';
  else if (size > 1024) sizeStr = (size / 1024).toFixed(2) + ' KB';
  else sizeStr = size + ' 字节';
  dolLog(`📊 ${varName} 大小: ${sizeStr}`, 'out');
  return true;
}

function parseFileCount(cmd) {
  const match = cmd.match(/^file\.count<(.+)>@<(lines|words|chars)>$/);
  if (!match) return false;
  const varName = match[1];
  const type = match[2];
  const content = dolVars[varName] || '';
  let count = 0;
  switch (type) {
    case 'lines': count = content.split('\n').length; break;
    case 'words': count = content.split(/\s+/).filter(w => w).length; break;
    case 'chars': count = content.length; break;
  }
  dolLog(`📈 ${varName} ${type}: ${count}`, 'out');
  return true;
}

function parseFileSearch(cmd) {
  const match = cmd.match(/^file\.search<(.+)>@<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const keyword = match[2];
  const content = dolVars[varName] || '';
  const lines = content.split('\n');
  const results = lines.filter(line => line.includes(keyword));
  dolLog(`🔍 搜索"${keyword}"，找到 ${results.length} 处匹配`, 'out');
  results.slice(0, 10).forEach((line, i) => {
    dolLog(`  ${i + 1}: ${line.substring(0, 100)}`, 'out');
  });
  if (results.length > 10) dolLog(`  ... 还有 ${results.length - 10} 处`, 'out');
  dolVars['searchResults'] = results;
  return true;
}

function parseFileReplace(cmd) {
  const match = cmd.match(/^file\.replace<(.+)>@<(.+)=<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const oldText = match[2];
  const newText = match[3];
  if (dolVars[varName]) {
    const count = (dolVars[varName].match(new RegExp(oldText, 'g')) || []).length;
    dolVars[varName] = dolVars[varName].replace(new RegExp(oldText, 'g'), newText);
    dolLog(`🔄 替换完成，共替换 ${count} 处`, 'suc');
  }
  return true;
}

function parseFileSort(cmd) {
  const match = cmd.match(/^file\.sort<(.+)>@<(asc|desc|numeric)>$/);
  if (!match) return false;
  const varName = match[1];
  const type = match[2];
  let lines = (dolVars[varName] || '').split('\n');
  if (type === 'numeric') lines.sort((a, b) => parseFloat(a) - parseFloat(b));
  else if (type === 'desc') lines.sort().reverse();
  else lines.sort();
  dolVars[varName] = lines.join('\n');
  dolLog(`📊 已排序 (${type})，共 ${lines.length} 行`, 'suc');
  return true;
}

function parseFileFilter(cmd) {
  const match = cmd.match(/^file\.filter<(.+)>@<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const condition = match[2];
  const lines = (dolVars[varName] || '').split('\n');
  let filtered = lines.filter(line => line.includes(condition));
  dolVars[varName] = filtered.join('\n');
  dolLog(`🔽 过滤完成，保留 ${filtered.length}/${lines.length} 行`, 'suc');
  return true;
}

// 9. file.format<变量>@<格式> - 格式化内容
function parseFileFormat(cmd) {
  const match = cmd.match(/^file\.format<(.+)>@<(json|csv|table|tree)>$/);
  if (!match) return false;
  const varName = match[1];
  const format = match[2];
  const content = dolVars[varName] || '';
  let formatted = content;
  let html = '';
  
  if (format === 'json') {
    try {
      formatted = JSON.stringify(JSON.parse(content), null, 2);
      dolVars[varName] = formatted;
      dolLog(`📋 JSON格式化成功`, 'suc');
    } catch { dolLog(`❌ JSON格式无效`, 'err'); }
  } else if (format === 'csv') {
    const lines = content.split('\n').map(l => l.split(',').map(c => `"${c.trim()}"`).join(','));
    formatted = lines.join('\n');
    dolVars[varName] = formatted;
    dolLog(`📋 CSV格式化成功`, 'suc');
  } else if (format === 'table') {
    html = '<table style="width:100%;border-collapse:collapse;font-family:monospace;">';
    const rows = content.split('\n');
    rows.forEach((row, i) => {
      html += '<tr>';
      row.split(',').forEach(cell => {
        const style = i === 0 ? 'background:#5a7ca3;color:white;padding:8px;border:1px solid #3a4a63;' : 'padding:8px;border:1px solid #3a4a63;';
        html += `<td style="${style}">${cell.trim()}</td>`;
      });
      html += '</tr>';
    });
    html += '</table>';
    const div = document.createElement('div');
    div.innerHTML = html;
    div.style.cssText = 'background:rgba(20,22,27,0.95);padding:15px;border-radius:8px;margin:10px 0;max-height:400px;overflow:auto;';
    document.body.appendChild(div);
    allComponents.push(div);
    dolLog(`📊 表格已生成`, 'suc');
  } else if (format === 'tree') {
    try {
      const obj = JSON.parse(content);
      html = '<div style="font-family:monospace;padding:10px;"><pre>' + JSON.stringify(obj, null, 2) + '</pre></div>';
      const div = document.createElement('div');
      div.innerHTML = html;
      div.style.cssText = 'background:rgba(20,22,27,0.95);padding:15px;border-radius:8px;margin:10px 0;max-height:400px;overflow:auto;';
      document.body.appendChild(div);
      allComponents.push(div);
      dolLog(`🌳 树形结构已生成`, 'suc');
    } catch { dolLog(`❌ 无法解析为JSON`, 'err'); }
  }
  return true;
}

// 10. file.diff<文件1>@<文件2> - 对比差异
function parseFileDiff(cmd) {
  const match = cmd.match(/^file\.diff<(.+)>@<(.+)>$/);
  if (!match) return false;
  const var1 = match[1];
  const var2 = match[2];
  const content1 = (dolVars[var1] || '').split('\n');
  const content2 = (dolVars[var2] || '').split('\n');
  let added = 0, removed = 0, same = 0;
  content1.forEach((line, i) => {
    if (line !== content2[i]) {
      if (!content2.includes(line)) removed++;
      else added++;
    } else same++;
  });
  dolLog(`📊 对比结果: +${added} -${removed} =${same}`, 'out');
  return true;
}

// 11. file.chunk<变量>@<大小> - 分块处理
function parseFileChunk(cmd) {
  const match = cmd.match(/^file\.chunk<(.+)>@<(\d+)>$/);
  if (!match) return false;
  const varName = match[1];
  const chunkSize = parseInt(match[2]);
  const content = dolVars[varName] || '';
  const lines = content.split('\n');
  const chunks = [];
  for (let i = 0; i < lines.length; i += chunkSize) {
    chunks.push(lines.slice(i, i + chunkSize).join('\n'));
  }
  dolVars[`${varName}_chunks`] = chunks;
  dolLog(`📦 已分块: ${chunks.length} 个块，每块 ${chunkSize} 行`, 'suc');
  return true;
}

// 12. file.zip<文件名> - 压缩文件
function parseFileZip(cmd) {
  const match = cmd.match(/^file\.zip<(.+)>$/);
  if (!match) return false;
  const filename = match[1];
  const content = dolVars['fileContent'] || '';
  const compressed = btoa(unescape(encodeURIComponent(content)));
  dolVars['compressed'] = compressed;
  dolLog(`📦 文件已压缩: ${filename} (原始${content.length} → 压缩后${compressed.length})`, 'suc');
  return true;
}

// 13. file.unzip<变量> - 解压文件
function parseFileUnzip(cmd) {
  const match = cmd.match(/^file\.unzip<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  try {
    const decompressed = decodeURIComponent(escape(atob(dolVars[varName])));
    dolVars['uncompressed'] = decompressed;
    dolLog(`📂 文件已解压 (${decompressed.length}字符)`, 'suc');
  } catch { dolLog(`❌ 解压失败`, 'err'); }
  return true;
}

// 14. file.backup<变量>@<名称> - 备份数据
function parseFileBackup(cmd) {
  const match = cmd.match(/^file\.backup<(.+)>@<(.+)>$/);
  if (!match) return false;
  const varName = match[1];
  const backupName = match[2];
  dolVars[`backup_${backupName}`] = dolVars[varName];
  dolLog(`💾 已备份 ${varName} 为 backup_${backupName}`, 'suc');
  return true;
}

// 15. file.restore<备份名>@<目标> - 恢复数据
function parseFileRestore(cmd) {
  const match = cmd.match(/^file\.restore<(.+)>@<(.+)>$/);
  if (!match) return false;
  const backupName = match[1];
  const targetVar = match[2];
  const backup = dolVars[`backup_${backupName}`];
  if (backup) {
    dolVars[targetVar] = backup;
    dolLog(`↩️ 已恢复 backup_${backupName} 到 ${targetVar}`, 'suc');
  } else {
    dolLog(`❌ 备份不存在: backup_${backupName}`, 'err');
  }
  return true;
}

// 16. file.split<文件名>@<行数> - 分割大文件
function parseFileSplit(cmd) {
  const match = cmd.match(/^file\.split<(.+)>@<(\d+)>$/);
  if (!match) return false;
  const filename = match[1];
  const lines = parseInt(match[2]);
  dolVars['splitFile'] = filename;
  dolVars['splitLines'] = lines;
  dolLog(`📁 文件分割信息已记录，准备接收数据`, 'suc');
  return true;
}

// 17. file.merge<文件列表> - 合并文件
function parseFileMerge(cmd) {
  const match = cmd.match(/^file\.merge<(.+)>$/);
  if (!match) return false;
  const files = match[1].split(',');
  dolLog(`🔗 合并 ${files.length} 个文件`, 'out');
  dolVars['mergeFiles'] = files;
  dolLog(`📋 待合并文件: ${files.join(', ')}`, 'suc');
  return true;
}

function parseFileCmd(cmd) {
  if (cmd.startsWith('file.read<')) return parseFileRead(cmd);
  if (cmd.startsWith('file.write<')) return parseFileWrite(cmd);
  if (cmd.startsWith('file.size<')) return parseFileSize(cmd);
  if (cmd.startsWith('file.count<')) return parseFileCount(cmd);
  if (cmd.startsWith('file.search<')) return parseFileSearch(cmd);
  if (cmd.startsWith('file.replace<')) return parseFileReplace(cmd);
  if (cmd.startsWith('file.sort<')) return parseFileSort(cmd);
  if (cmd.startsWith('file.filter<')) return parseFileFilter(cmd);
  if (cmd.startsWith('file.format<')) return parseFileFormat(cmd);
  if (cmd.startsWith('file.diff<')) return parseFileDiff(cmd);
  if (cmd.startsWith('file.chunk<')) return parseFileChunk(cmd);
  if (cmd.startsWith('file.zip<')) return parseFileZip(cmd);
  if (cmd.startsWith('file.unzip<')) return parseFileUnzip(cmd);
  if (cmd.startsWith('file.backup<')) return parseFileBackup(cmd);
  if (cmd.startsWith('file.restore<')) return parseFileRestore(cmd);
  if (cmd.startsWith('file.split<')) return parseFileSplit(cmd);
  if (cmd.startsWith('file.merge<')) return parseFileMerge(cmd);
  return false;
}

// ==================================================
// ========== 【新增：制作指令 make.*】 ==========
// ==================================================
// make.report<标题>@<数据>  制作报告
// make.form<名称>@<字段>   制作表单
// make.card<标题>@<内容>   制作卡片
// make.workflow<名称>@<步骤> 制作工作流
// make.timeline<名称>@<事件> 制作时间线
// make.calendar<月份>@<日程> 制作日历
// make.dashboard<名称>@<组件> 制作仪表板

function parseMakeReport(cmd) {
  const match = cmd.match(/^make\.report<(.+)>@<(.+)>$/);
  if (!match) return false;
  const title = match[1];
  const data = match[2];
  
  const report = document.createElement('div');
  report.style.cssText = 'background:linear-gradient(135deg,rgba(20,22,27,0.98),rgba(30,33,38,0.98));padding:30px;border-radius:12px;margin:20px 0;max-width:800px;border:2px solid #5a7ca3;box-shadow:0 10px 40px rgba(0,0,0,0.3);';
  
  const timestamp = new Date().toLocaleString();
  const sections = data.split('||');
  
  let html = `<div style="text-align:center;border-bottom:3px solid #5a7ca3;padding-bottom:20px;margin-bottom:25px;"><h1 style="color:#5a7ca3;margin:0;font-size:28px;">${title}</h1><p style="color:#888;margin:10px 0 0 0;font-size:12px;">生成时间: ${timestamp}</p></div>`;
  
  sections.forEach((section, i) => {
    const [sectionTitle, sectionContent] = section.split('::');
    html += `<div style="margin-bottom:20px;padding:15px;background:rgba(58,74,99,0.3);border-radius:8px;"><h3 style="color:#5a7ca3;margin:0 0 10px 0;font-size:16px;">📑 ${sectionTitle || '章节 ' + (i + 1)}</h3><div style="color:#e2e2e2;line-height:1.8;">${sectionContent || section}</div></div>`;
  });
  
  html += `<div style="text-align:center;padding-top:20px;border-top:1px solid #3a4a63;color:#666;font-size:11px;">由 DonglaugOL 系统自动生成</div>`;
  
  report.innerHTML = html;
  document.body.appendChild(report);
  allComponents.push(report);
  dolLog(`📝 报告已生成: ${title}`, 'suc');
  return true;
}

function parseMakeForm(cmd) {
  const match = cmd.match(/^make\.form<(.+)>@<(.+)>$/);
  if (!match) return false;
  const formName = match[1];
  const fields = match[2].split(',');
  
  const form = document.createElement('div');
  form.style.cssText = 'background:rgba(20,22,27,0.95);padding:25px;border-radius:12px;margin:15px 0;max-width:500px;border:2px solid #5a7ca3;';
  
  let html = `<h3 style="color:#5a7ca3;margin:0 0 20px 0;">📋 ${formName}</h3><form id="dolForm_${Date.now()}">`;
  
  fields.forEach((field, i) => {
    const [label, type] = field.split(':');
    const inputType = type || 'text';
    html += `<div style="margin-bottom:15px;"><label style="display:block;color:#e2e2e2;margin-bottom:5px;font-size:14px;">${label}</label><input type="${inputType}" style="width:100%;padding:10px;border:1px solid #3a4a63;border-radius:6px;background:#2a3a53;color:#e2e2e2;font-family:monospace;box-sizing:border-box;"></div>`;
  });
  
  html += `<button type="button" onclick="dolFormSubmit(this)" style="width:100%;padding:12px;background:#5a7ca3;color:white;border:none;border-radius:6px;cursor:pointer;font-size:14px;margin-top:10px;">提交</button></form>`;
  
  form.innerHTML = html;
  document.body.appendChild(form);
  allComponents.push(form);
  dolLog(`📋 表单已创建: ${formName}`, 'suc');
  return true;
}

function parseMakeCard(cmd) {
  const match = cmd.match(/^make\.card<(.+)>@<([\s\S]+?)>$/);
  if (!match) return false;
  const title = match[1];
  const content = match[2];
  
  const card = document.createElement('div');
  card.style.cssText = 'background:linear-gradient(135deg,#2a3a53,#1a2a43);padding:20px;border-radius:12px;margin:10px;max-width:300px;border:1px solid #3a4a63;box-shadow:0 4px 15px rgba(0,0,0,0.2);display:inline-block;vertical-align:top;';
  card.innerHTML = `<h4 style="color:#5a7ca3;margin:0 0 15px 0;font-size:16px;border-bottom:1px solid #3a4a63;padding-bottom:10px;">${title}</h4><div style="color:#e2e2e2;line-height:1.6;font-size:14px;">${content}</div>`;
  document.body.appendChild(card);
  allComponents.push(card);
  dolLog(`🃏 卡片已创建: ${title}`, 'suc');
  return true;
}

function parseMakeWorkflow(cmd) {
  const match = cmd.match(/^make\.workflow<(.+)>@<(.+)>$/);
  if (!match) return false;
  const name = match[1];
  const steps = match[2].split('>');
  
  const workflow = document.createElement('div');
  workflow.style.cssText = 'background:rgba(20,22,27,0.95);padding:25px;border-radius:12px;margin:15px 0;max-width:700px;border:2px solid #5a7ca3;';
  
  let html = `<h3 style="color:#5a7ca3;margin:0 0 20px 0;">🔄 ${name}</h3><div style="display:flex;align-items:center;flex-wrap:wrap;gap:10px;">`;
  
  steps.forEach((step, i) => {
    const stepNum = i + 1;
    const isLast = i === steps.length - 1;
    html += `<div style="background:#5a7ca3;color:white;padding:12px 20px;border-radius:8px;font-family:monospace;font-size:14px;position:relative;"><span style="position:absolute;top:-8px;left:-8px;background:#3a5a83;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;">${stepNum}</span>${step.trim()}</div>${!isLast ? '<div style="color:#5a7ca3;font-size:20px;">→</div>' : ''}`;
  });
  
  html += '</div>';
  workflow.innerHTML = html;
  document.body.appendChild(workflow);
  allComponents.push(workflow);
  dolLog(`🔄 工作流已创建: ${name} (${steps.length}步)`, 'suc');
  return true;
}

function parseMakeDashboard(cmd) {
  const match = cmd.match(/^make\.dashboard<(.+)>@<(.+)>$/);
  if (!match) return false;
  const name = match[1];
  const components = match[2].split(',');
  
  const dashboard = document.createElement('div');
  dashboard.style.cssText = 'background:rgba(20,22,27,0.95);padding:25px;border-radius:12px;margin:15px 0;max-width:900px;border:2px solid #5a7ca3;';
  
  let html = `<h3 style="color:#5a7ca3;margin:0 0 20px 0;">📊 ${name}</h3><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;">`;
  
  components.forEach((comp, i) => {
    const [title, value, trend] = comp.split(':');
    const trendIcon = trend === 'up' ? '📈' : trend === 'down' ? '📉' : '➡️';
    const trendColor = trend === 'up' ? '#4ade80' : trend === 'down' ? '#f87171' : '#888';
    html += `<div style="background:linear-gradient(135deg,#2a3a53,#1a2a43);padding:20px;border-radius:10px;border:1px solid #3a4a63;"><div style="color:#888;font-size:12px;margin-bottom:5px;">${title || '指标 ' + (i + 1)}</div><div style="color:#e2e2e2;font-size:28px;font-weight:bold;margin-bottom:5px;">${value || '---'}</div><div style="color:${trendColor};font-size:14px;">${trendIcon} ${trend || '稳定'}</div></div>`;
  });
  
  html += '</div>';
  dashboard.innerHTML = html;
  document.body.appendChild(dashboard);
  allComponents.push(dashboard);
  dolLog(`📊 仪表板已创建: ${name}`, 'suc');
  return true;
}

function parseMakeTimeline(cmd) {
  const match = cmd.match(/^make\.timeline<(.+)>@<(.+)>$/);
  if (!match) return false;
  const name = match[1];
  const events = match[2].split('|');
  
  const timeline = document.createElement('div');
  timeline.style.cssText = 'background:rgba(20,22,27,0.95);padding:25px;border-radius:12px;margin:15px 0;max-width:600px;border:2px solid #5a7ca3;';
  
  let html = `<h3 style="color:#5a7ca3;margin:0 0 20px 0;">📅 ${name}</h3><div style="position:relative;padding-left:30px;">`;
  
  events.forEach((event, i) => {
    const [date, desc] = event.split('::');
    const isLast = i === events.length - 1;
    html += `
      <div style="position:relative;padding-bottom:${isLast ? '0' : '20px'};">
        <div style="position:absolute;left:-38px;top:5px;width:16px;height:16px;background:${i % 2 === 0 ? '#5a7ca3' : '#4ade80'};border-radius:50%;border:3px solid #2a3a53;"></div>
        ${!isLast ? '<div style="position:absolute;left:-31px;top:20px;width:2px;height:calc(100% + 20px);background:#3a4a63;"></div>' : ''}
        <div style="color:#888;font-size:12px;margin-bottom:3px;">${date}</div>
        <div style="color:#e2e2e2;font-size:14px;">${desc || event}</div>
      </div>
    `;
  });
  
  html += '</div>';
  timeline.innerHTML = html;
  document.body.appendChild(timeline);
  allComponents.push(timeline);
  dolLog(`📅 时间线已创建: ${name}`, 'suc');
  return true;
}

function parseMakeCalendar(cmd) {
  const match = cmd.match(/^make\.calendar<(\d{4}-\d{2})>@<(.+)>$/);
  if (!match) return false;
  const month = match[1];
  const schedules = match[2];
  
  const [year, monthNum] = month.split('-').map(Number);
  const firstDay = new Date(year, monthNum - 1, 1).getDay();
  const daysInMonth = new Date(year, monthNum, 0).getDate();
  const monthNames = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];
  
  const calendar = document.createElement('div');
  calendar.style.cssText = 'background:rgba(20,22,27,0.95);padding:20px;border-radius:12px;margin:15px 0;max-width:450px;border:2px solid #5a7ca3;';
  
  let html = `<h3 style="color:#5a7ca3;margin:0 0 15px 0;text-align:center;">📆 ${year}年 ${monthNames[monthNum - 1]}</h3>`;
  html += '<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center;">';
  ['日', '一', '二', '三', '四', '五', '六'].forEach(d => {
    html += `<div style="background:#3a4a63;padding:8px;color:#888;font-size:12px;">${d}</div>`;
  });
  
  for (let i = 0; i < firstDay; i++) {
    html += '<div style="padding:8px;"></div>';
  }
  
  for (let day = 1; day <= daysInMonth; day++) {
    const hasSchedule = schedules.includes(`:${day}:`) || schedules.includes(`:${day},`) || schedules.endsWith(`:${day}`);
    const bgColor = hasSchedule ? '#5a7ca3' : '#2a3a53';
    const textColor = day === new Date().getDate() && new Date().getMonth() === monthNum - 1 ? '#fbbf24' : '#e2e2e2';
    html += `<div style="padding:8px;background:${bgColor};border-radius:4px;color:${textColor};font-size:13px;${hasSchedule ? 'box-shadow:0 0 10px rgba(90,124,163,0.5);' : ''}">${day}</div>`;
  }
  
  html += '</div>';
  calendar.innerHTML = html;
  document.body.appendChild(calendar);
  allComponents.push(calendar);
  dolLog(`📆 日历已生成: ${month}`, 'suc');
  return true;
}

function parseMakeCmd(cmd) {
  if (cmd.startsWith('make.report<')) return parseMakeReport(cmd);
  if (cmd.startsWith('make.form<')) return parseMakeForm(cmd);
  if (cmd.startsWith('make.card<')) return parseMakeCard(cmd);
  if (cmd.startsWith('make.timeline<')) return parseMakeTimeline(cmd);
  if (cmd.startsWith('make.calendar<')) return parseMakeCalendar(cmd);
  if (cmd.startsWith('make.workflow<')) return parseMakeWorkflow(cmd);
  if (cmd.startsWith('make.dashboard<')) return parseMakeDashboard(cmd);
  return false;
}

// 表单提交处理函数
window.dolFormSubmit = function(btn) {
  const form = btn.parentElement;
  const inputs = form.querySelectorAll('input');
  const values = {};
  inputs.forEach((input, i) => {
    values[`field_${i}`] = input.value;
  });
  dolVars['formData'] = values;
  dolLog(`📋 表单已提交: ${JSON.stringify(values)}`, 'suc');
};

// ==================================================
// ========== 【新增：搜索框指令 search.*】 ==========
// ==================================================
// search.box<提示>@<宽度>    创建搜索框
// search.list<名称>@<项目>   创建搜索列表
// search.table<名称>@<数据>  创建搜索表格

function parseSearchBox(cmd) {
  const match = cmd.match(/^search\.box<(.+)>@<(\d+)>$/);
  if (!match) return false;
  const placeholder = match[1];
  const width = match[2];
  
  const searchContainer = document.createElement('div');
  searchContainer.style.cssText = 'display:inline-flex;gap:10px;align-items:center;padding:15px;background:rgba(20,22,27,0.95);border-radius:8px;margin:10px 0;border:2px solid #5a7ca3;';
  
  const input = document.createElement('input');
  input.type = 'text';
  input.placeholder = placeholder;
  input.style.cssText = `width:${width}px;padding:10px 15px;border:1px solid #3a4a63;border-radius:6px;background:#2a3a53;color:#e2e2e2;font-family:monospace;font-size:14px;outline:none;`;
  input.oninput = function() {
    dolVars['searchInput'] = this.value;
  };
  
  const btn = document.createElement('button');
  btn.textContent = '搜索';
  btn.style.cssText = 'padding:10px 20px;background:#5a7ca3;color:white;border:none;border-radius:6px;cursor:pointer;font-family:monospace;';
  btn.onclick = function() {
    dolVars['searchResult'] = dolVars['searchInput'];
    dolLog(`✅ 搜索完成: ${dolVars['searchInput']}`, 'suc');
  };
  
  searchContainer.appendChild(input);
  searchContainer.appendChild(btn);
  document.body.appendChild(searchContainer);
  allComponents.push(searchContainer);
  dolLog(`🔍 搜索框已创建: "${placeholder}"`, 'suc');
  return true;
}

function parseSearchCmd(cmd) {
  if (cmd.startsWith('search.box<')) return parseSearchBox(cmd);
  return false;
}

// ==================================================
// ========== 【新增：工业化打印指令 pr.*】 ==========
// ==================================================
// pr.table<数据>       创建表格
// pr.label<文本>       创建标签
// pr.format<格式>@<内容> 格式化内容
// pr.export<格式>=<数据> 导出数据

function parsePrTable(cmd) {
  const match = cmd.match(/^pr\.table<(.+)>$/);
  if (!match) return false;
  const data = match[1];
  const rows = data.split(',');
  
  const table = document.createElement('div');
  table.style.cssText = 'background:rgba(20,22,27,0.95);padding:15px;border-radius:8px;margin:10px 0;max-width:100%;overflow:auto;';
  
  let html = '<table style="width:100%;border-collapse:collapse;font-family:monospace;">';
  rows.forEach((row, i) => {
    html += '<tr>';
    row.split('|').forEach(cell => {
      const style = i === 0 ? 'background:#5a7ca3;color:white;padding:8px;border:1px solid #3a4a63;' : 'padding:8px;border:1px solid #3a4a63;';
      html += `<td style="${style}">${cell.trim()}</td>`;
    });
    html += '</tr>';
  });
  html += '</table>';
  
  table.innerHTML = html;
  document.body.appendChild(table);
  allComponents.push(table);
  dolLog(`📊 表格已创建`, 'suc');
  return true;
}

function parsePrExport(cmd) {
  const match = cmd.match(/^pr\.export<(txt|json|csv)>=<(.+)>$/);
  if (!match) return false;
  const format = match[1];
  const data = match[2];
  let content = data;
  let mimeType = 'text/plain';
  let ext = 'txt';
  
  if (format === 'json') {
    content = JSON.stringify({ data: data }, null, 2);
    mimeType = 'application/json';
    ext = 'json';
  } else if (format === 'csv') {
    content = data.replace(/\|/g, ',');
    mimeType = 'text/csv';
    ext = 'csv';
  }
  
  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `export_${Date.now()}.${ext}`;
  a.click();
  URL.revokeObjectURL(url);
  dolLog(`📤 已导出为 ${format.toUpperCase()} 格式`, 'suc');
  return true;
}

function parsePrCmd(cmd) {
  if (cmd.startsWith('pr.table<')) return parsePrTable(cmd);
  if (cmd.startsWith('pr.export<')) return parsePrExport(cmd);
  return false;
}

// ==================================================
// ========== 【新增：扩展控制指令 ext.*】 ==========
// ==================================================
// ext.open<URL>       打开外部链接
