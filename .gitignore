function draw3dEmbed() {
  const uid = 'draw3d_embed_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div style="display:flex;gap:8px;margin-bottom:6px;">
        <button onclick="drawSystem3d.createCube('c'+Date.now(),-50,0,0,40,'#ff6b6b')" style="padding:4px 10px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">📦 立方体</button>
        <button onclick="drawSystem3d.createSphere('s'+Date.now(),50,0,0,30,'#5a9cf0')" style="padding:4px 10px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">🔵 球体</button>
        <button onclick="drawSystem3d.createPyramid('p'+Date.now(),0,50,0,40,'#ffaa00')" style="padding:4px 10px;background:#ffaa00;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">⛰️ 金字塔</button>
        <button onclick="drawSystem3d.clearObjects()" style="padding:4px 10px;background:#666;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">🗑️ 清空</button>
      </div>
      <canvas id="${uid}" width="600" height="300" style="width:100%;border-radius:6px;background:#0a0a0f;"></canvas>
    </div>
  `;
  showInlineUI(html);
  
  const canvas = document.getElementById(uid);
  const ctx = canvas.getContext('2d');
  const objects = [];
  let rx = 0, ry = 0;
  
  window.drawSystem3d = {
    createCube: function(id, x, y, z, size, color) {
      objects.push({ type: 'cube', id, x, y, z, size, color, rx: 0, ry: 0, rz: 0 });
    },
    createSphere: function(id, x, y, z, radius, color) {
      objects.push({ type: 'sphere', id, x, y, z, radius, color });
    },
    createPyramid: function(id, x, y, z, size, color) {
      objects.push({ type: 'pyramid', id, x, y, z, size, color });
    },
    clearObjects: function() { objects.length = 0; }
  };
  
  function project(x, y, z) {
    const cosx = Math.cos(rx), sinx = Math.sin(rx);
    const cosy = Math.cos(ry), siny = Math.sin(ry);
    const x1 = x * cosy + z * siny;
    const z1 = -x * siny + z * cosy;
    const y1 = y * cosx - z1 * sinx;
    const z2 = y * sinx + z1 * cosx;
    const scale = 200 / (200 + z2);
    return { x: canvas.width/2 + x1 * scale, y: canvas.height/2 - y1 * scale };
  }
  
  function drawCube(obj) {
    const s = obj.size;
    const points = [[-s,-s,-s],[s,-s,-s],[s,s,-s],[-s,s,-s],[-s,-s,s],[s,-s,s],[s,s,s],[-s,s,s]];
    const faces = [[0,1,2,3],[4,5,6,7],[0,4,7,3],[1,5,6,2],[3,2,6,7],[0,1,5,4]];
    ctx.fillStyle = obj.color;
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1;
    faces.forEach(f => {
      const p = f.map(i => project(obj.x + points[i][0], obj.y + points[i][1], obj.z + points[i][2]));
      ctx.beginPath();
      ctx.moveTo(p[0].x, p[0].y);
      p.forEach(pt => ctx.lineTo(pt.x, pt.y));
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
    });
  }
  
  function drawSphere(obj) {
    ctx.beginPath();
    const p = project(obj.x, obj.y, obj.z);
    ctx.arc(p.x, p.y, obj.radius, 0, Math.PI*2);
    ctx.fillStyle = obj.color;
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1;
    ctx.stroke();
  }
  
  function drawPyramid(obj) {
    const s = obj.size;
    const points = [[0,s,0],[-s,-s,s],[s,-s,s],[s,-s,-s],[-s,-s,-s]];
    const faces = [[0,1,2],[0,2,3],[0,3,4],[0,4,1],[1,2,3,4]];
    ctx.fillStyle = obj.color;
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1;
    faces.forEach(f => {
      const p = f.map(i => project(obj.x + points[i][0], obj.y + points[i][1], obj.z + points[i][2]));
      ctx.beginPath();
      ctx.moveTo(p[0].x, p[0].y);
      p.forEach(pt => ctx.lineTo(pt.x, pt.y));
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
    });
  }
  
  function animate() {
    ctx.fillStyle = '#0a0a0f';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    rx += 0.02;
    ry += 0.01;
    objects.forEach(obj => {
      if (obj.type === 'cube') drawCube(obj);
      else if (obj.type === 'sphere') drawSphere(obj);
      else if (obj.type === 'pyramid') drawPyramid(obj);
    });
    requestAnimationFrame(animate);
  }
  animate();
  dolLog(`✅ 3D内嵌画布已创建`, 'suc');
}

function draw2dEmbed() {
  const uid = 'draw2d_embed_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div style="display:flex;gap:8px;margin-bottom:6px;">
        <button onclick="draw2dTool='pen';draw2dColor='#ff6b6b'" style="padding:4px 10px;background:#ff6b6b;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">✏️ 画笔</button>
        <button onclick="draw2dTool='rect';draw2dColor='#5a9cf0'" style="padding:4px 10px;background:#5a9cf0;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">⬜ 矩形</button>
        <button onclick="draw2dTool='circle';draw2dColor='#ffaa00'" style="padding:4px 10px;background:#ffaa00;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">⭕ 圆形</button>
        <button onclick="draw2dTool='eraser'" style="padding:4px 10px;background:#666;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">🧹 橡皮擦</button>
        <button onclick="const c=document.getElementById('${uid}');c.getContext('2d').fillStyle='#0a0a0f';c.getContext('2d').fillRect(0,0,c.width,c.height)" style="padding:4px 10px;background:#333;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">🗑️ 清空</button>
      </div>
      <canvas id="${uid}" width="600" height="250" style="width:100%;border-radius:6px;background:#0a0a0f;cursor:crosshair;"></canvas>
    </div>
  `;
  showInlineUI(html);
  
  const canvas = document.getElementById(uid);
  const ctx = canvas.getContext('2d');
  let drawing = false;
  let lastX = 0, lastY = 0;
  window.draw2dTool = 'pen';
  window.draw2dColor = '#ff6b6b';
  
  canvas.addEventListener('mousedown', (e) => { drawing = true; [lastX, lastY] = [e.offsetX, e.offsetY]; });
  canvas.addEventListener('mouseup', () => drawing = false);
  canvas.addEventListener('mousemove', (e) => {
    if (!drawing) return;
    ctx.beginPath();
    ctx.moveTo(lastX, lastY);
    if (draw2dTool === 'eraser') {
      ctx.strokeStyle = '#0a0a0f';
      ctx.lineWidth = 10;
    } else {
      ctx.strokeStyle = draw2dColor;
      ctx.lineWidth = 2;
    }
    ctx.lineTo(e.offsetX, e.offsetY);
    ctx.stroke();
    [lastX, lastY] = [e.offsetX, e.offsetY];
  });
  dolLog(`✅ 2D内嵌画布已创建`, 'suc');
}

function embedGallery() {
  const uid = 'embed_gallery_' + Date.now();
  const html = `
    <div style="margin:8px 0;padding:8px;background:#161b22;border-radius:8px;border:1px solid #30363d;">
      <div style="display:flex;gap:4px;overflow-x:auto;padding-bottom:4px;">
        <img src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=beautiful%20nature%20landscape&image_size=square" style="width:100px;height:100px;border-radius:4px;object-fit:cover;flex-shrink:0;" />
