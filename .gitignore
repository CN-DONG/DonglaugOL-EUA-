let hackerMode = false;
let watchFolderHandle = null;
let folderWatchLog = [];

window.addEventListener('load', () => {
  const savedSettings = JSON.parse(localStorage.getItem('dol_settings') || '{}');
  const codeInput = document.getElementById('codeInput');
  const lineNumbersContainer = document.getElementById('codeInput-line-numbers');
  
  if (savedSettings.codeWidth) {
    codeInput.style.setProperty('width', savedSettings.codeWidth + 'px', 'important');
  } else {
    codeInput.style.setProperty('width', '1234px', 'important');
  }
  if (savedSettings.codeHeight) {
    codeInput.style.setProperty('height', savedSettings.codeHeight + 'px', 'important');
  }
  if (savedSettings.fontSize) {
    codeInput.style.setProperty('font-size', savedSettings.fontSize + 'px', 'important');
  }
  // ====== 语法高亮函数（全局可用） ======
  function updateCodeHighlight() {
    const highlight = document.getElementById('codeInput-highlight');
    if (!highlight) return;
    const text = codeInput.value;
    
    // 转义HTML实体，防止HTML标签被正则匹配
    const escapeHtml = (str) => {
      return str.replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
    };
    
    const lines = text.split('\n');
    let html = '';
    
    for (let i = 0; i < lines.length; i++) {
      let line = escapeHtml(lines[i]);
      
      let comment = '';
      // 只匹配行首或空白后的#或//作为注释，移除?和!
      const commentMatch = line.match(/(\s*#.*|\s*\/\/.*)$/);
      if (commentMatch) {
        comment = commentMatch[1];
        line = line.substring(0, line.length - comment.length);
      }
      
      // 使用token-based替换，避免正则匹配已插入的HTML标签
      // 先定义所有需要高亮的模式
      const tokens = [];
      const patterns = [
        { regex: /(\/[a-zA-Z]+\/)/g, type: 'cmd', color: '#ffd700' },
        { regex: /(ip\{[^}]+\}\*\{[^}]+\})/g, type: 'ip', color: '#5a9cf0' },
        { regex: /(ba&lt;[^&]+&gt;\*&lt;[^&]+&gt;)/g, type: 'ba', color: '#aa55ff' },
        { regex: /(&lt;[^&]+&gt;)/g, type: 'tag', color: '#ff69b4' },
        { regex: /(\[[^\]]+\])/g, type: 'bracket', color: '#8b4513' },
        { regex: /(\.\.[^.]+\.\.)/g, type: 'dot', color: '#888888', opacity: 0.4 },
        { regex: /(_[a-zA-Z]+)/g, type: 'underline', color: '#ff0000' },
        { regex: /(\(\))/g, type: 'paren', color: '#87ceeb' },
        { regex: /(''[^']*'')/g, type: 'quote', color: '#ff6b6b' },
        { regex: /(@\w+)/g, type: 'at', color: '#00ffcc' },
        { regex: /(\=)/g, type: 'equals', color: '#aa55ff' },
        { regex: /(\*)/g, type: 'star', color: '#cc9900' }
      ];
      
      // 收集所有token及其位置
      patterns.forEach(p => {
        let match;
        const regex = new RegExp(p.regex.source, 'g');
        while ((match = regex.exec(line)) !== null) {
          tokens.push({
            start: match.index,
            end: match.index + match[0].length,
            text: match[0],
            color: p.color,
            opacity: p.opacity
          });
        }
      });
      
      // 按位置排序token
      tokens.sort((a, b) => a.start - b.start);
      
      // 合并重叠的token，保留优先级高的
      const mergedTokens = [];
      let lastEnd = -1;
      tokens.forEach(t => {
        if (t.start >= lastEnd) {
          mergedTokens.push(t);
          lastEnd = t.end;
        }
      });
      
      // 构建最终的HTML
      let result = '';
      let lastPos = 0;
      mergedTokens.forEach(t => {
        // 添加普通文本
        if (t.start > lastPos) {
          result += line.substring(lastPos, t.start);
        }
        // 添加高亮文本
        const opacityStyle = t.opacity ? `opacity:${t.opacity};` : '';
        result += '<span style="color:' + t.color + ';' + opacityStyle + 'font-weight:bold;">' + t.text + '</span>';
        lastPos = t.end;
      });
      // 添加剩余文本
      if (lastPos < line.length) {
        result += line.substring(lastPos);
      }
      
      if (comment) {
        result += '<span style="color:#ffd700;">' + comment + '</span>';
      }
      
      html += result;
      if (i < lines.length - 1) {
        html += '\n';
      }
    }
    
    highlight.textContent = '';
    highlight.innerHTML = html;
    highlight.scrollTop = codeInput.scrollTop;
  }
  
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  // ====== 行号设置处理 ======
  const lineNumbersEnabled = localStorage.getItem('dol_lineNumbers') !== 'false';
  if (lineNumbersEnabled) {
    lineNumbersContainer.style.display = 'block';
    lineNumbersContainer.style.height = codeInput.offsetHeight + 'px';
    codeInput.style.paddingLeft = '50px';
    
    const highlight = document.getElementById('codeInput-highlight');
    if (highlight) {
      highlight.style.left = '0';
      highlight.style.width = '100%';
      highlight.style.paddingLeft = '50px';
    }
    
    const fontSize = codeInput.style.fontSize || '16px';
    const lineHeight = codeInput.style.lineHeight || '20px';
    lineNumbersContainer.style.fontSize = fontSize;
    lineNumbersContainer.style.lineHeight = lineHeight;
    
    const lines = codeInput.value.split('\n');
    let html = '';
    for (let i = 1; i <= lines.length; i++) {
      html += '<div style="padding-right:8px;">' + i + '</div>';
    }
    lineNumbersContainer.innerHTML = html;
    
    codeInput.addEventListener('scroll', () => {
      lineNumbersContainer.scrollTop = codeInput.scrollTop;
      const highlight = document.getElementById('codeInput-highlight');
      if (highlight) highlight.scrollTop = codeInput.scrollTop;
    });
    
    codeInput.addEventListener('input', () => {
      const fontSize = codeInput.style.fontSize || '16px';
      const lineHeight = codeInput.style.lineHeight || '20px';
      lineNumbersContainer.style.fontSize = fontSize;
      lineNumbersContainer.style.lineHeight = lineHeight;
      lineNumbersContainer.style.height = codeInput.offsetHeight + 'px';
      const lines = codeInput.value.split('\n');
      let html = '';
      for (let i = 1; i <= lines.length; i++) {
        html += '<div style="padding-right:8px;">' + i + '</div>';
      }
      lineNumbersContainer.innerHTML = html;
      updateCodeHighlight();
    });
  }
  
  // ====== 无论是否有行号，都监听输入并更新高亮 ======
  codeInput.addEventListener('input', updateCodeHighlight);
  
  // ====== 页面加载时立即更新一次高亮 ======
  updateCodeHighlight();
  
  // 指令大全交互逻辑 - F12+P+N 快捷键触发（弹窗方式）
  let isGuideExpanded = false;
  
  function toggleGuide() {
    isGuideExpanded = !isGuideExpanded;
    
    if (isGuideExpanded) {
      createGuideModal();
      dolLog('📚 指令大全已打开', 'info');
    } else {
      const modal = document.getElementById('guide-modal');
      if (modal) {
        modal.style.opacity = '0';
        modal.style.transform = 'scale(0.95) translateY(-20px)';
        setTimeout(() => modal.remove(), 300);
      }
    }
    playSound('switch');
  }
  
  function createGuideModal() {
    const modal = document.createElement('div');
    modal.id = 'guide-modal';
    modal.style.cssText = `
      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.95);
      width: 90%; max-width: 1200px; max-height: 80vh;
      background: rgba(30, 33, 38, 0.92);
      backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      box-shadow: 
        0 30px 80px rgba(0, 0, 0, 0.6),
        0 10px 30px rgba(0, 0, 0, 0.4),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      z-index: 9999;
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    `;
    
    const overlay = document.createElement('div');
    overlay.id = 'guide-overlay';
    overlay.style.cssText = `
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
      z-index: 9998;
      opacity: 0;
      transition: opacity 0.3s;
    `;
    
    overlay.addEventListener('click', toggleGuide);
    
    const header = document.createElement('div');
    header.style.cssText = `
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 25px;
      background: linear-gradient(180deg, rgba(90, 124, 163, 0.2) 0%, rgba(60, 90, 130, 0.1) 100%);
