    html += '<option>像素 (px)</option><option>百分比 (%)</option><option>视窗宽 (vw)</option><option>视窗高 (vh)</option><option>字体 (em)</option></select></div>';
    showInlineUI(html);
    var uniEl = document.getElementById(uid);
    if (uniEl) uniEl.addEventListener('change', function() { const act = window.__nsCustomAction || '单位'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('单位选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  
  // /ns/filter 过滤选择框
  if (line === '/ns/filter' || line.startsWith('/ns/filter<')) {
    const labelMatch = line.match(/^\/ns\/filter(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nsfil' + Date.now();
    let html = '<div style="width:320px;padding:10px;border-radius:12px;background:#e0e4eb;margin:10px;">';
    if (customLabel) { html += '<div style="color:#333;font-size:14px;margin-bottom:6px;font-weight:500;">' + escapeHtml(customLabel) + '</div>'; }
    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>全部</option><option>已完成</option><option>进行中</option><option>待处理</option><option>已取消</option></select></div>';
