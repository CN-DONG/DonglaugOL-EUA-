    dolLog('过滤选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  
  // /ns/encoding 编码选择框
  if (line === '/ns/encoding' || line.startsWith('/ns/encoding<')) {
    const labelMatch = line.match(/^\/ns\/encoding(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
