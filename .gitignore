        <div style="width:100%;height:100%;background:#000;color:#0f0;font-family:monospace;padding:10px;overflow:auto;">
          <div>Microsoft Windows [版本 10.0.19045.0]</div>
          <div>(c) Microsoft Corporation. 保留所有权利。</div>
          <div style="margin-top:10px;">C:\\Users\\Donglaug&gt;</div>
          <div style="margin-top:20px;color:#888;">提示：浏览器环境下无法直接执行系统命令</div>
        </div>
      `);
      return true;
      
    case 'notepad':
