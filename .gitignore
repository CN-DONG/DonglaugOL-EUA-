function create3dCapsule(param) {
  scene3d.model = 'capsule';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D胶囊 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function create3dRing(param) {
  scene3d.model = 'ring';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D环 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function create3dGear(param) {
  scene3d.model = 'gear';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D齿轮 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function create3dStar(param) {
  scene3d.model = 'star';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D星形 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function create3dHeart(param) {
  scene3d.model = 'heart';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D爱心 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function create3dDiamond(param) {
  scene3d.model = 'diamond';
  scene3d.size = parseInt(param) || 100;
  dolLog(`✅ 创建3D钻石 (大小: ${scene3d.size})`, 'suc');
  render3dModel();
  return true;
}

function set3dPosition(param) {
  if (!param) {
    dolLog(`📍 当前位置: X=${scene3d.position.x} Y=${scene3d.position.y} Z=${scene3d.position.z}`, 'info');
    return true;
  }
  const parts = param.split('*');
  scene3d.position.x = parseFloat(parts[0]) || 0;
  scene3d.position.y = parseFloat(parts[1]) || 0;
  scene3d.position.z = parseFloat(parts[2]) || 0;
  dolLog(`📍 位置已设置: X=${scene3d.position.x} Y=${scene3d.position.y} Z=${scene3d.position.z}`, 'suc');
  render3dModel();
  return true;
}

function set3dSegments(param) {
  const s = parseInt(param);
  if (isNaN(s) || s < 3 || s > 256) {
    dolLog(`❌ 分段范围: 3-256`, 'err');
    return true;
  }
  scene3d.segments = s;
  dolLog(`📐 分段数已设置: ${s}`, 'suc');
  render3dModel();
  return true;
}

function sculpt3dPush(param) {
  dolLog(`✋ 雕刻: 推出模式 (强度: ${scene3d.sculpt.strength})`, 'suc');
  scene3d.size += scene3d.sculpt.strength * 10;
  render3dModel();
  return true;
}

function sculpt3dPull(param) {
  dolLog(`✋ 雕刻: 拉入模式 (强度: ${scene3d.sculpt.strength})`, 'suc');
  scene3d.size = Math.max(10, scene3d.size - scene3d.sculpt.strength * 10);
  render3dModel();
  return true;
}

function sculpt3dSmooth(param) {
  dolLog(`✋ 雕刻: 平滑模式`, 'suc');
  scene3d.segments = Math.min(128, scene3d.segments + 4);
  render3dModel();
  return true;
}

function sculpt3dPinch(param) {
  dolLog(`✋ 雕刻: 收缩模式`, 'suc');
  scene3d.scale = Math.max(0.2, scene3d.scale - 0.05);
  render3dModel();
  return true;
}

function sculpt3dFlatten(param) {
  dolLog(`✋ 雕刻: 压扁模式`, 'suc');
  scene3d.scale = Math.max(0.1, scene3d.scale - 0.1);
  render3dModel();
  return true;
}

function sculpt3dInflate(param) {
  dolLog(`✋ 雕刻: 膨胀模式`, 'suc');
  scene3d.scale = Math.min(3, scene3d.scale + 0.1);
  render3dModel();
  return true;
}

function sculpt3dGrab(param) {
  dolLog(`✋ 雕刻: 抓取模式`, 'suc');
  return true;
}

function sculpt3dCrease(param) {
  dolLog(`✋ 雕刻: 褶皱模式`, 'suc');
  scene3d.segments = Math.max(3, scene3d.segments - 2);
  render3dModel();
  return true;
}

function set3dSculptSize(param) {
  const s = parseFloat(param);
  if (isNaN(s) || s <= 0) {
    dolLog(`❌ 笔刷大小必须 > 0`, 'err');
    return true;
  }
  scene3d.sculpt.size = s;
  dolLog(`🖌️ 雕刻笔刷大小: ${s}`, 'suc');
  return true;
}

function set3dSculptStrength(param) {
  const s = parseFloat(param);
  if (isNaN(s) || s < 0 || s > 1) {
    dolLog(`❌ 强度范围: 0-1`, 'err');
    return true;
  }
  scene3d.sculpt.strength = s;
  dolLog(`💪 雕刻强度: ${s}`, 'suc');
  return true;
}

function set3dMaterial(param) {
  const types = ['standard', 'metal', 'glass', 'plastic', 'rubber', 'wood', 'stone', 'water'];
  if (!param) {
    dolLog(`🎨 当前材质: ${scene3d.material.type}`, 'info');
    dolLog(`可用材质: ${types.join(', ')}`, 'info');
    return true;
  }
  if (!types.includes(param)) {
    dolLog(`❌ 未知材质: ${param}`, 'err');
    return true;
  }
  scene3d.material.type = param;
  switch(param) {
    case 'metal': scene3d.material.metalness = 0.9; scene3d.material.roughness = 0.2; break;
    case 'glass': scene3d.material.metalness = 0; scene3d.material.roughness = 0.05; scene3d.material.opacity = 0.5; break;
    case 'plastic': scene3d.material.metalness = 0; scene3d.material.roughness = 0.4; break;
    case 'rubber': scene3d.material.metalness = 0; scene3d.material.roughness = 0.9; break;
    case 'wood': scene3d.material.metalness = 0; scene3d.material.roughness = 0.7; break;
    case 'stone': scene3d.material.metalness = 0.1; scene3d.material.roughness = 0.8; break;
    case 'water': scene3d.material.metalness = 0; scene3d.material.roughness = 0.05; scene3d.material.opacity = 0.7; break;
  }
  dolLog(`🎨 材质已设置: ${param}`, 'suc');
  render3dModel();
  return true;
}

function set3dMetalness(param) {
  const v = parseFloat(param);
  if (isNaN(v) || v < 0 || v > 1) {
    dolLog(`❌ 金属度范围: 0-1`, 'err');
    return true;
  }
  scene3d.material.metalness = v;
  dolLog(`🔩 金属度: ${v}`, 'suc');
  return true;
}

function set3dRoughness(param) {
  const v = parseFloat(param);
  if (isNaN(v) || v < 0 || v > 1) {
    dolLog(`❌ 粗糙度范围: 0-1`, 'err');
    return true;
  }
  scene3d.material.roughness = v;
  dolLog(`🪨 粗糙度: ${v}`, 'suc');
  return true;
}

function set3dOpacity(param) {
  const v = parseFloat(param);
  if (isNaN(v) || v < 0 || v > 1) {
    dolLog(`❌ 不透明度范围: 0-1`, 'err');
    return true;
  }
  scene3d.material.opacity = v;
  dolLog(`👁️ 不透明度: ${v}`, 'suc');
  return true;
}

function set3dEmissive(param) {
  scene3d.material.emissive = param || '#000000';
  dolLog(`💡 自发光颜色: ${scene3d.material.emissive}`, 'suc');
  return true;
}

function set3dTiling(param) {
  const v = parseFloat(param);
  if (isNaN(v) || v <= 0) {
    dolLog(`❌ 平铺系数必须 > 0`, 'err');
    return true;
  }
  scene3d.material.tiling = v;
  dolLog(`🔲 纹理平铺: ${v}x`, 'suc');
  return true;
}

function start3dAnimLoop() {
  if (scene3d.animInterval) clearInterval(scene3d.animInterval);
  scene3d.animInterval = setInterval(() => {
    if (scene3d.animation.paused) return;
    scene3d.animation.time += 0.016 * scene3d.animation.speed;
    const t = scene3d.animation.time;
    switch(scene3d.animation.type) {
      case 'rotate':
        scene3d.rotation.x += 1 * scene3d.animation.speed;
        scene3d.rotation.y += 1.5 * scene3d.animation.speed;
        break;
      case 'spin':
        scene3d.rotation.y += 3 * scene3d.animation.speed;
        break;
      case 'bounce':
        scene3d.position.y = Math.sin(t * 3) * 30;
        break;
      case 'pulse':
        scene3d.scale = 1 + Math.sin(t * 4) * 0.2;
        break;
      case 'wave':
        scene3d.rotation.z = Math.sin(t * 2) * 15;
        scene3d.position.x = Math.sin(t) * 20;
        break;
    }
    render3dModel();
  }, 16);
}

function animate3dRotate(param) {
  stop3dAnimation();
  scene3d.animation.active = true;
  scene3d.animation.type = 'rotate';
  scene3d.animation.time = 0;
  scene3d.animation.paused = false;
  start3dAnimLoop();
  dolLog(`🔄 动画: 自动旋转已启动`, 'suc');
  return true;
}

function animate3dBounce(param) {
  stop3dAnimation();
  scene3d.animation.active = true;
  scene3d.animation.type = 'bounce';
  scene3d.animation.time = 0;
  scene3d.animation.paused = false;
  start3dAnimLoop();
  dolLog(`⬆️⬇️ 动画: 弹跳已启动`, 'suc');
  return true;
}

function animate3dPulse(param) {
  stop3dAnimation();
  scene3d.animation.active = true;
  scene3d.animation.type = 'pulse';
  scene3d.animation.time = 0;
  scene3d.animation.paused = false;
  start3dAnimLoop();
  dolLog(`💓 动画: 脉冲已启动`, 'suc');
  return true;
}

function animate3dSpin(param) {
  stop3dAnimation();
  scene3d.animation.active = true;
  scene3d.animation.type = 'spin';
  scene3d.animation.time = 0;
  scene3d.animation.paused = false;
  start3dAnimLoop();
  dolLog(`🌀 动画: 自旋已启动`, 'suc');
  return true;
}

function animate3dWave(param) {
  stop3dAnimation();
  scene3d.animation.active = true;
  scene3d.animation.type = 'wave';
  scene3d.animation.time = 0;
  scene3d.animation.paused = false;
  start3dAnimLoop();
  dolLog(`🌊 动画: 波浪已启动`, 'suc');
  return true;
}

function set3dAnimSpeed(param) {
  const s = parseFloat(param);
  if (isNaN(s) || s <= 0 || s > 10) {
    dolLog(`❌ 动画速度范围: 0.1-10`, 'err');
    return true;
  }
  scene3d.animation.speed = s;
  dolLog(`⚡ 动画速度: ${s}x`, 'suc');
  return true;
}

function stop3dAnimation() {
  if (scene3d.animInterval) {
    clearInterval(scene3d.animInterval);
    scene3d.animInterval = null;
  }
  scene3d.animation.active = false;
  scene3d.animation.type = null;
  scene3d.position = { x: 0, y: 0, z: 0 };
  dolLog(`⏹️ 动画已停止`, 'info');
  return true;
}

function pause3dAnimation() {
  scene3d.animation.paused = !scene3d.animation.paused;
  dolLog(scene3d.animation.paused ? `⏸️ 动画已暂停` : `▶️ 动画已继续`, 'info');
  return true;
}

function set3dAmbientLight(param) {
  if (!param) {
    dolLog(`💡 环境光: 颜色=${scene3d.lighting.ambient.color} 强度=${scene3d.lighting.ambient.intensity}`, 'info');
    return true;
  }
  const parts = param.split('*');
  if (parts[0]) scene3d.lighting.ambient.color = parts[0];
  if (parts[1]) scene3d.lighting.ambient.intensity = parseFloat(parts[1]) || 0.5;
  dolLog(`💡 环境光已设置: ${scene3d.lighting.ambient.color} @ ${scene3d.lighting.ambient.intensity}`, 'suc');
  return true;
}

function set3dDirectionalLight(param) {
  if (!param) {
    dolLog(`☀️ 方向光: 颜色=${scene3d.lighting.directional.color} 强度=${scene3d.lighting.directional.intensity}`, 'info');
    return true;
  }
  const parts = param.split('*');
  if (parts[0]) scene3d.lighting.directional.color = parts[0];
  if (parts[1]) scene3d.lighting.directional.intensity = parseFloat(parts[1]) || 0.8;
  dolLog(`☀️ 方向光已设置: ${scene3d.lighting.directional.color} @ ${scene3d.lighting.directional.intensity}`, 'suc');
  return true;
}

function set3dPointLight(param) {
  if (!param) {
    dolLog(`💡 点光源: 颜色=${scene3d.lighting.point.color} 强度=${scene3d.lighting.point.intensity}`, 'info');
    return true;
  }
  const parts = param.split('*');
  if (parts[0]) scene3d.lighting.point.color = parts[0];
  if (parts[1]) scene3d.lighting.point.intensity = parseFloat(parts[1]) || 0;
  dolLog(`💡 点光源已设置: ${scene3d.lighting.point.color} @ ${scene3d.lighting.point.intensity}`, 'suc');
  return true;
}

function set3dSpotLight(param) {
  if (!param) {
    dolLog(`🔦 聚光灯: 颜色=${scene3d.lighting.spot.color} 强度=${scene3d.lighting.spot.intensity}`, 'info');
    return true;
  }
  const parts = param.split('*');
  if (parts[0]) scene3d.lighting.spot.color = parts[0];
  if (parts[1]) scene3d.lighting.spot.intensity = parseFloat(parts[1]) || 0;
  dolLog(`🔦 聚光灯已设置: ${scene3d.lighting.spot.color} @ ${scene3d.lighting.spot.intensity}`, 'suc');
  return true;
}

function set3dLightIntensity(param) {
  const v = parseFloat(param);
  if (isNaN(v) || v < 0 || v > 5) {
    dolLog(`❌ 光强度范围: 0-5`, 'err');
    return true;
  }
  scene3d.lighting.ambient.intensity = v * 0.5;
  scene3d.lighting.directional.intensity = v;
  dolLog(`💡 全局光强度: ${v}`, 'suc');
  return true;
}

function set3dLightColor(param) {
  if (!param) param = '#ffffff';
  scene3d.lighting.ambient.color = param;
  scene3d.lighting.directional.color = param;
  dolLog(`🎨 灯光颜色: ${param}`, 'suc');
  return true;
}

function toggle3dShadow(param) {
  scene3d.lighting.shadow = param ? (param === 'on' || param === '1' || param === 'true') : !scene3d.lighting.shadow;
  dolLog(`🌑 阴影: ${scene3d.lighting.shadow ? '开启' : '关闭'}`, 'info');
  return true;
}

function set3dBackground(param) {
  scene3d.background = param || '#0a0a0f';
  dolLog(`🎨 背景颜色: ${scene3d.background}`, 'suc');
  return true;
}

function render3dImage(param) {
  const fileName = param || `render_${Date.now()}.png`;
  if (scene3d.ctx) {
    const url = scene3d.ctx.canvas.toDataURL('image/png');
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    dolLog(`📷 渲染图已保存: ${fileName}`, 'suc');
  } else {
    dolLog(`❌ 请先打开3D窗口`, 'err');
  }
  return true;
}

function set3dRenderQuality(param) {
  const levels = ['low', 'medium', 'high', 'ultra'];
  if (!param || !levels.includes(param)) {
    dolLog(`📊 当前渲染质量: ${scene3d.render.quality}`, 'info');
    dolLog(`可选: low, medium, high, ultra`, 'info');
    return true;
  }
  scene3d.render.quality = param;
  const segMap = { low: 16, medium: 32, high: 64, ultra: 128 };
  scene3d.segments = segMap[param];
  dolLog(`📊 渲染质量: ${param} (分段: ${scene3d.segments})`, 'suc');
  render3dModel();
  return true;
}

function toggle3dAntialias(param) {
  scene3d.render.antialias = param ? (param === 'on' || param === '1' || param === 'true') : !scene3d.render.antialias;
  dolLog(`✨ 抗锯齿: ${scene3d.render.antialias ? '开启' : '关闭'}`, 'info');
  return true;
}

function export3dObj(param) {
  const fileName = param || `model_${Date.now()}.obj`;
  const objData = `# DonglaugOL 3D Export\n# Model: ${scene3d.model}\n# Size: ${scene3d.size}\n\nv 0 0 0\n`;
  const blob = new Blob([objData], {type: 'text/plain'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = fileName;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  dolLog(`📦 已导出OBJ: ${fileName}`, 'suc');
  return true;
}

function export3dStl(param) {
  const fileName = param || `model_${Date.now()}.stl`;
  const stlData = `solid DonglaugOL\nendsolid DonglaugOL\n`;
  const blob = new Blob([stlData], {type: 'text/plain'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = fileName;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  dolLog(`📦 已导出STL: ${fileName}`, 'suc');
  return true;
}

// ==================================================
// ========== 【3D/2D 开发者动画指令 draw.*】 ==========
// ==================================================
// draw.3d.init                          - 初始化3D渲染画布
// draw.3d.cubeid<id>bs<大小>c<颜色>     - 创建3D立方体
// draw.3d.sphereid<id>bs<半径>c<颜色>   - 创建3D球体
// draw.3d.torusid<id>bs<半径>c<颜色>    - 创建3D圆环
// draw.3d.pyramidid<id>bs<大小>c<颜色>  - 创建3D金字塔
// draw.3d.moveid<id>ip{x}*{y}sp<速度>   - 移动3D对象
// draw.3d.spinid<id>sp<速度>            - 持续旋转
// draw.3d.bounceid<id>bs<高度>sp<速度>  - 弹跳动画
// draw.3d.colorid<id>c<颜色>            - 设置3D颜色
// draw.3d.clickid<id>c<动作>            - 设置点击事件
// draw.3d.particleip{x}*{y}bs<数量>c<颜色> - 创建粒子
// draw.close                            - 关闭渲染画布
// draw.2d.init                          - 初始化2D渲染画布
// draw.2d.rectid<id>ip{x}*{y}bs<宽>*<高>c<颜色> - 创建矩形
// draw.2d.circleid<id>ip{x}*{y}bs<半径>c<颜色> - 创建圆形
// draw.2d.textid<id>ip{x}*{y}c<颜色>    - 创建文字
// draw.2d.moveid<id>ip{x}*{y}sp<速度>   - 移动2D对象
// draw.2d.clickid<id>c<动作>            - 设置点击事件

let drawSystem = {
  canvas: null,
  ctx: null,
  objects3d: [],
  objects2d: [],
  camera: { x: 0, y: 0, z: 500 },
  animating: false,
  animationFrame: null,
  is3dMode: true
};

let lmbLanguages = {};
let currentLmbLanguage = null;

function parseLmbCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/lmb/')) return false;
  const rest = cmd.substring(5);
  
  if (rest.startsWith('lang.name<')) {
    const name = rest.match(/lang\.name<([^>]*)>/)[1];
    currentLmbLanguage = name;
    lmbLanguages[name] = lmbLanguages[name] || { rules: [], name, win: null };
    
    if (lmbLanguages[name].win && document.body.contains(lmbLanguages[name].win)) {
      lmbLanguages[name].win.remove();
    }
    
    const win = createBaseWindow(`💬 ${name}`, 400, 500, 200, 100, false, true);
    const content = win.querySelector('.sys-win-content');
    content.style.padding = '0';
    content.style.background = '#0a0a0f';
    content.style.display = 'flex';
    content.style.flexDirection = 'column';
    
    const chatArea = document.createElement('div');
    chatArea.style.flex = '1';
    chatArea.style.padding = '10px';
    chatArea.style.overflowY = 'auto';
    chatArea.style.background = '#0d0d14';
    chatArea.id = `lmb-chat-${name}`;
    
    const inputArea = document.createElement('div');
    inputArea.style.display = 'flex';
    inputArea.style.gap = '5px';
    inputArea.style.padding = '10px';
    inputArea.style.background = '#1a1a24';
    
    const input = document.createElement('input');
    input.type = 'text';
    input.style.flex = '1';
    input.style.padding = '8px 12px';
    input.style.border = '1px solid #333';
    input.style.borderRadius = '4px';
    input.style.background = '#0d0d14';
    input.style.color = '#fff';
    input.style.outline = 'none';
    input.placeholder = `输入内容...`;
    
    const sendBtn = document.createElement('button');
    sendBtn.textContent = '发送';
    sendBtn.className = 'sys-calc-btn';
    sendBtn.style.padding = '8px 16px';
    
    inputArea.appendChild(input);
    inputArea.appendChild(sendBtn);
    content.appendChild(chatArea);
    content.appendChild(inputArea);
    
    win.addEventListener('click', (e) => {
      if (e.target === win) win.remove();
    });
    
    function lmbSend() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      
      chatArea.innerHTML += `<div style="margin-bottom:8px;"><span style="color:#5a9cf0;font-weight:bold;">用户:</span> <span style="color:#fff;">${text}</span></div>`;
      
      let reply = '未知输入';
      for (const rule of lmbLanguages[name].rules) {
        if (text.includes(rule.input) || rule.input.includes(text)) {
          reply = rule.output;
          break;
        }
      }
      
      setTimeout(() => {
        chatArea.innerHTML += `<div style="margin-bottom:8px;"><span style="color:#ff6b6b;font-weight:bold;">${name}:</span> <span style="color:#fff;">${reply}</span></div>`;
        chatArea.scrollTop = chatArea.scrollHeight;
      }, 500);
      
      chatArea.scrollTop = chatArea.scrollHeight;
      dolLog(`💬 [${name}] 用户: ${text} → PC: ${reply}`, 'info');
    }
    
    sendBtn.onclick = lmbSend;
    input.onkeypress = (e) => { if (e.key === 'Enter') lmbSend(); };
    
    lmbLanguages[name].win = win;
    dolLog(`✅ 创建语言并打开对话窗口: ${name}`, 'suc');
    return true;
  }
  
  if (rest.startsWith('input@user<')) {
    if (!currentLmbLanguage) {
      dolLog(`❌ 请先使用 /lmb/lang.name<名字> 创建语言`, 'err');
      return true;
    }
    const match = cmd.match(/input@user<([^>]*)>output@pc<([^>]*)>/);
    if (match) {
      const userInput = match[1];
      const pcOutput = match[2];
      lmbLanguages[currentLmbLanguage].rules.push({ input: userInput, output: pcOutput });
      dolLog(`✅ 添加规则: "${userInput}" → "${pcOutput}"`, 'suc');
    } else {
      dolLog(`❌ 格式错误！正确格式: /lmb/input@user<用户输入>output@pc<输出内容>`, 'err');
    }
    return true;
  }
  
  if (rest.startsWith('talk<')) {
    if (!currentLmbLanguage) {
      dolLog(`❌ 请先使用 /lmb/lang.name<名字> 创建语言`, 'err');
      return true;
    }
    const input = rest.match(/talk<([^>]*)>/)[1];
    const lang = lmbLanguages[currentLmbLanguage];
    let output = '未知输入';
    for (const rule of lang.rules) {
      if (input.includes(rule.input) || rule.input.includes(input)) {
        output = rule.output;
        break;
      }
    }
    dolLog(`💬 [${currentLmbLanguage}] 用户: ${input} → PC: ${output}`, 'info');
    return true;
  }
  
  if (rest === 'list') {
    const names = Object.keys(lmbLanguages);
    if (names.length === 0) {
      dolLog(`📭 暂无语言`, 'info');
    } else {
      dolLog(`📋 语言列表: ${names.join(', ')}`, 'info');
      names.forEach(name => {
        const rules = lmbLanguages[name].rules;
        dolLog(`  ${name} (${rules.length}条规则)`, 'info');
      });
    }
    return true;
  }
  
  if (rest === 'rules') {
    if (!currentLmbLanguage) {
      dolLog(`❌ 请先使用 /lmb/lang.name<名字> 切换语言`, 'err');
      return true;
    }
    const rules = lmbLanguages[currentLmbLanguage].rules;
    if (rules.length === 0) {
      dolLog(`📭 ${currentLmbLanguage} 暂无规则`, 'info');
    } else {
      dolLog(`📋 ${currentLmbLanguage} 规则列表:`, 'info');
      rules.forEach((rule, i) => {
        dolLog(`  ${i+1}. "${rule.input}" → "${rule.output}"`, 'info');
      });
    }
    return true;
  }
  
  if (rest.startsWith('delete<')) {
    const name = rest.match(/delete<([^>]*)>/)[1];
    if (lmbLanguages[name]) {
      delete lmbLanguages[name];
      if (currentLmbLanguage === name) currentLmbLanguage = null;
      dolLog(`✅ 删除语言: ${name}`, 'suc');
    } else {
      dolLog(`❌ 未找到语言: ${name}`, 'err');
    }
    return true;
  }
  
  if (rest === 'clear') {
    if (!currentLmbLanguage) {
      dolLog(`❌ 请先使用 /lmb/lang.name<名字> 切换语言`, 'err');
      return true;
    }
    lmbLanguages[currentLmbLanguage].rules = [];
    dolLog(`✅ 清空 ${currentLmbLanguage} 的所有规则`, 'suc');
    return true;
  }
  
  dolLog(`❌ 未知的 /lmb/ 指令: ${rest}`, 'err');
  return true;
}

function parseDrawCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('draw.')) return false;
  
  const parts = cmd.split('.');
  if (parts.length < 2) return false;
  
  if (parts[1] === 'close' || parts[1] === 'exit') {
    return closeDrawCanvas();
  }
  
  if (parts.length < 3) return false;
  
  const mode = parts[1];
  const action = parts[2];
  
  const bsMatch = cmd.match(/bs<(\d+)>(?:\*<(\d+)>)?/);
  const ipMatch = cmd.match(/ip\{(\-?\d+)\}\*\{(\-?\d+)\}(?:\*\{(\-?\d+)\})?/);
  const idMatch = cmd.match(/id<(\w+)>/);
  const colorMatch = cmd.match(/c<([^>]+)>/);
  const speedMatch = cmd.match(/sp<(\d+)>/);
  
  const params = [];
  if (idMatch) params.push(idMatch[1]);
  if (ipMatch) {
    params.push(ipMatch[1]);
    params.push(ipMatch[2]);
    params.push(ipMatch[3] || '0');
  }
  if (bsMatch) {
    params.push(bsMatch[1]);
    if (bsMatch[2]) params.push(bsMatch[2]);
  }
  if (colorMatch) params.push(colorMatch[1]);
  if (speedMatch) params.push(speedMatch[1]);
  
  const oldStyleMatch = cmd.match(/<([^>]*)>/);
  if (oldStyleMatch && !bsMatch && !ipMatch) {
    const oldParams = oldStyleMatch[1].split(',');
    oldParams.forEach(p => params.push(p.trim()));
  }
  
  if (mode === '3d') {
    return executeDraw3dAction(action, params);
  } else if (mode === '2d') {
    return executeDraw2dAction(action, params);
  }
  return false;
}

function executeDraw3dAction(action, params) {
  switch(action) {
    case 'init': return initDrawCanvas(true);
    case 'cube': return createDraw3dObject('cube', params);
    case 'sphere': return createDraw3dObject('sphere', params);
    case 'torus': return createDraw3dObject('torus', params);
    case 'cone': return createDraw3dObject('cone', params);
    case 'cylinder': return createDraw3dObject('cylinder', params);
    case 'pyramid': return createDraw3dObject('pyramid', params);
    case 'tetra': return createDraw3dObject('tetra', params);
    case 'octa': return createDraw3dObject('octa', params);
    case 'move': return animateDraw3dMove(params);
    case 'rotate': return animateDraw3dRotate(params);
    case 'spin': return animateDraw3dSpin(params);
    case 'bounce': return animateDraw3dBounce(params);
    case 'orbit': return animateDraw3dOrbit(params);
    case 'pulse': return animateDraw3dPulse(params);
    case 'fade': return animateDraw3dFade(params);
    case 'wave': return animateDraw3dWave(params);
    case 'text': return createDraw3dText(params);
    case 'ground': return createDraw3dGround(params);
    case 'scale': return setDraw3dScale(params);
    case 'color': return setDraw3dColor(params);
    case 'remove': return removeDraw3dObject(params);
    case 'clear': return clearDraw3dObjects();
    case 'camera': return setDrawCamera(params);
    case 'click': return setDraw3dClick(params);
    case 'particle': return createDraw3dParticle(params);
    case 'light': return setDraw3dLight(params);
    default: dolLog(`❌ 未知的 draw.3d 指令: ${action}`, 'err'); return true;
  }
}

function executeDraw2dAction(action, params) {
  switch(action) {
    case 'init': return initDrawCanvas(false);
    case 'rect': return createDraw2dObject('rect', params);
    case 'circle': return createDraw2dObject('circle', params);
    case 'line': return createDraw2dObject('line', params);
    case 'text': return createDraw2dObject('text', params);
    case 'move': return animateDraw2dMove(params);
    case 'rotate': return animateDraw2dRotate(params);
    case 'scale': return setDraw2dScale(params);
    case 'color': return setDraw2dColor(params);
    case 'remove': return removeDraw2dObject(params);
    case 'clear': return clearDraw2dObjects();
    case 'click': return setDraw2dClick(params);
    default: dolLog(`❌ 未知的 draw.2d 指令: ${action}`, 'err'); return true;
  }
}

function initDrawCanvas(is3d) {
  if (drawSystem.canvas && document.body.contains(drawSystem.canvas)) {
    drawSystem.canvas.remove();
  }
  
  drawSystem.is3dMode = is3d;
  
  const canvas = document.createElement('canvas');
  canvas.id = 'drawCanvas';
  canvas.style.position = 'fixed';
  canvas.style.top = '0';
  canvas.style.left = '0';
  canvas.style.width = '100%';
  canvas.style.height = '100%';
  canvas.style.zIndex = '9999';
  canvas.style.background = is3d ? '#0a0a0f' : '#1a1a24';
  canvas.style.cursor = 'pointer';
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  
  const ctx = canvas.getContext('2d');
  drawSystem.canvas = canvas;
  drawSystem.ctx = ctx;
  
  canvas.addEventListener('click', handleDrawClick);
  canvas.addEventListener('resize', () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  });
  
  document.body.appendChild(canvas);
  
  if (!drawSystem.animating) {
    drawSystem.animating = true;
    drawAnimationLoop();
  }
  
  dolLog(`✅ ${is3d ? '3D' : '2D'}渲染画布已初始化`, 'suc');
  return true;
}

function closeDrawCanvas() {
  if (drawSystem.canvas && document.body.contains(drawSystem.canvas)) {
    drawSystem.canvas.remove();
    drawSystem.canvas = null;
    drawSystem.ctx = null;
  }
  if (drawSystem.animationFrame) {
    cancelAnimationFrame(drawSystem.animationFrame);
    drawSystem.animationFrame = null;
  }
  drawSystem.animating = false;
  drawSystem.objects3d = [];
  drawSystem.objects2d = [];
  dolLog(`✅ 已关闭渲染画布`, 'suc');
  return true;
}

function createDraw3dObject(type, params) {
  const id = params[0] || 'obj_' + Date.now();
  const x = parseFloat(params[1]) || 0;
  const y = parseFloat(params[2]) || 0;
  const z = parseFloat(params[3]) || 0;
  
  let size = parseFloat(params[4]) || 100;
  let color = params[5] || '#5a9cf0';
  
  if (type === 'cone' || type === 'cylinder') {
    size = parseFloat(params[4]) || 50;
    const height = parseFloat(params[5]) || 100;
    color = params[6] || '#5a9cf0';
  }
  
  const obj = {
    id,
    type,
    x, y, z,
    size,
    color,
    rotation: { x: 0, y: 0, z: 0 },
    scale: 1,
    targetX: x, targetY: y, targetZ: z,
    targetRotation: { x: 0, y: 0, z: 0 },
    moveSpeed: 0,
    rotateSpeed: 0,
    clickAction: null,
    visible: true
  };
  
  if (type === 'cone' || type === 'cylinder') {
    obj.height = parseFloat(params[5]) || 100;
  }
  
  drawSystem.objects3d.push(obj);
  dolLog(`✅ 创建3D对象: ${id} (${type})`, 'suc');
  return true;
}

function animateDraw3dMove(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.targetX = parseFloat(params[1]) || obj.x;
  obj.targetY = parseFloat(params[2]) || obj.y;
  obj.targetZ = parseFloat(params[3]) || obj.z;
  obj.moveSpeed = parseFloat(params[4]) || 5;
  
  dolLog(`✅ 开始移动3D对象: ${id}`, 'suc');
  return true;
}

function animateDraw3dRotate(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.targetRotation.x = parseFloat(params[1]) || 0;
  obj.targetRotation.y = parseFloat(params[2]) || 0;
  obj.targetRotation.z = parseFloat(params[3]) || 0;
  obj.rotateSpeed = parseFloat(params[4]) || 2;
  
  dolLog(`✅ 开始旋转3D对象: ${id}`, 'suc');
  return true;
}

function setDraw3dScale(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.scale = parseFloat(params[1]) || 1;
  dolLog(`✅ 设置3D对象缩放: ${id} (${obj.scale}x)`, 'suc');
  return true;
}

function setDraw3dColor(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.color = params[1] || '#5a9cf0';
  dolLog(`✅ 设置3D对象颜色: ${id} (${obj.color})`, 'suc');
  return true;
}

function removeDraw3dObject(params) {
  const id = params[0];
  const idx = drawSystem.objects3d.findIndex(o => o.id === id);
  if (idx === -1) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  drawSystem.objects3d.splice(idx, 1);
  dolLog(`✅ 移除3D对象: ${id}`, 'suc');
  return true;
}

function clearDraw3dObjects() {
  drawSystem.objects3d = [];
  dolLog(`✅ 已清空所有3D对象`, 'info');
  return true;
}

function setDrawCamera(params) {
  drawSystem.camera.x = parseFloat(params[0]) || 0;
  drawSystem.camera.y = parseFloat(params[1]) || 0;
  drawSystem.camera.z = parseFloat(params[2]) || 500;
  dolLog(`✅ 相机位置已设置: (${drawSystem.camera.x}, ${drawSystem.camera.y}, ${drawSystem.camera.z})`, 'info');
  return true;
}

function setDraw3dClick(params) {
  const id = params[0];
  const action = params[1];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.clickAction = action;
  dolLog(`✅ 设置3D对象点击事件: ${id} -> ${action}`, 'suc');
  return true;
}

function animateDraw3dSpin(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.spinSpeed = parseFloat(params[1]) || 1;
  obj.spinAxis = params[2] || 'y';
  dolLog(`✅ 开始持续旋转: ${id} (速度: ${obj.spinSpeed}, 轴: ${obj.spinAxis})`, 'suc');
  return true;
}

function animateDraw3dBounce(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.bounceHeight = parseFloat(params[1]) || 100;
  obj.bounceSpeed = parseFloat(params[2]) || 2;
  obj.bounceBaseY = obj.y;
  obj.bouncePhase = 0;
  dolLog(`✅ 开始弹跳动画: ${id} (高度: ${obj.bounceHeight}, 速度: ${obj.bounceSpeed})`, 'suc');
  return true;
}

function animateDraw3dOrbit(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.orbitCenterX = parseFloat(params[1]) || 0;
  obj.orbitCenterY = parseFloat(params[2]) || 0;
  obj.orbitCenterZ = parseFloat(params[3]) || 0;
  obj.orbitRadius = parseFloat(params[4]) || 100;
  obj.orbitSpeed = parseFloat(params[5]) || 2;
  obj.orbitAngle = 0;
  obj.orbitAxis = params[6] || 'y';
  dolLog(`✅ 开始轨道运动: ${id} (半径: ${obj.orbitRadius}, 速度: ${obj.orbitSpeed})`, 'suc');
  return true;
}

function animateDraw3dPulse(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.pulseScale = parseFloat(params[1]) || 1.5;
  obj.pulseSpeed = parseFloat(params[2]) || 2;
  obj.pulsePhase = 0;
  obj.baseScale = obj.scale;
  dolLog(`✅ 开始脉冲动画: ${id} (缩放: ${obj.pulseScale}, 速度: ${obj.pulseSpeed})`, 'suc');
  return true;
}

function animateDraw3dFade(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.fadeOpacity = parseFloat(params[1]) || 0;
  obj.fadeSpeed = parseFloat(params[2]) || 2;
  obj.baseOpacity = 1;
  dolLog(`✅ 开始淡入淡出: ${id} (目标透明度: ${obj.fadeOpacity})`, 'suc');
  return true;
}

function animateDraw3dWave(params) {
  const id = params[0];
  const obj = drawSystem.objects3d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到3D对象: ${id}`, 'err');
    return true;
  }
  
  obj.waveHeight = parseFloat(params[1]) || 50;
  obj.waveSpeed = parseFloat(params[2]) || 2;
  obj.wavePhase = 0;
  obj.waveBaseY = obj.y;
  dolLog(`✅ 开始波浪动画: ${id} (高度: ${obj.waveHeight}, 速度: ${obj.waveSpeed})`, 'suc');
  return true;
}

function createDraw3dText(params) {
  const id = params[0] || 'txt_' + Date.now();
  const text = params[1] || 'Text';
  const x = parseFloat(params[2]) || 0;
  const y = parseFloat(params[3]) || 0;
  const z = parseFloat(params[4]) || 0;
  const color = params[5] || '#ffffff';
  const size = parseFloat(params[6]) || 30;
  
  const obj = {
    id,
    type: 'text3d',
    x, y, z,
    text,
    color,
    size,
    rotation: { x: 0, y: 0, z: 0 },
    scale: 1,
    targetX: x, targetY: y, targetZ: z,
    targetRotation: { x: 0, y: 0, z: 0 },
    moveSpeed: 0,
    rotateSpeed: 0,
    clickAction: null,
    visible: true
  };
  
  drawSystem.objects3d.push(obj);
  dolLog(`✅ 创建3D文字: ${id} (${text})`, 'suc');
  return true;
}

function createDraw3dGround(params) {
  const id = params[0] || 'ground_' + Date.now();
  const width = parseFloat(params[1]) || 500;
  const height = parseFloat(params[2]) || 500;
  const color = params[3] || '#333333';
  
  const obj = {
    id,
    type: 'ground',
    x: 0, y: -150, z: 0,
    width,
    height,
    color,
    rotation: { x: Math.PI/2, y: 0, z: 0 },
    scale: 1,
    visible: true
  };
  
  drawSystem.objects3d.push(obj);
  dolLog(`✅ 创建3D地面: ${id}`, 'suc');
  return true;
}

function createDraw3dParticle(params) {
  const x = parseFloat(params[0]) || 0;
  const y = parseFloat(params[1]) || 0;
  const z = parseFloat(params[2]) || 0;
  const count = parseInt(params[3]) || 50;
  const color = params[4] || '#ff6b6b';
  
  for (let i = 0; i < count; i++) {
    const angle = (i / count) * Math.PI * 2;
    const speed = Math.random() * 3 + 1;
    drawSystem.objects3d.push({
      id: 'particle_' + Date.now() + '_' + i,
      type: 'particle',
      x, y, z,
      vx: Math.cos(angle) * speed,
      vy: Math.random() * 5 - 2.5,
      vz: Math.sin(angle) * speed,
      color,
      size: Math.random() * 4 + 2,
      life: 100,
      maxLife: 100,
      visible: true
    });
  }
  
  dolLog(`✅ 创建粒子效果: ${count}个粒子`, 'suc');
  return true;
}

function setDraw3dLight(params) {
  drawSystem.light = {
    x: parseFloat(params[0]) || 0,
    y: parseFloat(params[1]) || 300,
    z: parseFloat(params[2]) || 500,
    intensity: parseFloat(params[3]) || 1
  };
  dolLog(`✅ 设置光照位置: (${drawSystem.light.x}, ${drawSystem.light.y}, ${drawSystem.light.z})`, 'suc');
  return true;
}

function createDraw2dObject(type, params) {
  const id = params[0] || 'obj_' + Date.now();
  
  let obj = {
    id,
    type,
    x: 0, y: 0,
    color: '#5a9cf0',
    rotation: 0,
    scale: 1,
    targetX: 0, targetY: 0,
    targetRotation: 0,
    moveSpeed: 0,
    rotateSpeed: 0,
    clickAction: null,
    visible: true
  };
  
  switch(type) {
    case 'rect':
      obj.x = parseFloat(params[1]) || 0;
      obj.y = parseFloat(params[2]) || 0;
      obj.width = parseFloat(params[3]) || 100;
      obj.height = parseFloat(params[4]) || 50;
      obj.color = params[5] || '#5a9cf0';
      obj.targetX = obj.x;
      obj.targetY = obj.y;
      break;
    case 'circle':
      obj.x = parseFloat(params[1]) || 0;
      obj.y = parseFloat(params[2]) || 0;
      obj.radius = parseFloat(params[3]) || 50;
      obj.color = params[4] || '#5a9cf0';
      obj.targetX = obj.x;
      obj.targetY = obj.y;
      break;
    case 'line':
      obj.x1 = parseFloat(params[1]) || 0;
      obj.y1 = parseFloat(params[2]) || 0;
      obj.x2 = parseFloat(params[3]) || 100;
      obj.y2 = parseFloat(params[4]) || 100;
      obj.x = (obj.x1 + obj.x2) / 2;
      obj.y = (obj.y1 + obj.y2) / 2;
      obj.color = params[5] || '#5a9cf0';
      obj.width = parseFloat(params[6]) || 2;
      obj.targetX = obj.x;
      obj.targetY = obj.y;
      break;
    case 'text':
      obj.x = parseFloat(params[1]) || 0;
      obj.y = parseFloat(params[2]) || 50;
      obj.text = params[3] || 'Hello';
      obj.color = params[4] || '#ffffff';
      obj.size = parseFloat(params[5]) || 24;
      obj.targetX = obj.x;
      obj.targetY = obj.y;
      break;
  }
  
  drawSystem.objects2d.push(obj);
  dolLog(`✅ 创建2D对象: ${id} (${type})`, 'suc');
  return true;
}

function animateDraw2dMove(params) {
  const id = params[0];
  const obj = drawSystem.objects2d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到2D对象: ${id}`, 'err');
    return true;
  }
  
  obj.targetX = parseFloat(params[1]) || obj.x;
  obj.targetY = parseFloat(params[2]) || obj.y;
  obj.moveSpeed = parseFloat(params[3]) || 5;
  
  dolLog(`✅ 开始移动2D对象: ${id}`, 'suc');
  return true;
}

function animateDraw2dRotate(params) {
  const id = params[0];
  const obj = drawSystem.objects2d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到2D对象: ${id}`, 'err');
    return true;
  }
  
  obj.targetRotation = parseFloat(params[1]) || 0;
  obj.rotateSpeed = parseFloat(params[2]) || 2;
  
  dolLog(`✅ 开始旋转2D对象: ${id}`, 'suc');
  return true;
}

function setDraw2dScale(params) {
  const id = params[0];
  const obj = drawSystem.objects2d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到2D对象: ${id}`, 'err');
    return true;
  }
  
  obj.scale = parseFloat(params[1]) || 1;
  dolLog(`✅ 设置2D对象缩放: ${id} (${obj.scale}x)`, 'suc');
  return true;
}

function setDraw2dColor(params) {
  const id = params[0];
  const obj = drawSystem.objects2d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到2D对象: ${id}`, 'err');
    return true;
  }
  
  obj.color = params[1] || '#5a9cf0';
  dolLog(`✅ 设置2D对象颜色: ${id} (${obj.color})`, 'suc');
  return true;
}

function removeDraw2dObject(params) {
  const id = params[0];
  const idx = drawSystem.objects2d.findIndex(o => o.id === id);
  if (idx === -1) {
    dolLog(`❌ 未找到2D对象: ${id}`, 'err');
    return true;
  }
  
  drawSystem.objects2d.splice(idx, 1);
  dolLog(`✅ 移除2D对象: ${id}`, 'suc');
  return true;
}

function clearDraw2dObjects() {
  drawSystem.objects2d = [];
  dolLog(`✅ 已清空所有2D对象`, 'info');
  return true;
}

function setDraw2dClick(params) {
  const id = params[0];
  const action = params[1];
  const obj = drawSystem.objects2d.find(o => o.id === id);
  if (!obj) {
    dolLog(`❌ 未找到2D对象: ${id}`, 'err');
    return true;
  }
  
  obj.clickAction = action;
  dolLog(`✅ 设置2D对象点击事件: ${id} -> ${action}`, 'suc');
  return true;
}

function handleDrawClick(e) {
  const rect = drawSystem.canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  
  if (drawSystem.is3dMode) {
    drawSystem.objects3d.forEach(obj => {
      if (obj.clickAction && is3dObjectClicked(obj, x, y)) {
        runLine(obj.clickAction);
      }
    });
  } else {
    drawSystem.objects2d.forEach(obj => {
      if (obj.clickAction && is2dObjectClicked(obj, x, y)) {
        runLine(obj.clickAction);
      }
    });
  }
}

function is3dObjectClicked(obj, screenX, screenY) {
  const width = drawSystem.canvas.width;
  const height = drawSystem.canvas.height;
  
  const rx = obj.rotation.x * Math.PI / 180;
  const ry = obj.rotation.y * Math.PI / 180;
  const rz = obj.rotation.z * Math.PI / 180;
  
  const cosx = Math.cos(rx), sinx = Math.sin(rx);
  const cosy = Math.cos(ry), siny = Math.sin(ry);
  const cosz = Math.cos(rz), sinz = Math.sin(rz);
  
  function project(pcx, pcy, pcz) {
    let x1 = pcx * cosz - pcy * sinz;
    let y1 = pcx * sinz + pcy * cosz;
    const y2 = y1 * cosx - pcz * sinx;
    const z1 = y1 * sinx + pcz * cosx;
    const x2 = x1 * cosy + z1 * siny;
    const z2 = -x1 * siny + z1 * cosy;
    const scale = drawSystem.camera.z / (drawSystem.camera.z + z2);
    return { x: width / 2 + x2 * scale + obj.x, y: height / 2 + y2 * scale + obj.y };
  }
  
  const hs = obj.size / 2 * obj.scale;
  const corners = [
    project(-hs, -hs, -hs),
    project(hs, -hs, -hs),
    project(hs, hs, -hs),
    project(-hs, hs, -hs),
    project(-hs, -hs, hs),
    project(hs, -hs, hs),
    project(hs, hs, hs),
    project(-hs, hs, hs)
  ];
  
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  corners.forEach(c => {
    minX = Math.min(minX, c.x);
    maxX = Math.max(maxX, c.x);
    minY = Math.min(minY, c.y);
    maxY = Math.max(maxY, c.y);
  });
  
  return screenX >= minX && screenX <= maxX &&
         screenY >= minY && screenY <= maxY;
}

function is2dObjectClicked(obj, screenX, screenY) {
  switch(obj.type) {
    case 'rect':
      return screenX >= obj.x && screenX <= obj.x + obj.width &&
             screenY >= obj.y && screenY <= obj.y + obj.height;
    case 'circle':
      const dx = screenX - obj.x;
      const dy = screenY - obj.y;
      return dx * dx + dy * dy <= obj.radius * obj.radius;
    case 'text':
      return screenX >= obj.x && screenX <= obj.x + obj.text.length * obj.size * 0.6 &&
             screenY >= obj.y - obj.size && screenY <= obj.y + obj.size * 0.2;
    default:
      return false;
  }
}

function drawAnimationLoop() {
  if (!drawSystem.canvas || !drawSystem.ctx) return;
  
  const ctx = drawSystem.ctx;
  const width = drawSystem.canvas.width;
  const height = drawSystem.canvas.height;
  
  ctx.clearRect(0, 0, width, height);
  
  if (drawSystem.is3dMode) {
    draw3dScene(ctx, width, height);
  } else {
    draw2dScene(ctx, width, height);
  }
  
  drawSystem.animationFrame = requestAnimationFrame(drawAnimationLoop);
}

function draw3dScene(ctx, width, height) {
  ctx.save();
  
  function project(x, y, z, rx, ry, rz, ox, oy) {
    const cosx = Math.cos(rx), sinx = Math.sin(rx);
    const cosy = Math.cos(ry), siny = Math.sin(ry);
    const cosz = Math.cos(rz), sinz = Math.sin(rz);
    
    let x1 = x * cosz - y * sinz;
    let y1 = x * sinz + y * cosz;
    
    const y2 = y1 * cosx - z * sinx;
    const z1 = y1 * sinx + z * cosx;
    const x2 = x1 * cosy + z1 * siny;
    const z2 = -x1 * siny + z1 * cosy;
    
    const scale = drawSystem.camera.z / (drawSystem.camera.z + z2);
    return { x: width / 2 + x2 * scale + ox, y: height / 2 + y2 * scale + oy, z: z2 };
  }
  
  function drawFace(ctx, points, color, scale, rx, ry, rz, ox, oy) {
    ctx.beginPath();
    const p0 = project(points[0][0] * scale, points[0][1] * scale, points[0][2] * scale, rx, ry, rz, ox, oy);
    ctx.moveTo(p0.x, p0.y);
    for (let i = 1; i < points.length; i++) {
      const p = project(points[i][0] * scale, points[i][1] * scale, points[i][2] * scale, rx, ry, rz, ox, oy);
      ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
    ctx.lineWidth = 1;
    ctx.stroke();
  }
  
  drawSystem.objects3d.forEach(obj => {
    if (!obj.visible) return;
    
    ctx.save();
    
    if (obj.opacity !== undefined && obj.opacity !== null) {
      ctx.globalAlpha = obj.opacity;
    }
    
    if (obj.moveSpeed > 0) {
      const dx = obj.targetX - obj.x;
      const dy = obj.targetY - obj.y;
      const dz = obj.targetZ - obj.z;
      const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
      if (dist > 1) {
        obj.x += (dx / dist) * obj.moveSpeed;
        obj.y += (dy / dist) * obj.moveSpeed;
        obj.z += (dz / dist) * obj.moveSpeed;
      } else {
        obj.x = obj.targetX;
        obj.y = obj.targetY;
        obj.z = obj.targetZ;
        obj.moveSpeed = 0;
      }
    }
    
    if (obj.rotateSpeed > 0) {
      const drx = obj.targetRotation.x - obj.rotation.x;
      const dry = obj.targetRotation.y - obj.rotation.y;
      const drz = obj.targetRotation.z - obj.rotation.z;
      obj.rotation.x += drx * 0.05 * obj.rotateSpeed;
      obj.rotation.y += dry * 0.05 * obj.rotateSpeed;
      obj.rotation.z += drz * 0.05 * obj.rotateSpeed;
      
      if (Math.abs(drx) < 1 && Math.abs(dry) < 1 && Math.abs(drz) < 1) {
        obj.rotation = { ...obj.targetRotation };
        obj.rotateSpeed = 0;
      }
    }
    
    if (obj.spinSpeed) {
      if (obj.spinAxis === 'x') obj.rotation.x += obj.spinSpeed;
      else if (obj.spinAxis === 'z') obj.rotation.z += obj.spinSpeed;
      else obj.rotation.y += obj.spinSpeed;
    }
    
    if (obj.bounceHeight) {
      obj.bouncePhase += 0.05 * obj.bounceSpeed;
      obj.y = obj.bounceBaseY + Math.sin(obj.bouncePhase) * obj.bounceHeight;
    }
    
    if (obj.orbitRadius) {
      obj.orbitAngle += 0.05 * obj.orbitSpeed;
      if (obj.orbitAxis === 'x') {
        obj.y = obj.orbitCenterY + Math.cos(obj.orbitAngle) * obj.orbitRadius;
        obj.z = obj.orbitCenterZ + Math.sin(obj.orbitAngle) * obj.orbitRadius;
      } else if (obj.orbitAxis === 'z') {
        obj.x = obj.orbitCenterX + Math.cos(obj.orbitAngle) * obj.orbitRadius;
        obj.y = obj.orbitCenterY + Math.sin(obj.orbitAngle) * obj.orbitRadius;
      } else {
        obj.x = obj.orbitCenterX + Math.cos(obj.orbitAngle) * obj.orbitRadius;
        obj.z = obj.orbitCenterZ + Math.sin(obj.orbitAngle) * obj.orbitRadius;
      }
    }
    
    if (obj.pulseScale) {
      obj.pulsePhase += 0.05 * obj.pulseSpeed;
      obj.scale = obj.baseScale + Math.sin(obj.pulsePhase) * (obj.pulseScale - obj.baseScale);
    }
    
    if (obj.fadeOpacity !== undefined) {
      obj.opacity = obj.opacity || 1;
      const dof = obj.fadeOpacity - obj.opacity;
      obj.opacity += dof * 0.05 * obj.fadeSpeed;
      if (Math.abs(dof) < 0.01) obj.opacity = obj.fadeOpacity;
    }
    
    if (obj.waveHeight) {
      obj.wavePhase += 0.05 * obj.waveSpeed;
      obj.y = obj.waveBaseY + Math.sin(obj.wavePhase) * obj.waveHeight;
    }
    
    const rx = obj.rotation.x * Math.PI / 180;
    const ry = obj.rotation.y * Math.PI / 180;
    const rz = obj.rotation.z * Math.PI / 180;
    const hs = obj.size / 2;
    
    switch(obj.type) {
      case 'cube':
        const faces = [
          [[-hs,-hs,-hs],[hs,-hs,-hs],[hs,hs,-hs],[-hs,hs,-hs]],
          [[-hs,-hs,hs],[hs,-hs,hs],[hs,hs,hs],[-hs,hs,hs]],
          [[-hs,-hs,-hs],[-hs,hs,-hs],[-hs,hs,hs],[-hs,-hs,hs]],
          [[hs,-hs,-hs],[hs,hs,-hs],[hs,hs,hs],[hs,-hs,hs]],
          [[-hs,-hs,-hs],[-hs,-hs,hs],[hs,-hs,hs],[hs,-hs,-hs]],
          [[-hs,hs,-hs],[-hs,hs,hs],[hs,hs,hs],[hs,hs,-hs]]
        ];
        faces.forEach(face => drawFace(ctx, face, obj.color, obj.scale, rx, ry, rz, obj.x, obj.y));
        break;
      case 'sphere':
        const r = obj.size / 2;
        for (let i = 0; i <= 8; i++) {
          const lat = (i / 8) * Math.PI;
          const nextLat = ((i + 1) / 8) * Math.PI;
          for (let j = 0; j <= 16; j++) {
            const lng = (j / 16) * Math.PI * 2;
            const nextLng = ((j + 1) / 16) * Math.PI * 2;
            
            ctx.beginPath();
            const p1 = project(r * Math.sin(lat) * Math.cos(lng) * obj.scale, r * Math.cos(lat) * obj.scale, r * Math.sin(lat) * Math.sin(lng) * obj.scale, rx, ry, rz, obj.x, obj.y);
            ctx.moveTo(p1.x, p1.y);
            const p2 = project(r * Math.sin(nextLat) * Math.cos(lng) * obj.scale, r * Math.cos(nextLat) * obj.scale, r * Math.sin(nextLat) * Math.sin(lng) * obj.scale, rx, ry, rz, obj.x, obj.y);
            ctx.lineTo(p2.x, p2.y);
            const p3 = project(r * Math.sin(nextLat) * Math.cos(nextLng) * obj.scale, r * Math.cos(nextLat) * obj.scale, r * Math.sin(nextLat) * Math.sin(nextLng) * obj.scale, rx, ry, rz, obj.x, obj.y);
            ctx.lineTo(p3.x, p3.y);
            const p4 = project(r * Math.sin(lat) * Math.cos(nextLng) * obj.scale, r * Math.cos(lat) * obj.scale, r * Math.sin(lat) * Math.sin(nextLng) * obj.scale, rx, ry, rz, obj.x, obj.y);
            ctx.lineTo(p4.x, p4.y);
            ctx.closePath();
            ctx.fillStyle = obj.color;
            ctx.fill();
          }
        }
        ctx.lineWidth = 1;
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        for (let i = 0; i <= 16; i++) {
          const lat = (i / 16) * Math.PI;
          ctx.beginPath();
          for (let j = 0; j <= 32; j++) {
            const lng = (j / 32) * Math.PI * 2;
            const px = r * Math.sin(lat) * Math.cos(lng);
            const py = r * Math.cos(lat);
            const pz = r * Math.sin(lat) * Math.sin(lng);
            const p = project(px * obj.scale, py * obj.scale, pz * obj.scale, rx, ry, rz, obj.x, obj.y);
            if (j === 0) ctx.moveTo(p.x, p.y);
            else ctx.lineTo(p.x, p.y);
          }
          ctx.stroke();
        }
        break;
      case 'torus':
        const tr = obj.size / 2;
        const ttr = tr * 0.3;
        for (let i = 0; i < 16; i++) {
          const phi = (i / 16) * Math.PI * 2;
          ctx.beginPath();
          for (let j = 0; j <= 32; j++) {
            const theta = (j / 32) * Math.PI * 2;
            const px = (tr + ttr * Math.cos(theta)) * Math.cos(phi);
            const py = (tr + ttr * Math.cos(theta)) * Math.sin(phi);
            const pz = ttr * Math.sin(theta);
            const p = project(px * obj.scale, py * obj.scale, pz * obj.scale, rx, ry, rz, obj.x, obj.y);
            if (j === 0) ctx.moveTo(p.x, p.y);
            else ctx.lineTo(p.x, p.y);
          }
          ctx.strokeStyle = obj.color;
          ctx.stroke();
        }
        break;
      case 'cone':
        const cr = obj.size;
        const ch = obj.height || 100;
        ctx.beginPath();
        for (let i = 0; i <= 32; i++) {
          const theta = (i / 32) * Math.PI * 2;
          const px = cr * Math.cos(theta);
          const pz = cr * Math.sin(theta);
          const p = project(px * obj.scale, -ch/2 * obj.scale, pz * obj.scale, rx, ry, rz, obj.x, obj.y);
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        }
        ctx.closePath();
        ctx.fillStyle = obj.color;
        ctx.fill();
        ctx.stroke();
        break;
      case 'cylinder':
        const cylr = obj.size;
        const cylh = obj.height || 100;
        for (let i = 0; i <= 32; i++) {
          const theta = (i / 32) * Math.PI * 2;
          const px = cylr * Math.cos(theta);
          const pz = cylr * Math.sin(theta);
          const p1 = project(px * obj.scale, -cylh/2 * obj.scale, pz * obj.scale, rx, ry, rz, obj.x, obj.y);
          const p2 = project(px * obj.scale, cylh/2 * obj.scale, pz * obj.scale, rx, ry, rz, obj.x, obj.y);
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = obj.color;
          ctx.stroke();
        }
        ctx.beginPath();
        for (let i = 0; i <= 32; i++) {
          const theta = (i / 32) * Math.PI * 2;
          const px = cylr * Math.cos(theta);
          const pz = cylr * Math.sin(theta);
          const p = project(px * obj.scale, -cylh/2 * obj.scale, pz * obj.scale, rx, ry, rz, obj.x, obj.y);
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        }
        ctx.closePath();
        ctx.fillStyle = obj.color;
        ctx.fill();
        ctx.stroke();
        break;
      case 'pyramid':
        const pyFaces = [
          [[0,hs,0],[-hs,-hs,-hs],[hs,-hs,-hs]],
          [[0,hs,0],[hs,-hs,-hs],[hs,-hs,hs]],
          [[0,hs,0],[hs,-hs,hs],[-hs,-hs,hs]],
          [[0,hs,0],[-hs,-hs,hs],[-hs,-hs,-hs]],
          [[-hs,-hs,-hs],[hs,-hs,-hs],[hs,-hs,hs],[-hs,-hs,hs]]
        ];
        pyFaces.forEach(face => drawFace(ctx, face, obj.color, obj.scale, rx, ry, rz, obj.x, obj.y));
        break;
      case 'tetra':
        const tFaces = [
          [[0,hs*1.2,0],[-hs,-hs/2,-hs],[hs,-hs/2,-hs]],
          [[0,hs*1.2,0],[hs,-hs/2,-hs],[0,-hs/2,hs]],
          [[0,hs*1.2,0],[0,-hs/2,hs],[-hs,-hs/2,-hs]],
          [[-hs,-hs/2,-hs],[hs,-hs/2,-hs],[0,-hs/2,hs]]
        ];
        tFaces.forEach(face => drawFace(ctx, face, obj.color, obj.scale, rx, ry, rz, obj.x, obj.y));
        break;
      case 'octa':
        const oFaces = [
          [[0,hs,0],[hs,0,0],[0,0,hs]],
          [[0,hs,0],[0,0,hs],[-hs,0,0]],
          [[0,hs,0],[-hs,0,0],[0,0,-hs]],
          [[0,hs,0],[0,0,-hs],[hs,0,0]],
          [[0,-hs,0],[hs,0,0],[0,0,-hs]],
          [[0,-hs,0],[0,0,-hs],[-hs,0,0]],
          [[0,-hs,0],[-hs,0,0],[0,0,hs]],
          [[0,-hs,0],[0,0,hs],[hs,0,0]]
        ];
        oFaces.forEach(face => drawFace(ctx, face, obj.color, obj.scale, rx, ry, rz, obj.x, obj.y));
        break;
      case 'particle':
        obj.x += obj.vx;
        obj.y += obj.vy;
        obj.z += obj.vz;
        obj.vy -= 0.1;
        obj.life--;
        if (obj.life <= 0) {
          obj.visible = false;
          return;
        }
        const pp = project(0, 0, obj.z, rx, ry, rz, obj.x, obj.y);
        ctx.beginPath();
        ctx.arc(pp.x, pp.y, obj.size * (obj.life / obj.maxLife), 0, Math.PI * 2);
        ctx.fillStyle = obj.color;
        ctx.globalAlpha = obj.life / obj.maxLife;
        ctx.fill();
        ctx.globalAlpha = 1;
        break;
      case 'text3d':
        const tp = project(0, 0, obj.z, rx, ry, rz, obj.x, obj.y);
        ctx.font = obj.size * obj.scale + 'px monospace';
        ctx.fillStyle = obj.color;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.globalAlpha = obj.opacity !== undefined ? obj.opacity : 1;
        ctx.fillText(obj.text, tp.x, tp.y);
        ctx.globalAlpha = 1;
        break;
      case 'ground':
        const gw = obj.width / 2;
        const gh = obj.height / 2;
        const groundFaces = [
          [[-gw,0,-gh],[gw,0,-gh],[gw,0,gh],[-gw,0,gh]]
        ];
        groundFaces.forEach(face => drawFace(ctx, face, obj.color, obj.scale, rx, ry, rz, obj.x, obj.y));
        break;
    }
    
    ctx.restore();
  });
  
  ctx.restore();
}

function draw2dScene(ctx, width, height) {
  drawSystem.objects2d.forEach(obj => {
    if (!obj.visible) return;
    
    ctx.save();
    
    if (obj.moveSpeed > 0) {
      const dx = obj.targetX - obj.x;
      const dy = obj.targetY - obj.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist > 1) {
        obj.x += (dx / dist) * obj.moveSpeed;
        obj.y += (dy / dist) * obj.moveSpeed;
      } else {
        obj.x = obj.targetX;
        obj.y = obj.targetY;
        obj.moveSpeed = 0;
      }
    }
    
    if (obj.rotateSpeed > 0) {
      const dr = obj.targetRotation - obj.rotation;
      obj.rotation += dr * 0.05 * obj.rotateSpeed;
      if (Math.abs(dr) < 1) {
        obj.rotation = obj.targetRotation;
        obj.rotateSpeed = 0;
      }
    }
    
    ctx.translate(obj.x, obj.y);
    ctx.rotate(obj.rotation * Math.PI / 180);
    ctx.scale(obj.scale, obj.scale);
    
    switch(obj.type) {
      case 'rect':
        ctx.fillStyle = obj.color;
        ctx.fillRect(0, 0, obj.width, obj.height);
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.strokeRect(0, 0, obj.width, obj.height);
        break;
      case 'circle':
        ctx.beginPath();
        ctx.arc(0, 0, obj.radius, 0, Math.PI * 2);
        ctx.fillStyle = obj.color;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.stroke();
        break;
      case 'line':
        ctx.beginPath();
        ctx.moveTo(obj.x1 - obj.x, obj.y1 - obj.y);
        ctx.lineTo(obj.x2 - obj.x, obj.y2 - obj.y);
        ctx.strokeStyle = obj.color;
        ctx.lineWidth = obj.width;
        ctx.stroke();
        break;
      case 'text':
        ctx.fillStyle = obj.color;
        ctx.font = `${obj.size}px Arial`;
        ctx.fillText(obj.text, 0, 0);
        break;
    }
    
    ctx.restore();
  });
}

// ==================================================
// ========== 【2D制作指令 /2d/】 ==========
// ==================================================
// /2d/open<宽>*<高>                     - 打开2D画板（带工具栏）
// /2d/pen<颜色>                         - 设置画笔颜色
// /2d/size<大小>                        - 设置画笔粗细
// /2d/clear                             - 清空画布
// /2d/save                              - 保存作品为PNG
// /2d/rect<颜色>                        - 矩形工具
// /2d/circle<颜色>                      - 圆形工具
// /2d/line<颜色>                        - 直线工具
// /2d/eraser                            - 橡皮擦工具
// /2d/fill<颜色>                        - 填充工具

let canvas2d = {
  win: null,
  ctx: null,
  canvas: null,
  tempCanvas: null,
  tempCtx: null,
  isDrawing: false,
  tool: 'pen',
  color: '#5a9cf0',
  size: 3,
  lastX: 0,
  lastY: 0
};

function parse2dCmd(line) {
  const cmd = line.trim();
  if (!cmd.startsWith('/2d/')) return false;
  const rest = cmd.substring(4);
  let action = rest, param = null;
  const sp = rest.indexOf('<');
  if (sp !== -1) {
    param = rest.substring(sp+1, rest.length - (rest.endsWith('>') ? 1 : 0));
    action = rest.substring(0, sp);
  }
  return execute2dAction(action, param);
}

function execute2dAction(action, param) {
  switch(action) {
    case 'open': return open2dCanvas(param);
    case 'pen': return set2dPen(param);
    case 'size': return set2dSize(param);
    case 'clear': return clear2dCanvas();
    case 'save': return save2dCanvas();
    case 'rect': return set2dTool('rect', param);
    case 'circle': return set2dTool('circle', param);
    case 'line': return set2dTool('line', param);
    case 'eraser': return set2dTool('eraser');
    case 'fill': return set2dTool('fill', param);
    case 'embed': return embed2dCanvas(param);
    default: dolLog(`❌ 未知的 2d 指令: ${action}`, 'err'); return true;
  }
}

function open2dCanvas(param) {
  if (canvas2d.win && document.body.contains(canvas2d.win)) {
    canvas2d.win.remove();
  }
  const parts = (param || '600*400').split('*');
  const width = parseInt(parts[0]) || 600;
  const height = parseInt(parts[1]) || 400;
  
  canvas2d.win = createBaseWindow('🎨 2D画板', width + 200, height + 60, 250, 120, false, true);
  const content = canvas2d.win.querySelector('.sys-win-content');
  content.style.padding = '10px';
  content.style.background = '#1a1a24';
  content.style.display = 'flex';
  content.style.gap = '10px';
  content.innerHTML = `
    <div style="flex:1;display:flex;flex-direction:column;gap:10px;">
      <canvas id="canvas2d" style="width:100%;height:${height}px;background:#fff;border-radius:6px;box-shadow:0 0 20px rgba(0,0,0,0.3);cursor:crosshair;"></canvas>
      <div style="display:flex;gap:8px;justify-content:center;">
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('pen')">✏️ 画笔</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('rect')">▭ 矩形</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('circle')">⭕ 圆形</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('line')">📏 直线</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('eraser')">🧹 橡皮</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="clear2dCanvas()">🗑️ 清空</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="save2dCanvas()">💾 保存</button>
      </div>
    </div>
    <div style="width:160px;background:#252530;border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:10px;">
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;">🎨 颜色</div>
      <input type="color" id="canvas2dColor" value="${canvas2d.color}" oninput="set2dPen(this.value)" style="width:100%;height:40px;border:none;border-radius:4px;cursor:pointer;">
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">📏 粗细</div>
      <input type="range" id="canvas2dSize" min="1" max="50" value="${canvas2d.size}" oninput="set2dSize(this.value)" style="width:100%;">
      <div style="color:#888;font-size:12px;text-align:center;">${canvas2d.size}px</div>
      <div style="font-weight:bold;color:#5a9cf0;font-size:13px;border-bottom:1px solid #333;padding-bottom:8px;margin-top:5px;">🔧 当前工具</div>
      <div id="canvas2dTool" style="text-align:center;color:#fff;font-size:14px;font-weight:bold;">✏️ 画笔</div>
      <div style="font-size:11px;color:#666;text-align:center;margin-top:auto;padding-top:10px;border-top:1px solid #333;">
        提示: 拖动鼠标绘制
      </div>
    </div>
  `;
  
  setTimeout(() => {
    const canvas = document.getElementById('canvas2d');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = height;
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = canvas.width;
      tempCanvas.height = canvas.height;
      tempCanvas.style.position = 'absolute';
      tempCanvas.style.top = '0';
      tempCanvas.style.left = '0';
      tempCanvas.style.pointerEvents = 'none';
      tempCanvas.style.borderRadius = '6px';
      tempCanvas.style.width = canvas.offsetWidth + 'px';
      tempCanvas.style.height = canvas.offsetHeight + 'px';
      canvas.parentElement.style.position = 'relative';
      canvas.parentElement.appendChild(tempCanvas);
      
      canvas2d.canvas = canvas;
      canvas2d.ctx = ctx;
      canvas2d.tempCanvas = tempCanvas;
      canvas2d.tempCtx = tempCanvas.getContext('2d');
      
      canvas.addEventListener('mousedown', start2dDraw);
      canvas.addEventListener('mousemove', draw2d);
      canvas.addEventListener('mouseup', end2dDraw);
      canvas.addEventListener('mouseout', end2dDraw);
    }
  }, 100);
  
  dolLog(`✅ 2D画板已打开 (${width}×${height})`, 'suc');
  return true;
}

function start2dDraw(e) {
  if (!canvas2d.ctx) return;
  canvas2d.isDrawing = true;
  const rect = canvas2d.canvas.getBoundingClientRect();
  canvas2d.lastX = e.clientX - rect.left;
  canvas2d.lastY = e.clientY - rect.top;
  
  if (canvas2d.tool === 'fill') {
    const ctx = canvas2d.ctx;
    const x = canvas2d.lastX;
    const y = canvas2d.lastY;
    const imageData = ctx.getImageData(0, 0, canvas2d.canvas.width, canvas2d.canvas.height);
    const data = imageData.data;
    const targetColor = getPixelColor(data, x, y, canvas2d.canvas.width);
    const fillColor = hexToRgb(canvas2d.color);
    
    if (colorsEqual(targetColor, fillColor)) return;
    
    floodFill(data, x, y, canvas2d.canvas.width, canvas2d.canvas.height, targetColor, fillColor);
    ctx.putImageData(imageData, 0, 0);
    canvas2d.isDrawing = false;
  }
}

function draw2d(e) {
  if (!canvas2d.isDrawing || !canvas2d.ctx) return;
  
  const rect = canvas2d.canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  const ctx = canvas2d.ctx;
  const tempCtx = canvas2d.tempCtx;
  
  ctx.strokeStyle = canvas2d.tool === 'eraser' ? '#fff' : canvas2d.color;
  ctx.fillStyle = canvas2d.tool === 'eraser' ? '#fff' : canvas2d.color;
  ctx.lineWidth = canvas2d.size;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  
  switch(canvas2d.tool) {
    case 'pen':
      ctx.beginPath();
      ctx.moveTo(canvas2d.lastX, canvas2d.lastY);
      ctx.lineTo(x, y);
      ctx.stroke();
      break;
    case 'rect':
      if (tempCtx) {
        tempCtx.clearRect(0, 0, canvas2d.tempCanvas.width, canvas2d.tempCanvas.height);
        tempCtx.strokeStyle = canvas2d.color;
        tempCtx.lineWidth = canvas2d.size;
        tempCtx.strokeRect(canvas2d.lastX, canvas2d.lastY, x - canvas2d.lastX, y - canvas2d.lastY);
      }
      break;
    case 'circle':
      if (tempCtx) {
        tempCtx.clearRect(0, 0, canvas2d.tempCanvas.width, canvas2d.tempCanvas.height);
        tempCtx.strokeStyle = canvas2d.color;
        tempCtx.lineWidth = canvas2d.size;
        const radius = Math.sqrt(Math.pow(x - canvas2d.lastX, 2) + Math.pow(y - canvas2d.lastY, 2));
        tempCtx.beginPath();
        tempCtx.arc(canvas2d.lastX, canvas2d.lastY, radius, 0, Math.PI * 2);
        tempCtx.stroke();
      }
      break;
    case 'line':
      if (tempCtx) {
        tempCtx.clearRect(0, 0, canvas2d.tempCanvas.width, canvas2d.tempCanvas.height);
        tempCtx.strokeStyle = canvas2d.color;
        tempCtx.lineWidth = canvas2d.size;
        tempCtx.beginPath();
        tempCtx.moveTo(canvas2d.lastX, canvas2d.lastY);
        tempCtx.lineTo(x, y);
        tempCtx.stroke();
      }
      break;
    case 'eraser':
      ctx.beginPath();
      ctx.moveTo(canvas2d.lastX, canvas2d.lastY);
      ctx.lineTo(x, y);
      ctx.stroke();
      break;
  }
  
  canvas2d.lastX = x;
  canvas2d.lastY = y;
}

function end2dDraw() {
  if (canvas2d.tempCtx && canvas2d.tempCanvas && canvas2d.canvas) {
    canvas2d.ctx.drawImage(canvas2d.tempCanvas, 0, 0);
    canvas2d.tempCtx.clearRect(0, 0, canvas2d.tempCanvas.width, canvas2d.tempCanvas.height);
  }
  canvas2d.isDrawing = false;
}

function set2dPen(param) {
  if (!param) {
    dolLog(`✏️ 当前画笔颜色: ${canvas2d.color}`, 'info');
    return true;
  }
  canvas2d.color = param;
  canvas2d.tool = 'pen';
  update2dToolInfo();
  if (canvas2d.win) {
    const colorInput = canvas2d.win.querySelector('#canvas2dColor');
    if (colorInput) colorInput.value = param;
  }
  dolLog(`✏️ 画笔颜色已设置为: ${param}`, 'suc');
  return true;
}

function set2dSize(param) {
  if (!param) {
    dolLog(`📏 当前画笔粗细: ${canvas2d.size}px`, 'info');
    return true;
  }
  const size = parseInt(param);
  if (isNaN(size) || size < 1 || size > 50) {
    dolLog(`❌ 粗细范围 1-50`, 'err');
    return true;
  }
  canvas2d.size = size;
  if (canvas2d.win) {
    const sizeInput = canvas2d.win.querySelector('#canvas2dSize');
    if (sizeInput) sizeInput.value = size;
    const sizeLabel = canvas2d.win.querySelector('#canvas2dSize').nextElementSibling;
    if (sizeLabel) sizeLabel.textContent = size + 'px';
  }
  dolLog(`📏 画笔粗细已设置为: ${size}px`, 'suc');
  return true;
}

function set2dTool(tool, param) {
  canvas2d.tool = tool;
  if (param) canvas2d.color = param;
  update2dToolInfo();
  if (canvas2d.win) {
    const colorInput = canvas2d.win.querySelector('#canvas2dColor');
    if (colorInput && param) colorInput.value = param;
  }
  const toolNames = { pen: '✏️ 画笔', rect: '▭ 矩形', circle: '⭕ 圆形', line: '📏 直线', eraser: '🧹 橡皮', fill: '🖍️ 填充' };
  dolLog(`🔧 工具已切换为: ${toolNames[tool]}`, 'suc');
  return true;
}

function update2dToolInfo() {
  if (!canvas2d.win) return;
  const toolNames = { pen: '✏️ 画笔', rect: '▭ 矩形', circle: '⭕ 圆形', line: '📏 直线', eraser: '🧹 橡皮', fill: '🖍️ 填充' };
  const toolEl = canvas2d.win.querySelector('#canvas2dTool');
  if (toolEl) toolEl.textContent = toolNames[canvas2d.tool];
}

function clear2dCanvas() {
  if (!canvas2d.ctx) {
    dolLog(`❌ 请先打开画板: /2d/open`, 'err');
    return true;
  }
  canvas2d.ctx.fillStyle = '#fff';
  canvas2d.ctx.fillRect(0, 0, canvas2d.canvas.width, canvas2d.canvas.height);
  dolLog(`🗑️ 画布已清空`, 'info');
  return true;
}

function save2dCanvas() {
  if (!canvas2d.canvas) {
    dolLog(`❌ 请先打开画板: /2d/open`, 'err');
    return true;
  }
  const dataUrl = canvas2d.canvas.toDataURL('image/png');
  const a = document.createElement('a');
  a.href = dataUrl;
  a.download = `drawing_${Date.now()}.png`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  dolLog(`💾 作品已保存`, 'suc');
  return true;
}

function embed2dCanvas(param) {
  const parts = (param || '600*400').split('*');
  const width = parseInt(parts[0]) || 600;
  const height = parseInt(parts[1]) || 400;
  
  const html = `
    <div style="margin:8px 0;padding:12px;background:#1a1a24;border-radius:8px;border:1px solid #333;">
      <div style="color:#5a9cf0;font-size:14px;margin-bottom:8px;">🎨 2D画板</div>
      <canvas id="embed2dCanvas" style="width:100%;height:${height}px;background:#fff;border-radius:6px;box-shadow:0 0 20px rgba(0,0,0,0.3);cursor:crosshair;" data-height="${height}"></canvas>
      <div style="display:flex;gap:8px;justify-content:center;margin-top:10px;">
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('pen')">✏️ 画笔</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('rect')">▭ 矩形</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('circle')">⭕ 圆形</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('line')">📏 直线</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="set2dTool('eraser')">🧹 橡皮</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="clear2dCanvas()">🗑️ 清空</button>
        <button class="sys-calc-btn" style="font-size:12px;padding:6px 12px;" onclick="save2dCanvas()">💾 保存</button>
      </div>
      <div style="display:flex;gap:10px;justify-content:center;margin-top:8px;">
        <input type="color" value="${canvas2d.color}" oninput="set2dPen(this.value)" style="width:40px;height:25px;border:none;border-radius:4px;cursor:pointer;">
        <input type="range" min="1" max="50" value="${canvas2d.size}" oninput="set2dSize(this.value)" style="width:150px;">
      </div>
    </div>
  `;
  showInlineUI(html);
  
  setTimeout(() => {
    const canvas = document.getElementById('embed2dCanvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = parseInt(canvas.getAttribute('data-height')) || rect.height;
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = canvas.width;
      tempCanvas.height = canvas.height;
      tempCanvas.style.position = 'absolute';
      tempCanvas.style.top = '0';
      tempCanvas.style.left = '0';
      tempCanvas.style.pointerEvents = 'none';
      tempCanvas.style.borderRadius = '6px';
      tempCanvas.style.width = canvas.offsetWidth + 'px';
      tempCanvas.style.height = canvas.offsetHeight + 'px';
      canvas.parentElement.style.position = 'relative';
      canvas.parentElement.appendChild(tempCanvas);
      
      canvas2d.canvas = canvas;
      canvas2d.ctx = ctx;
      canvas2d.tempCanvas = tempCanvas;
      canvas2d.tempCtx = tempCanvas.getContext('2d');
      
      canvas.addEventListener('mousedown', start2dDraw);
      canvas.addEventListener('mousemove', draw2d);
      canvas.addEventListener('mouseup', end2dDraw);
      canvas.addEventListener('mouseout', end2dDraw);
    }
  }, 100);
  
  dolLog(`✅ 2D画板已嵌入页面 (${width}×${height})`, 'suc');
  return true;
}

function getPixelColor(data, x, y, width) {
  const idx = (y * width + x) * 4;
  return { r: data[idx], g: data[idx+1], b: data[idx+2], a: data[idx+3] };
}

function hexToRgb(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? {
    r: parseInt(result[1], 16),
    g: parseInt(result[2], 16),
    b: parseInt(result[3], 16),
    a: 255
  } : { r: 0, g: 0, b: 0, a: 255 };
}

function colorsEqual(c1, c2) {
  return c1.r === c2.r && c1.g === c2.g && c1.b === c2.b && c1.a === c2.a;
}

function floodFill(data, x, y, width, height, targetColor, fillColor) {
  const stack = [[x, y]];
  while (stack.length > 0) {
    const [cx, cy] = stack.pop();
    if (cx < 0 || cx >= width || cy < 0 || cy >= height) continue;
    
    const idx = (cy * width + cx) * 4;
    const currentColor = { r: data[idx], g: data[idx+1], b: data[idx+2], a: data[idx+3] };
    
    if (!colorsEqual(currentColor, targetColor)) continue;
    
    data[idx] = fillColor.r;
    data[idx+1] = fillColor.g;
    data[idx+2] = fillColor.b;
    data[idx+3] = fillColor.a;
    
    stack.push([cx + 1, cy]);
    stack.push([cx - 1, cy]);
    stack.push([cx, cy + 1]);
    stack.push([cx, cy - 1]);
  }
}

// ==================================================
// ========== 【控制电脑指令 /lc/ (需先宣誓)】 ==========
// ==================================================
// /lc/close_pc<延迟几秒>              关闭当前窗口
// /lc/delete.file<文件名>             删除存储中的数据
// /lc/find.file<文件名>               搜索页面元素和存储
// /lc/open<文件名/URL>                打开链接或下载文件
// /lc/sys.EE.look-check[1/2].<选项>@p/@a 查看设备信息
// /lc/bye.wts<窗口名>@p/@a            强制关闭窗口
// /lc/cl@dol@h.m<延迟几秒>            关闭本窗口
// /lc/146255#DE@E                    系统调试模式
// /lc/clear.cache                     清除浏览器缓存
// /lc/export.data<文件名>             导出存储数据到文件
// /lc/sys.summary                    系统信息摘要

function parseControlCmd(cmd) {
  // 移除宣誓检查限制
  // oathTaken 检查已移除，现在可以直接使用 /lc/ 指令
  
  const line = cmd.trim();
  
  // 1. 关机（浏览器限制提示）
  const shutdownMatch = line.match(/^\/lc\/close_pc<(\d+)>$/);
  if (shutdownMatch) {
    dolLog(`⚠️ 浏览器安全限制：无法直接关闭电脑`, 'err');
    dolLog(`💡 JavaScript运行在浏览器沙箱中，没有系统关机权限`, 'info');
    dolLog(`📌 请使用原生应用或系统命令执行关机操作`, 'info');
    dolLog(`🔧 建议使用: DonglaugOL# 指令（需要扩展支持）`, 'info');
    return true;
  }
  
  // 2. 删除文件（清理浏览器存储）
  const deleteMatch = line.match(/^\/lc\/delete\.file<([^>]+)>$/);
  if (deleteMatch) {
    const fileName = deleteMatch[1];
    dolLog(`⚠️ 正在删除文件: ${fileName}`, 'warn');
    
    // 清理 localStorage/sessionStorage
    if (localStorage.getItem(fileName)) {
      localStorage.removeItem(fileName);
      dolLog(`✅ 已从存储中删除: ${fileName}`, 'suc');
    } else {
      // 尝试删除 cookies
      document.cookie = `${fileName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
      dolLog(`✅ 已尝试清理相关数据: ${fileName}`, 'suc');
    }
    return true;
  }
  
  // 3. 查找文件（搜索页面元素）
  const findMatch = line.match(/^\/lc\/find\.file<([^>]+)>$/);
  if (findMatch) {
    const fileName = findMatch[1];
    dolLog(`🔍 正在查找: ${fileName}`, 'info');
    
    // 搜索页面中的元素
    const foundElements = document.querySelectorAll(`*[data-file="${fileName}"], *[id*="${fileName}"], *[class*="${fileName}"]`);
    if (foundElements.length > 0) {
      dolLog(`✅ 找到 ${foundElements.length} 个匹配项:`, 'suc');
      foundElements.forEach((el, i) => {
        dolLog(`   ${i + 1}. ${el.tagName}#${el.id || '(no id)'}.${el.className || '(no class)'}`);
      });
    } else {
      // 搜索 localStorage
      const keys = Object.keys(localStorage).filter(k => k.includes(fileName));
      if (keys.length > 0) {
        dolLog(`✅ 在存储中找到 ${keys.length} 个匹配:`, 'suc');
        keys.forEach(k => dolLog(`   • ${k}`));
      } else {
        dolLog(`❌ 未找到: ${fileName}`, 'err');
      }
    }
    return true;
  }
  
  // 4. 打开文件（打开链接或下载）
  const openMatch = line.match(/^\/lc\/open<([^>]+)>$/);
  if (openMatch) {
    const fileName = openMatch[1];
    
    // 检查是否是URL
    if (fileName.startsWith('http://') || fileName.startsWith('https://')) {
      window.open(fileName, '_blank');
      dolLog(`✅ 已打开链接: ${fileName}`, 'suc');
    } else {
      // 尝试下载模拟文件
      const blob = new Blob(['这是文件内容: ' + fileName], {type: 'text/plain'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      dolLog(`✅ 已下载文件: ${fileName}`, 'suc');
    }
    return true;
  }
  
  // 5. 查看电子设备信息
  const sysInfoMatch = line.match(/^\/lc\/sys\.EE\.look-check\[(\d+)\]\.([^@]+)@([pa])$/);
  if (sysInfoMatch) {
    const depth = parseInt(sysInfoMatch[1]);
    const option = sysInfoMatch[2];
    const mode = sysInfoMatch[3];
    dolLog(`🔧 正在查看电子设备信息 [深度${depth}]...`, 'info');
    
    setTimeout(() => {
      if (depth === 1) {
        // 基本信息
        dolLog(`📱 设备信息（基本）:`, 'out');
        dolLog(`   • 用户代理: ${navigator.userAgent.substring(0, 50)}...`, 'out');
        dolLog(`   • 浏览器: ${navigator.appName}`, 'out');
        dolLog(`   • 平台: ${navigator.platform}`, 'out');
        dolLog(`   • 语言: ${navigator.language}`, 'out');
      } else {
        // 深度信息
        dolLog(`🔬 设备信息（深度）:`, 'out');
        dolLog(`   • 用户代理: ${navigator.userAgent}`, 'out');
        dolLog(`   • 浏览器名称: ${navigator.appName}`, 'out');
        dolLog(`   • 浏览器版本: ${navigator.appVersion}`, 'out');
        dolLog(`   • 平台: ${navigator.platform}`, 'out');
        dolLog(`   • 语言: ${navigator.language}`, 'out');
        dolLog(`   • Cookie启用: ${navigator.cookieEnabled}`, 'out');
        dolLog(`   • 在线状态: ${navigator.onLine ? '在线' : '离线'}`, 'out');
        dolLog(`   • 硬件并发数: ${navigator.hardwareConcurrency || '未知'}`, 'out');
        dolLog(`   • 屏幕分辨率: ${screen.width}x${screen.height}`, 'out');
        dolLog(`   • 可用内存: ${Math.round(performance.memory?.usedJSHeapSize / 1024 / 1024) || '未知'}MB`, 'out');
        dolLog(`   • 设备像素比: ${window.devicePixelRatio}`, 'out');
        dolLog(`   • 时区: ${Intl.DateTimeFormat().resolvedOptions().timeZone}`, 'out');
      }
      dolLog(`✅ 设备信息查询完成（${mode === 'p' ? '预览模式' : '详细模式'}）`, 'suc');
    }, 300);
    return true;
  }
  
  // 6. 强制关闭窗口（关闭当前标签）
  const closeWinMatch = line.match(/^\/lc\/bye\.wts<([^>]+)@([pa])$/);
  if (closeWinMatch) {
    const winName = closeWinMatch[1];
    const mode = closeWinMatch[2];
    dolLog(`🔒 正在强制关闭窗口: ${winName}`, 'warn');
    
    if (mode === 'p') {
      // 优雅关闭
      dolLog(`⚠️ 正在保存状态...`, 'warn');
      setTimeout(() => {
        window.close();
      }, 500);
    } else {
      // 强制终止
      window.close();
    }
    dolLog(`✅ 窗口关闭命令已发送`, 'suc');
    return true;
  }
  
  // 7. 关闭本窗口
  const closeThisMatch = line.match(/^\/lc\/cl@dol@h\.m<(\d+)>$/);
  if (closeThisMatch) {
    const delay = parseInt(closeThisMatch[1]) * 1000;
    dolLog(`⚠️ 本窗口将在 ${closeThisMatch[1]} 秒后关闭...`, 'warn');
    setTimeout(() => {
      window.close();
    }, delay);
    return true;
  }
  
  // 8. 自定义指令 - 系统调试模式
  if (line === '/lc/146255#DE@E') {
    dolLog(`🎮 系统调试模式已激活！`, 'info');
    dolLog(`✨ 执行系统诊断...`, 'out');
    
    // 执行多项系统检查
    setTimeout(() => {
      dolLog(`🔍 内存使用: ${Math.round(performance.memory?.usedJSHeapSize / 1024 / 1024) || '未知'}MB / ${Math.round(performance.memory?.totalJSHeapSize / 1024 / 1024) || '未知'}MB`, 'out');
      dolLog(`🔍 页面加载时间: ${performance.timing?.loadEventEnd - performance.timing?.navigationStart || '未知'}ms`, 'out');
      dolLog(`🔍 连接类型: ${navigator.connection?.effectiveType || '未知'}`, 'out');
      dolLog(`✅ 系统诊断完成！`, 'suc');
    }, 800);
    
    return true;
  }
  
  // 9. 清除浏览器缓存
  if (line === '/lc/clear.cache') {
    dolLog(`⚠️ 正在清除浏览器缓存...`, 'warn');
    caches.keys().then(names => {
      names.forEach(name => caches.delete(name));
      dolLog(`✅ 缓存已清除`, 'suc');
    }).catch(() => {
      dolLog(`⚠️ 缓存清除失败（可能不支持）`, 'warn');
    });
    return true;
  }
  
  // 10. 导出数据到文件
  const exportMatch = line.match(/^\/lc\/export\.data<([^>]+)>$/);
  if (exportMatch) {
    const fileName = exportMatch[1];
    dolLog(`📤 正在导出数据: ${fileName}`, 'info');
    
    // 收集所有存储数据
    const exportData = {
      localStorage: Object.fromEntries(Object.entries(localStorage)),
      cookies: document.cookie,
      timestamp: new Date().toISOString()
    };
    
    // 创建并下载文件
    const blob = new Blob([JSON.stringify(exportData, null, 2)], {type: 'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${fileName}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    dolLog(`✅ 数据已导出为: ${fileName}.json`, 'suc');
    return true;
  }
  
  // 11. 系统信息摘要
  if (line === '/lc/sys.summary') {
    dolLog(`📊 系统信息摘要:`, 'info');
    dolLog(`   • 浏览器: ${navigator.appName} ${navigator.appVersion}`, 'out');
    dolLog(`   • 平台: ${navigator.platform}`, 'out');
    dolLog(`   • 语言: ${navigator.language}`, 'out');
    dolLog(`   • 屏幕: ${screen.width}x${screen.height}`, 'out');
    dolLog(`   • 在线: ${navigator.onLine ? '是' : '否'}`, 'out');
    dolLog(`   • 存储: ${localStorage.length} 项`, 'out');
    dolLog(`✅ 系统信息摘要已生成`, 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：8个黑客模式高级指令 (需开启黑客模式)】 ==========
// ==================================================
// /hack/stealth                        隐身模式（隐藏控制台）
// /hack/disable<功能>                  禁用指定功能
// /hack/enable<功能>                   启用指定功能
// /hack/scan                           扫描页面元素
// /hack/extract<类型>                  提取页面数据
// /hack/override<方法>                 覆盖内置方法
// /hack/monitor<目标>                  监控目标
// /hack/exploit<漏洞>                  模拟漏洞利用（演示用）

let hackModeEnabled = false;
let oathTaken = false;  // 宣誓状态：是否已输入宣誓指令

// ==================================================
// ========== 【宣誓指令】 ==========
// ==================================================
// [<IKTID;BISU@dol.P;ISND)!}{2B IM 5S 7B 8G FH 91/MCSYNRAY,OOGKJGI.MNN/)><ENDXSCD;TKDOLBYE@dol}
// 意思：我一直到危险但是我需要用求求了 不会做非法知识

function parseOathCmd(cmd) {
  const oathCode = '[<IKTID;BISU@dol.P;ISND)!}{2B IM 5S 7B 8G FH 91/MCSYNRAY,OOGKJGI.MNN/)><ENDXSCD;TKDOLBYE@dol}';
  if (cmd.trim() === oathCode) {
    oathTaken = true;
    dolLog(`📜 宣誓成功！您已确认了解风险并承诺遵守规则`, 'suc');
    dolLog(`✅ 已解锁: /lc/ 控制指令 和 部分黑客指令`, 'suc');
    dolLog(`🔓 沙箱权限已提升（微微破解）`, 'warn');
    return true;
  }
  return false;
}

function parseHackCmd(cmd) {
  // 检查是否已宣誓
  if (!oathTaken) {
    dolLog(`❌ 需要先输入宣誓指令才能使用黑客指令`, 'err');
    dolLog(`💡 请输入: [<IKTID;BISU@dol.P;ISND)!}{2B IM 5S 7B 8G FH 91/MCSYNRAY,OOGKJGI.MNN/)><ENDXSCD;TKDOLBYE@dol}`, 'info');
    return false;
  }
  
  if (!hackModeEnabled) {
    dolLog(`❌ 需要先开启黑客模式: /nsrp/hack`, 'err');
    return false;
  }
  
  const line = cmd.trim();
  
  // 1. 隐身模式
  if (line === '/hack/stealth') {
    // 隐藏控制台和调试信息
    const consoleStyles = document.createElement('style');
    consoleStyles.textContent = '.dol-console { opacity: 0.3; transition: opacity 0.5s; } .dol-console:hover { opacity: 1; }';
    document.head.appendChild(consoleStyles);
    dolLog(`🎭 隐身模式已开启`, 'hack');
    return true;
  }
  
  // 2. 禁用功能
  const disableMatch = line.match(/^\/hack\/disable<([^>]+)>$/);
  if (disableMatch) {
    const feature = disableMatch[1].toLowerCase();
    switch(feature) {
      case 'rightclick':
        document.addEventListener('contextmenu', e => e.preventDefault());
        dolLog(`🔒 右键菜单已禁用`, 'hack');
        break;
      case 'select':
        document.body.style.userSelect = 'none';
        dolLog(`🔒 文本选择已禁用`, 'hack');
        break;
      case 'copy':
        document.addEventListener('copy', e => e.preventDefault());
        dolLog(`🔒 复制功能已禁用`, 'hack');
        break;
      default:
        dolLog(`❌ 未知功能: ${feature}`, 'err');
    }
    return true;
  }
  
  // 3. 启用功能
  const enableMatch = line.match(/^\/hack\/enable<([^>]+)>$/);
  if (enableMatch) {
    const feature = enableMatch[1].toLowerCase();
    switch(feature) {
      case 'rightclick':
        document.removeEventListener('contextmenu', e => e.preventDefault());
        dolLog(`🔓 右键菜单已启用`, 'hack');
        break;
      case 'select':
        document.body.style.userSelect = '';
        dolLog(`🔓 文本选择已启用`, 'hack');
        break;
      case 'copy':
        document.removeEventListener('copy', e => e.preventDefault());
        dolLog(`🔓 复制功能已启用`, 'hack');
        break;
      default:
        dolLog(`❌ 未知功能: ${feature}`, 'err');
    }
    return true;
  }
  
  // 4. 扫描页面元素
  if (line === '/hack/scan') {
    const elements = document.querySelectorAll('*');
    const stats = {
      total: elements.length,
      buttons: document.querySelectorAll('button').length,
      inputs: document.querySelectorAll('input, textarea').length,
      divs: document.querySelectorAll('div').length
    };
    dolLog(`📡 页面扫描完成:`, 'hack');
    dolLog(`   • 总元素: ${stats.total}`, 'out');
    dolLog(`   • 按钮: ${stats.buttons}`, 'out');
    dolLog(`   • 输入框: ${stats.inputs}`, 'out');
    dolLog(`   • 容器: ${stats.divs}`, 'out');
    return true;
  }
  
  // 5. 提取页面数据
  const extractMatch = line.match(/^\/hack\/extract<([^>]+)>$/);
  if (extractMatch) {
    const type = extractMatch[1].toLowerCase();
    switch(type) {
      case 'links':
        const links = Array.from(document.querySelectorAll('a')).map(a => a.href);
        dolLog(`🔗 提取链接 (${links.length}个):`, 'hack');
        links.slice(0, 5).forEach(link => dolLog(`   • ${link}`, 'out'));
        break;
      case 'images':
        const imgs = Array.from(document.querySelectorAll('img')).map(img => img.src);
        dolLog(`🖼️ 提取图片 (${imgs.length}个):`, 'hack');
        imgs.slice(0, 5).forEach(img => dolLog(`   • ${img}`, 'out'));
        break;
      case 'forms':
        const forms = Array.from(document.querySelectorAll('form')).map(f => f.action || '无action');
        dolLog(`📝 提取表单 (${forms.length}个):`, 'hack');
        forms.forEach((form, i) => dolLog(`   • 表单${i+1}: ${form}`, 'out'));
        break;
      default:
        dolLog(`❌ 未知提取类型: ${type}`, 'err');
    }
    return true;
  }
  
  // 6. 覆盖内置方法（演示用）
  const overrideMatch = line.match(/^\/hack\/override<([^>]+)>$/);
  if (overrideMatch) {
    const method = overrideMatch[1].toLowerCase();
    switch(method) {
      case 'alert':
        window._originalAlert = window.alert;
        window.alert = (msg) => {
          dolLog(`⚠️ 拦截警告: ${msg}`, 'hack');
        };
        dolLog(`🔧 已覆盖 alert() 方法`, 'hack');
        break;
      case 'confirm':
        window._originalConfirm = window.confirm;
        window.confirm = (msg) => {
          dolLog(`⚠️ 拦截确认: ${msg}`, 'hack');
          return true; // 自动确认
        };
        dolLog(`🔧 已覆盖 confirm() 方法`, 'hack');
        break;
      default:
        dolLog(`❌ 未知方法: ${method}`, 'err');
    }
    return true;
  }
  
  // 7. 监控目标
  const monitorMatch = line.match(/^\/hack\/monitor<([^>]+)>$/);
  if (monitorMatch) {
    const target = monitorMatch[1].toLowerCase();
    dolLog(`🎯 开始监控: ${target}`, 'hack');
    switch(target) {
      case 'network':
        // 模拟网络监控
        setInterval(() => {
          dolLog(`📊 网络状态: 在线 | 延迟: ${Math.floor(Math.random() * 50) + 10}ms`, 'info');
        }, 3000);
        break;
      case 'memory':
        // 模拟内存监控
        setInterval(() => {
          const mem = Math.floor(Math.random() * 100) + 50;
          dolLog(`📊 内存使用: ${mem}MB`, 'info');
        }, 3000);
        break;
      default:
        dolLog(`❌ 未知监控目标: ${target}`, 'err');
    }
    return true;
  }
  
  // 8. 模拟漏洞利用（演示用）
  const exploitMatch = line.match(/^\/hack\/exploit<([^>]+)>$/);
  if (exploitMatch) {
    const exploit = exploitMatch[1].toLowerCase();
    dolLog(`💥 模拟漏洞利用: ${exploit}`, 'hack');
    switch(exploit) {
      case 'xss':
        dolLog(`⚠️ XSS演示: 已绕过前端过滤`, 'warn');
        break;
      case 'csrf':
        dolLog(`⚠️ CSRF演示: 已伪造请求`, 'warn');
        break;
      case 'sqli':
        dolLog(`⚠️ SQL注入演示: 已绕过验证`, 'warn');
        break;
      default:
        dolLog(`❌ 未知漏洞类型: ${exploit}`, 'err');
    }
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：2个辅助运行指令 /run/】 ==========
// ==================================================
// /run/bat                    辅助运行 DonglaugOL$.bat 文件
// /run/cmd<命令>              辅助运行系统命令（提供说明）

function parseRunCmd(cmd) {
  const line = cmd.trim();
  
  // 1. 辅助运行 .bat 文件
  if (line === '') {
    dolLog('🔧 辅助运行 DonglaugOL$.bat', 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       DonglaugOL$ Terminal 辅助启动指南', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog('📌 启动方式:', 'info');
    dolLog('   1. 双击运行 DonglaugOL$.bat 文件', 'out');
    dolLog('   2. 在命令行中输入: DonglaugOL$.bat', 'out');
    dolLog('   3. 使用 PowerShell: .\DonglaugOL$.bat', 'out');
    dolLog('', 'out');
    dolLog('📋 可用指令组:', 'info');
    dolLog('   • /ctrl/  - 系统控制 (关机/重启/休眠/锁定)', 'out');
    dolLog('   • /wnd/   - 窗口控制 (最小化/最大化/恢复)', 'out');
    dolLog('   • /inp/   - 输入设备 (键盘/鼠标控制)', 'out');
    dolLog('   • /disp/  - 显示控制 (亮度/分辨率)', 'out');
    dolLog('   • /fop/   - 文件操作 (备份/压缩/解压)', 'out');
    dolLog('   • /mon/   - 系统监控 (CPU/内存/磁盘)', 'out');
    dolLog('   • /eco/   - 生态连接 (连接DonglaugOL生态)', 'out');
    dolLog('', 'out');
    dolLog('💡 提示: 输入 help 查看完整指令列表', 'info');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    
    // 创建启动按钮
    const btn = document.createElement('button');
    btn.className = 'custom-btn';
    btn.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);padding:15px 30px;font-size:18px;z-index:10000;';
    btn.textContent = '📂 打开 DonglaugOL$ 文件位置';
    btn.onclick = () => {
      dolLog('💡 请在文件管理器中双击 DonglaugOL$.bat 启动终端', 'info');
      // 尝试打开文件夹（浏览器限制，仅提示）
      dolLog('⚠️ 浏览器安全限制：无法直接启动 .bat 文件', 'warn');
      dolLog('📌 请手动打开文件夹并运行 DonglaugOL$.bat', 'info');
    };
    document.body.appendChild(btn);
    
    // 5秒后自动移除按钮
    setTimeout(() => {
      if (btn.parentElement) btn.remove();
    }, 10000);
    
    return true;
  }
  
  // 2. 辅助运行系统命令
  const cmdMatch = line.match(/^\/run\/cmd<([^>]+)>$/);
  if (cmdMatch) {
    const command = cmdMatch[1];
    dolLog(`🔧 辅助运行命令: ${command}`, 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       系统命令执行说明', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog('⚠️ 浏览器安全限制:', 'warn');
    dolLog('   JavaScript 运行在浏览器沙箱中', 'out');
    dolLog('   无法直接执行系统命令', 'out');
    dolLog('', 'out');
    dolLog('📌 执行方式:', 'info');
    dolLog('   1. 打开命令提示符 (cmd)', 'out');
    dolLog('   2. 打开 PowerShell', 'out');
    dolLog('   3. 在 DonglaugOL$.bat 中执行', 'out');
    dolLog('', 'out');
    dolLog('💡 建议命令:', 'info');
    
    // 根据命令类型提供建议
    const cmdLower = command.toLowerCase();
    if (cmdLower.includes('shutdown') || cmdLower.includes('restart')) {
      dolLog('   • 关机: shutdown /s /t 0', 'out');
      dolLog('   • 重启: shutdown /r /t 0', 'out');
      dolLog('   或使用 DonglaugOL$ 指令: /ctrl/shutdown, /ctrl/restart', 'out');
    } else if (cmdLower.includes('tasklist') || cmdLower.includes('process')) {
      dolLog('   • 进程列表: tasklist', 'out');
      dolLog('   • 结束进程: taskkill /IM 进程名', 'out');
      dolLog('   或使用 DonglaugOL$ 指令: /mon/process', 'out');
    } else if (cmdLower.includes('ipconfig') || cmdLower.includes('network')) {
      dolLog('   • 网络配置: ipconfig /all', 'out');
      dolLog('   或使用 DonglaugOL$ 指令: /mon/network', 'out');
    } else if (cmdLower.includes('systeminfo') || cmdLower.includes('info')) {
      dolLog('   • 系统信息: systeminfo', 'out');
      dolLog('   或使用 DonglaugOL$ 指令: /mon/cpu, /mon/memory', 'out');
    } else {
      dolLog(`   • 请在终端中执行: ${command}`, 'out');
    }
    
    dolLog('', 'out');
    dolLog('🔗 生态连接: 使用 /eco/connect 连接 DonglaugOL 生态系统', 'info');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：DonglaugOL 生态跳转指令】 ==========
// ==================================================
// /dol/other.open<$>                    打开 DonglaugOL 生态其他应用
//    /dol+dol$/run.go.batdol$<DonglaugOL$>  跳转到 DonglaugOL$ 终端

function parseDolOtherCmd(cmd) {
  const line = cmd.trim();
  
  // 1. /dol/other.open<$> - 打开 DonglaugOL 生态其他应用
  if (line === '/dol/other.open<$>') {
    dolLog('🌐 DonglaugOL 生态应用', 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       DonglaugOL 生态系统', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog('📦 可用应用:', 'info');
    dolLog('   • DonglaugOL$ Terminal - 系统控制终端', 'out');
    dolLog('   • DonglaugOL EUA - 编程语言环境', 'out');
    dolLog('', 'out');
    dolLog('🔗 跳转方式:', 'info');
    dolLog('   • 输入:    /dol+dol$/run.go.batdol$<DonglaugOL$>', 'out');
    dolLog('   • 或输入: /run/bat', 'out');
    dolLog('', 'out');
    dolLog('💡 提示: DonglaugOL$ 提供完整的系统控制功能', 'info');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    return true;
  }
  
  // 2.    /dol+dol$/run.go.batdol$<DonglaugOL$> - 跳转到 DonglaugOL$ 终端
  const batMatch = line.match(/^\-+\/dol\+dol\$\/run\.go\.batdol\$<(.+)>$/);
  if (batMatch) {
    const target = batMatch[1];
    dolLog(`🚀 正在跳转到: ${target}`, 'suc');
    
    // 尝试打开 .bat 文件
    const batPath = './DonglaugOL$.bat';
    
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('       DonglaugOL$ Terminal 启动中...', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog('🔧 DonglaugOL$ 功能:', 'info');
    dolLog('   • /ctrl/  - 系统控制 (关机/重启/休眠/锁定)', 'out');
    dolLog('   • /wnd/   - 窗口控制 (最小化/最大化/恢复)', 'out');
    dolLog('   • /inp/   - 输入设备 (键盘/鼠标控制)', 'out');
    dolLog('   • /disp/  - 显示控制 (亮度/分辨率)', 'out');
    dolLog('   • /fop/   - 文件操作 (备份/压缩/解压)', 'out');
    dolLog('   • /mon/   - 系统监控 (CPU/内存/磁盘)', 'out');
    dolLog('   • /eco/   - 生态连接', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    
    // 创建启动提示窗口
    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);display:flex;justify-content:center;align-items:center;z-index:99999;';
    
    const content = document.createElement('div');
    content.style.cssText = 'background:linear-gradient(145deg, #2a2e35, #1e2126);padding:40px;border-radius:20px;text-align:center;color:#e2e2e2;max-width:500px;box-shadow:0 10px 40px rgba(0,0,0,0.5);';
    
    content.innerHTML = `
      <div style="font-size:60px;margin-bottom:20px;">🚀</div>
      <h2 style="margin-bottom:15px;color:#9fc0e5;">DonglaugOL$ Terminal</h2>
      <p style="margin-bottom:20px;color:#a8b9a8;">正在打开 DonglaugOL$.bat 文件...</p>
      <div style="background:rgba(45,49,56,0.6);padding:15px;border-radius:10px;margin-bottom:20px;text-align:left;">
        <div style="color:#9fc0e5;margin-bottom:10px;">📋 文件位置:</div>
        <div style="color:#d0d8e2;font-family:monospace;margin-bottom:15px;">DonglaugOL$.bat</div>
      </div>
      <div style="display:flex;gap:10px;justify-content:center;">
        <button id="openBatBtn" style="padding:12px 30px;background:linear-gradient(180deg, rgba(85,215,150,0.75), rgba(55,188,122,0.65));color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">打开 .bat 文件</button>
        <button onclick="this.closest('div[style*=fixed]').remove()" style="padding:12px 30px;background:rgba(100,105,115,0.65);color:#fff;border:none;border-radius:9999px;cursor:pointer;font-size:16px;">关闭</button>
      </div>
    `;
    
    modal.appendChild(content);
    document.body.appendChild(modal);
    
    // 绑定打开按钮事件
    setTimeout(() => {
      const openBtn = document.getElementById('openBatBtn');
      if (openBtn) {
        openBtn.onclick = () => {
          try {
            // 尝试打开 .bat 文件
            window.open(batPath, '_blank');
            dolLog('✅ 已尝试打开 DonglaugOL$.bat', 'suc');
          } catch (e) {
            dolLog('⚠️ 浏览器阻止了文件打开', 'warn');
            dolLog('💡 请手动打开 DonglaugOL$.bat', 'info');
          }
        };
        
        // 自动尝试打开
        openBtn.click();
      }
    }, 500);
    
    // 10秒后自动关闭
    setTimeout(() => {
      if (modal.parentElement) modal.remove();
    }, 10000);
    
    return true;
  }
  
  return false;
}

