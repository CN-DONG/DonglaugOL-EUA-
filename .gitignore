            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/web/title&lt;标题&gt;</span> - 设置网页标题</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/web/bg&lt;颜色/URL&gt;</span> - 设置背景</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/web/icon&lt;URL&gt;</span> - 设置图标</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/web/font&lt;字体&gt;</span> - 设置字体</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/web/link&lt;URL&gt;</span> - 跳转网页</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #8e44ad;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#8e44ad;margin-bottom:8px;font-size:14px;">📦 存储指令 /store/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/store/save&lt;键&gt;=&lt;值&gt;</span> - 保存数据</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/store/load&lt;键&gt;</span> - 加载数据</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/store/delete&lt;键&gt;</span> - 删除数据</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/store/list</span> - 列出所有存储</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/store/clear</span> - 清空存储</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #27ae60;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#27ae60;margin-bottom:8px;font-size:14px;">🔄 循环指令</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">loopN{指令}</span> - 循环N次</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">loop[N]@M{指令}</span> - 间隔M秒循环</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">loop.inf{指令}</span> - 无限循环</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">loop.stop</span> - 停止循环</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #c0392b;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#c0392b;margin-bottom:8px;font-size:14px;">💻 操控指令 /cd/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/cd/goto&lt;cmd&gt;</span> - 模拟系统命令</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/cd/goto&lt;notepad&gt;</span> - 打开记事本</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/cd/goto&lt;calculator&gt;</span> - 打开计算器</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/cd/goto&lt;explorer&gt;</span> - 资源管理器</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #16a085;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#16a085;margin-bottom:8px;font-size:14px;">📱 实用功能 /uf/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/uf/screenshot.use.now</span> - 截图</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/uf/s.recording.use.atNs</span> - 延迟录音</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/uf/v.recording.use.atNs</span> - 延迟录屏</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/uf/phone.use</span> - 模拟电话</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/uf/printer.use&lt;图片&gt;</span> - 打印图片</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #d35400;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#d35400;margin-bottom:8px;font-size:14px;">🖨️ 打印指令 /pr/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pr/printer.use.nb.text&lt;文本&gt;</span> - 打印文本</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pr/printer.use.nb.image&lt;图片&gt;</span> - 打印图片</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pr/printer.use.nb.web&lt;网址&gt;</span> - 打印网页</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pr/printer.use.nb.all</span> - 打印页面</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #2980b9;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#2980b9;margin-bottom:8px;font-size:14px;">🌐 浏览器指令 /browser/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/browser/refresh</span> - 刷新页面</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/browser/back</span> - 返回上一页</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/browser/forward</span> - 前进下一页</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/browser/open&lt;URL&gt;</span> - 打开新标签</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #7f8c8d;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#7f8c8d;margin-bottom:8px;font-size:14px;">🔍 监视指令 /watch/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/watch/start</span> - 开始监视</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/watch/stop</span> - 停止监视</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/watch/export</span> - 导出日志</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/watch/status</span> - 查看状态</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #e67e22;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#e67e22;margin-bottom:8px;font-size:14px;">🎵 音乐指令</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">music 1-7</span> - 播放音符(哆-西)</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/dol/light</span> - 创建变色灯</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/ig/line red/green/blue</span> - 设置灯光颜色</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #34495e;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#34495e;margin-bottom:8px;font-size:14px;">💬 弹幕指令</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/danmu&lt;内容&gt;</span> - 发送弹幕</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/danmu&lt;内容&gt;[时长]</span> - 自定义时长</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/danmu&lt;内容&gt;[时长][颜色]</span> - 自定义颜色</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #2c3e50;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#2c3e50;margin-bottom:8px;font-size:14px;">📐 数学计算</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">1+1</span> - 简单计算</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">[ 2+x=y . y=1 ?x= ]</span> - 解方程</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">x² / √x</span> - 平方/平方根</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #95a5a6;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#95a5a6;margin-bottom:8px;font-size:14px;">📦 语言基础</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">var&lt;变量&gt;=&lt;值&gt;</span> - 变量声明</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">if&lt;条件&gt;{代码}</span> - 条件判断</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">for&lt;初始&gt;;&lt;条件&gt;;&lt;步长&gt;{代码}</span> - 循环</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">func&lt;名称&gt;(&lt;参数&gt;){代码}</span> - 函数定义</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">arr&lt;元素1,元素2&gt;</span> - 数组定义</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #1abc9c;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#1abc9c;margin-bottom:8px;font-size:14px;">🔧 工具指令 /dol/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/dol/copy.output&lt;高度&gt;</span> - 可复制输出框</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/dol/delete.input&lt;高度&gt;</span> - 可编辑输入框</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/dol/save.input&lt;高度&gt;</span> - 可保存输入框</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/dol/asl&lt;ese&gt;exit</span> - 全屏按钮</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/dol/input&lt;高度&gt;</span> - 用户输入框</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #3498db;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#3498db;margin-bottom:8px;font-size:14px;">📱 设备信息 /edv/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">=import &amp; use&lt;edv&gt;%</span> - 导入设备模块</div>
            <div style="margin-top:6px;font-weight:bold;color:#9fc0e5;">基本信息：</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/os</span> - 操作系统</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/browser</span> - 浏览器信息</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/language</span> - 系统语言</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/screen</span> - 屏幕分辨率</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/cpu</span> - CPU核心数</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/memory</span> - 设备内存</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/network</span> - 网络状态</div>
            <div style="margin-top:6px;font-weight:bold;color:#9fc0e5;">定位传感：</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/geolocation</span> - 地理位置</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/camera</span> - 摄像头</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/microphone</span> - 麦克风</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/battery</span> - 电池状态</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/clipboard</span> - 剪贴板</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/device</span> - 全部设备信息</div>
            <div style="margin-top:6px;font-weight:bold;color:#9fc0e5;">更多传感：</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/vibrate</span> - 设备震动</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/orientation</span> - 陀螺仪/方向</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/motion</span> - 加速计/运动</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/screenshot</span> - 截屏预览</div>
            <div style="margin-top:6px;font-weight:bold;color:#9fc0e5;">信息展示：</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/info</span> - 信息面板（输出框）</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/window</span> - 信息窗口（新窗口）</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/text</span> - 纯文本（可复制）</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/json</span> - JSON格式</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/all</span> - 全部指令（一键复制）</div>
            <div style="margin-top:6px;font-weight:bold;color:#9fc0e5;">连接设备：</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/edv/bluetooth</span> - 蓝牙设备扫描</div>
            <div style="margin-top:4px;font-size:11px;color:#666;">两种方式：/edv/指令 或 edv.指令（需先导入）</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #e91e63;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#e91e63;margin-bottom:8px;font-size:14px;">🎨 调色板 /pal/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">=import &amp; use&lt;pal&gt;%</span> - 导入调色板模块</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pal/picker</span> - 调色板(取色+转换)</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pal/hex</span> - 随机HEX | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pal/rgb</span> - 随机RGB</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pal/random</span> - 5个随机色 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pal/contrast</span> - 对比色板</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/pal/palette</span> - 精选色板(莫兰迪等)</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #9c27b0;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#9c27b0;margin-bottom:8px;font-size:14px;">⏰ 时间 /time/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">=import &amp; use&lt;time&gt;%</span> - 导入时间模块</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/time/now</span> - 当前时间 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/time/clock</span> - 数字时钟</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/time/stamp</span> - 时间戳 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/time/date</span> - 完整日期</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/time/countdown<60></span> - 倒计时(秒)</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/time/stopwatch</span> - 秒表(开始/停止)</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #3f51b5;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#3f51b5;margin-bottom:8px;font-size:14px;">🧮 计算器 /calc/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">=import &amp; use&lt;calc&gt;%</span> - 导入计算器模块</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/calc/1+2*3</span> - 直接写表达式</div>
            <div>支持: + - * / % ^ sqrt sin cos tan log ln abs</div>
            <div>支持: round floor ceil pi e 示例: <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/calc/sqrt(16)</span></div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #ff9800;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#ff9800;margin-bottom:8px;font-size:14px;">🎲 随机数 /rand/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">=import &amp; use&lt;rand&gt;%</span> - 导入随机数模块</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/rand/int<100></span> - 随机整数 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/rand/int<1,10></span> - 自定义范围</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/rand/float</span> - 随机浮点 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/rand/color</span> - 随机颜色</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/rand/pick<a,b,c></span> - 随机选择</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/rand/shuffle<a,b,c,d></span> - 随机打乱</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #00bcd4;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#00bcd4;margin-bottom:8px;font-size:14px;">📋 JSON /json/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">=import &amp; use&lt;json&gt;%</span> - 导入JSON模块</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/format</span> - 格式化 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/minify</span> - 压缩</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/validate</span> - 校验 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/parse</span> - 解析</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/tree</span> - 树形展示 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/editor</span> - 编辑器</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/json/tostring&lt;k=v,k=v&gt;</span> - 键值对转JSON</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #16a085;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#16a085;margin-bottom:8px;font-size:14px;">📋 待办事项 /todo/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/add&lt;内容&gt;</span> - 添加</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/list</span> - 列表 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/window</span> - 窗口</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/done&lt;ID&gt;</span> - 完成 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/del&lt;ID&gt;</span> - 删除</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/edit&lt;ID|内容&gt;</span> - 编辑 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/todo/clear</span> - 清空</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #9b59b6;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#9b59b6;margin-bottom:8px;font-size:14px;">👾 GLITCH 彩蛋</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/glitch</span> 或 <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/egg/glitch</span> - 触发乱码效果</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #3498db;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#3498db;margin-bottom:8px;font-size:14px;">📱 二维码 /qr/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/qr/make&lt;内容&gt;</span> - 生成二维码</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/qr/url&lt;网址&gt;</span> - 网址 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/qr/text&lt;文字&gt;</span> - 文本</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/qr/wifi&lt;名称|密码|加密&gt;</span> - WiFi二维码</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #e67e22;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#e67e22;margin-bottom:8px;font-size:14px;">🎬 视频播放 /vlc/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/play&lt;URL&gt;</span> - 播放视频</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/pause</span> - 暂停/继续 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/stop</span> - 停止</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/volume&lt;0-100&gt;</span> - 音量 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/fullscreen</span> - 全屏</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/seek&lt;秒&gt;</span> - 跳转 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/info</span> - 信息</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/open</span> - 本地文件 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/nad</span> - NAD风格</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/embed&lt;URL&gt;</span> - 嵌入页面 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/loop</span> - 循环</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/speed&lt;倍速&gt;</span> - 速度 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/snapshot</span> - 截图</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/vlc/playlist&lt;url1|url2&gt;</span> - 播放列表</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #27ae60;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#27ae60;margin-bottom:8px;font-size:14px;">🖼️ 图片处理 /img/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/preview&lt;URL&gt;</span> - 预览 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/open</span> - 本地选择</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/info&lt;URL&gt;</span> - 信息 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/rotate&lt;URL|角度&gt;</span> - 旋转</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/filter&lt;URL|滤镜&gt;</span> - 滤镜 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/grayscale&lt;URL&gt;</span> - 灰度</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/slideshow&lt;url1|url2&gt;</span> - 幻灯片 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/gallery&lt;url1|url2&gt;</span> - 画廊</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/img/embed&lt;url1|url2&gt;</span> - 无窗口（嵌入页面）</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #e67e22;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#e67e22;margin-bottom:8px;font-size:14px;">🖨️ 打印机 /prt/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/open</span> - 控制面板 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/nad</span> - NAD风格</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/connect</span> - 连接 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/disconnect</span> - 断开</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/print</span> - 打印 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/queue</span> - 队列</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/paper</span> - 纸张 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/quality</span> - DPI</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/copies</span> - 份数 | <span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/prt/ink</span> - 墨水</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #27ae60;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#27ae60;margin-bottom:8px;font-size:14px;">📊 表格 /tbl/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/tbl/new&lt;3|2|姓名,年龄,城市&gt;</span> - 新建表格</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/tbl/add&lt;王五,28,广州&gt;</span> - 添加一行</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/tbl/show</span> - 显示表格</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #3498db;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#3498db;margin-bottom:8px;font-size:14px;">📝 文档 /doc/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/doc/new&lt;我的文档&gt;</span> - 新建文档</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/doc/write&lt;这是一段文字&gt;</span> - 写入段落</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/doc/show</span> - 显示文档</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #e74c3c;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#e74c3c;margin-bottom:8px;font-size:14px;">⚠️ 声音指令 /so/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/so/open</span> - 开启声音</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/so/close</span> - 关闭声音</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/so/sound&lt;文件名.mp3&gt;</span> - 自定义声音</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #f39c12;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#f39c12;margin-bottom:8px;font-size:14px;">⚡ 自动指令 /auto/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/auto/clean</span> - 自动清空</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/auto/light</span> - 自动变色灯</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/auto/camera</span> - 自动拍照</div>
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/auto/run&lt;毫秒&gt;</span> - 延迟运行</div>
          </div>
        </div>
        <div style="padding:14px;background:rgba(0,0,0,0.25);border-radius:12px;border-left:4px solid #9b59b6;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05);">
          <div style="font-weight:bold;color:#9b59b6;margin-bottom:8px;font-size:14px;">🎬 动画指令 /ac/</div>
          <div style="font-size:12px;color:#ccc;line-height:1.8;">
            <div><span style="color:#8ab4f8;cursor:pointer;text-decoration:underline;text-decoration-style:dotted;" class="cmd-click">/ac/ make.AZ19{   A0,0 B2 C#fff 2D E5 S2}end&lt;Dr~</span></div>
            <div style="margin-top:4px;font-size:11px;color:#666;">参数: A=位置 B=速度 C=颜色 D=类型 E=步数</div>
          </div>
        </div>
      </div>
      <div style="margin-top:20px;padding-top:15px;border-top:1px solid rgba(255,255,255,0.1);text-align:center;">
        <span style="font-size:13px;color:#666;">💡 提示：点击指令可自动复制到输入框 | 按 ESC 关闭</span>
      </div>
    `;
    
    modal.appendChild(header);
    modal.appendChild(content);
    document.body.appendChild(overlay);
    document.body.appendChild(modal);
    
    requestAnimationFrame(() => {
      modal.style.opacity = '1';
      modal.style.transform = 'translate(-50%, -50%) scale(1)';
      overlay.style.opacity = '1';
    });
    
    const cmdClicks = modal.querySelectorAll('.cmd-click');
    cmdClicks.forEach(span => {
      span.addEventListener('click', () => {
        const cmdText = span.textContent.trim();
        codeInput.value = cmdText;
        codeInput.focus();
        playSound('click');
        dolLog(`📋 指令已复制: ${cmdText}`, 'info');
      });
      span.addEventListener('mouseenter', () => {
        span.style.color = '#a8c9ff';
        span.style.textDecorationStyle = 'solid';
      });
      span.addEventListener('mouseleave', () => {
        span.style.color = '#8ab4f8';
        span.style.textDecorationStyle = 'dotted';
      });
    });
  }
  
  // 快捷键支持
  let keySequence = [];
  let keySequenceTimeout = null;
  
  let dolLogoClickCount = 0;
  let dolLogoClickTimer = null;
  const dolLogo = document.querySelector('.dol-logo, #dol-logo, [alt="DonglaugOL"]');
  if (dolLogo) {
    dolLogo.style.cursor = 'pointer';
    dolLogo.addEventListener('click', () => {
      dolLogoClickCount++;
      if (dolLogoClickTimer) clearTimeout(dolLogoClickTimer);
      dolLogoClickTimer = setTimeout(() => { dolLogoClickCount = 0; }, 3000);
      if (dolLogoClickCount === 5) {
        dolLog('🎮 彩蛋解锁: 8846!', 'egg');
        trigger8846Game();
        dolLogoClickCount = 0;
      } else if (dolLogoClickCount === 10) {
        dolLog('♟️ 彩蛋解锁: AI中国象棋!', 'egg');
        triggerChineseChess();
        dolLogoClickCount = 0;
      }
    });
  }

  let glitchActive = false;
  function triggerGlitch() {
    if (glitchActive) return;
    glitchActive = true;
    const chars = '!@#$%^&*()_+-=[]{}|;:,.<>?/~`';
    const origText = {};
    document.querySelectorAll('body *').forEach((el, i) => {
      if (el.children.length === 0 && el.textContent.trim()) {
        origText[i] = el.textContent;
      }
    });
    let count = 0;
    const interval = setInterval(() => {
      document.querySelectorAll('body *').forEach((el, i) => {
        if (origText[i] !== undefined) {
          let t = '';
          for (let j = 0; j < origText[i].length; j++) {
            t += Math.random() > 0.3 ? chars[Math.floor(Math.random() * chars.length)] : origText[i][j];
          }
          el.textContent = t;
        }
      });
      count++;
      if (count > 15) {
        clearInterval(interval);
        document.querySelectorAll('body *').forEach((el, i) => {
          if (origText[i] !== undefined) el.textContent = origText[i];
        });
        glitchActive = false;
      }
    }, 80);
  }

  function trigger8846Game() {
    const win = createBaseWindow('🎮 8846 小游戏', 400, 500, 300, 400, false, true);
    const content = win.querySelector('.sys-win-content');
    content.style.padding = '20px';
    content.style.textAlign = 'center';
    content.innerHTML = `
      <div style="font-size:48px;font-weight:bold;color:#ffcc33;text-shadow:0 0 20px rgba(255,200,50,0.8);margin:20px 0;">8846</div>
      <div style="color:#aaa;margin-bottom:20px;">按数字键 8 8 4 6 解锁!</div>
      <div id="game8846-input" style="font-size:32px;color:#66e0ff;letter-spacing:8px;margin:20px 0;">____</div>
      <div id="game8846-status" style="color:#888;">输入: 8 → 8 → 4 → 6</div>
    `;
    const target = ['8','8','4','6'];
    let idx = 0;
    const handler = (e) => {
      if (e.key === target[idx]) {
        idx++;
        const display = content.querySelector('#game8846-input');
        display.textContent = target.slice(0, idx).join(' ') + ' _'.repeat(4 - idx);
        if (idx === 4) {
          content.querySelector('#game8846-status').innerHTML = '<span style="color:#66ff88;font-size:20px;">🎉 恭喜通关! Dongper 8846!</span>';
          document.removeEventListener('keydown', handler);
          dolLog('🏆 8846 游戏通关!', 'dongper');
        }
      } else if (e.key !== 'Shift' && e.key !== 'Control' && e.key !== 'Alt') {
        idx = 0;
        content.querySelector('#game8846-input').textContent = '_ _ _ _';
      }
    };
    document.addEventListener('keydown', handler);
    win.addEventListener('remove', () => document.removeEventListener('keydown', handler));
  }

  function triggerChineseChess() {
    const win = createBaseWindow('♟️ AI 中国象棋', 560, 640, 400, 500, false, true);
    const content = win.querySelector('.sys-win-content');
    content.style.padding = '15px';
    const board = document.createElement('div');
    board.style.cssText = 'width:100%;aspect-ratio:9/10;background:linear-gradient(145deg,#d4a574,#b8956a);border:3px solid #5c3d2e;border-radius:8px;position:relative;box-shadow:inset 0 2px 8px rgba(0,0,0,0.3),0 8px 24px rgba(0,0,0,0.5);';
    let html = '';
    for (let i = 0; i < 10; i++) {
      for (let j = 0; j < 9; j++) {
        const isRiver = i === 4 || i === 5;
        html += `<div style="position:absolute;left:${j*11.11+5.55}%;top:${i*10+5}%;width:6px;height:6px;background:#3a2a1a;border-radius:50%;transform:translate(-50%,-50%);"></div>`;
      }
    }
    html += `<div style="position:absolute;left:0;right:0;top:45%;bottom:45%;background:linear-gradient(90deg,transparent,rgba(90,60,40,0.3),transparent);display:flex;align-items:center;justify-content:center;font-size:24px;color:#5c3d2e;font-weight:bold;letter-spacing:20px;text-shadow:1px 1px 2px rgba(0,0,0,0.3);">楚 河&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;漢 界</div>`;
    const pieces = [
      {x:0,y:0,t:'車',c:'r'},{x:1,y:0,t:'馬',c:'r'},{x:2,y:0,t:'象',c:'r'},{x:3,y:0,t:'士',c:'r'},{x:4,y:0,t:'將',c:'r'},{x:5,y:0,t:'士',c:'r'},{x:6,y:0,t:'象',c:'r'},{x:7,y:0,t:'馬',c:'r'},{x:8,y:0,t:'車',c:'r'},
      {x:1,y:2,t:'砲',c:'r'},{x:7,y:2,t:'砲',c:'r'},
      {x:0,y:3,t:'卒',c:'r'},{x:2,y:3,t:'卒',c:'r'},{x:4,y:3,t:'卒',c:'r'},{x:6,y:3,t:'卒',c:'r'},{x:8,y:3,t:'卒',c:'r'},
      {x:0,y:9,t:'車',c:'b'},{x:1,y:9,t:'馬',c:'b'},{x:2,y:9,t:'相',c:'b'},{x:3,y:9,t:'仕',c:'b'},{x:4,y:9,t:'帥',c:'b'},{x:5,y:9,t:'仕',c:'b'},{x:6,y:9,t:'相',c:'b'},{x:7,y:9,t:'馬',c:'b'},{x:8,y:9,t:'車',c:'b'},
      {x:1,y:7,t:'炮',c:'b'},{x:7,y:7,t:'炮',c:'b'},
      {x:0,y:6,t:'兵',c:'b'},{x:2,y:6,t:'兵',c:'b'},{x:4,y:6,t:'兵',c:'b'},{x:6,y:6,t:'兵',c:'b'},{x:8,y:6,t:'兵',c:'b'},
    ];
    pieces.forEach(p => {
      const color = p.c === 'r' ? '#c0392b' : '#1a1a1a';
      const bg = p.c === 'r' ? '#f5deb3' : '#f5e6c8';
      html += `<div style="position:absolute;left:${p.x*11.11+5.55}%;top:${p.y*10+5}%;transform:translate(-50%,-50%);width:36px;height:36px;background:radial-gradient(circle at 30% 30%,${bg},#d4b896);border:2px solid ${color};border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:bold;color:${color};box-shadow:inset 0 2px 4px rgba(255,255,255,0.5),inset 0 -2px 4px rgba(0,0,0,0.2),0 2px 6px rgba(0,0,0,0.4);cursor:pointer;">${p.t}</div>`;
    });
    board.innerHTML = html;
    content.appendChild(board);
    const status = document.createElement('div');
    status.style.cssText = 'margin-top:12px;text-align:center;color:#aaa;';
    status.textContent = '♟️ 象棋棋盘已展示 (AI对弈开发中...)';
    content.appendChild(status);
  }

  function showF12QuickInput() {
    const win = createBaseWindow('⚡ F12 快捷输入面板', 420, 520, 300, 400, false, true);
    const content = win.querySelector('.sys-win-content');
    content.style.padding = '16px';
    const shortcuts = [
      { keys: 'F12 → P → N', name: '指令大全', desc: '打开/关闭完整指令列表' },
      { keys: 'F12 → D → G', name: '俄罗斯方块', desc: '经典俄罗斯方块游戏' },
      { keys: 'F12 → 6 → G', name: '弹球游戏', desc: '经典打砖块弹球' },
      { keys: 'F12 → G → L', name: '乱码特效', desc: '屏幕 glitch 乱码彩蛋' },
      { keys: 'F12 → Q', name: '快捷面板', desc: '打开此快捷输入面板' },
      { keys: 'Logo点击5次', name: '8846游戏', desc: '8-8-4-6 按键小游戏' },
      { keys: 'Logo点击10次', name: '中国象棋', desc: 'AI中国象棋棋盘' },
    ];
    let html = '<div style="color:#5a9cf0;font-weight:bold;margin-bottom:12px;font-size:14px;">🎯 快捷键 & 彩蛋大全</div>';
    shortcuts.forEach(s => {
      html += `
        <div style="background:linear-gradient(145deg,#2d3340,#1e232c);border:1px solid #3a4252;border-radius:8px;padding:10px;margin-bottom:8px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05),0 2px 6px rgba(0,0,0,0.3);">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="color:#ffcc33;font-weight:bold;font-family:monospace;">${s.keys}</span>
            <span style="color:#66ff88;font-weight:bold;">${s.name}</span>
          </div>
          <div style="color:#888;font-size:12px;margin-top:4px;">${s.desc}</div>
        </div>
      `;
    });
    html += '<div style="color:#666;font-size:12px;text-align:center;margin-top:10px;">💡 先按 F12，然后快速按下后续按键</div>';
    content.innerHTML = html;
  }

  function triggerPinball() {
    const win = createBaseWindow('🎱 弹球游戏', 520, 420, 300, 300, false, true);
    const content = win.querySelector('.sys-win-content');
    content.style.padding = '10px';
    const canvas = document.createElement('canvas');
    canvas.width = 480;
    canvas.height = 360;
    canvas.style.cssText = 'background:linear-gradient(180deg,#1a1a2e,#16213e);border:2px solid #3a4252;border-radius:8px;display:block;margin:0 auto;box-shadow:inset 0 2px 8px rgba(0,0,0,0.5);';
    content.appendChild(canvas);
    const ctx = canvas.getContext('2d');
    let ballX = 240, ballY = 300, ballDX = 3, ballDY = -3, ballR = 8;
    let paddleX = 200, paddleW = 80, paddleH = 12;
    let bricks = [];
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 8; c++) {
        bricks.push({ x: c*58+10, y: r*25+20, w: 52, h: 18, alive: true, color: ['#ff6b6b','#ffd93d','#6bcb77','#4d96ff'][r] });
      }
    }
    let score = 0, gameOver = false;
    document.addEventListener('keydown', paddleHandler);
    function paddleHandler(e) {
      if (e.key === 'ArrowLeft') paddleX = Math.max(0, paddleX - 20);
      if (e.key === 'ArrowRight') paddleX = Math.min(400, paddleX + 20);
    }
    function draw() {
      ctx.fillStyle = '#1a1a2e';
      ctx.fillRect(0, 0, 480, 360);
      bricks.forEach(b => {
        if (b.alive) {
          ctx.fillStyle = b.color;
          ctx.shadowColor = b.color;
          ctx.shadowBlur = 10;
          ctx.fillRect(b.x, b.y, b.w, b.h);
          ctx.shadowBlur = 0;
        }
      });
      ctx.fillStyle = '#5a9cf0';
      ctx.shadowColor = '#5a9cf0';
      ctx.shadowBlur = 15;
      ctx.fillRect(paddleX, 340, paddleW, paddleH);
      ctx.beginPath();
      ctx.arc(ballX, ballY, ballR, 0, Math.PI*2);
      ctx.fillStyle = '#ffd93d';
      ctx.shadowColor = '#ffd93d';
      ctx.shadowBlur = 20;
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.fillStyle = '#aaa';
      ctx.font = '14px monospace';
      ctx.fillText('分数: ' + score, 10, 355);
      if (gameOver) {
        ctx.fillStyle = 'rgba(0,0,0,0.7)';
        ctx.fillRect(0, 0, 480, 360);
        ctx.fillStyle = '#ff6b6b';
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('游戏结束', 240, 180);
        ctx.fillStyle = '#fff';
        ctx.font = '18px sans-serif';
        ctx.fillText('最终分数: ' + score, 240, 220);
        return;
      }
      ballX += ballDX;
      ballY += ballDY;
      if (ballX < ballR || ballX > 480 - ballR) ballDX = -ballDX;
      if (ballY < ballR) ballDY = -ballDY;
      if (ballY > 340 - ballR && ballY < 352 && ballX > paddleX && ballX < paddleX + paddleW) ballDY = -ballDY;
      if (ballY > 360) gameOver = true;
      bricks.forEach(b => {
        if (b.alive && ballX > b.x && ballX < b.x + b.w && ballY > b.y && ballY < b.y + b.h) {
          b.alive = false;
          ballDY = -ballDY;
          score += 10;
        }
      });
      requestAnimationFrame(draw);
    }
    draw();
    win.addEventListener('remove', () => document.removeEventListener('keydown', paddleHandler));
  }

  function resetKeySequence() {
    keySequence = [];
    if (keySequenceTimeout) clearTimeout(keySequenceTimeout);
  }
  
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'TEXTAREA') return;
    
    if (e.key === 'F12') {
      e.preventDefault();
      keySequence = ['F12'];
      tetrisKeySequence = ['F12'];
      keySequenceTimeout = setTimeout(resetKeySequence, 2000);
      return;
    }
    
    if (keySequence.length > 0) {
      keySequence.push(e.key.toLowerCase());
      
      if (keySequence.length === 3 && keySequence[0] === 'F12' && keySequence[1] === 'p' && keySequence[2] === 'n') {
        e.preventDefault();
        toggleGuide();
        resetKeySequence();
        tetrisKeySequence = [];
        return;
      }
      
      if (keySequence.length === 3 && keySequence[0] === 'F12' && keySequence[1] === 'd' && keySequence[2] === 'g') {
        e.preventDefault();
        initTetris();
        resetKeySequence();
        tetrisKeySequence = [];
        return;
      }

      if (keySequence.length === 3 && keySequence[0] === 'F12' && keySequence[1] === '6' && keySequence[2] === 'g') {
        e.preventDefault();
        triggerPinball();
        dolLog('🎱 彩蛋解锁: 弹球游戏!', 'egg');
        resetKeySequence();
        tetrisKeySequence = [];
        return;
      }

      if (keySequence.length === 3 && keySequence[0] === 'F12' && keySequence[1] === 'g' && keySequence[2] === 'l') {
        e.preventDefault();
        triggerGlitch();
        dolLog('🌀 彩蛋解锁: Glitch 乱码特效!', 'egg');
        resetKeySequence();
        tetrisKeySequence = [];
        return;
      }

      if (keySequence.length === 2 && keySequence[0] === 'F12' && keySequence[1] === 'q') {
        e.preventDefault();
        showF12QuickInput();
        resetKeySequence();
        return;
      }
      
      if (keySequence.length >= 3) {
        resetKeySequence();
        tetrisKeySequence = [];
      } else {
        keySequenceTimeout = setTimeout(resetKeySequence, 2000);
      }
    }
    
    if (e.ctrlKey || e.metaKey) {
      switch(e.key.toLowerCase()) {
        case 'r':
          e.preventDefault();
          run();
          break;
        case 's':
          e.preventDefault();
          saveAsDolwrt();
          break;
        case 'l':
          e.preventDefault();
          openFile();
          break;
        case 'd':
          e.preventDefault();
          openSettingsWindow();
          break;
        case 'c':
          e.preventDefault();
          openCalculator();
          break;
        case 'k':
          e.preventDefault();
          codeInput.focus();
          break;
      }
    }
    
    if (e.key === 'F5') {
      e.preventDefault();
      run();
    }
    
    if (e.key === 'Escape') {
      const settingsPanel = document.getElementById('settings-panel');
      if (settingsPanel) {
        settingsPanel.remove();
      }
      if (isGuideExpanded) {
        toggleGuide();
      }
    }
  });
  
});
let folderWatcherRunning = false;
let fpsMonitorRunning = false;
let voiceControlRunning = false;
let fileIndexMap = {};
// ==================================================
// ========== 【初代版本核心函数 100%完整保留】 ==========
// ==================================================
// HTML转义函数，防止XSS攻击
function escapeHtml(str) {
  if (str === undefined || str === null) return '';
  return String(str).replace(/[&<>"']/g, c => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[c]));
}

let errorCount = 0;
const errorLogs = [];

function createErrorReport(errorText, lineNumber = 0, code = '', errorLocation = '') {
  errorCount++;
  const now = new Date();
  const timeStr = now.toLocaleTimeString();
  const dateStr = now.toLocaleDateString();
  
  const errorCode = 'ERR-' + String(errorCount).padStart(4, '0');
  
  errorLogs.push({
    code: errorCode,
    text: errorText,
    line: lineNumber,
    time: timeStr,
    date: dateStr
  });
  
  let report = '';
  
  if (lineNumber === 0) {
    report = `
======>Error log <output>
Error in line<0>
:1 ${errorText || 'code'}
:2 ${code || 'unknown'}
Error :Because '${errorText}' error in<${errorLocation || 'error location'}>:time:${timeStr}
Error :Correct code is '${code || 'unknown'}':you can input '/h@m?' to help you   
===========other information=>     <Al /! BC op[2:]>
Error time: ${timeStr}
Error date: ${dateStr}
<${dateStr}>
     <0>
           <----   >DonglaugOL 3.2.0<--2026.T
                  <${errorCount}>
                              <${errorCode}>
                              <${errorCode.replace('ERR', 'ERRT')}>
                              <${errorCode.replace('ERR', 'ERRL')}>
                                  <Other>
                                                 <Error lock ;2047>
              <====*====>                             
  <ctrl+f11+l/l+d+s+f12>
<log name>
`;
  } else {
    report = `
======>Error log <output>
Error in line<${lineNumber}>
:1 ${errorText || 'code'}
:2 ${code || 'fuck'}
Error :Because '${errorText}' error in<${errorLocation || 'error location'}>:time:${timeStr}
Error :Correct code is '${code || 'fuck'}':you can input '/h@m?' to help you   
===========other information=>     <Al /! BC op[2:]>
Error time: ${timeStr}
Error date: ${dateStr}
Error line: ${lineNumber}
<${dateStr}>
     <${lineNumber}>
           <----   >DonglaugOL 3.2.0<--2026.T
                  <${errorCount}>
                              <${errorCode}>
                              <${errorCode.replace('ERR', 'ERRT')}>
                              <${errorCode.replace('ERR', 'ERRL')}>
                                  <Other>
                                                 <Error lock ;2047>
              <====*====>                             
  <ctrl+f11+l/l+d+s+f12>
<log name>
`;
  }
  
  return report.trim();
}

function dolLog(text, cls = 'out') {
  const out = document.querySelector('.dol-output');
  if (!out) return;
  const div = document.createElement('div');
  div.className = 'line ' + cls + ' log-glow';
  div.style.whiteSpace = 'pre-wrap';
  setTimeout(() => div.classList.remove('log-glow'), 1500);
  
  if (cls === 'err') {
    div.textContent = createErrorReport(text);
    div.style.fontFamily = 'monospace';
    div.style.fontSize = '12px';
  } else {
    const parts = [];
    let lastIndex = 0;
    
    const regex = /(\/(.*?)\/)|(<(.*?)>)|(\[\[(.*?)\]\])|(\{\{(.*?)\}\})|(\(\((.*?)\)\))/g;
    let match;
    
    while ((match = regex.exec(text)) !== null) {
      if (match.index > lastIndex) {
        parts.push({ type: 'text', content: text.substring(lastIndex, match.index) });
      }
      if (match[1]) {
        parts.push({ type: 'red', content: match[2] });
      } else if (match[3]) {
        parts.push({ type: 'lightred', content: match[4] });
      } else if (match[5]) {
        parts.push({ type: 'marquee', content: match[6] });
      } else if (match[7]) {
        parts.push({ type: 'float', content: match[8] });
      } else if (match[9]) {
        parts.push({ type: 'rainbow', content: match[10] });
      }
      lastIndex = regex.lastIndex;
    }
    
    if (lastIndex < text.length) {
      parts.push({ type: 'text', content: text.substring(lastIndex) });
    }
    
    if (parts.length === 0) {
      div.textContent = text;
    } else {
      parts.forEach(part => {
        if (part.type === 'text') {
          const span = document.createElement('span');
          span.textContent = part.content;
          span.style.color = '#ffffff';
          div.appendChild(span);
        } else if (part.type === 'red') {
          const span = document.createElement('span');
          span.textContent = part.content;
          span.style.color = '#ff4d4d';
          span.style.fontWeight = 'bold';
          span.style.textShadow = '0 0 10px rgba(255,80,80,0.6)';
          div.appendChild(span);
        } else if (part.type === 'lightred') {
          const span = document.createElement('span');
          span.textContent = part.content;
          span.style.color = '#ff8888';
          span.style.textShadow = '0 0 8px rgba(255,130,130,0.4)';
          div.appendChild(span);
        } else if (part.type === 'marquee') {
          const span = document.createElement('span');
          span.className = 'log-marquee';
          span.textContent = '✦ ' + part.content + ' ✦';
          span.style.color = '#ffcc33';
          span.style.fontWeight = 'bold';
          span.style.textShadow = '0 0 12px rgba(255,200,50,0.6)';
          const wrap = document.createElement('div');
          wrap.style.overflow = 'hidden';
          wrap.appendChild(span);
          div.appendChild(wrap);
        } else if (part.type === 'float') {
          const span = document.createElement('span');
          span.className = 'log-float';
          span.textContent = part.content;
          span.style.display = 'inline-block';
          span.style.color = '#66e0ff';
          span.style.fontWeight = 'bold';
          span.style.textShadow = '0 0 10px rgba(100,220,255,0.5)';
          div.appendChild(span);
        } else if (part.type === 'rainbow') {
          const span = document.createElement('span');
          span.textContent = part.content;
          span.style.fontWeight = 'bold';
          span.style.background = 'linear-gradient(90deg,#ff6b6b,#ffd93d,#6bcb77,#4d96ff,#c780ff,#ff6b9d)';
          span.style.webkitBackgroundClip = 'text';
          span.style.webkitTextFillColor = 'transparent';
          span.style.backgroundClip = 'text';
          span.style.filter = 'drop-shadow(0 1px 2px rgba(0,0,0,0.5))';
          div.appendChild(span);
        }
      });
    }
  }
  
  out.appendChild(div);
  out.scrollTop = out.scrollHeight;
  allComponents.push(div);
}

function showErrorDialog(title, message, suggestion = '') {
  const win = createBaseWindow('❌ ' + title, 500, 320, 400, 250, false, true);
  
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '20px';
  content.style.fontFamily = 'monospace';
  content.style.fontSize = '14px';
  
  const errorHTML = `
    <div style="color:#ff4757;margin-bottom:15px;font-size:16px;font-weight:bold;">${escapeHtml(message)}</div>
    ${suggestion ? `<div style="color:#ffa502;margin-bottom:15px;padding-left:10px;border-left:3px solid #ffa502;">💡 ${escapeHtml(suggestion)}</div>` : ''}
    <div style="color:#7f8c8d;margin-top:20px;font-size:12px;">--- 错误详情 ---</div>
    <div style="color:#bdc3c7;margin-top:10px;white-space:pre-wrap;">${new Date().toLocaleString()}</div>
    <div style="margin-top:20px;">
      <button onclick="this.closest('.sys-window').remove();" style="padding:8px 24px;background:#e74c3c;color:white;border:none;border-radius:5px;cursor:pointer;">关闭</button>
      <button onclick="copyError('${escapeHtml(message)}');this.closest('.sys-window').remove();" style="padding:8px 24px;background:#3498db;color:white;border:none;border-radius:5px;cursor:pointer;margin-left:10px;">复制</button>
    </div>
  `;
  
  content.innerHTML = errorHTML;
  
  dolLog(`❌ ${title}: ${message}`, 'err');
  
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  function copyError(msg) {
    navigator.clipboard.writeText(msg).then(() => {
      dolLog(`✅ 错误信息已复制`, 'suc');
    });
  }
  
  return win;
}

window.onerror = function(message, source, lineno, colno, error) {
  const suggestion = getErrorSuggestion(message);
  showErrorDialog('运行时错误', message, suggestion);
  return true;
};

function getErrorSuggestion(message) {
  if (message.includes('is not defined')) {
    return '变量未定义，请检查拼写或确保变量已声明';
  } else if (message.includes('Cannot read')) {
    return '尝试访问空值属性，请检查对象是否存在';
  } else if (message.includes('Unexpected token')) {
    return '语法错误，请检查括号、引号是否配对';
  } else if (message.includes('Cannot set')) {
    return '无法设置属性，请检查对象是否可写';
  } else if (message.includes('Maximum call stack')) {
    return '递归调用过多，请检查是否有无限循环';
  } else if (message.includes('Invalid')) {
    return '无效参数，请检查参数类型和格式';
  } else if (message.includes('Not enough')) {
    return '参数不足，请检查函数调用';
  }
  return '请检查代码逻辑或查看控制台获取更多信息';
}

function getCommandSuggestion(cmd) {
  const suggestions = {
    '3d': ['/3d/open', 'draw.3d.init', 'draw.3d.cubeid<id>bs<大小>c<颜色>'],
    '2d': ['/2d/open<宽>*<高>', 'draw.2d.init', 'draw.2d.rectid<id>ip{x}*{y}bs<w>*<h>c<颜色>'],
    'vlc': ['/vlc/open', '/vlc/nad', '/vlc/embed<URL>'],
    'img': ['/img/open', '/img/preview<URL>', '/img/gallery'],
    'prt': ['/prt/open', '/prt/nad', '/prt/connect'],
    'wifi': ['/wifi/open', '/wifi/connect<SSID>'],
    'todo': ['/todo/add<内容>', '/todo/list', '/todo/window'],
    'json': ['/json/format<JSON>', '/json/minify<JSON>', '/json/validate<JSON>'],
    'h': ['/h@m?', '/help'],
    'help': ['/h@m?', '/help'],
    'exit': ['/exit', 'draw.close'],
    'close': ['/exit', 'draw.close'],
    'music': ['/vlc/open', '/vlc/nad'],
    'video': ['/vlc/open', '/vlc/nad'],
    'calc': ['/calc', '/sci'],
    'camera': ['/camera'],
    'clock': ['/clock'],
    'timer': ['/timer<秒数>'],
    'stopwatch': ['/stopwatch'],
    'alarm': ['/alarm<时间>'],
    'calendar': ['/calendar'],
    'weather': ['/weather<城市>'],
    'translate': ['/translate<文本>'],
    'paint': ['/paint'],
    'notepad': ['/notepad'],
    'screenshot': ['/screenshot'],
    'color': ['/color'],
    'glitch': ['/glitch'],
    'egg': ['/glitch', '/egg/glitch'],
    'system': ['/sys', '/sysinfo', '/taskmgr'],
    'network': ['/net', '/wifi/open'],
    'file': ['/file'],
    'device': ['/device'],
    'terminal': ['/terminal'],
    'easter': ['/glitch', '/egg/glitch'],
    'spin': ['draw.3d.spinid<id>sp<速度>'],
    'move': ['draw.3d.moveid<id>ip{x}*{y}*{z}sp<速度>'],
    'orbit': ['draw.3d.orbitid<id>ip{x}*{y}*{z}bs<半径>sp<速度>'],
    'bounce': ['draw.3d.bounceid<id>bs<高度>sp<速度>'],
    'pulse': ['draw.3d.pulseid<id>bs<缩放>sp<速度>'],
    'fade': ['draw.3d.fadeid<id>bs<透明度>sp<速度>'],
    'wave': ['draw.3d.waveid<id>bs<高度>sp<速度>'],
    'cube': ['draw.3d.cubeid<id>bs<大小>c<颜色>'],
    'sphere': ['draw.3d.sphereid<id>bs<半径>c<颜色>'],
    'pyramid': ['draw.3d.pyramidid<id>bs<大小>c<颜色>'],
    'particle': ['draw.3d.particleip{x}*{y}*{z}bs<数量>c<颜色>'],
    'text': ['draw.3d.textid<id>c<文字>ip{x}*{y}*{z}bs<大小>', 'draw.2d.textid<id>ip{x}*{y}c<颜色>'],
    'ground': ['draw.3d.groundid<id>bs<宽>*<高>c<颜色>'],
    'rect': ['draw.2d.rectid<id>ip{x}*{y}bs<w>*<h>c<颜色>'],
    'circle': ['draw.2d.circleid<id>ip{x}*{y}bs<半径>c<颜色>'],
    'click': ['draw.3d.clickid<id>c<动作>', 'draw.2d.clickid<id>c<动作>'],
    'import': ['=import & use<3T-CGraphics>%'],
    'graphic': ['=import & use<3T-CGraphics>%', 'draw.3d.init'],
  };
  
  for (const [keyword, cmds] of Object.entries(suggestions)) {
    if (cmd.toLowerCase().includes(keyword)) {
      return cmds;
    }
  }
  
  return [];
}
// 初代照片指令解析 完整保留
function parsePwlPhoto(cmd) {
  const reg = /^\.pwl\*\/(.+)=bsz<(\d+)>\*<(\d+)>ip<(\d+)>\*<(\d+)>cly<([yn])>$/;
  const match = cmd.trim().match(reg);
  if (!match) return false;
  const url = match[1];
  const w = match[2], h = match[3];
  const x = match[4], y = match[5];
  const round = match[6] === 'y';
  const img = document.createElement('img');
  img.src = url;
  img.style.position = 'absolute';
  img.style.left = x + 'px';
  img.style.top = y + 'px';
  img.style.width = w + 'px';
  img.style.height = h + 'px';
  img.style.objectFit = 'cover';
  if (round) img.style.borderRadius = '12px';
  document.body.appendChild(img);
  allComponents.push(img);
  dolLog('✅ 图片加载完成', 'suc');
  return true;
}
// 初代时间指令 完整保留
function parseTime(cmd) {
  if (cmd === 'time now') {
    dolLog('⏰ ' + new Date().toLocaleString(), 'time');
    return true;
  }
  return false;
}
// 初代开发者模式开关 完整保留
function parseDevOpen(cmd) {
  if (cmd === '/dol/developers>>>open') {
    devMode = true;
    const tag = document.createElement('div');
    tag.className = 'dev-mode-tag';
    tag.textContent = 'DEV MODE';
    document.body.appendChild(tag);
    allComponents.push(tag);
    dolLog('🔧 开发者模式已开启', 'stage');
    return true;
  }
  return false;
}
// 初代开发者指令 完整保留
function parseDevCmd(cmd) {
  if (!cmd.startsWith('   ')) return false;
  if (!devMode) {
    dolLog('❌ 请先开启开发者模式', 'err');
    return true;
  }
  
  // 移除缩进标记    
  const innerCmd = cmd.substring(3).trim();
  
  // inp.p<> - 输入指令
  const inpMatch = innerCmd.match(/^inp\.p<([^>]*)>$/);
  if (inpMatch) {
    const prompt = inpMatch[1] || '请输入:';
    const userInput = prompt(prompt);
    if (userInput !== null) {
      dolVars['input'] = userInput;
      dolLog(`📥 输入: ${userInput}`, 'info');
    }
    return true;
  }
  
  // pr*/ = 或    pr*/ = 或 pr*/<内容> - 输出打印
  const prMatch = innerCmd.match(/^pr\*/);
  if (prMatch) {
    let content = innerCmd.replace(/^pr\*/, '').trim();
    if (content === '=') {
      // pr*/ = 输出变量 input 的值
      content = dolVars['input'] !== undefined ? dolVars['input'] : '(空)';
    } else if (content.startsWith('/')) {
      // pr*/<内容>
      content = content.substring(1).trim();
    }
    dolLog(`📤 ${content}`, 'out');
    return true;
  }
  
  // out.p<> - 输出指令
  const outMatch = innerCmd.match(/^out\.p<([^>]*)>$/);
  if (outMatch) {
    const content = outMatch[1];
    dolLog(`📤 ${content}`, 'out');
    return true;
  }
  
  // 原有指令
  if (cmd === '    phoneinfo') {
    const ua = navigator.userAgent;
    const isHarmony = /HarmonyOS/.test(ua);
    const ver = isHarmony ? '鸿蒙' : /Android/.test(ua) ? '安卓' : '未知';
    dolLog('📱 系统：' + ver, 'time');
    return true;
  }
  
  if (cmd === '    cleancache') {
    dolLog('🧹 已清理界面缓存', 'suc');
    return true;
  }
  
  //    其他命令 - 直接执行
  if (innerCmd) {
    // 尝试解析为其他指令
    const result = parseLine(innerCmd);
    if (!result) {
      dolLog(`🔧 执行: ${innerCmd}`, 'info');
    }
    return true;
  }
  
  return false;
}
// 初代清理函数 兼容增强版
function clearAll() {
  // 修复：彻底释放所有视频流，防止黑屏
  document.querySelectorAll('video').forEach(video => {
    if (video.srcObject) {
      video.srcObject.getTracks().forEach(track => {
        track.stop();
        track.enabled = false;
      });
      video.srcObject = null;
    }
    video.removeAttribute('src');
    video.remove();
  });
  
  // 修复：彻底释放所有媒体流（摄像头/麦克风）
  dolStopAllStreams();
  
  // 修复：清理所有 setInterval 定时器
  dolClearAllIntervals();
  
  // 修复：清理所有 requestAnimationFrame 动画帧
  dolCancelAllAnimFrames();
  
  // 修复：重置背景样式，防止黑屏
  document.body.style.filter = 'none';
  document.body.style.background = '#2c3036';
  document.body.style.backgroundImage = 'none';
  document.body.style.color = '#e2e2e2';
  
  // 清理所有组件
  allComponents.forEach(el => {
    try {
      // 如果组件内部有 canvas/iframe/video，一并清理
      if (el && el.querySelectorAll) {
        el.querySelectorAll('canvas, iframe, video, audio').forEach(child => {
          try { child.remove(); } catch(e) {}
        });
      }
      el.remove();
    } catch (e) {
      console.warn('移除组件失败:', e);
    }
  });
  allComponents = [];
  
  // 清理所有定时器（setTimeout）
  timerList.forEach(t => clearTimeout(t));
  timerList = [];
  
  // 清理缓存
  sysWindowCache = {};
  sysSwitchCache = {};
  btnStateCache = {};
  funcWindowCache = {};
  
  // 清理特殊元素
  document.querySelector('.dev-mode-tag')?.remove();
  document.querySelector('.dev-debug-panel')?.remove();
  document.querySelector('.hacker-mode-tag')?.remove();
  document.querySelector('.fps-monitor')?.remove();
  document.querySelector('.watch-log-panel')?.remove();
  document.querySelector('.voice-indicator')?.remove();
  
  // 清理内联UI容器
  const inlineContainer = document.getElementById('inlineUIContainer');
  if (inlineContainer) inlineContainer.innerHTML = '';
  
  // 清理音频上下文
  if (dolMusicContext) {
    try { dolMusicContext.close(); } catch(e) {}
    dolMusicContext = null;
  }
  
  // 清理所有系统窗口
  document.querySelectorAll('.sys-window').forEach(w => {
    try { w.remove(); } catch(e) {}
  });
  
  // 清理弹窗遮罩
  document.querySelectorAll('.modal-overlay, .dol-modal').forEach(m => {
    try { m.remove(); } catch(e) {}
  });
  
  // 停止所有录音器
  try {
    if (typeof dolRecorder !== 'undefined' && dolRecorder.mediaRecorder) {
      if (dolRecorder.mediaRecorder.state !== 'inactive') dolRecorder.mediaRecorder.stop();
      dolRecorder.mediaRecorder = null;
      dolRecorder.isRecording = false;
    }
  } catch(e) {}
  try {
    if (typeof dolUfRecorder !== 'undefined' && dolUfRecorder.mediaRecorder) {
      if (dolUfRecorder.mediaRecorder.state !== 'inactive') dolUfRecorder.mediaRecorder.stop();
      dolUfRecorder.mediaRecorder = null;
      dolUfRecorder.isRecording = false;
    }
  } catch(e) {}
  try {
    if (typeof dolUfAudioRec !== 'undefined' && dolUfAudioRec.mediaRecorder) {
      if (dolUfAudioRec.mediaRecorder.state !== 'inactive') dolUfAudioRec.mediaRecorder.stop();
      dolUfAudioRec.mediaRecorder = null;
      dolUfAudioRec.isRecording = false;
    }
  } catch(e) {}
  
  // 停止循环队列
  dolLoopQueue = [];
  
  // 重置运行状态
  hackerMode = false;
  folderWatcherRunning = false;
  fpsMonitorRunning = false;
  voiceControlRunning = false;
  watchFolderHandle = null;
  folderWatchLog = [];
  fileIndexMap = {};
  
  // 停止俄罗斯方块
  if (typeof tetrisGame !== 'undefined' && tetrisGame) {
    try { tetrisGame.stop(); } catch(e) {}
    tetrisGame = null;
    const tc = document.getElementById('tetris-container');
    if (tc) tc.remove();
  }
  
  dolLog('✅ 已清理所有资源（含定时器、动画帧、媒体流）', 'suc');
}

// 修复：页面关闭/切换时自动释放所有媒体资源，防止权限锁死
window.addEventListener('beforeunload', () => {
  dolStopAllStreams();
  dolClearAllIntervals();
  dolCancelAllAnimFrames();
  // 停止所有录音器
  try {
    if (typeof dolRecorder !== 'undefined' && dolRecorder.mediaRecorder && dolRecorder.mediaRecorder.state !== 'inactive') dolRecorder.mediaRecorder.stop();
    if (typeof dolUfRecorder !== 'undefined' && dolUfRecorder.mediaRecorder && dolUfRecorder.mediaRecorder.state !== 'inactive') dolUfRecorder.mediaRecorder.stop();
    if (typeof dolUfAudioRec !== 'undefined' && dolUfAudioRec.mediaRecorder && dolUfAudioRec.mediaRecorder.state !== 'inactive') dolUfAudioRec.mediaRecorder.stop();
  } catch(e) {}
});

// 修复：手机切换标签页时暂停动画，减少电量消耗
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    // 页面不可见时，暂停所有动画帧（不清理，恢复时可以继续）
    dolAnimFrames.forEach(id => cancelAnimationFrame(id));
  }
});

// ==================================================
// ========== 【新增：自定义后缀保存函数 其他代码无修改】 ==========
// ==================================================
function saveCustomFile(suffix) {
  // 过滤非法后缀名字符，保证文件安全
  const safeSuffix = suffix.replace(/[<>:"/\\|?*]/g, '').trim();
  const finalSuffix = safeSuffix || 'dolwrt';
  const blob = new Blob([codeInput.value], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `donglaugol_code.${finalSuffix}`;
  a.click();
  URL.revokeObjectURL(url);
  dolLog(`✅ 文件已保存为 donglaugol_code.${finalSuffix}`, 'suc');
}
// 新增：自定义保存指令解析函数
function parseSaveCustomCmd(cmd) {
  const reg = /^save<(.+)>$/;
  const match = cmd.trim().match(reg);
  if (!match) return false;
  const suffix = match[1];
  saveCustomFile(suffix);
  return true;
}
// ==================================================
// ========== 【开发者版本增强函数 完整追加 全兼容】 ==========
// ==================================================
function dolCalc(expr) {
  try {
    let s = expr;
    for(let k in dolVars) s = s.replaceAll(k, dolVars[k]);
    for(let k in dolArrs) {
      for(let idx in dolArrs[k]) s = s.replaceAll(`${k}[${idx}]`, dolArrs[k][idx]);
    }
    s = s.replaceAll('$input', `"${dolUserInputValue}"`);
    
    // 修复：安全处理可能导致正则表达式错误的内容
    // 将所有类似正则表达式的内容转换为字符串，避免无效标志错误
    s = s.replace(/\/([^\/]+)\/([^\/]*)$/g, (match, pattern, flags) => {
      // 只有当标志是有效正则表达式标志时才保留
      if (/^[gimsuy]*$/.test(flags) && flags.length <= 6) {
        return match;
      }
      // 否则转换为字符串
      return `"${match}"`;
    });
    
    const sandbox = {
      dolVars, dolArrs, dolUserInputValue,
      Math, parseInt, parseFloat, isNaN, isFinite
    };
    const forbiddenKeys = ['window', 'document', 'parent', 'top', 'location', 'fetch', 'XMLHttpRequest', 'eval', 'Function'];
    forbiddenKeys.forEach(key => s = s.replaceAll(key, 'null'));
    
    // 额外的安全检查：确保表达式不会导致安全问题
    if (s.includes('new RegExp')) {
      dolLog('❌ 不允许使用 new RegExp', 'err');
      return null;
    }
    
    return Function(...Object.keys(sandbox), '"use strict";return (' + s + ')')(...Object.values(sandbox));
  } catch(e) {
    dolLog(`计算错误: ${e.message}`, 'err');
    return null;
  }
}
function parseDolUserInput(cmd) {
  const reg = /^\/dol\/input<(\d+)>(ok\.output\.in<(\w+)>)?$/;
  const match = cmd.match(reg);
  if (!match) return false;
  const height = match[1] || 70;
  const connectOutput = match[3] || null;
  const userInput = document.createElement('textarea');
  userInput.className = 'dol-user-input';
  userInput.style.height = `${height}px`;
  userInput.placeholder = '请输入内容，按回车确认';
  if (connectOutput) {
    userInput.dataset.connectOutput = connectOutput;
  }
  userInput.addEventListener('focus', () => {
    dolUserInputValue = userInput.value.trim();
  });
  userInput.addEventListener('input', (e) => {
    dolUserInputValue = e.target.value.trim();
    if (connectOutput) {
      const outputElements = document.querySelectorAll('.dol-output-box');
      outputElements.forEach(el => {
        if (el.dataset.name === connectOutput || connectOutput === 'output') {
          el.textContent = dolUserInputValue;
        }
      });
    }
  });
  userInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      dolUserInputValue = userInput.value.trim();
      dolLog(`[你输入]：${dolUserInputValue}`, 'input');
    }
  });
  document.body.appendChild(userInput);
  allComponents.push(userInput);
  return true;
}

// ==================================================
// ========== 【新增：/dol/ 工具指令组】 ==========
// ==================================================
// /dol/copy.output<高度>   输出可一键复制框
// /dol/delete.input<高度>  输入修改删除（可拖拽文件有保存键）
// /dol/save.input<高度>    输入后保存
// /dol/save.output<高度>   保存输出的文字

function parseDolToolCmd(cmd) {
  const line = cmd.trim();

  // /dol/copy.output<高度> - 输出可一键复制框
  const copyMatch = line.match(/^\/dol\/copy\.output(?:<(\d+)>)?$/);
  if (copyMatch) {
    const height = parseInt(copyMatch[1]) || 150;
    const wrapper = document.createElement('div');
    wrapper.style.cssText = `
      width:100%;margin-bottom:10px;border:1px solid rgba(255,255,255,0.1);border-radius:12px;
      background:rgba(30,33,38,0.7);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px);
      overflow:hidden;
    `;
    // 按钮栏
    const btnBar = document.createElement('div');
    btnBar.style.cssText = `
      display:flex;gap:6px;padding:6px 8px;background:rgba(0,0,0,0.2);
      border-bottom:1px solid rgba(255,255,255,0.05);
    `;
    const copyBtn = document.createElement('button');
    copyBtn.textContent = '📋 复制';
    copyBtn.style.cssText = `
      padding:4px 14px;font-size:13px;border-radius:9999px;border:1px solid rgba(255,255,255,0.15);
      background:linear-gradient(180deg,rgba(100,180,255,0.5),rgba(60,140,220,0.4));
      color:#fff;cursor:pointer;font-family:monospace;
    `;
    copyBtn.onclick = () => {
      const text = outputBox.value;
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = '✅ 已复制';
          setTimeout(() => copyBtn.textContent = '📋 复制', 1500);
          playSound('success');
        }).catch(() => {
          outputBox.select();
          document.execCommand('copy');
          copyBtn.textContent = '✅ 已复制';
          setTimeout(() => copyBtn.textContent = '📋 复制', 1500);
        });
      }
    };
    const clearBtn = document.createElement('button');
    clearBtn.textContent = '🗑️ 清空';
    clearBtn.style.cssText = `
      padding:4px 14px;font-size:13px;border-radius:9999px;border:1px solid rgba(255,255,255,0.15);
      background:linear-gradient(180deg,rgba(255,100,100,0.4),rgba(200,60,60,0.3));
      color:#fff;cursor:pointer;font-family:monospace;
    `;
    clearBtn.onclick = () => { outputBox.value = ''; playSound('click'); };
    btnBar.appendChild(copyBtn);
    btnBar.appendChild(clearBtn);
    // 输出区域
    const outputBox = document.createElement('textarea');
    outputBox.readOnly = true;
    outputBox.style.cssText = `
      width:100%;height:${height}px;background:transparent;color:#a8b9a8;
      padding:10px 12px;border:none;outline:none;resize:none;font-size:14px;
      font-family:monospace;line-height:1.5;
    `;
    outputBox.placeholder = '运行结果将显示在这里...';
    // 劫持 dolLog 来捕获输出
    const origLog = window.dolLog;
    let captureCount = 0;
    const captureLines = [];
    const origAppendChild = wrapper.appendChild.bind(wrapper);
    // 使用一个简单方式：监听输出区域变化
    wrapper.appendChild(btnBar);
    wrapper.appendChild(outputBox);
    document.body.appendChild(wrapper);
    allComponents.push(wrapper);

    // 持续将 dolOutput 的最新内容同步到复制框
    const syncInterval = setInterval(() => {
      const outEl = document.querySelector('.dol-output');
      if (outEl) {
        const text = outEl.innerText || outEl.textContent;
        if (text !== outputBox.value) {
          outputBox.value = text;
          outputBox.scrollTop = outputBox.scrollHeight;
        }
      }
    }, 500);
    wrapper._syncInterval = syncInterval;

    dolLog('📋 复制输出框已创建', 'suc');
