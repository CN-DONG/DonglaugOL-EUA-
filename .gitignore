    if (customLabel) { html += '<div style="color:#333;font-size:14px;margin-bottom:6px;font-weight:500;">' + escapeHtml(customLabel) + '</div>'; }
    html += '<select id="' + uid + '" style="width:100%;height:56px;padding:0 18px;border:none;border-radius:8px;font-size:16px;color:#222;background:linear-gradient(160deg,#fff,#e9ecf2);cursor:pointer;">';
    html += '<option>紧急</option><option>高</option><option>中</option><option>低</option><option>空闲</option></select></div>';
    showInlineUI(html);
    var priEl = document.getElementById(uid);
    if (priEl) priEl.addEventListener('change', function() { const act = window.__nsCustomAction || '优先级'; dolLog(act + ': ' + this.value, 'suc'); });
    dolLog('优先级选择框已创建' + (customLabel ? ' (' + customLabel + ')' : ''), 'suc');
    return true;
  }
  
  // /ns/unit 单位选择框
  if (line === '/ns/unit' || line.startsWith('/ns/unit<')) {
    const labelMatch = line.match(/^\/ns\/unit(?:<([^>]+)>)?$/);
    const customLabel = labelMatch && labelMatch[1] ? labelMatch[1] : (window.__nsCustomText || '');
    const uid = 'nsuni' + Date.now();
