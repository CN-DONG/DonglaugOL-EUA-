    if (parseNcNewCmd(line)) return;
    if (parseNhCmd(line)) return;
    if (parseNsSwitchCmd(line)) return;
    if (parseNsCmd(line)) return;
    if (parseRaCmd(line)) return;
    if (parseUnCmd(line)) return;
    if (parseNpPageCmd(line)) return;
    // ========== 运行绑定指令 ==========
    if (parseBindKeyCmd(line)) return;
    if (parseBindVarCmd(line)) return;
    if (parseRunBindCmd(line)) return;
    if (parseRunVarCmd(line)) return;
    // ========== AI/编程语言玩具指令 ==========
    if (parseAIChatCmd(line)) return;
    if (parseToyLangCmd(line)) return;
    if (parseToyCalcCmd(line)) return;
    if (parseToySnippetCmd(line)) return;
    if (parseToyAdventureCmd(line)) return;
    // ========== 原有代码完全不变 ==========
    if (parseDevOpen(line)) return;
    if (parseDevCmd(line)) return;
    if (parsePwlPhoto(line)) return;
    if (parseTime(line)) return;
    if (line.startsWith('/nb/bs<')) parseCreateBtn(line);
    else if (line.startsWith('/nb/color')) parseBtnColor(line);
    else if (line.startsWith('/nb/do.say<')) parseBtnSay(line);
    else if (line.startsWith('/nb/do.web<')) parseBtnWeb(line);
    else if (line.startsWith('/nb/do.print<')) parseBtnPrint(line);
    else if (line.startsWith('/nb/do.music<')) parseBtnMusic(line);
    else if (line.startsWith('/nb/do.draw<')) parseBtnDraw(line);
    else if (line.startsWith('/iu/')) parseInput(line);
    else if (line.startsWith('/lpf/')) parseLpf(line);
    else if (line.startsWith('/wo/')) {
      if (!parseWeb(line)) parseWoSingleLine(line);
    }
    else if (line.startsWith('/ow/')) parseDolWindow(line);
    else if (line.startsWith('/uc/color')) parsePageBg(line);
    else if (line.startsWith('/nad/btn')) parseSysSquareBtn(line);
    else if (line.startsWith('/nad/win')) parseSysWindow(line);
    else if (line.startsWith('/nad/browser')) parseNadBrowser(line);
    else if (line.startsWith('/nad/table')) parseNadTable(line);
    else if (line.startsWith('/nad/text')) parseNadText(line);
    else if (line.startsWith('/nad/page')) parseNadPage(line);
    else if (line.startsWith('/nad/form')) parseNadForm(line);
    else if (line.startsWith('/nad/list')) parseNadList(line);
    else if (line.startsWith('/nad/tree')) parseNadTree(line);
    else if (line.startsWith('/dol/input')) parseDolUserInput(line);
    else if (line.startsWith('/dol/output')) parseDolOutput(line);
    else if (line.startsWith('/dol/light')) parseDolLight(line);
    else if (line.startsWith('/dol/canvas')) parseDolCanvas(line);
    else if (line.startsWith('/dol/copy.output') || line.startsWith('/dol/delete.input') || line.startsWith('/dol/save.input') || line.startsWith('/dol/save.output') || line.startsWith('/dol/asl')) parseDolToolCmd(line);
    else if (line.startsWith('@m<')) parseDolCondition(line);
    else if (line.startsWith('ut[')) parseDolUt(line);
    else if (line.startsWith('pr.c*/')) parseDolPrintColor(line);
    else if (line.startsWith('pr.z*/')) parseDolPrintSize(line);
    else if (line.startsWith('pr.o*/')) parseDolPrintMultiLine(line);
    else if (line.startsWith('/egg/')) parseDolEgg(line);
    else if (line.startsWith('/dol/developers>>>open')) parseDolDevMode(line);
    else if (line.startsWith('/dol/members>>>open')) parseDolMembersMode(line);
    else if (line.startsWith('/dol/oc.bnc')) {
      if (line.includes('.on')) toggleSidebar(true);
      else if (line.includes('.off')) toggleSidebar(false);
      else toggleSidebar();
    }
    else if (line.startsWith('   /')) parseDevCommand(line);
    // ========== 新增：独立缩进格式    <内容> 直接输出 ==========
    else if (line.startsWith('   <')) {
      const match = line.match(/^-\+-<([^>]+)>/);
      if (match) {
        dolLog(match[1], 'out');
        return;  // 新增：确保处理后返回，不再继续执行
      }
    }
    else if (parseLightEffect(line)) {}
    else if (parseExtraCmd(line)) {}
    else if (line.startsWith('new@dol.di')) {
      parseDolVar(line);
      return;
    }
    else if (line.startsWith('/nsrp/bs')) {
      if (!parseNsrpLinkAd(line)) parseNsrpTextAd(line);
      return;
    }
    else if (line.startsWith('pr*/') || line.startsWith('pt<')) {
      parseDolPrint(line);
      return;
    }
    else if (line.startsWith('/ig/line ')) {
      parseDolLightColor(line);
      return;
    }
    else if (line.startsWith('/ig/draw#draw') || line.startsWith('dr-gt') || line.startsWith('dr-sp ') || line.startsWith('/dr/,')) {
      parseDolDraw(line);
      return;
    }
    else if (line.startsWith('music')) {
      parseDolMusic(line);
      return;
    }
    else if (line.startsWith('loop')) {
      parseDolLoop(line);
      return;
    }
    else if (line.startsWith('time')) {
      parseTimeCommand(line);
      return;
    }
    else if (!parseDolVar(line)) {
      dolLog(`❌ 未知指令: ${line}`, 'err');
    }
  });
  enableSearchBox();
}
// ==================================================
// ========== 【核心修改：新run函数，实现新窗口运行】 ==========
// ==================================================
function run() {
  playSound('click');
  const newWindow = window.open('about:blank', '_blank', 'width=1200,height=800');
  if (!newWindow) {
    alert('浏览器阻止了弹窗，请允许弹窗后重试！');
    return;
  }
  // 获取当前完整的HTML文档内容
  let fullHTML = document.documentElement.outerHTML;
  // 替换codeInput值为当前编辑的代码
  const currentCode = codeInput.value;
  const newHTML = fullHTML.replace(
    /<textarea id="codeInput"([\s\S]*?)><\/textarea>/,
    `<textarea id="codeInput"$1>${currentCode.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>`
  );
  // 写入新窗口文档（不做正则替换，避免破坏HTML结构）
  newWindow.document.open();
  newWindow.document.write(newHTML);
  newWindow.document.close();
  // 等待脚本加载完成后执行
  setTimeout(function() {
    try {
      // 用 DOM 操作移除不需要的元素（比正则更安全）
      const sidebar = newWindow.document.getElementById('appSidebar');
      if (sidebar) sidebar.remove();
      const floatBtn = newWindow.document.getElementById('sidebarFloatingBtn');
      if (floatBtn) floatBtn.remove();
      const noiseLayer = newWindow.document.querySelector('.noise-layer');
      if (noiseLayer) noiseLayer.remove();
      // 移除按钮行
      const btns = newWindow.document.querySelectorAll('.re-run-btn, .file-btn, .settings-btn');
      btns.forEach(b => b.parentElement?.remove());
      // 移除底部固定元素
      newWindow.document.querySelectorAll('[style*="position:fixed"]').forEach(el => {
        const id = el.id || '';
        // 保留日志窗口和锁屏
        if (id === 'dolLogContainer' || id === 'lockScreen') return;
        el.remove();
      });
      // 移除所有编辑控件
      const editorSkeuomorph = newWindow.document.getElementById('editorSkeuomorph');
      if (editorSkeuomorph) editorSkeuomorph.remove();
      // 隐藏代码输入容器
      const codeContainer = newWindow.document.getElementById('codeInput-container');
      if (codeContainer) codeContainer.style.display = 'none';
      newWindow.document.querySelectorAll('.editor-shimmer').forEach(el => el.remove());

      if (typeof newWindow.originalRun === 'function') {
        newWindow.originalRun();
      } else {
        // originalRun 还没加载，再等一会
        setTimeout(function() {
          if (typeof newWindow.originalRun === 'function') {
            newWindow.originalRun();
          }
        }, 500);
      }
    } catch (e) {
      console.error('运行失败:', e);
      newWindow.document.body.innerHTML = '<pre style="color:red;padding:20px;">运行错误: ' + e.message + '</pre>';
    }
  }, 600);
}
// ==================================================
// ========== 【重置函数 双版本兼容合并 100%保留】 ==========
// ==================================================
function reRun() {
  codeInput.classList.remove('hide');
  // ========== 新增：显示左上角4个按钮 ==========
  document.querySelectorAll('button').forEach(btn => {
    btn.classList.remove('hide');
  });
  clearAll();
  codeInput.value = '';
  const highlightEl = document.getElementById('codeInput-highlight');
  if (highlightEl) highlightEl.innerHTML = '';
  const lineNumbersEl = document.getElementById('codeInput-line-numbers');
  if (lineNumbersEl) lineNumbersEl.innerHTML = '';
  document.body.style.background = '#2c3036';
  document.body.style.backgroundImage = 'none';
  document.body.classList.remove('light-mode');
  document.body.style.fontSize = '14px';
  currentBtn = null;
  btnDefaultColor = '#5a7ca3';
  dolVars = {};
  dolArrs = {};
  dolLastVal = 0;
  dolLoopQueue = [];
  dolIsDrawing = false;
  dolBrushSize = 2;
  dolMusicTone = 4;
  dolMusicDuration = 500;
  dolUserInputValue = '';
  devMode = false;
  debugMode = false;
  if (dolMusicContext) {
    dolMusicContext.close();
    dolMusicContext = null;
  }
}

let loadingOverlay = null;
let dinoGame = null;
let performanceMonitor = null;

function showLoadingOverlay(text = '加载中...') {
  if (loadingOverlay) loadingOverlay.remove();
  
  loadingOverlay = document.createElement('div');
  loadingOverlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);display:flex;flex-direction:column;justify-content:center;align-items:center;z-index:9999;';
  
  const spinner = document.createElement('div');
  spinner.style.cssText = 'width:50px;height:50px;border:4px solid #333;border-top-color:#5a9cf0;border-radius:50%;animation:spin 1s linear infinite;';
  
  const label = document.createElement('div');
  label.style.cssText = 'margin-top:20px;color:#5a9cf0;font-size:18px;font-weight:bold;';
  label.textContent = text;
  
  loadingOverlay.appendChild(spinner);
  loadingOverlay.appendChild(label);
  document.body.appendChild(loadingOverlay);
}

function hideLoadingOverlay() {
  if (loadingOverlay) {
    loadingOverlay.remove();
    loadingOverlay = null;
  }
}

function startDinoGame() {
  if (dinoGame) dinoGame.remove();
  
  dinoGame = document.createElement('div');
  dinoGame.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:#2c3036;display:flex;flex-direction:column;justify-content:center;align-items:center;z-index:9999;';
  
  const canvas = document.createElement('canvas');
  canvas.width = 800;
  canvas.height = 200;
  canvas.style.border = '2px solid #333';
  canvas.style.background = '#2c3036';
  
  const ctx = canvas.getContext('2d');
  let dinoY = 120, dinoVy = 0, dinoJumping = false;
  let cactusX = 750, cactusWidth = 30, cactusHeight = 60;
  let groundY = 160;
  let score = 0;
  let gameSpeed = 5;
  
  function drawDino() {
    ctx.fillStyle = '#fff';
    ctx.fillRect(50, dinoY, 40, 40);
    ctx.fillRect(45, dinoY + 30, 10, 10);
    ctx.fillRect(85, dinoY + 30, 10, 10);
    ctx.fillStyle = '#ff6b6b';
    ctx.fillRect(55, dinoY + 10, 8, 8);
    ctx.fillRect(72, dinoY + 10, 8, 8);
  }
  
  function drawCactus() {
    ctx.fillStyle = '#5a9cf0';
    ctx.fillRect(cactusX, groundY - cactusHeight, cactusWidth, cactusHeight);
  }
  
  function drawGround() {
    ctx.fillStyle = '#333';
    ctx.fillRect(0, groundY, canvas.width, 40);
  }
  
  function drawScore() {
    ctx.fillStyle = '#fff';
    ctx.font = '20px monospace';
    ctx.fillText(`分数: ${score}`, 10, 30);
  }
  
  function gameLoop() {
    if (!dinoGame) return;
    
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    drawGround();
    drawDino();
    drawCactus();
    drawScore();
    
    if (dinoJumping) {
      dinoVy += 1;
      dinoY += dinoVy;
      if (dinoY >= 120) {
        dinoY = 120;
        dinoJumping = false;
        dinoVy = 0;
      }
    }
    
    cactusX -= gameSpeed;
    if (cactusX < -50) {
      cactusX = 800;
      cactusWidth = 20 + Math.random() * 20;
      cactusHeight = 40 + Math.random() * 30;
      score++;
      if (score % 5 === 0) gameSpeed += 0.5;
    }
    
    if (50 + 40 > cactusX && 50 < cactusX + cactusWidth && dinoY + 40 > groundY - cactusHeight) {
      ctx.fillStyle = '#ff0000';
      ctx.font = '40px monospace';
      ctx.fillText('游戏结束!', canvas.width / 2 - 100, groundY - 80);
      return;
    }
    
    requestAnimationFrame(gameLoop);
  }
  
  function jump() {
    if (!dinoJumping) {
      dinoVy = -12;
      dinoJumping = true;
    }
  }
  
  canvas.addEventListener('click', jump);
  dinoGame.addEventListener('keydown', (e) => { if (e.code === 'Space') jump(); });
  
  dinoGame.appendChild(canvas);
  document.body.appendChild(dinoGame);
  
  const title = document.createElement('div');
  title.style.cssText = 'margin-top:10px;color:#ff6b6b;font-size:14px;';
  title.textContent = '💀 页面卡住了！点击屏幕或按空格键跳跃';
  dinoGame.appendChild(title);
  
  gameLoop();
}

function startPerformanceMonitor() {
  if (performanceMonitor) clearInterval(performanceMonitor);
  
  let lastTime = performance.now();
  let frameCount = 0;
  let freezeCount = 0;
  
  performanceMonitor = setInterval(() => {
    const now = performance.now();
    const delta = now - lastTime;
    
    if (delta > 500) {
      freezeCount++;
      if (freezeCount >= 2) {
        startDinoGame();
        clearInterval(performanceMonitor);
      }
    } else {
      freezeCount = 0;
    }
    
    frameCount++;
    lastTime = now;
  }, 100);
}

function stopPerformanceMonitor() {
  if (performanceMonitor) {
    clearInterval(performanceMonitor);
    performanceMonitor = null;
  }
}

function parseNadBrowser(line) {
  const w = parseInt(line.match(/\/nad\/browser<(\d+)\*(\d+)>/)?.[1] || '800');
  const h = parseInt(line.match(/\/nad\/browser<(\d+)\*(\d+)>/)?.[2] || '500');
  const x = parseInt(line.match(/ip\{(\d+)\}/)?.[1] || '100');
  const y = parseInt(line.match(/ip\{\d+\}\*\{(\d+)\}/)?.[1] || '50');
  const title = line.match(/@\s*(.+)/)?.[1] || '浏览器';
  const win = createBaseWindow(title, w, h, x, y, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '0';
  content.style.overflow = 'hidden';
  content.innerHTML = '<iframe src="https://www.baidu.com" style="width:100%;height:100%;border:none;"></iframe>';
  dolLog(`✅ 创建浏览器窗口: ${title}`, 'suc');
}

function parseNadTable(line) {
  const rows = parseInt(line.match(/\/nad\/table<(\d+)\*(\d+)>/)?.[1] || '5');
  const cols = parseInt(line.match(/\/nad\/table<(\d+)\*(\d+)>/)?.[2] || '4');
  const x = parseInt(line.match(/ip\{(\d+)\}/)?.[1] || '100');
  const y = parseInt(line.match(/ip\{\d+\}\*\{(\d+)\}/)?.[1] || '50');
  const title = line.match(/@\s*(.+)/)?.[1] || '数据表';
  const win = createBaseWindow(title, 600, 400, x, y, false, true);
  const content = win.querySelector('.sys-win-content');
  content.style.padding = '10px';
  let html = '<table style="width:100%;border-collapse:collapse;">';
  for (let i = 0; i < rows; i++) {
    html += '<tr>';
    for (let j = 0; j < cols; j++) {
      html += `<td style="border:1px solid #333;padding:8px;text-align:center;background:#1a1a24;color:#fff;">${i + 1}-${j + 1}</td>`;
    }
    html += '</tr>';
  }
  html += '</table>';
  content.innerHTML = html;
  dolLog(`✅ 创建表格窗口: ${title} (${rows}行${cols}列)`, 'suc');
}

function parseNadText(line) {
  const w = parseInt(line.match(/\/nad\/text<(\d+)\*(\d+)>/)?.[1] || '600');
  const h = parseInt(line.match(/\/nad\/text<(\d+)\*(\d+)>/)?.[2] || '400');
