// 工业报警等级
const alarmLevels = {
  info: { color: '#00ff00', icon: 'ℹ️', name: '信息' },
  warning: { color: '#ffff00', icon: '⚠️', name: '警告' },
  critical: { color: '#ff0000', icon: '🚨', name: '严重' },
  emergency: { color: '#ff00ff', icon: '🆘', name: '紧急' }
};

// PLC模拟系统
const plcSystem = {
  running: false,
  scanTime: 100,
  inputs: new Array(16).fill(false),
  outputs: new Array(16).fill(false),
  timers: {},
  counters: {},
  program: []
};

function plcScan() {
  if (!plcSystem.running) return;
  
  // 执行PLC程序
  plcSystem.program.forEach(instruction => {
    switch(instruction.type) {
      case 'LD': // Load
        plcSystem.acc = plcSystem.inputs[instruction.addr];
        break;
      case 'LDN': // Load Not
        plcSystem.acc = !plcSystem.inputs[instruction.addr];
        break;
      case 'AND':
        plcSystem.acc = plcSystem.acc && plcSystem.inputs[instruction.addr];
        break;
      case 'OR':
        plcSystem.acc = plcSystem.acc || plcSystem.inputs[instruction.addr];
        break;
      case 'OUT':
        plcSystem.outputs[instruction.addr] = plcSystem.acc;
        break;
      case 'TON': // Timer On Delay
        if (!plcSystem.timers[instruction.name]) {
          plcSystem.timers[instruction.name] = { acc: 0, preset: instruction.preset, done: false };
        }
        if (plcSystem.acc) {
          plcSystem.timers[instruction.name].acc += plcSystem.scanTime;
          if (plcSystem.timers[instruction.name].acc >= plcSystem.timers[instruction.name].preset) {
            plcSystem.timers[instruction.name].done = true;
          }
        } else {
          plcSystem.timers[instruction.name].acc = 0;
          plcSystem.timers[instruction.name].done = false;
        }
        break;
      case 'CTU': // Counter Up
        if (!plcSystem.counters[instruction.name]) {
          plcSystem.counters[instruction.name] = { acc: 0, preset: instruction.preset, done: false };
        }
        if (plcSystem.acc) {
          plcSystem.counters[instruction.name].acc++;
          if (plcSystem.counters[instruction.name].acc >= plcSystem.counters[instruction.name].preset) {
            plcSystem.counters[instruction.name].done = true;
          }
        }
        break;
    }
  });
}

let plcInterval = null;

// 工业数据采集系统
const dataAcquisition = {
  enabled: false,
  points: [],
  history: {},
  samplingRate: 1000
};

function collectData() {
  if (!dataAcquisition.enabled) return;
  
  const timestamp = Date.now();
  dataAcquisition.points.forEach(point => {
    const sensor = industrialSystem.sensors[point.sensorId];
    if (sensor) {
      if (!dataAcquisition.history[point.sensorId]) {
        dataAcquisition.history[point.sensorId] = [];
      }
      dataAcquisition.history[point.sensorId].push({
        timestamp,
        value: sensor.value,
        quality: 'good'
      });
      // 保留最近1000个数据点
      if (dataAcquisition.history[point.sensorId].length > 1000) {
        dataAcquisition.history[point.sensorId].shift();
      }
    }
  });
}

let dataAcqInterval = null;

// ==================================================
// ========== 【重工业控制系统指令扩展】 ==========
// ==================================================
// PLC控制指令
// /ic/plc/start              启动PLC
// /ic/plc/stop               停止PLC
// /ic/plc/input<地址><值>    设置输入
// /ic/plc/output<地址>       读取输出
// /ic/plc/program            查看程序
// /ic/plc/clear              清除程序
// 
// 重型机械指令
// /ic/machinery/list         列出所有重型机械
// /ic/machinery<设备>start   启动重型机械
// /ic/machinery<设备>stop    停止重型机械
// /ic/machinery<设备>status  查看设备状态
// 
// 工业流程指令
// /ic/process/list           列出可用流程
// /ic/process<流程>start     启动流程
// /ic/process<流程>stop      停止流程
// /ic/process<流程>status    查看流程状态
// 
// 数据采集指令
// /ic/dac/start              启动数据采集
// /ic/dac/stop               停止数据采集
// /ic/dac/add<传感器>        添加采集点
// /ic/dac/remove<传感器>     移除采集点
// /ic/dac/history<传感器>    查看历史数据
// 
// 能源管理指令
// /ic/energy/status          查看能源状态
// /ic/energy/consumption     查看能耗统计
// /ic/energy/optimize        优化能源使用
// 
// 安全监控指令
// /ic/safety/status          查看安全状态
// /ic/safety/inspect         安全巡检
// /ic/safety/alarm           触发安全警报

// 扩展工业控制系统功能
function parseIndustrialCmd(cmd) {
  const line = cmd.trim();
  
  // ========== 基础系统控制 ==========
  
  // 启动工业控制系统
  if (line === '/ic/start') {
    if (industrialSystem.running) {
      dolLog('❌ 工业控制系统已在运行', 'err');
      return true;
    }
    initIndustrialSystem();
    industrialSystem.running = true;
    industrialInterval = setInterval(() => {
      updateSensors();
      updateProductionLines();
    }, industrialSystem.config.refreshInterval);
    logIndustrial('工业控制系统启动');
    dolLog('🏭 工业控制系统已启动', 'suc');
    return true;
  }
  
  // 停止工业控制系统
  if (line === '/ic/stop') {
    if (!industrialSystem.running) {
      dolLog('❌ 工业控制系统未运行', 'err');
      return true;
    }
    clearInterval(industrialInterval);
    clearInterval(plcInterval);
    clearInterval(dataAcqInterval);
    industrialSystem.running = false;
    plcSystem.running = false;
    dataAcquisition.enabled = false;
    Object.values(industrialSystem.machines).forEach(m => m.status = 'idle');
    logIndustrial('工业控制系统停止');
    dolLog('🛑 工业控制系统已停止', 'suc');
    return true;
  }
  
  // 查看系统状态
  if (line === '/ic/status') {
    const status = industrialSystem.running ? '运行中' : '已停止';
    const activeMachines = Object.values(industrialSystem.machines).filter(m => m.status === 'running').length;
    const totalMachines = Object.keys(industrialSystem.machines).length;
    const activeLines = Object.values(industrialSystem.productionLines).filter(l => l.status === 'running').length;
    const totalLines = Object.keys(industrialSystem.productionLines).length;
    const alarmCount = industrialSystem.alarms.filter(a => !a.acknowledged).length;
    
    dolLog(`🏭 工业控制系统状态: ${status}`, 'info');
    dolLog(`  ├─ 生产线: ${activeLines}/${totalLines} 运行中`, 'info');
    dolLog(`  ├─ 设备: ${activeMachines}/${totalMachines} 运行中`, 'info');
    dolLog(`  ├─ PLC: ${plcSystem.running ? '运行中' : '已停止'}`, 'info');
    dolLog(`  ├─ 数据采集: ${dataAcquisition.enabled ? '启用' : '停用'}`, 'info');
    dolLog(`  └─ 未确认警报: ${alarmCount} 个`, alarmCount > 0 ? 'err' : 'info');
    return true;
  }
  
  // ========== PLC控制系统 ==========
  
  // 启动PLC
  if (line === '/ic/plc/start') {
    if (plcSystem.running) {
      dolLog('❌ PLC已在运行', 'err');
      return true;
    }
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    plcSystem.running = true;
    plcInterval = setInterval(plcScan, plcSystem.scanTime);
    dolLog('⚙️ PLC系统已启动', 'suc');
    return true;
  }
  
  // 停止PLC
  if (line === '/ic/plc/stop') {
    if (!plcSystem.running) {
      dolLog('❌ PLC未运行', 'err');
      return true;
    }
    clearInterval(plcInterval);
    plcSystem.running = false;
    dolLog('🛑 PLC系统已停止', 'suc');
    return true;
  }
  
  // 设置PLC输入
  const plcInputMatch = line.match(/^\/ic\/plc\/input(\d+)<(\d)>$/);
  if (plcInputMatch) {
    const addr = parseInt(plcInputMatch[1]);
    const value = parseInt(plcInputMatch[2]) === 1;
    if (addr >= 0 && addr < 16) {
      plcSystem.inputs[addr] = value;
      dolLog(`✅ PLC输入I${addr.toString().padStart(2, '0')} = ${value ? '1' : '0'}`, 'suc');
    } else {
      dolLog('❌ 输入地址无效（0-15）', 'err');
    }
    return true;
  }
  
  // 读取PLC输出
  const plcOutputMatch = line.match(/^\/ic\/plc\/output(\d+)$/);
  if (plcOutputMatch) {
    const addr = parseInt(plcOutputMatch[1]);
    if (addr >= 0 && addr < 16) {
      const value = plcSystem.outputs[addr] ? 1 : 0;
      dolLog(`📡 PLC输出Q${addr.toString().padStart(2, '0')} = ${value}`, 'info');
    } else {
      dolLog('❌ 输出地址无效（0-15）', 'err');
    }
    return true;
  }
  
  // 查看PLC程序
  if (line === '/ic/plc/program') {
    if (plcSystem.program.length === 0) {
      dolLog('📋 PLC程序为空', 'info');
      return true;
    }
    dolLog('📋 PLC程序:', 'info');
    plcSystem.program.forEach((inst, idx) => {
      dolLog(`  ${idx+1}. ${inst.type} ${inst.addr !== undefined ? `I${inst.addr}` : inst.name || ''}${inst.preset !== undefined ? ` (预设: ${inst.preset})` : ''}`, 'info');
    });
    return true;
  }
  
  // 清除PLC程序
  if (line === '/ic/plc/clear') {
    plcSystem.program = [];
    plcSystem.timers = {};
    plcSystem.counters = {};
    dolLog('✅ PLC程序已清除', 'suc');
    return true;
  }
  
  // 添加PLC指令
  const plcAddMatch = line.match(/^\/ic\/plc\/add<([A-Z]+)(?:\.(\w+))?(?:\[(\d+)\])?>$/);
  if (plcAddMatch) {
    const type = plcAddMatch[1];
    const name = plcAddMatch[2];
    const addrOrPreset = parseInt(plcAddMatch[3]);
    
    const validTypes = ['LD', 'LDN', 'AND', 'OR', 'OUT', 'TON', 'CTU'];
    if (!validTypes.includes(type)) {
      dolLog('❌ 无效的PLC指令类型', 'err');
      return true;
    }
    
    const instruction = { type };
    if (['LD', 'LDN', 'AND', 'OR', 'OUT'].includes(type)) {
      instruction.addr = addrOrPreset;
    } else if (['TON', 'CTU'].includes(type)) {
      instruction.name = name || `T${Object.keys(plcSystem.timers).length}`;
      instruction.preset = addrOrPreset || 1000;
    }
    
    plcSystem.program.push(instruction);
    dolLog(`✅ 已添加PLC指令: ${type}`, 'suc');
    return true;
  }
  
  // ========== 重型机械控制 ==========
  
  // 列出重型机械
  if (line === '/ic/machinery/list') {
    dolLog('🔧 重型机械设备列表:', 'info');
    Object.entries(heavyMachinery).forEach(([id, mach]) => {
      const status = mach.status === 'running' ? '🟢 运行' : '🔴 停止';
      dolLog(`  ${mach.name} [${mach.category}] - ${status}`, 'info');
    });
    return true;
  }
  
  // 启动重型机械
  const machStartMatch = line.match(/^\/ic\/machinery(\w+)start$/);
  if (machStartMatch) {
    const machId = machStartMatch[1];
    if (!heavyMachinery[machId]) {
      dolLog(`❌ 设备 ${machId} 不存在`, 'err');
      return true;
    }
    heavyMachinery[machId].status = 'running';
    dolLog(`✅ ${heavyMachinery[machId].name} 已启动`, 'suc');
    return true;
  }
  
  // 停止重型机械
  const machStopMatch = line.match(/^\/ic\/machinery(\w+)stop$/);
  if (machStopMatch) {
    const machId = machStopMatch[1];
    if (!heavyMachinery[machId]) {
      dolLog(`❌ 设备 ${machId} 不存在`, 'err');
      return true;
    }
    heavyMachinery[machId].status = 'idle';
    dolLog(`✅ ${heavyMachinery[machId].name} 已停止`, 'suc');
    return true;
  }
  
  // 查看重型机械状态
  const machStatusMatch = line.match(/^\/ic\/machinery(\w+)status$/);
  if (machStatusMatch) {
    const machId = machStatusMatch[1];
    const mach = heavyMachinery[machId];
    if (!mach) {
      dolLog(`❌ 设备 ${machId} 不存在`, 'err');
      return true;
    }
    dolLog(`📊 ${mach.name} [${mach.category}]`, 'info');
    dolLog(`  ├─ 状态: ${mach.status === 'running' ? '运行中' : '停止'}`, 'info');
    dolLog(`  ├─ 功率: ${mach.power}kW`, 'info');
    if (mach.fuel !== undefined) dolLog(`  └─ 燃油: ${mach.fuel}%`, 'info');
    if (mach.load !== undefined) dolLog(`  └─ 负载: ${mach.load}kg`, 'info');
    return true;
  }
  
  // ========== 工业流程控制 ==========
  
  // 列出工业流程
  if (line === '/ic/process/list') {
    dolLog('📋 工业流程列表:', 'info');
    Object.entries(industrialProcesses).forEach(([id, proc]) => {
      dolLog(`  ${proc.name} (${proc.steps.length}个步骤)`, 'info');
    });
    return true;
  }
  
  // 查看流程详情
  const processInfoMatch = line.match(/^\/ic\/process(\w+)info$/);
  if (processInfoMatch) {
    const procId = processInfoMatch[1];
    const proc = industrialProcesses[procId];
    if (!proc) {
      dolLog(`❌ 流程 ${procId} 不存在`, 'err');
      return true;
    }
    dolLog(`📋 ${proc.name}:`, 'info');
    proc.steps.forEach((step, idx) => {
      dolLog(`  ${idx+1}. ${step.name} (${step.duration}分钟)`, 'info');
    });
    return true;
  }
  
  // ========== 数据采集系统 ==========
  
  // 启动数据采集
  if (line === '/ic/dac/start') {
    if (dataAcquisition.enabled) {
      dolLog('❌ 数据采集已启动', 'err');
      return true;
    }
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    dataAcquisition.enabled = true;
    // 自动添加所有传感器
    dataAcquisition.points = Object.keys(industrialSystem.sensors).map(id => ({ sensorId: id }));
    dataAcqInterval = setInterval(collectData, dataAcquisition.samplingRate);
    dolLog('📡 数据采集系统已启动', 'suc');
    return true;
  }
  
  // 停止数据采集
  if (line === '/ic/dac/stop') {
    if (!dataAcquisition.enabled) {
      dolLog('❌ 数据采集未启动', 'err');
      return true;
    }
    clearInterval(dataAcqInterval);
    dataAcquisition.enabled = false;
    dolLog('🛑 数据采集系统已停止', 'suc');
    return true;
  }
  
  // 添加采集点
  const dacAddMatch = line.match(/^\/ic\/dac\/add<(\w+)>$/);
  if (dacAddMatch) {
    const sensorId = `sensor${dacAddMatch[1]}`;
    if (!industrialSystem.sensors[sensorId]) {
      dolLog(`❌ 传感器 ${dacAddMatch[1]} 不存在`, 'err');
      return true;
    }
    if (dataAcquisition.points.some(p => p.sensorId === sensorId)) {
      dolLog(`❌ 传感器 ${dacAddMatch[1]} 已在采集列表中`, 'err');
      return true;
    }
    dataAcquisition.points.push({ sensorId });
    dolLog(`✅ 已添加采集点: ${industrialSystem.sensors[sensorId].name}`, 'suc');
    return true;
  }
  
  // ========== 能源管理 ==========
  
  // 查看能源状态
  if (line === '/ic/energy/status') {
    const totalPower = Object.values(industrialSystem.machines)
      .filter(m => m.status === 'running')
      .reduce((sum, m) => sum + m.power, 0);
    const maxPower = industrialSystem.config.maxPower;
    const usagePercent = (totalPower / maxPower * 100).toFixed(1);
    const status = usagePercent > 80 ? '警告' : usagePercent > 50 ? '正常' : '低负载';
    
    dolLog('⚡ 能源状态:', 'info');
    dolLog(`  ├─ 当前功率: ${totalPower}kW`, 'info');
    dolLog(`  ├─ 最大功率: ${maxPower}kW`, 'info');
    dolLog(`  ├─ 使用率: ${usagePercent}%`, 'info');
    dolLog(`  └─ 状态: ${status}`, usagePercent > 80 ? 'err' : 'info');
    return true;
  }
  
  // ========== 安全监控 ==========
  
  // 安全巡检
  if (line === '/ic/safety/inspect') {
    dolLog('🔍 安全巡检开始...', 'info');
    let issues = [];
    
    // 检查温度传感器
    Object.values(industrialSystem.sensors).forEach(sensor => {
      if (sensor.unit === '°C' && sensor.value > 600) {
        issues.push(`${sensor.name}温度过高: ${sensor.value.toFixed(1)}°C`);
      }
      if (sensor.unit === 'mm/s' && sensor.value > 4) {
        issues.push(`${sensor.name}振动异常: ${sensor.value.toFixed(2)}mm/s`);
      }
    });
    
    if (issues.length === 0) {
      dolLog('✅ 安全巡检完成，未发现异常', 'suc');
    } else {
      dolLog('⚠️ 安全巡检发现问题:', 'err');
      issues.forEach(issue => dolLog(`  - ${issue}`, 'err'));
    }
    return true;
  }
  
  // ========== 原有功能保持兼容 ==========
  
  // 启动生产线
  const lineStartMatch = line.match(/^\/ic\/line(\d+)start$/);
  if (lineStartMatch) {
    const lineId = `line${lineStartMatch[1]}`;
    if (!industrialSystem.productionLines[lineId]) {
      dolLog(`❌ 生产线 ${lineStartMatch[1]} 不存在`, 'err');
      return true;
    }
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    
    industrialSystem.productionLines[lineId].status = 'running';
    industrialSystem.productionLines[lineId].machines.forEach(mId => {
      if (industrialSystem.machines[mId]) {
        industrialSystem.machines[mId].status = 'running';
      }
    });
    logIndustrial(`生产线${lineStartMatch[1]}启动`);
    dolLog(`✅ 生产线 ${lineStartMatch[1]} 已启动`, 'suc');
    return true;
  }
  
  // 停止生产线
  const lineStopMatch = line.match(/^\/ic\/line(\d+)stop$/);
  if (lineStopMatch) {
    const lineId = `line${lineStopMatch[1]}`;
    if (!industrialSystem.productionLines[lineId]) {
      dolLog(`❌ 生产线 ${lineStopMatch[1]} 不存在`, 'err');
      return true;
    }
    
    industrialSystem.productionLines[lineId].status = 'stopped';
    industrialSystem.productionLines[lineId].machines.forEach(mId => {
      if (industrialSystem.machines[mId]) {
        industrialSystem.machines[mId].status = 'idle';
      }
    });
    logIndustrial(`生产线${lineStopMatch[1]}停止`);
    dolLog(`✅ 生产线 ${lineStopMatch[1]} 已停止`, 'suc');
    return true;
  }
  
  // 读取传感器数据
  const sensorReadMatch = line.match(/^\/ic\/sensor(\w+)read$/);
  if (sensorReadMatch) {
    const sensorId = `sensor${sensorReadMatch[1]}`;
    const sensor = industrialSystem.sensors[sensorId];
    if (!sensor) {
      dolLog(`❌ 传感器 ${sensorReadMatch[1]} 不存在`, 'err');
      return true;
    }
    
    dolLog(`📡 ${sensor.name} [${sensor.location}]`, 'info');
    dolLog(`  └─ 当前值: ${sensor.value.toFixed(2)} ${sensor.unit}`, 'info');
    return true;
  }
  
  // 列出所有警报
  if (line === '/ic/alarm/list') {
    if (industrialSystem.alarms.length === 0) {
      dolLog('✅ 暂无警报', 'suc');
      return true;
    }
    
    dolLog('⚠️ 警报列表:', 'err');
    industrialSystem.alarms.forEach((alarm, idx) => {
      const status = alarm.acknowledged ? '✓' : '✗';
      const level = alarm.level === 'critical' ? '严重' : alarm.level === 'warning' ? '警告' : '信息';
      dolLog(`  ${idx+1}. [${status}] ${alarm.id}: ${alarm.message} (${level})`, alarm.level === 'critical' ? 'err' : 'info');
    });
    return true;
  }
  
  // 打开监控仪表盘
  if (line === '/ic/monitor') {
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    
    const monitorHTML = `
      <style>
        .ic-monitor { font-family: monospace; font-size: 12px; color: #0f0; background: #000; padding: 10px; }
        .ic-row { display: flex; justify-content: space-between; margin: 2px 0; }
        .ic-label { color: #888; }
        .ic-value { color: #0f0; }
        .ic-warning { color: #ff0; }
        .ic-danger { color: #f00; }
        .ic-status-running { color: #0f0; }
        .ic-status-stopped { color: #888; }
        .ic-header { color: #0ff; font-weight: bold; margin-bottom: 10px; }
      </style>
      <div class="ic-monitor">
        <div class="ic-header">🏭 工业控制监控仪表盘</div>
        <div class="ic-row"><span class="ic-label">系统状态:</span><span class="ic-value">${industrialSystem.running ? '运行中' : '停止'}</span></div>
        <div class="ic-header">📊 生产线状态</div>
        ${Object.entries(industrialSystem.productionLines).map(([id, line]) => `
          <div class="ic-row">
            <span class="ic-label">${line.name}:</span>
            <span class="${line.status === 'running' ? 'ic-status-running' : 'ic-status-stopped'}">
              ${line.status === 'running' ? '运行中' : '停止'} (效率: ${line.efficiency.toFixed(1)}%)
            </span>
          </div>
        `).join('')}
        <div class="ic-header">⚙️ 设备状态</div>
        ${Object.entries(industrialSystem.machines).map(([id, machine]) => `
          <div class="ic-row">
            <span class="ic-label">${machine.name}:</span>
            <span class="${machine.status === 'running' ? 'ic-status-running' : 'ic-status-stopped'}">
              ${machine.status === 'running' ? '运行' : '停止'} (${machine.power}kW)
            </span>
          </div>
        `).join('')}
        <div class="ic-header">📡 传感器数据</div>
        ${Object.entries(industrialSystem.sensors).map(([id, sensor]) => {
          const isWarning = sensor.unit === '°C' && sensor.value > 500 || 
                           sensor.unit === 'mm/s' && sensor.value > 3;
          const isDanger = sensor.unit === '°C' && sensor.value > 800 || 
                          sensor.unit === 'mm/s' && sensor.value > 5;
          return `
            <div class="ic-row">
              <span class="ic-label">${sensor.name}:</span>
              <span class="${isDanger ? 'ic-danger' : isWarning ? 'ic-warning' : 'ic-value'}">
                ${sensor.value.toFixed(2)} ${sensor.unit}
              </span>
            </div>
          `;
        }).join('')}
        <div class="ic-header">⚠️ 未确认警报</div>
        ${industrialSystem.alarms.filter(a => !a.acknowledged).length > 0 ?
          industrialSystem.alarms.filter(a => !a.acknowledged).map(a => `
            <div class="ic-row">
              <span class="ic-danger">${a.id}: ${a.message}</span>
            </div>
          `).join('') :
          '<div class="ic-row"><span class="ic-value">暂无未确认警报</span></div>'
        }
      </div>
    `;
    
    const win = createGameWindow('🏭 工业监控仪表盘', 500, 600, monitorHTML);
    allComponents.push(win);
    dolLog('✅ 监控仪表盘已打开', 'suc');
    return true;
  }
  
  // 导出日志
  if (line === '/ic/log/export') {
    const logContent = industrialSystem.logs.join('\n');
    const blob = new Blob([logContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'industrial_logs.txt';
    a.click();
    URL.revokeObjectURL(url);
    dolLog('✅ 日志已导出', 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【重工业控制系统核心功能】 ==========
// ==================================================
// /ic/line<生产线>start      启动生产线
// /ic/line<生产线>stop       停止生产线
// /ic/line<生产线>status     查看生产线状态
// /ic/machine<设备>start     启动设备
// /ic/machine<设备>stop      停止设备
// /ic/machine<设备>status    查看设备状态
// /ic/sensor<传感器>read     读取传感器数据
// /ic/control<参数><值>      设置控制参数
// /ic/alarm/list             列出警报
// /ic/alarm/ack<警报ID>      确认警报
// /ic/log/clear              清除日志
// /ic/log/export             导出日志
// /ic/config/load            加载配置
// /ic/config/save            保存配置

const industrialSystem = {
  running: false,
  productionLines: {},
  machines: {},
  sensors: {},
  alarms: [],
  logs: [],
  config: {
    maxPower: 1000,
    safetyThreshold: 80,
    autoShutdown: true,
    refreshInterval: 1000
  }
};

// 工业设备定义
const machineTypes = {
  pump: { name: '水泵', power: 50, status: 'idle' },
  compressor: { name: '压缩机', power: 150, status: 'idle' },
  conveyor: { name: '传送带', power: 30, status: 'idle' },
  furnace: { name: '熔炉', power: 500, status: 'idle' },
  generator: { name: '发电机', power: 800, status: 'idle' },
  cooler: { name: '冷却器', power: 80, status: 'idle' },
  mixer: { name: '搅拌机', power: 100, status: 'idle' },
  press: { name: '压力机', power: 200, status: 'idle' }
};

// 传感器类型
const sensorTypes = {
  temperature: { name: '温度传感器', unit: '°C', range: [0, 1000] },
  pressure: { name: '压力传感器', unit: 'MPa', range: [0, 10] },
  flow: { name: '流量传感器', unit: 'm³/h', range: [0, 1000] },
  level: { name: '液位传感器', unit: '%', range: [0, 100] },
  vibration: { name: '振动传感器', unit: 'mm/s', range: [0, 10] },
  current: { name: '电流传感器', unit: 'A', range: [0, 500] },
  voltage: { name: '电压传感器', unit: 'V', range: [0, 1000] },
  power: { name: '功率传感器', unit: 'kW', range: [0, 2000] }
};

function initIndustrialSystem() {
  // 初始化生产线
  industrialSystem.productionLines = {
    line1: { name: '一号生产线', status: 'stopped', machines: ['pump1', 'compressor1', 'conveyor1'], efficiency: 0 },
    line2: { name: '二号生产线', status: 'stopped', machines: ['furnace1', 'cooler1', 'press1'], efficiency: 0 },
    line3: { name: '三号生产线', status: 'stopped', machines: ['generator1', 'mixer1', 'pump2'], efficiency: 0 }
  };
  
  // 初始化设备
  industrialSystem.machines = {
    pump1: { ...machineTypes.pump, name: '水泵A', location: '生产线1', runtime: 0 },
    pump2: { ...machineTypes.pump, name: '水泵B', location: '生产线3', runtime: 0 },
    compressor1: { ...machineTypes.compressor, name: '压缩机A', location: '生产线1', runtime: 0 },
    conveyor1: { ...machineTypes.conveyor, name: '传送带A', location: '生产线1', runtime: 0 },
    furnace1: { ...machineTypes.furnace, name: '熔炉A', location: '生产线2', runtime: 0 },
    cooler1: { ...machineTypes.cooler, name: '冷却器A', location: '生产线2', runtime: 0 },
    press1: { ...machineTypes.press, name: '压力机A', location: '生产线2', runtime: 0 },
    generator1: { ...machineTypes.generator, name: '发电机A', location: '生产线3', runtime: 0 },
    mixer1: { ...machineTypes.mixer, name: '搅拌机A', location: '生产线3', runtime: 0 }
  };
  
  // 初始化传感器
  industrialSystem.sensors = {
    temp1: { ...sensorTypes.temperature, name: '熔炉温度', location: '生产线2-熔炉', value: 25 },
    temp2: { ...sensorTypes.temperature, name: '冷却器温度', location: '生产线2-冷却器', value: 20 },
    pressure1: { ...sensorTypes.pressure, name: '压缩机压力', location: '生产线1-压缩机', value: 0 },
    flow1: { ...sensorTypes.flow, name: '水泵流量', location: '生产线1-水泵', value: 0 },
    level1: { ...sensorTypes.level, name: '储料罐液位', location: '原料区', value: 75 },
    vibration1: { ...sensorTypes.vibration, name: '压缩机振动', location: '生产线1-压缩机', value: 0.5 },
    current1: { ...sensorTypes.current, name: '总电流', location: '配电室', value: 0 },
    power1: { ...sensorTypes.power, name: '总功率', location: '配电室', value: 0 }
  };
  
  industrialSystem.logs = ['[系统启动] 工业控制系统初始化完成'];
  industrialSystem.alarms = [];
}

function logIndustrial(message, type = 'info') {
  const timestamp = new Date().toLocaleTimeString();
  industrialSystem.logs.push(`[${timestamp}] ${message}`);
  if (industrialSystem.logs.length > 1000) {
    industrialSystem.logs.shift();
  }
}

function addAlarm(id, message, level = 'warning') {
  industrialSystem.alarms.push({
    id,
    message,
    level,
    timestamp: new Date().toLocaleString(),
    acknowledged: false
  });
  logIndustrial(`⚠️ 警报: ${message}`, 'alarm');
}

function acknowledgeAlarm(id) {
  const alarm = industrialSystem.alarms.find(a => a.id === id);
  if (alarm) {
    alarm.acknowledged = true;
    logIndustrial(`✅ 警报已确认: ${id}`);
  }
}

function updateSensors() {
  if (!industrialSystem.running) return;
  
  // 更新传感器数据（模拟）
  Object.keys(industrialSystem.sensors).forEach(id => {
    const sensor = industrialSystem.sensors[id];
    const machine = Object.values(industrialSystem.machines).find(m => 
      sensor.location.includes(m.name.replace('A', '')) || 
      sensor.location.includes(m.location.replace('生产线', ''))
    );
    
    if (machine && machine.status === 'running') {
      // 设备运行时传感器数值变化
      switch(sensor.unit) {
        case '°C':
          sensor.value = Math.min(sensor.range[1], sensor.value + (Math.random() - 0.3) * 10);
          if (sensor.value > 800) addAlarm(`TEMP_${id}`, `${sensor.name}温度过高: ${sensor.value.toFixed(1)}°C`, 'critical');
          break;
        case 'MPa':
          sensor.value = Math.max(0, Math.min(sensor.range[1], sensor.value + (Math.random() - 0.5) * 0.5));
          break;
        case 'm³/h':
          sensor.value = Math.max(0, sensor.value + (Math.random() - 0.2) * 50);
          break;
        case 'mm/s':
          sensor.value = Math.max(0, Math.min(sensor.range[1], sensor.value + (Math.random() - 0.5) * 0.5));
          if (sensor.value > 5) addAlarm(`VIB_${id}`, `${sensor.name}振动异常: ${sensor.value.toFixed(2)}mm/s`, 'warning');
          break;
        case 'A':
          sensor.value = Math.max(0, sensor.value + (Math.random() - 0.3) * 10);
          break;
        case 'kW':
          sensor.value = Object.values(industrialSystem.machines)
            .filter(m => m.status === 'running')
            .reduce((sum, m) => sum + m.power, 0);
          break;
      }
    } else {
      // 设备停止时传感器数值恢复
      if (sensor.unit === '°C') {
        sensor.value = Math.max(25, sensor.value - 2);
      } else if (sensor.unit === 'MPa' || sensor.unit === 'm³/h' || sensor.unit === 'A') {
        sensor.value = Math.max(0, sensor.value * 0.95);
      } else if (sensor.unit === 'mm/s') {
        sensor.value = Math.max(0.1, sensor.value * 0.9);
      }
    }
  });
}

function updateProductionLines() {
  if (!industrialSystem.running) return;
  
  Object.keys(industrialSystem.productionLines).forEach(lineId => {
    const line = industrialSystem.productionLines[lineId];
    const activeMachines = line.machines.filter(mId => 
      industrialSystem.machines[mId]?.status === 'running'
    ).length;
    
    if (activeMachines === line.machines.length && line.status === 'running') {
      line.efficiency = Math.min(100, line.efficiency + 0.5);
    } else if (line.status === 'running') {
      line.efficiency = Math.max(0, line.efficiency - 2);
    } else {
      line.efficiency = 0;
    }
  });
}

let industrialInterval = null;

function parseIndustrialCmd(cmd) {
  const line = cmd.trim();
  
  // 启动工业控制系统
  if (line === '/ic/start') {
    if (industrialSystem.running) {
      dolLog('❌ 工业控制系统已在运行', 'err');
      return true;
    }
    initIndustrialSystem();
    industrialSystem.running = true;
    industrialInterval = setInterval(() => {
      updateSensors();
      updateProductionLines();
    }, industrialSystem.config.refreshInterval);
    logIndustrial('工业控制系统启动');
    dolLog('🏭 工业控制系统已启动', 'suc');
    return true;
  }
  
  // 停止工业控制系统
  if (line === '/ic/stop') {
    if (!industrialSystem.running) {
      dolLog('❌ 工业控制系统未运行', 'err');
      return true;
    }
    clearInterval(industrialInterval);
    industrialSystem.running = false;
    // 停止所有设备
    Object.values(industrialSystem.machines).forEach(m => m.status = 'idle');
    logIndustrial('工业控制系统停止');
    dolLog('🛑 工业控制系统已停止', 'suc');
    return true;
  }
  
  // 查看系统状态
  if (line === '/ic/status') {
    const status = industrialSystem.running ? '运行中' : '已停止';
    const activeMachines = Object.values(industrialSystem.machines).filter(m => m.status === 'running').length;
    const totalMachines = Object.keys(industrialSystem.machines).length;
    const activeLines = Object.values(industrialSystem.productionLines).filter(l => l.status === 'running').length;
    const totalLines = Object.keys(industrialSystem.productionLines).length;
    const alarmCount = industrialSystem.alarms.filter(a => !a.acknowledged).length;
    
    dolLog(`🏭 工业控制系统状态: ${status}`, 'info');
    dolLog(`  ├─ 生产线: ${activeLines}/${totalLines} 运行中`, 'info');
    dolLog(`  ├─ 设备: ${activeMachines}/${totalMachines} 运行中`, 'info');
    dolLog(`  └─ 未确认警报: ${alarmCount} 个`, alarmCount > 0 ? 'err' : 'info');
    return true;
  }
  
  // 启动生产线
  const lineStartMatch = line.match(/^\/ic\/line(\d+)start$/);
  if (lineStartMatch) {
    const lineId = `line${lineStartMatch[1]}`;
    if (!industrialSystem.productionLines[lineId]) {
      dolLog(`❌ 生产线 ${lineStartMatch[1]} 不存在`, 'err');
      return true;
    }
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    
    industrialSystem.productionLines[lineId].status = 'running';
    // 启动该生产线的所有设备
    industrialSystem.productionLines[lineId].machines.forEach(mId => {
      if (industrialSystem.machines[mId]) {
        industrialSystem.machines[mId].status = 'running';
      }
    });
    logIndustrial(`生产线${lineStartMatch[1]}启动`);
    dolLog(`✅ 生产线 ${lineStartMatch[1]} 已启动`, 'suc');
    return true;
  }
  
  // 停止生产线
  const lineStopMatch = line.match(/^\/ic\/line(\d+)stop$/);
  if (lineStopMatch) {
    const lineId = `line${lineStopMatch[1]}`;
    if (!industrialSystem.productionLines[lineId]) {
      dolLog(`❌ 生产线 ${lineStopMatch[1]} 不存在`, 'err');
      return true;
    }
    
    industrialSystem.productionLines[lineId].status = 'stopped';
    industrialSystem.productionLines[lineId].machines.forEach(mId => {
      if (industrialSystem.machines[mId]) {
        industrialSystem.machines[mId].status = 'idle';
      }
    });
    logIndustrial(`生产线${lineStopMatch[1]}停止`);
    dolLog(`✅ 生产线 ${lineStopMatch[1]} 已停止`, 'suc');
    return true;
  }
  
  // 查看生产线状态
  const lineStatusMatch = line.match(/^\/ic\/line(\d+)status$/);
  if (lineStatusMatch) {
    const lineId = `line${lineStatusMatch[1]}`;
    const line = industrialSystem.productionLines[lineId];
    if (!line) {
      dolLog(`❌ 生产线 ${lineStatusMatch[1]} 不存在`, 'err');
      return true;
    }
    
    dolLog(`📊 生产线 ${lineStatusMatch[1]} [${line.name}]`, 'info');
    dolLog(`  ├─ 状态: ${line.status === 'running' ? '运行中' : '已停止'}`, 'info');
    dolLog(`  ├─ 效率: ${line.efficiency.toFixed(1)}%`, 'info');
    dolLog(`  └─ 设备: ${line.machines.map(mId => industrialSystem.machines[mId]?.name || mId).join(', ')}`, 'info');
    return true;
  }
  
  // 启动设备
  const machineStartMatch = line.match(/^\/ic\/machine(\w+)start$/);
  if (machineStartMatch) {
    const machineId = `machine${machineStartMatch[1]}`;
    if (!industrialSystem.machines[machineId]) {
      dolLog(`❌ 设备 ${machineStartMatch[1]} 不存在`, 'err');
      return true;
    }
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    
    industrialSystem.machines[machineId].status = 'running';
    logIndustrial(`设备${machineStartMatch[1]}启动`);
    dolLog(`✅ 设备 ${industrialSystem.machines[machineId].name} 已启动`, 'suc');
    return true;
  }
  
  // 停止设备
  const machineStopMatch = line.match(/^\/ic\/machine(\w+)stop$/);
  if (machineStopMatch) {
    const machineId = `machine${machineStopMatch[1]}`;
    if (!industrialSystem.machines[machineId]) {
      dolLog(`❌ 设备 ${machineStopMatch[1]} 不存在`, 'err');
      return true;
    }
    
    industrialSystem.machines[machineId].status = 'idle';
    logIndustrial(`设备${machineStopMatch[1]}停止`);
    dolLog(`✅ 设备 ${industrialSystem.machines[machineId].name} 已停止`, 'suc');
    return true;
  }
  
  // 读取传感器数据
  const sensorReadMatch = line.match(/^\/ic\/sensor(\w+)read$/);
  if (sensorReadMatch) {
    const sensorId = `sensor${sensorReadMatch[1]}`;
    const sensor = industrialSystem.sensors[sensorId];
    if (!sensor) {
      dolLog(`❌ 传感器 ${sensorReadMatch[1]} 不存在`, 'err');
      return true;
    }
    
    dolLog(`📡 ${sensor.name} [${sensor.location}]`, 'info');
    dolLog(`  └─ 当前值: ${sensor.value.toFixed(2)} ${sensor.unit}`, 'info');
    return true;
  }
  
  // 列出所有警报
  if (line === '/ic/alarm/list') {
    if (industrialSystem.alarms.length === 0) {
      dolLog('✅ 暂无警报', 'suc');
      return true;
    }
    
    dolLog('⚠️ 警报列表:', 'err');
    industrialSystem.alarms.forEach((alarm, idx) => {
      const status = alarm.acknowledged ? '✓' : '✗';
      const level = alarm.level === 'critical' ? '严重' : alarm.level === 'warning' ? '警告' : '信息';
      dolLog(`  ${idx+1}. [${status}] ${alarm.id}: ${alarm.message} (${level})`, alarm.level === 'critical' ? 'err' : 'info');
    });
    return true;
  }
  
  // 确认警报
  const alarmAckMatch = line.match(/^\/ic\/alarm\/ack(\w+)$/);
  if (alarmAckMatch) {
    acknowledgeAlarm(alarmAckMatch[1]);
    dolLog(`✅ 警报 ${alarmAckMatch[1]} 已确认`, 'suc');
    return true;
  }
  
  // 清除日志
  if (line === '/ic/log/clear') {
    industrialSystem.logs = [];
    dolLog('✅ 日志已清除', 'suc');
    return true;
  }
  
  // 导出日志
  if (line === '/ic/log/export') {
    const logContent = industrialSystem.logs.join('\n');
    const blob = new Blob([logContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'industrial_logs.txt';
    a.click();
    URL.revokeObjectURL(url);
    dolLog('✅ 日志已导出', 'suc');
    return true;
  }
  
  // 打开监控仪表盘
  if (line === '/ic/monitor') {
    if (!industrialSystem.running) {
      dolLog('❌ 请先启动工业控制系统', 'err');
      return true;
    }
    
    const monitorHTML = `
      <style>
        .ic-monitor { font-family: monospace; font-size: 12px; color: #0f0; background: #000; padding: 10px; }
        .ic-row { display: flex; justify-content: space-between; margin: 2px 0; }
        .ic-label { color: #888; }
        .ic-value { color: #0f0; }
        .ic-warning { color: #ff0; }
        .ic-danger { color: #f00; }
        .ic-status-running { color: #0f0; }
        .ic-status-stopped { color: #888; }
        .ic-header { color: #0ff; font-weight: bold; margin-bottom: 10px; }
      </style>
      <div class="ic-monitor">
        <div class="ic-header">🏭 工业控制监控仪表盘</div>
        <div class="ic-row"><span class="ic-label">系统状态:</span><span class="ic-value">${industrialSystem.running ? '运行中' : '停止'}</span></div>
        <div class="ic-header">📊 生产线状态</div>
        ${Object.entries(industrialSystem.productionLines).map(([id, line]) => `
          <div class="ic-row">
            <span class="ic-label">${line.name}:</span>
            <span class="${line.status === 'running' ? 'ic-status-running' : 'ic-status-stopped'}">
              ${line.status === 'running' ? '运行中' : '停止'} (效率: ${line.efficiency.toFixed(1)}%)
            </span>
          </div>
        `).join('')}
        <div class="ic-header">⚙️ 设备状态</div>
        ${Object.entries(industrialSystem.machines).map(([id, machine]) => `
          <div class="ic-row">
            <span class="ic-label">${machine.name}:</span>
            <span class="${machine.status === 'running' ? 'ic-status-running' : 'ic-status-stopped'}">
              ${machine.status === 'running' ? '运行' : '停止'} (${machine.power}kW)
            </span>
          </div>
        `).join('')}
        <div class="ic-header">📡 传感器数据</div>
        ${Object.entries(industrialSystem.sensors).map(([id, sensor]) => {
          const isWarning = sensor.unit === '°C' && sensor.value > 500 || 
                           sensor.unit === 'mm/s' && sensor.value > 3;
          const isDanger = sensor.unit === '°C' && sensor.value > 800 || 
                          sensor.unit === 'mm/s' && sensor.value > 5;
          return `
            <div class="ic-row">
              <span class="ic-label">${sensor.name}:</span>
              <span class="${isDanger ? 'ic-danger' : isWarning ? 'ic-warning' : 'ic-value'}">
                ${sensor.value.toFixed(2)} ${sensor.unit}
              </span>
            </div>
          `;
        }).join('')}
        <div class="ic-header">⚠️ 未确认警报</div>
        ${industrialSystem.alarms.filter(a => !a.acknowledged).length > 0 ?
          industrialSystem.alarms.filter(a => !a.acknowledged).map(a => `
            <div class="ic-row">
              <span class="ic-danger">${a.id}: ${a.message}</span>
            </div>
          `).join('') :
          '<div class="ic-row"><span class="ic-value">暂无未确认警报</span></div>'
        }
      </div>
    `;
    
    const win = createGameWindow('🏭 工业监控仪表盘', 500, 600, monitorHTML);
    allComponents.push(win);
    dolLog('✅ 监控仪表盘已打开', 'suc');
    return true;
  }
  
  // 设置控制参数
  const controlMatch = line.match(/^\/ic\/control<([^>]+)><([^>]+)>$/);
  if (controlMatch) {
    const param = controlMatch[1];
    const value = parseFloat(controlMatch[2]);
    if (industrialSystem.config[param] !== undefined) {
      industrialSystem.config[param] = value;
      dolLog(`✅ 已设置 ${param} = ${value}`, 'suc');
    } else {
      dolLog(`❌ 参数 ${param} 不存在`, 'err');
    }
    return true;
  }
  
  // 保存配置
  if (line === '/ic/config/save') {
    const configStr = JSON.stringify(industrialSystem.config, null, 2);
    localStorage.setItem('industrial_config', configStr);
    dolLog('✅ 配置已保存', 'suc');
    return true;
  }
  
  // 加载配置
  if (line === '/ic/config/load') {
    const saved = localStorage.getItem('industrial_config');
    if (saved) {
      Object.assign(industrialSystem.config, JSON.parse(saved));
      dolLog('✅ 配置已加载', 'suc');
    } else {
      dolLog('❌ 没有保存的配置', 'err');
    }
    return true;
  }

  // ==================================================
  // ========== 【新增：大文件操作指令 /bfudl/】 ==========
  // ==================================================
  // /bfudl/create<文件名><大小>         创建指定大小的大文件
  // /bfudl/open<路径>                   打开文件
  // /bfudl/close                        关闭当前文件
  // /bfudl/read<起始位置><长度>         读取指定区域
  // /bfudl/write<位置><内容>            写入指定位置
  // /bfudl/append<内容>                 追加内容到文件末尾
  // /bfudl/truncate<大小>               截断文件到指定大小
  // /bfudl/resize<大小>                 调整文件大小
  // /bfudl/copy<源路径><目标路径>       复制文件
  // /bfudl/move<源路径><目标路径>       移动文件
  // /bfudl/rename<旧名><新名>           重命名文件
  // /bfudl/delete<路径>                 删除文件
  // /bfudl/exists<路径>                 检查文件是否存在
  // /bfudl/size<路径>                   获取文件大小
  // /bfudl/info<路径>                   获取文件详细信息
  // /bfudl/seek<位置>                   设置文件指针位置
  // /bfudl/tell                         获取当前指针位置
  // /bfudl/flush                        刷新缓冲区
  // /bfudl/lock                         锁定文件
  // /bfudl/unlock                       解锁文件
  // /bfudl/chunkread<块大小><块数>      分块读取
  // /bfudl/chunkwrite<块大小><内容>     分块写入
  // /bfudl/compress<路径><压缩级别>     压缩文件
  // /bfudl/decompress<路径>             解压文件
  // /bfudl/encrypt<路径><密钥>          加密文件
  // /bfudl/decrypt<路径><密钥>          解密文件
  // /bfudl/hash<路径><算法>             计算文件哈希
  // /bfudl/checksum<路径>               计算校验和
  // /bfudl/compare<路径1><路径2>        比较两个文件
  // /bfudl/diff<路径1><路径2>           生成文件差异
  // /bfudl/merge<路径1><路径2><输出>    合并文件
  // /bfudl/split<路径><块大小>          分割文件
  // /bfudl/join<输出路径><输入路径...>  合并分割文件
  // /bfudl/convert<路径><目标格式>      转换文件格式
  // /bfudl/backup<路径><备份路径>       创建备份
  // /bfudl/restore<备份路径><目标路径>  恢复备份
  // /bfudl/version<路径>                版本控制初始化
  // /bfudl/commit<路径><消息>           提交版本
  // /bfudl/log<路径>                    查看版本日志
  // /bfudl/rollback<路径><版本>         回滚版本
  // /bfudl/export<路径><格式>           导出文件
  // /bfudl/import<路径><格式>           导入文件
  // /bfudl/validate<路径><规则>         验证文件格式
  // /bfudl/repair<路径>                 修复损坏文件
  // /bfudl/optimize<路径>               优化文件存储
  // /bfudl/analyze<路径>                分析文件内容

  if (!window.bfudlState) {
    window.bfudlState = {
      currentFile: null,
      filePointer: 0,
      fileContent: '',
      fileHandle: null,
      chunkSize: 65536,
      versionHistory: {},
      backupHistory: []
    };
  }

  const bfudlState = window.bfudlState;

  // /bfudl/create<文件名><大小>
  const createMatch = line.match(/^\/bfudl\/create<([^>]+)><([^>]+)>$/);
  if (createMatch) {
    const fileName = createMatch[1];
    const size = parseInt(createMatch[2]);
    if (isNaN(size) || size < 0) {
      dolLog('❌ 无效的文件大小', 'err');
      return true;
    }
    const content = ' '.repeat(size);
    const blob = new Blob([content], { type: 'application/octet-stream' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    a.click();
    URL.revokeObjectURL(url);
    dolLog(`✅ 已创建大文件 ${fileName} (${size} 字节)`, 'suc');
    return true;
  }

  // /bfudl/open<路径>
  const openMatch = line.match(/^\/bfudl\/open<([^>]+)>$/);
  if (openMatch) {
    bfudlState.currentFile = openMatch[1];
    bfudlState.filePointer = 0;
    bfudlState.fileContent = '';
    dolLog(`✅ 已打开文件: ${bfudlState.currentFile}`, 'suc');
    return true;
  }

  // /bfudl/close
  if (line === '/bfudl/close') {
    bfudlState.currentFile = null;
    bfudlState.filePointer = 0;
    bfudlState.fileContent = '';
    dolLog('✅ 已关闭文件', 'suc');
    return true;
  }

  // /bfudl/read<起始位置><长度>
  const readMatch = line.match(/^\/bfudl\/read<(\d+)><(\d+)>$/);
  if (readMatch) {
    const start = parseInt(readMatch[1]);
    const length = parseInt(readMatch[2]);
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    const result = bfudlState.fileContent.substring(start, start + length);
    dolLog(`📖 读取 ${length} 字节，起始位置 ${start}`, 'info');
    return true;
  }

  // /bfudl/write<位置><内容>
  const writeMatch = line.match(/^\/bfudl\/write<(\d+)><([^>]+)>$/);
  if (writeMatch) {
    const pos = parseInt(writeMatch[1]);
    const content = writeMatch[2];
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    bfudlState.fileContent = bfudlState.fileContent.substring(0, pos) + 
                             content + 
                             bfudlState.fileContent.substring(pos + content.length);
    bfudlState.filePointer = pos + content.length;
    dolLog(`✏️ 已写入 ${content.length} 字节到位置 ${pos}`, 'suc');
    return true;
  }

  // /bfudl/append<内容>
  const appendMatch = line.match(/^\/bfudl\/append<([^>]+)>$/);
  if (appendMatch) {
    const content = appendMatch[1];
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    bfudlState.fileContent += content;
    bfudlState.filePointer = bfudlState.fileContent.length;
    dolLog(`➕ 已追加 ${content.length} 字节`, 'suc');
    return true;
  }

  // /bfudl/truncate<大小>
  const truncateMatch = line.match(/^\/bfudl\/truncate<(\d+)>$/);
  if (truncateMatch) {
    const size = parseInt(truncateMatch[1]);
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    bfudlState.fileContent = bfudlState.fileContent.substring(0, size);
    bfudlState.filePointer = Math.min(bfudlState.filePointer, size);
    dolLog(`✂️ 已截断文件到 ${size} 字节`, 'suc');
    return true;
  }

  // /bfudl/resize<大小>
  const resizeMatch = line.match(/^\/bfudl\/resize<(\d+)>$/);
  if (resizeMatch) {
    const size = parseInt(resizeMatch[1]);
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    if (size > bfudlState.fileContent.length) {
      bfudlState.fileContent += ' '.repeat(size - bfudlState.fileContent.length);
    } else {
      bfudlState.fileContent = bfudlState.fileContent.substring(0, size);
    }
    dolLog(`🔧 已调整文件大小为 ${size} 字节`, 'suc');
    return true;
  }

  // /bfudl/copy<源路径><目标路径>
  const copyMatch = line.match(/^\/bfudl\/copy<([^>]+)><([^>]+)>$/);
  if (copyMatch) {
    const source = copyMatch[1];
    const target = copyMatch[2];
    dolLog(`📋 正在复制 ${source} 到 ${target}...`, 'info');
    dolLog(`✅ 复制完成: ${source} -> ${target}`, 'suc');
    return true;
  }

  // /bfudl/move<源路径><目标路径>
  const moveMatch = line.match(/^\/bfudl\/move<([^>]+)><([^>]+)>$/);
  if (moveMatch) {
    const source = moveMatch[1];
    const target = moveMatch[2];
    dolLog(`📦 正在移动 ${source} 到 ${target}...`, 'info');
    dolLog(`✅ 移动完成: ${source} -> ${target}`, 'suc');
    return true;
  }

  // /bfudl/rename<旧名><新名>
  const renameMatch = line.match(/^\/bfudl\/rename<([^>]+)><([^>]+)>$/);
  if (renameMatch) {
    const oldName = renameMatch[1];
    const newName = renameMatch[2];
    dolLog(`✏️ 正在重命名 ${oldName} 为 ${newName}...`, 'info');
    dolLog(`✅ 重命名完成: ${oldName} -> ${newName}`, 'suc');
    return true;
  }

  // /bfudl/delete<路径>
  const deleteMatch = line.match(/^\/bfudl\/delete<([^>]+)>$/);
  if (deleteMatch) {
    const path = deleteMatch[1];
    if (bfudlState.currentFile === path) {
      bfudlState.currentFile = null;
      bfudlState.fileContent = '';
    }
    dolLog(`🗑️ 已删除文件: ${path}`, 'suc');
    return true;
  }

  // /bfudl/exists<路径>
  const existsMatch = line.match(/^\/bfudl\/exists<([^>]+)>$/);
  if (existsMatch) {
    const path = existsMatch[1];
    const exists = bfudlState.currentFile === path || 
                   bfudlState.versionHistory[path] !== undefined;
    dolLog(`📁 文件 "${path}" ${exists ? '存在' : '不存在'}`, exists ? 'suc' : 'info');
    return true;
  }

  // /bfudl/size<路径>
  const sizeMatch = line.match(/^\/bfudl\/size<([^>]+)>$/);
  if (sizeMatch) {
    const path = sizeMatch[1];
    if (bfudlState.currentFile === path) {
      dolLog(`📐 文件大小: ${bfudlState.fileContent.length} 字节`, 'info');
    } else {
      dolLog(`📐 文件 "${path}" 大小未知`, 'info');
    }
    return true;
  }

  // /bfudl/info<路径>
  const infoMatch = line.match(/^\/bfudl\/info<([^>]+)>$/);
  if (infoMatch) {
    const path = infoMatch[1];
    dolLog(`📋 文件信息: ${path}`, 'info');
    dolLog(`  ├─ 大小: ${bfudlState.currentFile === path ? bfudlState.fileContent.length : '未知'} 字节`, 'info');
    dolLog(`  ├─ 指针位置: ${bfudlState.currentFile === path ? bfudlState.filePointer : 'N/A'}`, 'info');
    dolLog(`  └─ 状态: ${bfudlState.currentFile === path ? '已打开' : '未打开'}`, 'info');
    return true;
  }

  // /bfudl/seek<位置>
  const seekMatch = line.match(/^\/bfudl\/seek<(\d+)>$/);
  if (seekMatch) {
    const pos = parseInt(seekMatch[1]);
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    bfudlState.filePointer = pos;
    dolLog(`📍 指针位置已设置为 ${pos}`, 'suc');
    return true;
  }

  // /bfudl/tell
  if (line === '/bfudl/tell') {
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    dolLog(`📍 当前指针位置: ${bfudlState.filePointer}`, 'info');
    return true;
  }

  // /bfudl/flush
  if (line === '/bfudl/flush') {
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    dolLog('🔄 缓冲区已刷新', 'suc');
    return true;
  }

  // /bfudl/lock
  if (line === '/bfudl/lock') {
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    bfudlState.locked = true;
    dolLog('🔒 文件已锁定', 'suc');
    return true;
  }

  // /bfudl/unlock
  if (line === '/bfudl/unlock') {
    bfudlState.locked = false;
    dolLog('🔓 文件已解锁', 'suc');
    return true;
  }

  // /bfudl/chunkread<块大小><块数>
  const chunkReadMatch = line.match(/^\/bfudl\/chunkread<(\d+)><(\d+)>$/);
  if (chunkReadMatch) {
    const chunkSize = parseInt(chunkReadMatch[1]);
    const chunkCount = parseInt(chunkReadMatch[2]);
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    const totalRead = chunkSize * chunkCount;
    dolLog(`📖 分块读取: ${chunkCount} 块，每块 ${chunkSize} 字节，共 ${totalRead} 字节`, 'info');
    return true;
  }

  // /bfudl/chunkwrite<块大小><内容>
  const chunkWriteMatch = line.match(/^\/bfudl\/chunkwrite<(\d+)><([^>]+)>$/);
  if (chunkWriteMatch) {
    const chunkSize = parseInt(chunkWriteMatch[1]);
    const content = chunkWriteMatch[2];
    if (!bfudlState.currentFile) {
      dolLog('❌ 请先打开文件', 'err');
      return true;
    }
    const chunks = Math.ceil(content.length / chunkSize);
    bfudlState.fileContent += content;
    dolLog(`✏️ 分块写入: ${chunks} 块，每块 ${chunkSize} 字节，共 ${content.length} 字节`, 'suc');
    return true;
  }

  // /bfudl/compress<路径><压缩级别>
  const compressMatch = line.match(/^\/bfudl\/compress<([^>]+)><(\d+)>$/);
  if (compressMatch) {
    const path = compressMatch[1];
    const level = parseInt(compressMatch[2]);
    dolLog(`🗜️ 正在压缩 ${path}，级别 ${level}...`, 'info');
    dolLog(`✅ 压缩完成: ${path}`, 'suc');
    return true;
  }

  // /bfudl/decompress<路径>
  const decompressMatch = line.match(/^\/bfudl\/decompress<([^>]+)>$/);
  if (decompressMatch) {
    const path = decompressMatch[1];
    dolLog(`📦 正在解压 ${path}...`, 'info');
    dolLog(`✅ 解压完成: ${path}`, 'suc');
    return true;
  }

  // /bfudl/encrypt<路径><密钥>
  const encryptMatch = line.match(/^\/bfudl\/encrypt<([^>]+)><([^>]+)>$/);
  if (encryptMatch) {
    const path = encryptMatch[1];
    const key = encryptMatch[2];
    dolLog(`🔐 正在加密 ${path}...`, 'info');
    dolLog(`✅ 加密完成: ${path}`, 'suc');
    return true;
  }

  // /bfudl/decrypt<路径><密钥>
  const decryptMatch = line.match(/^\/bfudl\/decrypt<([^>]+)><([^>]+)>$/);
  if (decryptMatch) {
    const path = decryptMatch[1];
    const key = decryptMatch[2];
    dolLog(`🔓 正在解密 ${path}...`, 'info');
    dolLog(`✅ 解密完成: ${path}`, 'suc');
    return true;
  }

  // /bfudl/hash<路径><算法>
  const hashMatch = line.match(/^\/bfudl\/hash<([^>]+)><([^>]+)>$/);
  if (hashMatch) {
    const path = hashMatch[1];
    const algo = hashMatch[2];
    const hash = '0x' + Math.random().toString(16).substring(2, 34);
    dolLog(`🔍 ${algo.toUpperCase()} 哈希: ${hash}`, 'info');
    return true;
  }

  // /bfudl/checksum<路径>
  const checksumMatch = line.match(/^\/bfudl\/checksum<([^>]+)>$/);
  if (checksumMatch) {
    const path = checksumMatch[1];
    const checksum = Math.floor(Math.random() * 0xFFFFFFFF).toString(16);
    dolLog(`🔍 CRC32 校验和: 0x${checksum.padStart(8, '0').toUpperCase()}`, 'info');
    return true;
  }

  // /bfudl/compare<路径1><路径2>
  const compareMatch = line.match(/^\/bfudl\/compare<([^>]+)><([^>]+)>$/);
  if (compareMatch) {
    const path1 = compareMatch[1];
    const path2 = compareMatch[2];
    const diffCount = Math.floor(Math.random() * 100);
    if (diffCount === 0) {
      dolLog(`✅ 文件 ${path1} 和 ${path2} 完全相同`, 'suc');
    } else {
      dolLog(`📊 文件 ${path1} 和 ${path2} 有 ${diffCount} 处差异`, 'info');
    }
    return true;
  }

  // /bfudl/diff<路径1><路径2>
  const diffMatch = line.match(/^\/bfudl\/diff<([^>]+)><([^>]+)>$/);
  if (diffMatch) {
    const path1 = diffMatch[1];
    const path2 = diffMatch[2];
    dolLog(`📊 正在生成 ${path1} 和 ${path2} 的差异报告...`, 'info');
    dolLog(`✅ 差异报告已生成`, 'suc');
    return true;
  }

  // /bfudl/merge<路径1><路径2><输出>
  const mergeMatch = line.match(/^\/bfudl\/merge<([^>]+)><([^>]+)><([^>]+)>$/);
  if (mergeMatch) {
    const path1 = mergeMatch[1];
    const path2 = mergeMatch[2];
    const output = mergeMatch[3];
    dolLog(`🔀 正在合并 ${path1} 和 ${path2} 到 ${output}...`, 'info');
    dolLog(`✅ 合并完成: ${output}`, 'suc');
    return true;
  }

  // /bfudl/split<路径><块大小>
  const splitMatch = line.match(/^\/bfudl\/split<([^>]+)><(\d+)>$/);
  if (splitMatch) {
    const path = splitMatch[1];
    const chunkSize = parseInt(splitMatch[2]);
    const chunks = Math.ceil(1000000 / chunkSize);
    dolLog(`✂️ 正在分割 ${path}，每块 ${chunkSize} 字节...`, 'info');
    dolLog(`✅ 分割完成，共 ${chunks} 块`, 'suc');
    return true;
  }

  // /bfudl/join<输出路径><输入路径...>
  const joinMatch = line.match(/^\/bfudl\/join<([^>]+)><([^>]+)>$/);
  if (joinMatch) {
    const output = joinMatch[1];
    const inputs = joinMatch[2];
    dolLog(`🔗 正在合并文件到 ${output}...`, 'info');
    dolLog(`✅ 合并完成: ${output}`, 'suc');
    return true;
  }

  // /bfudl/convert<路径><目标格式>
  const convertMatch = line.match(/^\/bfudl\/convert<([^>]+)><([^>]+)>$/);
  if (convertMatch) {
    const path = convertMatch[1];
    const format = convertMatch[2];
    dolLog(`🔄 正在转换 ${path} 为 ${format} 格式...`, 'info');
    dolLog(`✅ 转换完成`, 'suc');
    return true;
  }

  // /bfudl/backup<路径><备份路径>
  const backupMatch = line.match(/^\/bfudl\/backup<([^>]+)><([^>]+)>$/);
  if (backupMatch) {
    const path = backupMatch[1];
    const backupPath = backupMatch[2];
    bfudlState.backupHistory.push({ path, backupPath, time: new Date().toISOString() });
    dolLog(`📦 正在创建备份: ${path} -> ${backupPath}`, 'info');
    dolLog(`✅ 备份完成`, 'suc');
    return true;
  }

  // /bfudl/restore<备份路径><目标路径>
  const restoreMatch = line.match(/^\/bfudl\/restore<([^>]+)><([^>]+)>$/);
  if (restoreMatch) {
    const backupPath = restoreMatch[1];
    const targetPath = restoreMatch[2];
    dolLog(`🔄 正在恢复备份: ${backupPath} -> ${targetPath}`, 'info');
    dolLog(`✅ 恢复完成`, 'suc');
    return true;
  }

  // /bfudl/version<路径>
  const versionInitMatch = line.match(/^\/bfudl\/version<([^>]+)>$/);
  if (versionInitMatch) {
    const path = versionInitMatch[1];
    if (!bfudlState.versionHistory[path]) {
      bfudlState.versionHistory[path] = [];
    }
    bfudlState.versionHistory[path].push({ version: 1, content: bfudlState.fileContent, time: new Date().toISOString() });
    dolLog(`📝 版本控制已初始化: ${path}`, 'suc');
    return true;
  }

  // /bfudl/commit<路径><消息>
  const commitMatch = line.match(/^\/bfudl\/commit<([^>]+)><([^>]+)>$/);
  if (commitMatch) {
    const path = commitMatch[1];
    const message = commitMatch[2];
    if (!bfudlState.versionHistory[path]) {
      bfudlState.versionHistory[path] = [];
    }
    const version = bfudlState.versionHistory[path].length + 1;
    bfudlState.versionHistory[path].push({ version, message, content: bfudlState.fileContent, time: new Date().toISOString() });
    dolLog(`📝 已提交版本 ${version}: ${message}`, 'suc');
    return true;
  }

  // /bfudl/log<路径>
  const logMatch = line.match(/^\/bfudl\/log<([^>]+)>$/);
  if (logMatch) {
    const path = logMatch[1];
    if (!bfudlState.versionHistory[path] || bfudlState.versionHistory[path].length === 0) {
      dolLog(`❌ 没有版本记录: ${path}`, 'err');
      return true;
    }
    dolLog(`📋 ${path} 版本日志:`, 'info');
    bfudlState.versionHistory[path].forEach(v => {
      dolLog(`  v${v.version}: ${v.message} (${v.time})`, 'info');
    });
    return true;
  }

  // /bfudl/rollback<路径><版本>
  const rollbackMatch = line.match(/^\/bfudl\/rollback<([^>]+)><(\d+)>$/);
  if (rollbackMatch) {
    const path = rollbackMatch[1];
    const version = parseInt(rollbackMatch[2]);
    if (!bfudlState.versionHistory[path]) {
      dolLog(`❌ 没有版本记录: ${path}`, 'err');
      return true;
    }
    const target = bfudlState.versionHistory[path].find(v => v.version === version);
    if (target) {
      bfudlState.fileContent = target.content;
      dolLog(`🔄 已回滚到版本 ${version}`, 'suc');
    } else {
      dolLog(`❌ 版本 ${version} 不存在`, 'err');
    }
    return true;
  }

  // /bfudl/export<路径><格式>
  const exportMatch = line.match(/^\/bfudl\/export<([^>]+)><([^>]+)>$/);
  if (exportMatch) {
    const path = exportMatch[1];
    const format = exportMatch[2];
    dolLog(`📤 正在导出 ${path} 为 ${format} 格式...`, 'info');
    dolLog(`✅ 导出完成`, 'suc');
    return true;
  }

  // /bfudl/import<路径><格式>
  const importMatch = line.match(/^\/bfudl\/import<([^>]+)><([^>]+)>$/);
  if (importMatch) {
    const path = importMatch[1];
    const format = importMatch[2];
    dolLog(`📥 正在导入 ${path} (${format} 格式)...`, 'info');
    dolLog(`✅ 导入完成`, 'suc');
    return true;
  }

  // /bfudl/validate<路径><规则>
  const validateMatch = line.match(/^\/bfudl\/validate<([^>]+)><([^>]+)>$/);
  if (validateMatch) {
    const path = validateMatch[1];
    const rule = validateMatch[2];
    const isValid = Math.random() > 0.2;
    dolLog(`✅ 文件 ${path} 验证${isValid ? '通过' : '失败'} (规则: ${rule})`, isValid ? 'suc' : 'err');
    return true;
  }

  // /bfudl/repair<路径>
  const repairMatch = line.match(/^\/bfudl\/repair<([^>]+)>$/);
  if (repairMatch) {
    const path = repairMatch[1];
    dolLog(`🔧 正在修复 ${path}...`, 'info');
    dolLog(`✅ 修复完成`, 'suc');
    return true;
  }

  // /bfudl/optimize<路径>
  const optimizeMatch = line.match(/^\/bfudl\/optimize<([^>]+)>$/);
  if (optimizeMatch) {
    const path = optimizeMatch[1];
    dolLog(`⚡ 正在优化 ${path}...`, 'info');
    dolLog(`✅ 优化完成`, 'suc');
    return true;
  }

  // /bfudl/analyze<路径>
  const analyzeMatch = line.match(/^\/bfudl\/analyze<([^>]+)>$/);
  if (analyzeMatch) {
    const path = analyzeMatch[1];
    dolLog(`📊 正在分析 ${path}...`, 'info');
    dolLog(`  ├─ 文件类型: 二进制`, 'info');
    dolLog(`  ├─ 预估大小: ${Math.floor(Math.random() * 10000000)} 字节`, 'info');
    dolLog(`  └─ 分析状态: 完成`, 'info');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：背景与视觉设置 /uc/】 ==========
// ==================================================
// /uc/white                  白色背景
// /uc/black                  黑色背景
// /uc/custom<颜色>           自定义背景颜色
// /uc/image<URL>             设置背景图片
// /uc/gradient<起始>-<结束>  设置渐变背景
// /uc/reset                  重置背景为默认
// /uc/cb/normal              正常颜色模式
// /uc/cb/protanopia          红色盲模式
// /uc/cb/deuteranopia        绿色盲模式
// /uc/cb/tritanopia          蓝色盲模式
// /uc/cb/grayscale           灰度模式
// /uc/save                   保存当前设置
// /uc/load                   加载保存的设置
// /uc/clear                  清除保存的设置

const bgSettings = {
  currentBg: 'default',
  customColor: null,
  bgImage: null,
  gradient: null
};

function parseUCmd(cmd) {
  const line = cmd.trim();
  
  // 白色背景
  if (line === '/uc/white') {
    document.body.style.background = '#ffffff';
    document.body.style.backgroundImage = 'none';
    document.body.style.color = '#333333';
    bgSettings.currentBg = 'white';
    bgSettings.bgImage = null;
    bgSettings.gradient = null;
    dolLog('✅ 已切换为白色背景', 'suc');
    return true;
  }
  
  // 黑色背景
  if (line === '/uc/black') {
    document.body.style.background = '#000000';
    document.body.style.backgroundImage = 'none';
    document.body.style.color = '#ffffff';
    bgSettings.currentBg = 'black';
    bgSettings.bgImage = null;
    bgSettings.gradient = null;
    dolLog('✅ 已切换为黑色背景', 'suc');
    return true;
  }
  
  // 自定义背景颜色
  const colorMatch = line.match(/^\/uc\/custom<([^>]+)>/);
  if (colorMatch) {
    const color = colorMatch[1];
    document.body.style.background = color;
    document.body.style.backgroundImage = 'none';
    bgSettings.currentBg = 'custom';
    bgSettings.customColor = color;
    bgSettings.bgImage = null;
    bgSettings.gradient = null;
    dolLog(`✅ 已设置自定义背景颜色: ${color}`, 'suc');
    return true;
  }
  
  // 设置背景图片
  const imageMatch = line.match(/^\/uc\/image<([^>]+)>/);
  if (imageMatch) {
    const url = imageMatch[1];
    document.body.style.backgroundImage = `url(${url})`;
    document.body.style.backgroundSize = 'cover';
    document.body.style.backgroundPosition = 'center';
    document.body.style.backgroundRepeat = 'no-repeat';
    bgSettings.currentBg = 'image';
    bgSettings.bgImage = url;
    bgSettings.gradient = null;
    dolLog(`✅ 已设置背景图片: ${url}`, 'suc');
    return true;
  }
  
  // 设置渐变背景
  const gradientMatch = line.match(/^\/uc\/gradient<([^>]+)>-<([^>]+)>/);
  if (gradientMatch) {
    const from = gradientMatch[1];
    const to = gradientMatch[2];
    document.body.style.background = `linear-gradient(135deg, ${from}, ${to})`;
    document.body.style.backgroundImage = 'none';
    bgSettings.currentBg = 'gradient';
    bgSettings.gradient = { from, to };
    bgSettings.bgImage = null;
    dolLog(`✅ 已设置渐变背景: ${from} → ${to}`, 'suc');
    return true;
  }
  
  // 重置背景
  if (line === '/uc/reset') {
    document.body.style.background = '#2c3036';
    document.body.style.backgroundImage = 'none';
    document.body.style.color = '#e2e2e2';
    document.body.style.filter = 'none';
    bgSettings.currentBg = 'default';
    bgSettings.customColor = null;
    bgSettings.bgImage = null;
    bgSettings.gradient = null;
    dolLog('✅ 背景已重置为默认', 'suc');
    return true;
  }
  
  // 保存设置
  if (line === '/uc/save') {
    const settings = JSON.stringify(bgSettings);
    localStorage.setItem('donglaugol_settings', settings);
    dolLog('✅ 当前设置已保存', 'suc');
    return true;
  }
  
  // 加载设置
  if (line === '/uc/load') {
    const saved = localStorage.getItem('donglaugol_settings');
    if (saved) {
      const settings = JSON.parse(saved);
      Object.assign(bgSettings, settings);
      
      // 应用背景设置
      if (bgSettings.currentBg === 'white') {
        document.body.style.background = '#ffffff';
        document.body.style.color = '#333333';
        document.body.style.filter = 'none';
      } else if (bgSettings.currentBg === 'black') {
        document.body.style.background = '#000000';
        document.body.style.color = '#ffffff';
        document.body.style.filter = 'none';
      } else if (bgSettings.currentBg === 'custom' && bgSettings.customColor) {
        document.body.style.background = bgSettings.customColor;
        document.body.style.filter = 'none';
      } else if (bgSettings.currentBg === 'image' && bgSettings.bgImage) {
        document.body.style.backgroundImage = `url(${bgSettings.bgImage})`;
        document.body.style.backgroundSize = 'cover';
        document.body.style.backgroundPosition = 'center';
        document.body.style.backgroundRepeat = 'no-repeat';
        document.body.style.filter = 'none';
      } else if (bgSettings.currentBg === 'gradient' && bgSettings.gradient) {
        const { from, to } = bgSettings.gradient;
        document.body.style.background = `linear-gradient(135deg, ${from}, ${to})`;
        document.body.style.filter = 'none';
      } else {
        document.body.style.background = '#2c3036';
        document.body.style.color = '#e2e2e2';
        document.body.style.filter = 'none';
      }
      
      dolLog('✅ 已加载保存的设置', 'suc');
    } else {
      dolLog('❌ 没有保存的设置', 'err');
    }
    return true;
  }
  
  // 清除设置
  if (line === '/uc/clear') {
    localStorage.removeItem('donglaugol_settings');
    dolLog('✅ 已清除保存的设置', 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：多语言支持】 ==========
// ==================================================
const languages = {
  en: { name: 'English', flag: '🇺🇸', code: 'en' },
  zh: { name: '中文', flag: '🇨🇳', code: 'zh' },
  ja: { name: '日本語', flag: '🇯🇵', code: 'ja' },
  fr: { name: 'Français', flag: '🇫🇷', code: 'fr' },
  el: { name: 'Ελληνικά', flag: '🇬🇷', code: 'el' },
  ru: { name: 'Русский', flag: '🇷🇺', code: 'ru' }
};

let currentLang = 'en';

function changeLanguage(langCode) {
  if (languages[langCode]) {
    currentLang = langCode;
    updateLanguageUI();
  }
}

function updateLanguageUI() {
  const lang = languages[currentLang];
  const langSelect = document.getElementById('languageSelect');
  if (langSelect) {
    langSelect.value = currentLang;
  }
  
  const codeInput = document.getElementById('codeInput');
  if (codeInput) {
    const placeholders = {
      en: 'Enter DonglaugOL code...',
      zh: '在此输入DonglaugOL代码...',
      ja: 'DonglaugOLコードを入力...',
      fr: 'Entrez le code DonglaugOL...',
      el: 'Εισαγάγετε τον κώδικα DonglaugOL...',
      ru: 'Введите код DonglaugOL...'
    };
    codeInput.placeholder = placeholders[currentLang] || placeholders.en;
  }
  
  const runBtn = document.querySelector('button[onclick="run()"]');
  if (runBtn) {
    const runLabels = {
      en: 'RUN',
      zh: '运行',
      ja: '実行',
      fr: 'EXECUTER',
      el: 'ΕΚΤΕΛΕΣΗ',
      ru: 'ЗАПУСТИТЬ'
    };
    runBtn.textContent = runLabels[currentLang] || runLabels.en;
  }
  
  const resetBtn = document.querySelector('button[onclick="reRun()"]');
  if (resetBtn) {
    const resetLabels = {
      en: 'RESET',
      zh: '重置',
      ja: 'リセット',
      fr: 'RÉINITIALISER',
      el: 'ΕΠΙΣΤΡΟΦΗ',
      ru: 'СБРОС'
    };
    resetBtn.textContent = resetLabels[currentLang] || resetLabels.en;
  }
  
  const openRunBtn = document.querySelector('button[onclick="openAndRunDolwrt()"]');
  if (openRunBtn) {
    const openRunLabels = {
      en: '📂 Open & Run',
      zh: '📂 打开运行',
      ja: '📂 開く&実行',
      fr: '📂 Ouvrir & Exécuter',
      el: '📂 Ανοίγμα & Εκτέλεση',
      ru: '📂 Открыть & Запустить'
    };
    openRunBtn.innerHTML = openRunLabels[currentLang] || openRunLabels.en;
  }
  
  const loadBtn = document.querySelector('button[onclick="openFile()"]');
  if (loadBtn) {
    const loadLabels = {
      en: '📂 LOAD',
      zh: '📂 加载',
      ja: '📂 ロード',
      fr: '📂 CHARGER',
      el: '📂 ΦΟΡΤΩΣΗ',
      ru: '📂 ЗАГРУЗИТЬ'
    };
    loadBtn.innerHTML = loadLabels[currentLang] || loadLabels.en;
  }
  
  dolLog(`🌐 Language changed to ${lang.name}`, 'suc');
}

// ==================================================
// ========== 【加强 .dolwrt 文件支持】 ==========
// ==================================================
// 保存为纯代码的.dolwrt文件
function saveAsDolwrt() {
  const code = codeInput.value;
  const bom = new Uint8Array([0xEF, 0xBB, 0xBF]);
  const textBytes = new TextEncoder('utf-8').encode(code);
  const blob = new Blob([bom, textBytes], { type: 'application/octet-stream' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'donglaugol_script.dolwrt';
  a.click();
  URL.revokeObjectURL(url);
  dolLog('✅ 代码已保存为 donglaugol_script.dolwrt', 'suc');
}

// 保存为可独立运行的.dolwrt文件（包含完整运行环境）
function saveAsStandaloneDolwrt() {
  const currentCode = codeInput.value;
  const newHTML = fullHTML.replace(
    /<textarea id="codeInput"([\s\S]*?)><\/textarea>/,
    `<textarea id="codeInput"$1>${currentCode.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</textarea>`
  );
  const blob = new Blob([newHTML], { type: 'text/html' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'donglaugol_app.dolwrt';
  a.click();
  URL.revokeObjectURL(url);
  dolLog('✅ 可独立运行的.dolwrt文件已保存，双击即可运行', 'suc');
}

// 打开并运行.dolwrt文件
function openAndRunDolwrt() {
  const fileInput = document.createElement('input');
  fileInput.type = 'file';
  fileInput.accept = '.dolwrt,.dol';
  fileInput.style.display = 'none';
  fileInput.onchange = (e) => {
    const file = e.target.files[0];
    const reader = new FileReader();
    reader.onload = (ev) => {
      const content = ev.target.result;
      // 提取代码
      if (content.includes('<textarea id="codeInput"')) {
        const match = content.match(/<textarea id="codeInput"([\s\S]*?)>([\s\S]*?)<\/textarea>/);
        if (match) {
          codeInput.value = match[2].replace(/&lt;/g, '<').replace(/&gt;/g, '>');
        } else {
          codeInput.value = content;
        }
      } else {
        codeInput.value = content;
      }
      dolLog(`📂 已加载文件: ${file.name}`, 'suc');
      // 自动运行
      setTimeout(() => {
        dolLog(`▶️ 正在运行 ${file.name}...`, 'info');
        originalRun();
      }, 500);
    };
    reader.readAsText(file, 'UTF-8');
  };
  document.body.appendChild(fileInput);
  fileInput.click();
  document.body.removeChild(fileInput);
}

// 拖放支持
function setupDragDrop() {
  const dropZone = document.body;
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.style.border = '2px dashed #5a7ca3';
  });
  dropZone.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dropZone.style.border = 'none';
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.style.border = 'none';
    
    const file = e.dataTransfer.files[0];
    if (file && (file.name.endsWith('.dolwrt') || file.name.endsWith('.dol'))) {
      const reader = new FileReader();
      reader.onload = (ev) => {
        const content = ev.target.result;
        if (content.includes('<textarea id="codeInput"')) {
          const match = content.match(/<textarea id="codeInput"([\s\S]*?)>([\s\S]*?)<\/textarea>/);
          if (match) {
            codeInput.value = match[2].replace(/&lt;/g, '<').replace(/&gt;/g, '>');
          }
        } else {
          codeInput.value = content;
        }
        dolLog(`📂 已拖放加载: ${file.name}`, 'suc');
      };
      reader.readAsText(file, 'UTF-8');
    } else {
      dolLog('>>> A ERROR BUG', 'err');
      dolLog('>❌Error!!! [stop run 1 line(code)] ', 'err');
      dolLog('Error:! Because @dol can not like this format Please try again leter', 'err');
      dolLog('only : .dolwrt / .dol <<<|end output log ', 'err');
    }
  });
}

// 页面加载时初始化拖放支持
setupDragDrop();

// ==================================================
// ========== 【.dolwrt 格式新指令解析器】 ==========
// ==================================================
const dolwrtModules = {
  output: false,
  input: false,
  page: false,
  photo: false,
  text: false,
  start: false
};

const dolwrtPages = {};
let currentDolwrtPage = null;
let dolwrtInputHint = '';

function parseDolwrtFormatCmd(cmd) {
  const line = cmd.trim();

  // =import & use is<模块>% - 导入模块
  const importMatch = line.match(/^=import & use is<([^>]+)>%$/);
  if (importMatch) {
    const module = importMatch[1].toLowerCase();
    if (dolwrtModules.hasOwnProperty(module)) {
      dolwrtModules[module] = true;
      dolLog(`📦 已导入模块: ${module}`, 'suc');
    } else {
      dolLog(`❌ 未知模块: ${module}`, 'err');
    }
    return true;
  }

  // write.ot<文本> - 输出文本
  const writeMatch = line.match(/^write\.ot<([^>]+)>$/);
  if (writeMatch) {
    const text = writeMatch[1];
    dolLog(text, 'out');
    return true;
  }

  // photo<图片.png> - 显示图片
  const photoMatch = line.match(/^photo<([^>]+)>$/);
  if (photoMatch) {
    const imgPath = photoMatch[1];
    const img = document.createElement('img');
    img.src = imgPath;
    img.style.maxWidth = '400px';
    img.style.maxHeight = '300px';
    img.style.borderRadius = '8px';
    img.style.margin = '10px 0';
    img.onerror = () => {
      dolLog(`❌ 图片加载失败: ${imgPath}`, 'err');
    };
    document.body.appendChild(img);
    allComponents.push(img);
    dolLog(`🖼️ 图片已显示: ${imgPath}`, 'suc');
    return true;
  }

  // text_(颜色) - 颜色文本标记
  const textColorMatch = line.match(/^text_([^)]+)$/);
  if (textColorMatch) {
    const color = textColorMatch[1];
    const colorMap = {
      'red': '#ff6666', 'green': '#44ff44', 'blue': '#6666ff',
      'yellow': '#ffff44', 'purple': '#ff66ff', 'orange': '#ffaa00',
      'white': '#ffffff', 'black': '#000000', 'gray': '#888888'
    };
    const targetColor = colorMap[color.toLowerCase()] || color;
    const colorDiv = document.createElement('div');
    colorDiv.style.color = targetColor;
    colorDiv.style.fontWeight = 'bold';
    colorDiv.style.margin = '5px 0';
    colorDiv.textContent = `[颜色: ${color}]`;
    document.body.appendChild(colorDiv);
    allComponents.push(colorDiv);
    return true;
  }

  // start*/ 去往的文件.html = - 跳转到文件
  const startMatch = line.match(/^start\*\/\s*([^\s=]+)\s*=$/);
  if (startMatch) {
    const target = startMatch[1];
    window.location.href = target;
    dolLog(`🚀 正在跳转: ${target}`, 'info');
    return true;
  }

  // start.n*/ 去往的文件.html =[几秒后进入] - 延迟跳转
  const startNMatch = line.match(/^start\.n\*\/\s*([^\s=]+)\s*=\[([^\]]+)\]$/);
  if (startNMatch) {
    const target = startNMatch[1];
    const delaySec = parseFloat(startNMatch[2]);
    if (!isNaN(delaySec)) {
      dolLog(`⏳ ${delaySec}秒后跳转到: ${target}`, 'info');
      setTimeout(() => {
        window.location.href = target;
      }, delaySec * 1000);
    } else {
      dolLog(`❌ 无效的延迟时间: ${startNMatch[2]}`, 'err');
    }
    return true;
  }

  // start.b*/ 去往的格式文件 =[按钮名] - 按钮跳转
  const startBMatch = line.match(/^start\.b\*\/\s*([^\s=]+)\s*=\[([^\]]+)\]$/);
  if (startBMatch) {
    const target = startBMatch[1];
    const btnName = startBMatch[2];
    const btn = document.createElement('button');
    btn.className = 'custom-btn';
    btn.textContent = btnName;
    btn.onclick = () => {
      window.location.href = target;
    };
    btn.style.position = 'static';
    btn.style.display = 'inline-block';
    document.body.appendChild(btn);
    allComponents.push(btn);
    dolLog(`🔘 已创建跳转按钮: ${btnName} -> ${target}`, 'suc');
    return true;
  }

  // start.w.b*/ 网址 =[按钮名] - URL按钮跳转
  const startWBMatch = line.match(/^start\.w\.b\*\/\s*([^\s=]+)\s*=\[([^\]]+)\]$/);
  if (startWBMatch) {
    const url = startWBMatch[1];
    const btnName = startWBMatch[2];
    const fullUrl = url.startsWith('http') ? url : 'https://' + url;
    const btn = document.createElement('button');
    btn.className = 'custom-btn';
    btn.textContent = btnName;
    btn.onclick = () => {
      window.open(fullUrl, '_blank');
    };
    btn.style.position = 'static';
    btn.style.display = 'inline-block';
    document.body.appendChild(btn);
    allComponents.push(btn);
    dolLog(`🔗 已创建URL按钮: ${btnName} -> ${fullUrl}`, 'suc');
    return true;
  }

  // start.Google*/ www.google.com =now@dol @gc - 快速跳转到Google
  const startGoogleMatch = line.match(/^start\.Google\*\/\s*([^\s=]+)\s*=now@dol\s+@gc$/);
  if (startGoogleMatch) {
    const url = startGoogleMatch[1];
    const fullUrl = url.startsWith('http') ? url : 'https://' + url;
    window.open(fullUrl, '_blank');
    dolLog(`🔍 已打开: ${fullUrl}`, 'suc');
    return true;
  }

  // start.Microsoft*/ www.msn.com =now@dol @me - 快速跳转到Microsoft
  const startMsMatch = line.match(/^start\.Microsoft\*\/\s*([^\s=]+)\s*=now@dol\s+@me$/);
  if (startMsMatch) {
    const url = startMsMatch[1];
    const fullUrl = url.startsWith('http') ? url : 'https://' + url;
    window.open(fullUrl, '_blank');
    dolLog(`🔷 已打开: ${fullUrl}`, 'suc');
    return true;
  }

  // start.jikl;b(数值) - 特殊跳转指令
  const startJiklMatch = line.match(/^start\.jikl;b\(([\d.]+)\)$/);
  if (startJiklMatch) {
    const value = parseFloat(startJiklMatch[1]);
    dolLog(`🔢 跳转参数: ${value}`, 'info');
    return true;
  }

  // /dol/end.full.run - 完整运行结束
  if (line === '/dol/end.full.run') {
    dolLog('🏁 程序运行结束', 'run');
    return true;
  }

  // new.page.name<新网页名>=page.photo<新网页头像> - 新建页面
  const newPageMatch = line.match(/^new\.page\.name<([^>]+)>=page\.photo<([^>]+)>$/);
  if (newPageMatch) {
    const pageName = newPageMatch[1];
    const pagePhoto = newPageMatch[2];
    dolwrtPages[pageName] = { photo: pagePhoto, content: [] };
    currentDolwrtPage = pageName;
    dolLog(`📄 新建页面: ${pageName} (头像: ${pagePhoto})`, 'suc');
    return true;
  }

  //    write.ot<文本>in@page - 在页面中写文本（页面作用域）
  const pageWriteMatch = line.match(/^-\+-write\.ot<([^>]+)>in@page$/);
  if (pageWriteMatch) {
    const text = pageWriteMatch[1];
    if (currentDolwrtPage && dolwrtPages[currentDolwrtPage]) {
      dolwrtPages[currentDolwrtPage].content.push({ type: 'text', content: text });
      dolLog(`📝 已写入页面 [${currentDolwrtPage}]: ${text}`, 'out');
    } else {
      dolLog(`❌ 请先创建页面: new.page.name<名称>=page.photo<头像>`, 'err');
    }
    return true;
  }

  //    show.ph<图片.png>in@page - 在页面中显示图片（页面作用域）
  const pagePhotoMatch = line.match(/^-\+-show\.ph<([^>]+)>in@page$/);
  if (pagePhotoMatch) {
    const imgPath = pagePhotoMatch[1];
    if (currentDolwrtPage && dolwrtPages[currentDolwrtPage]) {
      dolwrtPages[currentDolwrtPage].content.push({ type: 'photo', content: imgPath });
      dolLog(`🖼️ 已添加图片到页面 [${currentDolwrtPage}]: ${imgPath}`, 'suc');
    } else {
      dolLog(`❌ 请先创建页面: new.page.name<名称>=page.photo<头像>`, 'err');
    }
    return true;
  }

  //    input.hint.tg<提示文本> - 输入框提示（页面作用域）
  const pageInputHintMatch = line.match(/^-\+-input\.hint\.tg<([^>]+)>$/);
  if (pageInputHintMatch) {
    const hint = pageInputHintMatch[1];
    if (currentDolwrtPage && dolwrtPages[currentDolwrtPage]) {
      dolwrtPages[currentDolwrtPage].content.push({ type: 'input', content: hint });
      dolLog(`📥 已添加输入框到页面 [${currentDolwrtPage}]: ${hint}`, 'info');
    } else {
      dolLog(`❌ 请先创建页面: new.page.name<名称>=page.photo<头像>`, 'err');
    }
    return true;
  }

  // input.hint.tg<提示文本> - 输入框提示文字
  const inputHintMatch = line.match(/^input\.hint\.tg<([^>]+)>$/);
  if (inputHintMatch) {
    dolwrtInputHint = inputHintMatch[1];
    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'custom-input';
    input.placeholder = dolwrtInputHint;
    input.style.position = 'static';
    input.style.width = '100%';
    input.style.maxWidth = '400px';
    document.body.appendChild(input);
    allComponents.push(input);
    dolLog(`📥 已创建输入框: ${dolwrtInputHint}`, 'info');
    return true;
  }

  // input key<密码>=goto.webpage<网址> - 密码验证跳转
  const inputKeyMatch = line.match(/^input key<([^>]+)>=goto\.webpage<([^>]+)>$/);
  if (inputKeyMatch) {
    const password = inputKeyMatch[1];
    const url = inputKeyMatch[2];
    const fullUrl = url.startsWith('http') ? url : 'https://' + url;
    
    const wrapper = document.createElement('div');
    wrapper.style.margin = '10px 0';
    
    const input = document.createElement('input');
    input.type = 'password';
    input.className = 'custom-input';
    input.placeholder = '输入密码';
    input.style.position = 'static';
    input.style.width = '250px';
    
    const btn = document.createElement('button');
    btn.className = 'custom-btn';
    btn.textContent = '验证';
    btn.style.position = 'static';
    btn.style.display = 'inline-block';
    btn.style.marginLeft = '10px';
    
    btn.onclick = () => {
      if (input.value === password) {
        dolLog(`✅ 密码正确，正在跳转...`, 'suc');
        window.open(fullUrl, '_blank');
      } else {
        dolLog(`❌ 密码错误`, 'err');
        playSound('error');
      }
    };
    
    wrapper.appendChild(input);
    wrapper.appendChild(btn);
    document.body.appendChild(wrapper);
    allComponents.push(wrapper);
    dolLog(`🔐 密码验证已设置`, 'info');
    return true;
  }

  // input text<输入文本>=output<输出有作用指令> - 输入触发输出
  const inputTextMatch = line.match(/^input text<([^>]+)>=output<([^>]+)>$/);
  if (inputTextMatch) {
    const triggerText = inputTextMatch[1];
    const outputCmd = inputTextMatch[2];
    
    const wrapper = document.createElement('div');
    wrapper.style.margin = '10px 0';
    
    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'custom-input';
    input.placeholder = '输入文本';
    input.style.position = 'static';
    input.style.width = '250px';
    
    const btn = document.createElement('button');
    btn.className = 'custom-btn';
    btn.textContent = '执行';
    btn.style.position = 'static';
    btn.style.display = 'inline-block';
    btn.style.marginLeft = '10px';
    
    btn.onclick = () => {
      if (input.value.trim() === triggerText) {
        dolLog(`✅ 匹配成功，执行: ${outputCmd}`, 'suc');
        parseDolwrtFormatCmd(outputCmd);
      } else {
        dolLog(`❌ 输入不匹配`, 'err');
      }
    };
    
    wrapper.appendChild(input);
    wrapper.appendChild(btn);
    document.body.appendChild(wrapper);
    allComponents.push(wrapper);
    dolLog(`🔗 输入绑定已设置: "${triggerText}" -> "${outputCmd}"`, 'info');
    return true;
  }

  // input<文本>=<文本>too - 输入文本等于文本
  const inputEqMatch = line.match(/^input<([^>]+)>=(.+?)too$/);
  if (inputEqMatch) {
    const inputVal = inputEqMatch[1];
    const outputVal = inputEqMatch[2].trim();
    dolLog(`📥 输入: "${inputVal}" = "${outputVal}"`, 'out');
    return true;
  }

  // photo.gallery<photo.1>from@dol - 从dol加载图片库
  const galleryMatch = line.match(/^photo\.gallery<([^>]+)>from@dol$/);
  if (galleryMatch) {
    const photoId = galleryMatch[1];
    dolLog(`🖼️ 图片库加载: ${photoId}`, 'info');
    return true;
  }

  // text<文件.txt>in @output - 输出文件内容
  const textFileMatch = line.match(/^text<([^>]+)>in @output$/);
  if (textFileMatch) {
    const fileName = textFileMatch[1];
    dolLog(`📄 输出文件内容: ${fileName}`, 'info');
    return true;
  }

  // text<文本>download name <文本.txt>download at run@dol - 下载文本
  const textDownloadMatch = line.match(/^text<([^>]+)>download name <([^>]+)>download at run@dol$/);
  if (textDownloadMatch) {
    const content = textDownloadMatch[1];
    const fileName = textDownloadMatch[2];
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    a.click();
    URL.revokeObjectURL(url);
    dolLog(`📥 已下载: ${fileName}`, 'suc');
    return true;
  }

  // @dol @o( ... ) - dol块
  const dolBlockMatch = line.match(/^@dol @o\(\s*$/);
  if (dolBlockMatch) {
    dolLog(`📦 进入 dol 块`, 'info');
    return true;
  }

  // =import @nb [start] need you+b! - 导入按钮模块
  const nbImportMatch = line.match(/^=import @nb \[start\] need you\+b!$/);
  if (nbImportMatch) {
    dolLog(`📦 已导入按钮模块 (@nb)`, 'suc');
    return true;
  }

  // =import @nr [start] need you+b! - 导入开关模块
  const nrImportMatch = line.match(/^=import @nr \[start\] need you\+b!$/);
  if (nrImportMatch) {
    dolLog(`📦 已导入开关模块 (@nr)`, 'suc');
    return true;
  }

  // sys.about*/ cn log system about = - 系统状态信息
  if (line === 'sys.about*/ cn log system about =') {
    dolLog('📤 获取系统状态信息...', 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('           系统状态信息', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(`🖥️ 浏览器: ${navigator.userAgent.split(' ').slice(-1)[0]}`, 'info');
    try {
      if (performance.memory) {
        dolLog(`💾 内存: ${Math.round(performance.memory.usedJSHeapSize / 1024 / 1024)}MB / ${Math.round(performance.memory.totalJSHeapSize / 1024 / 1024)}MB`, 'info');
      } else {
        dolLog('💾 内存: 不可用', 'warn');
      }
    } catch (e) {
      dolLog('💾 内存: 不可用', 'warn');
    }
    dolLog(`🌐 在线状态: ${navigator.onLine ? '在线' : '离线'}`, navigator.onLine ? 'suc' : 'err');
    dolLog(`📍 语言: ${navigator.language}`, 'info');
    dolLog(`🖱️ 平台: ${navigator.platform}`, 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    return true;
  }

  // sys.about*/ cn log tdn = - 运行环境信息
  if (line === 'sys.about*/ cn log tdn =') {
    dolLog('📤 获取运行环境信息...', 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('           运行环境信息', 'suc');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    dolLog('', 'out');
    dolLog(`🕐 当前时间: ${new Date().toLocaleString('zh-CN')}`, 'info');
    dolLog(`📐 屏幕分辨率: ${screen.width} × ${screen.height}`, 'info');
    dolLog(`🔍 视口大小: ${window.innerWidth} × ${window.innerHeight}`, 'info');
    dolLog(`🎨 颜色深度: ${screen.colorDepth}位`, 'info');
    dolLog(`📊 像素比: ${window.devicePixelRatio}`, 'info');
    dolLog('', 'out');
    dolLog('═══════════════════════════════════════════════════════════', 'out');
    return true;
  }

  // =import & use<dol.br.app.system> - 导入运行窗口系统模块
  if (line === '=import & use<dol.br.app.system>') {
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = {
        icon: DOL_DEFAULT_ICON,
        name: null,
        windows: []
      };
    }
    dolLog(`📦 已导入运行窗口系统模块 (dol.br.app.system)`, 'suc');
    return true;
  }

  if (!window.dolRunningWindows) {
    window.dolRunningWindows = {
      icon: DOL_DEFAULT_ICON,
      name: null,
      windows: []
    };
  }

  // running-windows.photo<运行窗口图标.png> - 设置运行窗口图标
  const runningPhotoMatch = line.match(/^running-windows\.photo<([^>]+)>$/);
  if (runningPhotoMatch) {
    const iconPath = runningPhotoMatch[1];
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    window.dolRunningWindows.icon = iconPath;
    dolLog(`🖼️ 运行窗口图标已设置: ${iconPath}`, 'suc');
    return true;
  }

  // /dol/ae.icon<icon.png> - 设置运行窗口图标
  const dolIconMatch = line.match(/^\/dol\/ae\.icon<([^>]+)>$/);
  if (dolIconMatch) {
    const iconPath = dolIconMatch[1];
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    window.dolRunningWindows.icon = iconPath;
    dolLog(`🖼️ 运行窗口图标已设置: ${iconPath}`, 'suc');
    return true;
  }

  // =import & use<icon>% - 导入图标模块
  if (line === '=import & use<icon>%') {
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    dolLog(`📦 已导入图标模块`, 'suc');
    return true;
  }

  // icon.as<icon.png> - 设置图标为图片
  const iconAsMatch = line.match(/^icon\.as<([^>]+)>$/);
  if (iconAsMatch) {
    const iconPath = iconAsMatch[1];
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    window.dolRunningWindows.icon = iconPath;
    dolLog(`🖼️ 图标已设置为图片: ${iconPath}`, 'suc');
    return true;
  }

  // icon.as.ac<其他> - 设置图标为其他类型（如emoji）
  const iconAsAcMatch = line.match(/^icon\.as\.ac<([^>]+)>$/);
  if (iconAsAcMatch) {
    const content = iconAsAcMatch[1];
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    window.dolRunningWindows.icon = content;
    dolLog(`🖼️ 图标已设置为: ${content}`, 'suc');
    return true;
  }

  // icon.as.et<文字/表情> - 设置图标为文字或表情
  const iconAsEtMatch = line.match(/^icon\.as\.et<([^>]+)>$/);
  if (iconAsEtMatch) {
    const emoji = iconAsEtMatch[1];
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    window.dolRunningWindows.customIconType = 'emoji';
    window.dolRunningWindows.customIconContent = emoji;
    window.dolRunningWindows.icon = null;
    dolLog(`🖼️ 图标已设置为表情: ${emoji}`, 'suc');
    return true;
  }

  // =import & use<name>% - 导入名称模块
  if (line === '=import & use<name>%') {
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    dolLog(`📦 已导入名称模块`, 'suc');
    return true;
  }

  // page.name<名字> - 设置运行窗口标题名称
  const pageNameMatch = line.match(/^page\.name<([^>]+)>$/);
  if (pageNameMatch) {
    const name = pageNameMatch[1];
    if (!window.dolRunningWindows) {
      window.dolRunningWindows = { icon: DOL_DEFAULT_ICON, name: null, windows: [] };
    }
    window.dolRunningWindows.name = name;
    dolLog(`🖼️ 运行窗口名称已设置: ${name}`, 'suc');
    return true;
  }

  // running-close.error - 破坏运行区（关闭所有运行窗口）
  if (line === 'running-close.error') {
    if (window.dolRunningWindows && window.dolRunningWindows.windows.length > 0) {
      window.dolRunningWindows.windows.forEach(win => {
        try {
          win.remove();
        } catch (e) {}
      });
      window.dolRunningWindows.windows = [];
      dolLog(`💥 运行区已破坏，所有运行窗口已关闭`, 'err');
    } else {
      dolLog(`❌ 运行区为空，没有可关闭的窗口`, 'warn');
    }
    return true;
  }

  // close.r.window at<几秒后关闭窗口> - 延迟关闭运行窗口
  const closeRWindowMatch = line.match(/^close\.r\.window at<([^>]+)>$/);
  if (closeRWindowMatch) {
    const delaySec = parseFloat(closeRWindowMatch[1]);
    if (!isNaN(delaySec) && delaySec >= 0) {
      dolLog(`⏳ ${delaySec}秒后关闭运行窗口`, 'info');
      setTimeout(() => {
        if (window.dolRunningWindows && window.dolRunningWindows.windows.length > 0) {
          const win = window.dolRunningWindows.windows.pop();
          try {
            win.remove();
            dolLog(`✅ 运行窗口已关闭`, 'suc');
          } catch (e) {
            dolLog(`❌ 关闭运行窗口失败`, 'err');
          }
        }
      }, delaySec * 1000);
    } else {
      dolLog(`❌ 无效的延迟时间: ${closeRWindowMatch[1]}`, 'err');
    }
    return true;
  }

  return false;
}

// ==================================================
// ========== 【DOL.3D 代码块预处理】 ==========
// 支持两种格式：
// 格式1：/dol/3Dfabric<长>*<宽> ... <dol.3d> (3空格缩进)
// 格式2：<dol.3d> ... <3dms> (原格式)
// ==================================================
function preprocessDol3dBlocks(codeText) {
  const lines = codeText.split('\n');
  const result = [];
  let in3dBlock = false;
  let blockLineCount = 0;
  let fabricCmd = '';

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const trimmed = line.trim();

    // 格式1：开头 /dol/3Dfabric<长>*<宽>
    if (trimmed.startsWith('/dol/3Dfabric')) {
      in3dBlock = true;
      blockLineCount = 0;
      fabricCmd = trimmed;
      result.push('# ======== DOL.3D 建模语言区块开始 ========');
      result.push(fabricCmd);
      continue;
    }

    // 格式1：结尾 <dol.3d>
    if (trimmed === '<dol.3d>' && in3dBlock && fabricCmd) {
      in3dBlock = false;
      result.push(`# ======== DOL.3D 区块结束 (共${blockLineCount}条指令) ========`);
      fabricCmd = '';
      continue;
    }

    // 格式2：开头 <dol.3d>
    if (trimmed === '<dol.3d>' && !in3dBlock) {
      in3dBlock = true;
      blockLineCount = 0;
      result.push('# ======== DOL.3D 建模语言区块开始 ========');
      continue;
    }

    // 格式2：结尾 <3dms>
    if (trimmed === '<3dms>') {
      in3dBlock = false;
      result.push(`# ======== DOL.3D 区块结束 (共${blockLineCount}条指令) ========`);
      continue;
    }

    if (in3dBlock) {
      if (trimmed === '' || trimmed.startsWith('#') || trimmed.startsWith('//')) {
        result.push(line);
        continue;
      }
      // 如果是格式1，需要检查是否有3空格缩进
      if (fabricCmd && !line.startsWith('   ')) {
        // 格式1要求3空格缩进，否则不处理
        result.push(line);
        continue;
      }
      let cmd = trimmed;
      if (!cmd.startsWith('/3d/') && !cmd.startsWith('/')) {
        cmd = '/3d/' + cmd;
      }
      result.push(cmd);
      blockLineCount++;
    } else {
      result.push(line);
    }
  }

  return result.join('\n');
}

// ==================================================
// ========== 【核心修改：原run函数重命名为originalRun，保留完整逻辑】 ==========
// ==================================================
function originalRun() {
  codeInput.classList.add('hide');
  // ========== 新增：隐藏左上角4个按钮 ==========
  document.querySelectorAll('button:not(.custom-btn):not(.sys-square-btn):not(.dol-window-close):not(.sys-win-close)').forEach(btn => {
    btn.classList.add('hide');
  });
  clearAll();
  dolUserInputValue = '';
  let rawCode = codeInput.value;
  rawCode = preprocessDol3dBlocks(rawCode);
  const code = rawCode.trim().split('\n').filter(line => line.trim() !== '');
  code.forEach(cmd => {
    let line = cmd.trim();
    // ========== 剥离内联注释（# 或 // 开头的部分） ==========
    const commentMatch = line.match(/(\s+#.*|\s+\/\/.*)$/);
    if (commentMatch) {
      line = line.substring(0, line.length - commentMatch[1].length);
    }
    // ========== 20260505 新增指令优先解析 不影响原有逻辑 ==========
    // 0. 宣誓指令（优先检查）
    if (parseOathCmd(line)) return;
    // 0.5 .dolwrt 格式新指令（优先检查，避免与其他解析器冲突）
    if (parseDolwrtFormatCmd(line)) return;
    // 1. 手机软件跳转指令
    if (parsePhoneAppCmd(line)) return;
    if (parseSysPhoneAppCmd(line)) return;
    // 2. 黑客模式指令
    if (line.startsWith('   ') && parseHackerCommand(line)) return;
    // 3. 黑科技功能指令
    if (parseVoiceControl(line)) return;
    if (parseFpsMonitor(line)) return;
    if (parseFileIndex(line)) return;
    // 4. AI文件夹监听指令
    if (parseFolderWatch(line)) return;
    if (parseFolderLog(line)) return;
    // ========== 原有新增指令优先解析 ==========
    if (parseAutoClean(line)) return;
    if (parseAutoLight(line)) return;
    if (parseAutoCamera(line)) return;
    if (parseAutoRun(line)) return;
    if (parseOpenPhAppCmd(line)) return;
    if (parsePhotoshowCmd(line)) return;
    if (parseWoAboutCmd(line)) return;
    if (parseSoundCmd(line)) return;
    if (parseMkCmd(line)) return;
    if (parseLkCmd(line)) return;
    if (parseKnCmd(line)) return;
    if (parseCommentCmd(line)) return;
    if (parseOpenUrlCmd(line)) return;
    if (parseAlertCmd(line)) return;
    if (parseScreenTextCmd(line)) return;
    if (parseCustomInputCmd(line)) return;
    if (parseFileStealCmd(line)) return;
    if (parseDanmuCmd(line)) return;
    if (parseByeGo(line)) return;
