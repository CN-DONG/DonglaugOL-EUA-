      border-bottom:1px solid rgba(255,255,255,0.05);
    `;
    const saveBtn = document.createElement('button');
    saveBtn.textContent = '💾 保存输出';
    saveBtn.style.cssText = `
      padding:4px 14px;font-size:13px;border-radius:9999px;border:1px solid rgba(255,255,255,0.15);
      background:linear-gradient(180deg,rgba(80,215,150,0.5),rgba(39,174,96,0.4));
      color:#fff;cursor:pointer;font-family:monospace;
    `;
    const copyBtn = document.createElement('button');
    copyBtn.textContent = '📋 复制';
    copyBtn.style.cssText = `
      padding:4px 14px;font-size:13px;border-radius:9999px;border:1px solid rgba(255,255,255,0.15);
      background:linear-gradient(180deg,rgba(100,180,255,0.5),rgba(60,140,220,0.4));
      color:#fff;cursor:pointer;font-family:monospace;
    `;
    const clearBtn = document.createElement('button');
    clearBtn.textContent = '🗑️ 清空';
    clearBtn.style.cssText = `
      padding:4px 14px;font-size:13px;border-radius:9999px;border:1px solid rgba(255,255,255,0.15);
      background:linear-gradient(180deg,rgba(255,100,100,0.4),rgba(200,60,60,0.3));
      color:#fff;cursor:pointer;font-family:monospace;
    `;
    const outputBox = document.createElement('textarea');
    outputBox.readOnly = true;
    outputBox.style.cssText = `
      width:100%;height:${height}px;background:transparent;color:#a8b9a8;
      padding:10px 12px;border:none;outline:none;resize:none;font-size:14px;
      font-family:monospace;line-height:1.5;
    `;
    outputBox.placeholder = '输出内容将显示在这里...';

    saveBtn.onclick = () => {
      const text = outputBox.value;
      if (!text) { dolLog('⚠️ 输出为空', 'warn'); return; }
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'output_' + Date.now() + '.txt';
      a.click();
      URL.revokeObjectURL(url);
      dolLog('💾 输出已保存！', 'suc');
      playSound('success');
    };
    copyBtn.onclick = () => {
      const text = outputBox.value;
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = '✅ 已复制';
          setTimeout(() => copyBtn.textContent = '📋 复制', 1500);
          playSound('success');
        }).catch(() => {
          outputBox.select();
          document.execCommand('copy');
          copyBtn.textContent = '✅ 已复制';
          setTimeout(() => copyBtn.textContent = '📋 复制', 1500);
        });
      }
    };
    clearBtn.onclick = () => { outputBox.value = ''; playSound('click'); };

    btnBar.appendChild(saveBtn);
    btnBar.appendChild(copyBtn);
    btnBar.appendChild(clearBtn);
    wrapper.appendChild(btnBar);
    wrapper.appendChild(outputBox);
    document.body.appendChild(wrapper);
    allComponents.push(wrapper);

    // 同步输出
    const syncInterval = setInterval(() => {
      const outEl = document.querySelector('.dol-output');
      if (outEl) {
        const text = outEl.innerText || outEl.textContent;
        if (text !== outputBox.value) {
          outputBox.value = text;
          outputBox.scrollTop = outputBox.scrollHeight;
        }
      }
    }, 500);
    wrapper._syncInterval = syncInterval;

    dolLog('📝 可保存输出框已创建', 'suc');
    return true;
  }

  return false;
}
function parseDolDraw(cmd) {
  const canvasList = document.querySelectorAll('.dol-canvas');
  const canvas = canvasList[canvasList.length - 1];
  if (!canvas) {
    dolLog('❌ 请先创建画布：/dol/canvas<宽>*<高>', 'err');
    return false;
  }
  const ctx = canvas.getContext('2d');
  const centerX = canvas.width / 2;
  const centerY = canvas.height / 2;
  if (cmd === '/ig/draw#draw') {
    dolIsDrawing = !dolIsDrawing;
    dolLog(dolIsDrawing ? '✅ Drawing feature enabled' : '❌ Drawing feature disabled', 'out');
    return true;
  }
  const sizeMatch = cmd.match(/^dr-gt(\d+\.?\d*)$/);
  if (sizeMatch) {
    dolBrushSize = parseFloat(sizeMatch[1]) || 2;
    ctx.lineWidth = dolBrushSize;
    dolLog(`🖌️ Brush size set to: ${dolBrushSize}px`, 'out');
    return true;
  }
  const shapeMatch = cmd.match(/^dr-sp\s+(\w+)$/);
  if (shapeMatch) {
    const shape = shapeMatch[1];
    if (shape === 'circle') {
      ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      dolLog(`🟢 Brush shape set to: Round`, 'out');
    } else if (shape === 'square') {
      ctx.lineCap = 'square'; ctx.lineJoin = 'square';
      dolLog(`🟢 Brush shape set to: Square`, 'out');
    }
    return true;
  }
  const shapeDrawMatch = cmd.match(/^\/dr\/,\{(\w+)\}:<(\d+)>\*<(\d+)>$/);
  if (shapeDrawMatch) {
    const [, shape, w, h] = shapeDrawMatch;
    ctx.beginPath();
    switch(shape) {
      case 'ci_e': ctx.arc(centerX, centerY, w/2, 0, 2*Math.PI); break;
      case 'qu_e': ctx.rect(centerX - w/2, centerY - h/2, w, h); break;
      case 'sl_e':
        ctx.moveTo(centerX, centerY - h/2);
        ctx.lineTo(centerX - w/2, centerY + h/2);
        ctx.lineTo(centerX + w/2, centerY + h/2);
        ctx.closePath();
        break;
      case 'li_e': ctx.moveTo(centerX - w/2, centerY); ctx.lineTo(centerX + w/2, centerY); break;
      case '/j_e':
        ctx.moveTo(centerX, centerY);
        ctx.lineTo(centerX + w, centerY);
        ctx.moveTo(centerX, centerY);
        ctx.lineTo(centerX, centerY + h);
        break;
      case '/c_e': ctx.roundRect(centerX - w/2, centerY - h/2, w, h, 20); break;
      case 'sk_e':
        ctx.moveTo(centerX, centerY - h/2);
        ctx.lineTo(centerX + w/2, centerY);
        ctx.lineTo(centerX, centerY + h/2);
        ctx.lineTo(centerX - w/2, centerY);
        ctx.closePath();
        break;
      default: dolLog(`❌ Unknow shape: ${shape}`, 'err'); return false;
    }
    ctx.fill();
    ctx.stroke();
    dolLog(`✅ Draw shape [${shape}] success! Size: ${w}×${h}`, 'run');
    return true;
  }
  return false;
}
function parseDolLightColor(cmd) {
  const lightList = document.querySelectorAll('.dol-light');
  const light = lightList[lightList.length - 1];
  if (!light) return false;
  const reg = /^\/ig\/line\s+(.+)$/;
  const match = cmd.match(reg);
  if (!match) return false;
  const color = match[1].toLowerCase();
  const colorMap = {
    'red': '#ff0000', 'green': '#00ff44', 'yellow': '#ffff00', 'blue': '#0066ff'
  };
  const targetColor = colorMap[color] || color;
  light.style.background = targetColor;
  light.style.boxShadow = `0 0 40px ${targetColor}`;
  dolLog(`Light Set: ${color}`, 'out');
  return true;
}
function dolPlayNote(note) {
  if (![1,2,3,4,5,6,7].includes(note)) {
    dolLog(`❌ 音符错误！仅支持1(哆)-7(西)`, 'err');
    return;
  }
  if (!dolMusicContext) {
    dolMusicContext = new (window.AudioContext || window.webkitAudioContext)();
  }
  const oscillator = dolMusicContext.createOscillator();
  const gainNode = dolMusicContext.createGain();
  oscillator.type = 'sine';
  oscillator.frequency.value = noteFrequencies[note][dolMusicTone - 1];
  gainNode.gain.value = 0.3;
  oscillator.connect(gainNode);
  gainNode.connect(dolMusicContext.destination);
  oscillator.start();
  oscillator.stop(dolMusicContext.currentTime + dolMusicDuration / 1000);
  oscillator.onended = () => {
    oscillator.disconnect();
    gainNode.disconnect();
  };
  const noteName = {1:'哆',2:'瑞',3:'咪',4:'发',5:'嗦',6:'啦',7:'西'}[note];
  dolLog(`🎵 演奏 ${noteName}(${note}) | 音调：${dolMusicTone} | 时长：${dolMusicDuration}ms`, 'music');
  const lightList = document.querySelectorAll('.dol-light');
  const light = lightList[lightList.length - 1];
  if (light) {
    const originalColor = light.style.background || '#0066ff';
    light.style.background = '#ff99cc';
    light.style.boxShadow = '0 0 50px #ff99cc';
    setTimeout(() => {
      light.style.background = originalColor;
      light.style.boxShadow = originalColor ? `0 0 40px ${originalColor}` : '0 0 40px #0066ff';
    }, dolMusicDuration);
  }
}
function parseDolLoop(cmd) {
  const stopMatch = cmd.match(/^loop\.stop$/);
  if (stopMatch) {
    dolLoopQueue = [];
    timerList.forEach(t => clearTimeout(t));
    timerList = [];
    dolLog('Loop Stopped: All loops terminated', 'suc');
    return true;
  }

  const delayMatch = cmd.match(/^loop(\d+)?@([\d.]+)\{([^}]+)\}$/);
  if (delayMatch) {
    const times = delayMatch[1] ? parseInt(delayMatch[1]) : -1;
    const delaySeconds = parseFloat(delayMatch[2]);
    const cmdStr = delayMatch[3].trim();
    if (isNaN(delaySeconds) || delaySeconds < 0 || !cmdStr) {
      dolLog('Loop Err: Use loop[N]@M{cmd} (M≥0)', 'err');
      return false;
    }
    const cmdList = cmdStr.split(';').map(item => item.trim()).filter(item => item !== '');
    const isInfinite = times < 0;
    dolLoopQueue.push({total: times, cur: 1, cmdList: cmdList, delay: delaySeconds * 1000, infinite: isInfinite});
    dolLog(`Loop Init: ${isInfinite ? 'Infinite' : times+' times'} @ ${delaySeconds}s → ${cmdStr}`, 'out');
    execLoopWithDelay();
    return true;
  }

  const infMatch = cmd.match(/^loop\.inf\{([^}]+)\}$/);
  if (infMatch) {
    const cmdStr = infMatch[1].trim();
    if (!cmdStr) {
      dolLog('Loop Err: Use loop.inf{cmd}', 'err');
      return false;
    }
    const cmdList = cmdStr.split(';').map(item => item.trim()).filter(item => item !== '');
    dolLoopQueue.push({total: -1, cur: 1, cmdList: cmdList, delay: 300, infinite: true});
    dolLog(`Loop Init: Infinite → ${cmdStr}`, 'out');
    execLoopWithDelay();
    return true;
  }

  const match = cmd.match(/^loop(\d+)\{([^}]+)\}$/);
  if (!match) return false;
  const times = parseInt(match[1]);
  const cmdStr = match[2].trim();
  if (isNaN(times) || times < 1 || !cmdStr) {
    dolLog('Loop Err: Use loopN{cmd} (N≥1)', 'err');
    return false;
  }
  const cmdList = cmdStr.split(';').map(item => item.trim()).filter(item => item !== '');
  dolLoopQueue.push({total: times, cur: 1, cmdList: cmdList, delay: 300, infinite: false});
  dolLog(`Loop Init: ${times} times → ${cmdStr}`, 'out');
  execLoopWithDelay();
  return true;

  function execLoopWithDelay() {
    const task = dolLoopQueue[0];
    if (!task) return;
    task.cmdList.forEach(line => {
      if (line.startsWith('/ig/line ')) parseDolLightColor(line);
      else if (line.startsWith('pr*/') || line.startsWith('pt<')) parseDolPrint(line);
      else if (line.startsWith('ut[')) parseDolUt(line);
      else if (line.startsWith('music ')) parseDolMusic(line);
      else if (line.startsWith('/dr/,')) parseDolDraw(line);
      else if (line.startsWith('@m<')) parseDolCondition(line);
      else parseDolVar(line);
    });
    if (!task.infinite) {
      task.cur++;
      if (task.cur > task.total) {
        dolLoopQueue.shift();
        dolLog(`Loop Done: ${task.total} times`, 'out');
        return;
      }
    }
    const timerId = setTimeout(execLoopWithDelay, task.delay);
    timerList.push(timerId);
  }
}
function createBaseWindow(title, w, h, x, y, fullscreen = false, showCloseBtn = true) {
  // 修复：创建新窗口前，如果已有同标题窗口则先销毁旧的，防止僵尸DOM堆积
  const existingWin = document.querySelector(`.sys-window[data-win-title="${title}"]`);
  if (existingWin) {
    existingWin.querySelectorAll('video, canvas, iframe, audio').forEach(el => {
      try { el.remove(); } catch(e) {}
    });
    existingWin.remove();
    const idx = allComponents.indexOf(existingWin);
    if (idx > -1) allComponents.splice(idx, 1);
  }
  
  const win = document.createElement('div');
  win.className = 'sys-window';
  win.dataset.winTitle = title;
  
  if (fullscreen) {
    win.style.width = '100vw';
    win.style.height = '100vh';
    win.style.left = '0';
    win.style.top = '0';
    win.style.position = 'fixed';
  } else {
    win.style.width = `${w}px`;
    win.style.height = `${h}px`;
    win.style.left = `${x}px`;
    win.style.top = `${y}px`;
  }
  
  const btnsHTML = showCloseBtn ? `
    <div class="sys-win-btns">
      <div class="sys-win-btn sys-win-minimize" title="最小化">−</div>
      <div class="sys-win-btn sys-win-maximize" title="全屏">□</div>
      <div class="sys-win-btn sys-win-left" title="左半屏">◀</div>
      <div class="sys-win-btn sys-win-right" title="右半屏">▶</div>
      <div class="sys-win-btn sys-win-close" title="关闭">✕</div>
    </div>
  ` : '';
  
  let iconHtml = '';
  if (window.dolRunningWindows) {
    if (window.dolRunningWindows.customIconType === 'emoji') {
      iconHtml = `<span class="win-title-emoji" style="font-size:14px;margin-right:6px;">${window.dolRunningWindows.customIconContent}</span>`;
    } else if (window.dolRunningWindows.icon) {
      iconHtml = `<img src="${window.dolRunningWindows.icon}" class="win-title-icon" alt="">`;
    } else {
      iconHtml = `<img src="${DOL_DEFAULT_ICON}" class="win-title-icon" alt="">`;
    }
  }
  
  const customName = window.dolRunningWindows && window.dolRunningWindows.name ? window.dolRunningWindows.name : title;
  win.innerHTML = `
    <div class="sys-win-title">
      ${iconHtml}
      <span class="win-title-text"></span>
      ${btnsHTML}
    </div>
    <div class="sys-win-content"></div>
    <div class="sys-win-about-text"></div>
  `;
  win.querySelector('.win-title-text').textContent = customName;
  
  if (showCloseBtn) {
    // 隐藏按钮
    win.querySelector('.sys-win-minimize').onclick = () => {
      win.classList.toggle('minimized');
      dolLog(`${win.classList.contains('minimized') ? '🔽' : '🔼'} ${title}已${win.classList.contains('minimized') ? '隐藏' : '展开'}`, 'info');
    };
    
    // 全屏按钮
    win.querySelector('.sys-win-maximize').onclick = () => {
      win.classList.remove('half-screen');
      win.classList.toggle('maximized');
      dolLog(`${win.classList.contains('maximized') ? '📺' : '🖥️'} ${title}已${win.classList.contains('maximized') ? '全屏' : '恢复'}`, 'info');
    };
    
    // 左半屏按钮
    win.querySelector('.sys-win-left').onclick = () => {
      win.classList.remove('maximized', 'half-screen', 'right-screen');
      win.classList.add('left-screen');
      dolLog(`⬅️ ${title}已左半屏`, 'info');
    };
    
    // 右半屏按钮
    win.querySelector('.sys-win-right').onclick = () => {
      win.classList.remove('maximized', 'half-screen', 'left-screen');
      win.classList.add('right-screen');
      dolLog(`➡️ ${title}已右半屏`, 'info');
    };
    
    // 标题栏拖拽移动
    const titleBar = win.querySelector('.sys-win-title');
    let isDragging = false;
    let startX = 0, startY = 0, startLeft = 0, startTop = 0;
    
    titleBar.onmousedown = (e) => {
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      startLeft = parseInt(win.style.left) || 0;
      startTop = parseInt(win.style.top) || 0;
      e.preventDefault();
    };
    
    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      let dx = e.clientX - startX;
      let dy = e.clientY - startY;
      // 修复：限制窗口在屏幕范围内，防止拖出屏幕外找不回来
      let newLeft = startLeft + dx;
      let newTop = startTop + dy;
      newLeft = Math.max(-win.offsetWidth + 80, Math.min(window.innerWidth - 40, newLeft));
      newTop = Math.max(0, Math.min(window.innerHeight - 40, newTop));
      win.style.left = `${newLeft}px`;
      win.style.top = `${newTop}px`;
      win.style.position = 'absolute';
    });
    
    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
      }
    });
    
    // 关闭按钮
    win.querySelector('.sys-win-close').onclick = () => {
      win.querySelectorAll('video').forEach(v => {
        if (v.srcObject) {
          v.srcObject.getTracks().forEach(t => { t.stop(); t.enabled = false; });
          v.srcObject = null;
        }
      });
      win.querySelectorAll('canvas, iframe, audio').forEach(el => { try { el.remove(); } catch(e) {} });
      if (typeof playSound === 'function') playSound('switch');
      win.classList.remove('show');
      win.classList.add('closing');
      setTimeout(() => {
        win.remove();
        const idx = allComponents.indexOf(win);
        if (idx > -1) allComponents.splice(idx, 1);
        const rIdx = window.dolRunningWindows?.windows.indexOf(win);
        if (rIdx > -1) window.dolRunningWindows.windows.splice(rIdx, 1);
        dolLog(`✅ ${title}已关闭`, 'suc');
      }, 260);
    };
  }
  
  document.body.appendChild(win);
  allComponents.push(win);
  if (window.dolRunningWindows) {
    window.dolRunningWindows.windows.push(win);
  }
  if (typeof playSound === 'function') playSound('click');
  requestAnimationFrame(() => {
    win.classList.add('show');
  });
  return win;
}
// ==================================================
// ========== 【BUG修复：仅修改相机原有代码的问题行 无重写】 ==========
// ==================================================
function createCameraWindow() {
  // 修复：彻底清理缓存的相机窗口，避免黑屏
  if (funcWindowCache.cam) {
    // 确保彻底释放旧流
    const oldVideo = funcWindowCache.cam.querySelector('#cameraVideo');
    if (oldVideo && oldVideo.srcObject) {
      oldVideo.srcObject.getTracks().forEach(track => {
        track.stop();
        track.enabled = false;
      });
      oldVideo.srcObject = null;
      oldVideo.removeAttribute('src');
    }
    // 彻底移除旧窗口
    funcWindowCache.cam.remove();
    const idx = allComponents.indexOf(funcWindowCache.cam);
    if (idx > -1) allComponents.splice(idx, 1);
    delete funcWindowCache.cam;
  }
  // 原有DOM创建逻辑100%保留
  const win = createBaseWindow('相机', 640, 520, 300, 150);
  const content = win.querySelector('.sys-win-content');
  content.innerHTML = `
    <div class="sys-camera">
      <div class="sys-camera-container">
        <video class="sys-camera-video" id="cameraVideo" autoplay playsinline muted></video>
        <div class="sys-camera-loading" id="cameraLoading">
          <div class="sys-camera-spinner"></div>
          <div>正在启动摄像头...</div>
        </div>
      </div>
      <div class="sys-camera-btn-group">
        <button class="sys-camera-btn" id="switchCamera">切换摄像头</button>
        <button class="sys-camera-btn capture" id="captureBtn">拍照</button>
        <button class="sys-camera-btn" id="savePhoto">保存照片</button>
      </div>
    </div>
  `;
  // 原有元素获取逻辑100%保留
  const video = win.querySelector('#cameraVideo');
  const captureBtn = win.querySelector('#captureBtn');
  const switchBtn = win.querySelector('#switchCamera');
  const saveBtn = win.querySelector('#savePhoto');
  
  let stream = null;
  let facingMode = 'user';
  let capturedCanvas = null;
  const loadingEl = win.querySelector('#cameraLoading');
  
  // 显示加载状态
  function showLoading() {
    if (loadingEl) loadingEl.style.display = 'flex';
  }
  
  // 隐藏加载状态
  function hideLoading() {
    if (loadingEl) loadingEl.style.display = 'none';
  }
  
  // 修复：相机启动函数 修复黑屏问题
  async function startCamera() {
    try {
      // 显示加载状态
      showLoading();
      dolLog('📷 正在请求摄像头权限，请在浏览器弹窗中点击「允许」', 'stage');
      
      // 修复：彻底释放旧流
      if (stream) {
        stream.getTracks().forEach(track => {
          track.stop();
          track.enabled = false;
        });
        stream = null;
      }
      video.srcObject = null;
      
      // 修复：使用标准API获取摄像头
      stream = await navigator.mediaDevices.getUserMedia({
        video: { 
          facingMode: facingMode, 
          width: { ideal: 640, min: 640 }, 
          height: { ideal: 480, min: 480 }
        },
        audio: false
      });
      dolMediaStreams.push(stream); // 注册到全局，便于统一清理
      
      // 修复：确保视频元素正确绑定流并播放
      video.srcObject = stream;
      
      // 监听视频就绪事件
      video.onloadeddata = () => {
        hideLoading();
        dolLog(`✅ 摄像头启动成功（${facingMode === 'user' ? '前置' : '后置'}）`, 'suc');
      };
      
      // 尝试播放
      await video.play().catch(e => {
        dolLog(`⚠️ 自动播放被拦截，点击画面开始`, 'out');
      });
      
    } catch (e) {
      hideLoading();
      dolLog(`❌ 摄像头启动失败`, 'err');
      if (e.name === 'NotAllowedError') {
        dolLog('⚠️ 原因：你拒绝了摄像头权限，请在浏览器地址栏左侧重新开启权限', 'out');
      } else if (e.name === 'NotFoundError') {
        dolLog('⚠️ 原因：未检测到可用的摄像头设备，请检查设备是否正常连接', 'out');
      } else if (e.name === 'NotSupportedError') {
        dolLog('⚠️ 原因：当前浏览器不支持摄像头API，请使用Chrome/Edge/Firefox浏览器', 'out');
      } else {
        dolLog(`⚠️ 错误详情：${e.message}`, 'out');
      }
    }
  }
  // 原有拍照逻辑100%保留 仅修复流校验
  captureBtn.onclick = () => {
    if (!stream || video.readyState < 2) {
      dolLog('❌ 相机未就绪，请等待摄像头画面加载完成', 'err');
      return;
    }
    const canvas = document.createElement('canvas');
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0);
    capturedCanvas = canvas;
    
    // 原有闪屏效果保留
    video.style.filter = 'brightness(2)';
    setTimeout(() => {
      video.style.filter = 'none';
    }, 100);
    
    dolLog('✅ 拍照成功！点击"保存照片"下载', 'suc');
  };
  
  // 原有切换摄像头逻辑保留 仅修复旧流释放
  switchBtn.onclick = () => {
    facingMode = facingMode === 'user' ? 'environment' : 'user';
    startCamera();
  };
  
  // 原有保存照片逻辑100%保留
  saveBtn.onclick = () => {
    if (!capturedCanvas) {
      dolLog('❌ 请先完成拍照', 'err');
      return;
    }
    const link = document.createElement('a');
    link.download = `donglaugol_photo_${Date.now()}.png`;
    link.href = capturedCanvas.toDataURL('image/png');
    link.click();
    dolLog('✅ 照片已保存到本地', 'suc');
  };
  
  // 修复：添加关闭按钮检查，避免找不到元素报错
  const closeBtn = win.querySelector('.sys-win-close');
  if (closeBtn) {
    closeBtn.onclick = () => {
      if (stream) {
        stream.getTracks().forEach(track => {
          track.stop();
          track.enabled = false;
        });
        stream = null;
      }
      if (video.srcObject) {
        video.srcObject = null;
        video.removeAttribute('src');
      }
      win.remove();
      const idx = allComponents.indexOf(win);
      if (idx > -1) allComponents.splice(idx, 1);
      delete funcWindowCache.cam;
      dolLog('✅ 相机已关闭，资源已完全释放', 'suc');
    };
  } else {
    // 如果没有关闭按钮，添加点击窗口关闭功能
    win.addEventListener('click', () => {
      if (stream) {
        stream.getTracks().forEach(track => {
          track.stop();
          track.enabled = false;
        });
        stream = null;
      }
      win.remove();
      const idx = allComponents.indexOf(win);
      if (idx > -1) allComponents.splice(idx, 1);
      delete funcWindowCache.cam;
    });
  }
  // 原有启动逻辑100%保留
  startCamera();
  funcWindowCache.cam = win;
  return win;
}
// ==================================================
// ========== 【新增：4条自动指令专属解析函数 无任何原有代码修改】 ==========
// ==================================================
// 自动指令1：/auto/clean 自动清空所有控件
function parseAutoClean(cmd) {
  if (cmd !== '/auto/clean') return false;
  clearAll();
  dolLog('✅ 自动清空完成，所有控件已清除', 'suc');
  return true;
}
// 自动指令2：/auto/light 自动循环变色灯
function parseAutoLight(cmd) {
  if (cmd !== '/auto/light') return false;
  parseDolLight('/dol/light');
  const lightList = document.querySelectorAll('.dol-light');
  const light = lightList[lightList.length - 1];
  if (!light) {
    dolLog('❌ 灯光创建失败', 'err');
    return true;
  }
  const colors = ['#ff0000', '#ffaa00', '#ffff00', '#00ff44', '#0066ff', '#9370db', '#ff69b4'];
  let colorIndex = 0;
  const autoLightTimer = setInterval(() => {
    const targetColor = colors[colorIndex % colors.length];
    light.style.background = targetColor;
    light.style.boxShadow = `0 0 40px ${targetColor}`;
    colorIndex++;
  }, 500);
  timerList.push(autoLightTimer);
  dolLog('✅ 自动循环变色灯已启动', 'suc');
  return true;
}
// 自动指令3：/auto/camera 自动打开相机3秒后拍照
function parseAutoCamera(cmd) {
  if (cmd !== '/auto/camera') return false;
  const win = createCameraWindow();
  dolLog('📷 自动相机已启动，3秒后自动拍照', 'stage');
  const autoCameraTimer = setTimeout(() => {
    win.querySelector('#captureBtn').click();
    setTimeout(() => {
      win.querySelector('#savePhoto').click();
    }, 500);
  }, 3000);
  timerList.push(autoCameraTimer);
  return true;
}
// 自动指令4：/auto/run<毫秒数> 自动延迟指定时间后运行代码
function parseAutoRun(cmd) {
  const reg = /^\/auto\/run<(\d+)>$/;
  const match = cmd.match(reg);
  if (!match) return false;
  const delayMs = parseInt(match[1]);
  if (isNaN(delayMs) || delayMs < 0) {
    dolLog('❌ 延迟时间必须为≥0的数字', 'err');
    return true;
  }
  dolLog(`⏰ 自动运行已设置，${delayMs}毫秒后执行代码`, 'time');
  const autoRunTimer = setTimeout(() => {
    run();
  }, delayMs);
  timerList.push(autoRunTimer);
  return true;
}
// ==================================================
// ========== 【修复：弹幕功能专属解析函数 不修改原有代码】 ==========
// ==================================================
function parseDanmuCmd(cmd) {
  const line = cmd.trim();
  // 匹配格式：/danmu<弹幕内容>[滚动时长][颜色]
  const reg = /^\/danmu<([^>]+)>(?:\[(\d+)\])?(?:\[([^\]]+)\])?$/;
  const match = line.match(reg);
  if (!match) return false;
  const text = match[1];
  const duration = parseInt(match[2]) || 8; // 默认8秒滚动完
  const color = match[3] || '#ffffff';
  
  const danmuEl = document.createElement('div');
  danmuEl.className = 'dol-danmu';
  danmuEl.textContent = text;
  danmuEl.style.color = color;
  // 随机垂直位置，避免重叠
  const randomTop = Math.floor(Math.random() * (window.innerHeight - 100)) + 20;
  danmuEl.style.top = `${randomTop}px`;
  // 设置滚动动画时长
  danmuEl.style.animationDuration = `${duration}s`;
  
  document.body.appendChild(danmuEl);
  allComponents.push(danmuEl);
  
  // 动画结束后自动移除
  danmuEl.addEventListener('animationend', () => {
    danmuEl.remove();
  });
  
  dolLog(`✅ 弹幕已发送：${text} | 滚动时长：${duration}s | 颜色：${color}`, 'suc');
  return true;
}
// ==================================================
// ========== 【新增：24个正经游戏指令】 ==========
// ==================================================
// 游戏指令统一解析入口
function parseGameCommand(cmd) {
  const line = cmd.trim();
  const nowind = line.endsWith(' nowind.{@dol}');
  const cleanLine = nowind ? line.slice(0, -14).trim() : line;
  
  if (!cleanLine.startsWith('/game/')) return false;
  
  const gameType = cleanLine.slice(6); // 提取游戏类型
  
  const gameFunctions = {
    'guess.number': createGuessNumberGame,
    'memory.card': createMemoryCardGame,
    'snake': createSnakeGame,
    'tetris': createTetrisGame,
    'tictactoe': createTicTacToeGame,
    'minesweeper': createMinesweeperGame,
    'pong': createPongGame,
    'puzzle': createPuzzleGame,
    'typing': createTypingGame,
    'breakout': createBreakoutGame,
    '2048': create2048Game,
    'whackamole': createWhackamoleGame,
    'flappy': createFlappyGame,
    'chess': createChessGame,
    'sudoku': createSudokuGame,
    'connect4': createConnect4Game,
    'reversi': createReversiGame,
    'solitaire': createSolitaireGame,
    'wordle': createWordleGame,
    'quiz': createQuizGame,
    'reaction': createReactionGame,
    'simon': createSimonGame,
    'dice': createDiceGame,
    'lottery': createLotteryGame
  };
  
  if (gameFunctions[gameType]) {
    // 如果启用了全局全屏模式，或者使用了 nowind.{@dol} 参数，则全屏运行
    gameFunctions[gameType](nowind || gameFullscreenMode);
    return true;
  }
  
  dolLog('❌ 未知游戏类型', 'err');
  return true;
}

// ==================================================
// ========== 【新增：no./game/.<all>{@g} 全局全屏设置】 ==========
// ==================================================
let gameFullscreenMode = false; // 全局游戏全屏模式

function parseGameFullscreenCmd(cmd) {
  const line = cmd.trim();
  
  // 格式：no./game/.<all>{@g}  开启全局全屏
  if (line === 'no./game/.<all>{@g}') {
    gameFullscreenMode = true;
    dolLog('🎮 全局全屏模式已开启，所有游戏将全屏运行', 'suc');
    return true;
  }
  
  // 格式：off./game/.<all>{@g}  关闭全局全屏
  if (line === 'off./game/.<all>{@g}') {
    gameFullscreenMode = false;
    dolLog('🎮 全局全屏模式已关闭，游戏将在窗口中运行', 'suc');
    return true;
  }
  
  // 格式：/ow/bs<宽>*<高>  设置游戏窗口大小
  const bsMatch = line.match(/^\/ow\/bs<(\d+)?>\*<(\d+)?>$/);
  if (bsMatch) {
    const width = bsMatch[1] ? parseInt(bsMatch[1]) : 800;
    const height = bsMatch[2] ? parseInt(bsMatch[2]) : 600;
    gameWindowWidth = width;
    gameWindowHeight = height;
    dolLog(`🎮 游戏窗口大小已设置为 ${width}x${height}`, 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：7个网页制作指令】 ==========
// ==================================================

// /web/title<标题> 设置网页标题
function parseWebTitle(cmd) {
  const match = cmd.match(/^\/web\/title<(.+)>$/);
  if (!match) return false;
  document.title = match[1];
  dolLog(`🌐 网页标题已设置为：${match[1]}`, 'suc');
  return true;
}

// /web/bg<颜色或图片URL> 设置网页背景
function parseWebBg(cmd) {
  const match = cmd.match(/^\/web\/bg<(.+)>$/);
  if (!match) return false;
  const val = match[1];
  if (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('data:')) {
    document.body.style.backgroundImage = `url("${val}")`;
    document.body.style.backgroundSize = 'cover';
  } else if (/^#[0-9a-fA-F]{3,6}$/.test(val) || /^rgba?\([\d\s,\.]+\)$/.test(val) || /^[a-zA-Z]+$/.test(val)) {
    document.body.style.background = val;
  } else {
    dolLog(`❌ 无效的背景值`, 'err');
    return true;
  }
  dolLog(`🎨 网页背景已设置`, 'suc');
  return true;
}

// /web/icon<图片URL> 设置网页图标
function parseWebIcon(cmd) {
  const match = cmd.match(/^\/web\/icon<(.+)>$/);
  if (!match) return false;
  const url = match[1];
  // 只允许http/https/data协议
  if (!url.startsWith('http://') && !url.startsWith('https://') && !url.startsWith('data:')) {
    dolLog(`❌ 无效的图标URL`, 'err');
    return true;
  }
  const link = document.createElement('link');
  link.rel = 'icon';
  link.href = url;
  document.head.appendChild(link);
  dolLog(`🏠 网页图标已设置`, 'suc');
  return true;
}

// /web/font<字体名称> 设置网页字体
function parseWebFont(cmd) {
  const match = cmd.match(/^\/web\/font<(.+)>$/);
  if (!match) return false;
  // 安全校验：只允许字母、数字、空格和常见字体分隔符
  const font = match[1].replace(/[^a-zA-Z0-9\s,.\-'"u4e00-\u9fa5]/g, '').trim();
  if (!font) {
    dolLog(`❌ 无效的字体名称`, 'err');
    return true;
  }
  document.body.style.fontFamily = font;
  dolLog(`✍️ 网页字体已设置为：${font}`, 'suc');
  return true;
}

// /web/script<JS代码> 执行JavaScript代码
function parseWebScript(cmd) {
  const match = cmd.match(/^\/web\/script<(.+)>$/);
  if (!match) return false;
  const code = match[1];
  // 安全校验：禁止危险模式和全局对象访问
  const dangerous = /\b(?:cookie|localStorage|sessionStorage|fetch|XMLHttpRequest|WebSocket|eval|Function|document|window|self|top|parent|frames|navigator|location|import|require|process|globalThis|__proto__|constructor|prototype|this|arguments|callee|caller|Proxy|Reflect|Symbol|Map|Set|WeakMap|WeakSet|Promise|async|await|yield|delete|void|typeof|instanceof|in|of|class|extends|super|import|export|with)\b/i;
  const dangerousProps = /(?:\[\s*['"`]|\.bind\(|\.call\(|\.apply\(|\.toString\(|\.valueOf\(|\.constructor\[|\.__proto__|\.prototype)/;
  // 禁止括号和方括号访问
  const dangerousBrackets = /[[(]/;
  if (dangerous.test(code) || dangerousProps.test(code) || dangerousBrackets.test(code)) {
    dolLog(`❌ 禁止执行危险操作`, 'err');
    return true;
  }
  try {
    const fn = new Function('console', 'Math', 'Date', 'Array', 'Object', 'String', 'Number', 'JSON', '"use strict"; ' + code);
    fn(console, Math, Date, Array, Object, String, Number, JSON);
    dolLog(`⚡ JavaScript代码已执行`, 'suc');
  } catch (e) {
    dolLog(`❌ JavaScript执行错误：${e.message}`, 'err');
  }
  return true;
}

// /web/meta<内容> 添加meta标签
function parseWebMeta(cmd) {
  const match = cmd.match(/^\/web\/meta<(.+)>$/);
  if (!match) return false;
  const meta = document.createElement('meta');
  meta.name = 'description';
  meta.content = match[1];
  document.head.appendChild(meta);
  dolLog(`📝 Meta标签已添加`, 'suc');
  return true;
}

// /web/link<URL> 跳转到网页
function parseWebLink(cmd) {
  const match = cmd.match(/^\/web\/link<(.+)>$/);
  if (!match) return false;
  const url = match[1];
  // 安全校验：只允许http/https协议，防止 javascript: 等危险协议
  if (!/^https?:\/\/.+/.test(url)) {
    dolLog(`❌ 无效的链接URL，只允许 http/https`, 'err');
    return true;
  }
  window.location.href = url;
  return true;
}

// ==================================================
// ========== 【新增：50个其他功能指令（画画/终端/服务器/应用/控制）】 ==========
// ==================================================

// 画画类指令
let drawCanvas = null;
let drawCtx = null;
let drawColor = '#ffffff';
let drawSize = 5;

function parseDrawCmd(cmd) {
  const line = cmd.trim();
  
  // /draw/open<宽>*<高> 打开画布
  const openMatch = line.match(/^\/draw\/open<(\d+)?>\*<(\d+)?>$/);
  if (openMatch) {
    const w = parseInt(openMatch[1]) || 500;
    const h = parseInt(openMatch[2]) || 400;
    // 修复：销毁旧画布并从 allComponents 中移除引用
    if (drawCanvas) {
      drawCanvas.remove();
      const oldIdx = allComponents.indexOf(drawCanvas);
      if (oldIdx > -1) allComponents.splice(oldIdx, 1);
    }
    drawCanvas = document.createElement('canvas');
    drawCanvas.width = w;
    drawCanvas.height = h;
    drawCanvas.style.cssText = `position:fixed;bottom:220px;right:10px;border:2px solid #5a7ca3;border-radius:5px;cursor:crosshair;z-index:999;`;
    drawCtx = drawCanvas.getContext('2d');
    drawCtx.fillStyle = '#000';
    drawCtx.fillRect(0, 0, w, h);
    document.body.appendChild(drawCanvas);
    allComponents.push(drawCanvas);
    
    let drawing = false;
    drawCanvas.addEventListener('mousedown', (e) => { drawing = true; drawCtx.beginPath(); drawCtx.moveTo(e.offsetX, e.offsetY); });
    drawCanvas.addEventListener('mousemove', (e) => { if (drawing) { drawCtx.lineTo(e.offsetX, e.offsetY); drawCtx.strokeStyle = drawColor; drawCtx.lineWidth = drawSize; drawCtx.stroke(); } });
    drawCanvas.addEventListener('mouseup', () => drawing = false);
    drawCanvas.addEventListener('mouseleave', () => drawing = false);
    drawCanvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      drawing = true;
      const touch = e.touches[0];
      const rect = drawCanvas.getBoundingClientRect();
      drawCtx.beginPath();
      drawCtx.moveTo(touch.clientX - rect.left, touch.clientY - rect.top);
    }, { passive: false });
    drawCanvas.addEventListener('touchmove', (e) => {
      if (!drawing) return;
      e.preventDefault();
      const touch = e.touches[0];
      const rect = drawCanvas.getBoundingClientRect();
      drawCtx.lineTo(touch.clientX - rect.left, touch.clientY - rect.top);
      drawCtx.strokeStyle = drawColor;
      drawCtx.lineWidth = drawSize;
      drawCtx.stroke();
    }, { passive: false });
    drawCanvas.addEventListener('touchend', () => drawing = false);
    
    dolLog(`🎨 画布已打开 (${w}x${h})，按住鼠标画画`, 'suc');
    return true;
  }
  
  // /draw/color<颜色> 设置画笔颜色
  const colorMatch = line.match(/^\/draw\/color<(.+)>$/);
  if (colorMatch) { drawColor = colorMatch[1]; dolLog(`🎨 画笔颜色：${drawColor}`, 'suc'); return true; }
  
  // /draw/size<像素> 设置画笔大小
  const sizeMatch = line.match(/^\/draw\/size<(\d+)>$/);
  if (sizeMatch) { drawSize = parseInt(sizeMatch[1]); dolLog(`🎨 画笔大小：${drawSize}px`, 'suc'); return true; }
  
  // /draw/clear 清空画布
  if (line === '/draw/clear' && drawCtx) {
    drawCtx.fillStyle = '#000';
    drawCtx.fillRect(0, 0, drawCanvas.width, drawCanvas.height);
    dolLog(`🗑️ 画布已清空`, 'suc');
    return true;
  }
  
  // /draw/close 关闭画布
  if (line === '/draw/close' && drawCanvas) {
    drawCanvas.remove();
    drawCanvas = null;
    drawCtx = null;
    dolLog(`❌ 画布已关闭`, 'suc');
    return true;
  }
  
  // /draw/line<x1>,<y1>-<x2>,<y2> 画直线
  const lineMatch = line.match(/^\/draw\/line<(\d+),(\d+)-(\d+),(\d+)>$/);
  if (lineMatch && drawCtx) {
    drawCtx.beginPath();
    drawCtx.moveTo(parseInt(lineMatch[1]), parseInt(lineMatch[2]));
    drawCtx.lineTo(parseInt(lineMatch[3]), parseInt(lineMatch[4]));
    drawCtx.strokeStyle = drawColor;
    drawCtx.lineWidth = drawSize;
    drawCtx.stroke();
    dolLog(`📐 直线已绘制`, 'suc');
    return true;
  }
  
  // /draw/rect<x>,<y>-<w>,<h> 画矩形
  const rectMatch = line.match(/^\/draw\/rect<(\d+),(\d+)-(\d+),(\d+)>$/);
  if (rectMatch && drawCtx) {
    drawCtx.strokeStyle = drawColor;
    drawCtx.lineWidth = drawSize;
    drawCtx.strokeRect(parseInt(rectMatch[1]), parseInt(rectMatch[2]), parseInt(rectMatch[3]), parseInt(rectMatch[4]));
    dolLog(`▢ 矩形已绘制`, 'suc');
    return true;
  }
  
  // /draw/circle<x>,<y>-<r> 画圆
  const circleMatch = line.match(/^\/draw\/circle<(\d+),(\d+)-(\d+)>$/);
  if (circleMatch && drawCtx) {
    drawCtx.beginPath();
    drawCtx.arc(parseInt(circleMatch[1]), parseInt(circleMatch[2]), parseInt(circleMatch[3]), 0, Math.PI * 2);
    drawCtx.strokeStyle = drawColor;
    drawCtx.lineWidth = drawSize;
    drawCtx.stroke();
    dolLog(`⭕ 圆已绘制`, 'suc');
    return true;
  }
  
  return false;
}

// ==================================================
// ========== 【新增：动画制作指令】 ==========
// ==================================================
// 格式: /ac/ make.AZ19{   A0,0 B2 Cf 2D E5 S2 S4 5G 2H 7E 6R}end<Dr~
// 参数说明:
// A<x>,<y> - 起始位置
// B<速度> - 移动速度
// C<颜色> - 颜色（如 #fff）
// D<类型> - 动画类型（如 2D）
// E<数量> - 移动格数
// S<大小> - 元素大小
// G<高度> - 高度变化
// H<窗口高度> - 窗口高度
// R<窗口宽度> - 窗口宽度

function parseAnimationCmd(cmd) {
  const match = cmd.match(/^\/ac\/ make\.AZ19\{([\s\S]*?)\}end<Dr~$/);
  if (!match) return false;
  
  const params = match[1].trim();
  if (!params.startsWith('   ')) {
    dolLog('❌ 动画参数格式错误，必须以     开头', 'err');
    return true;
  }
  
  const paramStr = params.substring(3);
  const paramPairs = paramStr.split(' ');
  
  const animParams = {};
  for (const pair of paramPairs) {
    if (!pair) continue;
    const key = pair[0].toUpperCase();
    const value = pair.substring(1);
    animParams[key] = value;
  }
  
  // 解析参数
  const startPos = animParams['A'] || '0,0';
  const [startX, startY] = startPos.split(',').map(v => parseInt(v) || 0);
  const speed = parseInt(animParams['B']) || 2;
  const color = animParams['C'] || '#ffffff';
  const animType = animParams['D'] || '2D';
  const moveSteps = parseInt(animParams['E']) || 7;
  const size = parseInt(animParams['S']) || 20;
  const height = parseInt(animParams['G']) || 2;
  const winHeight = parseInt(animParams['H']) || 400;
  const winWidth = parseInt(animParams['R']) || 200;
  
  // 创建动画窗口
  const animWin = document.createElement('div');
  animWin.className = 'sys-window';
  animWin.style.width = winWidth + 'px';
  animWin.style.height = winHeight + 'px';
  animWin.style.left = '50%';
  animWin.style.top = '50%';
  animWin.style.transform = 'translate(-50%, -50%)';
  animWin.style.background = '#1e2126';
  animWin.style.border = '2px solid #5a7ca3';
  animWin.style.borderRadius = '8px';
  animWin.style.overflow = 'hidden';
  animWin.style.zIndex = '1000';
  document.body.appendChild(animWin);
  allComponents.push(animWin);
  
  // 创建画布
  const canvas = document.createElement('canvas');
  canvas.width = winWidth;
  canvas.height = winHeight;
  canvas.style.background = '#000';
  animWin.appendChild(canvas);
  
  const ctx = canvas.getContext('2d');
  let currentX = startX * 20;
  let currentY = startY * 20;
  let targetX = currentX + moveSteps * 20;
  let currentHeight = size;
  let targetHeight = size + height * 10;
  
  // 动画循环
  let frame = 0;
  const totalFrames = 60;
  
  function animate() {
    frame++;
    const progress = frame / totalFrames;
    
    // 计算位置
    currentX = startX * 20 + (targetX - startX * 20) * easeInOutQuad(progress);
    
    // 计算高度（先上升后保持）
    if (progress < 0.3) {
      currentHeight = size + (targetHeight - size) * (progress / 0.3);
    }
    
    // 清空画布
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, winWidth, winHeight);
    
    // 绘制移动元素
    ctx.fillStyle = color;
    ctx.fillRect(currentX, winHeight - currentHeight, size, currentHeight);
    
    if (frame < totalFrames) {
      dolRequestAnimationFrame(animate);
    } else {
      dolLog('🎬 动画制作完成', 'suc');
    }
  }
  
  animate();
  return true;
}

// 缓动函数
function easeInOutQuad(t) {
  return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
}

// ==================================================
// ========== 【新增：操控计算机指令】 ==========
// ==================================================
// 格式: /cd/goto<cmd> - 执行系统命令

function parseControlPCCmd(cmd) {
  const match = cmd.match(/^\/cd\/goto<(.+)>$/);
